#!/usr/bin/env python3
"""A synthetic `room-cli` for the Cloudroom driver's tests. It never reaches Cloudroom.

It logs each call's arguments as one JSON line in $FAKE_ROOM_LOG and keeps its threads in
$FAKE_ROOM_LOG.threads. `thread spawn` starts the program named by --provider as a local turn
(`<provider> --model <m> -p <prompt>`) and answers a receipt; `thread tell` starts another turn
with the message file's text; `thread archive` ends every process the thread's turns started, in any
session, as archiving a Cloudroom thread ends its sandbox. FAKE_ROOM_REFUSE
names a subcommand (spawn, tell, archive) to refuse, as Cloudroom does: a line on stderr, exit 1.
FAKE_ROOM_RECEIPT replaces the spawn receipt with that text, unchanged.
FAKE_ROOM_BREAK names a folder that spawn replaces with a regular file once the thread exists, and
FAKE_ROOM_READONLY one it makes read-only, as a full disk or a removed folder would break the caller's
next write. FAKE_ROOM_HOLD names a file that `tell` waits for (it makes <file>.held first, and logs
["thread", "told"] once it is done). `thread list` answers the threads not archived, as Cloudroom does.
"""
import json, os, shutil, signal, subprocess, sys, time

args, log = sys.argv[1:], os.environ['FAKE_ROOM_LOG']
with open(log, 'a') as f:
    f.write(json.dumps(args) + '\n')
sub = args[1] if len(args) > 1 and args[0] == 'thread' else ''
if sub and os.environ.get('FAKE_ROOM_REFUSE') == sub:
    sys.exit(print('Synthetic refusal of thread %s %s.' % (sub, ' '.join(args[2:3])), file=sys.stderr) or 1)
try:
    with open(log + '.threads') as f:
        threads = json.load(f)
except FileNotFoundError:
    threads = {}


local, json_out = os.environ.get('FAKE_ROOM_HOST') == 'local', '--json' in args


def flag(name):
    return args[args.index(name) + 1]


def mark(tid):
    return 'FAKE_ROOM_THREAD=%s:%s' % (log, tid)


def turn(thread, prompt):
    try:
        p = subprocess.Popen([thread['provider'], '--model', thread['model'], '-p', prompt], start_new_session=True,
                             env=dict(os.environ, FAKE_ROOM_THREAD=mark(thread['id']).partition('=')[2]),
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        thread['turns'].append(p.pid)
    except FileNotFoundError:
        pass  # a provider with no local program: the thread exists, and runs nothing here


if sub == 'spawn':
    tid = 'thr_syn_%04d' % (len(threads) + 1)
    threads[tid] = {'id': tid, 'provider': flag('--provider'), 'model': flag('--model'), 'title': flag('--title'), 'turns': []}
    turn(threads[tid], flag('--prompt'))
    if os.environ.get('FAKE_ROOM_BREAK'):
        shutil.rmtree(os.environ['FAKE_ROOM_BREAK'], ignore_errors=True)
        open(os.environ['FAKE_ROOM_BREAK'], 'w').close()
    if os.environ.get('FAKE_ROOM_READONLY'):
        os.chmod(os.environ['FAKE_ROOM_READONLY'], 0o500)
    threads[tid].update(projectId=flag('--project'), parentThreadId=os.environ.get('ROOM_THREAD_ID'))
    out = os.environ.get('FAKE_ROOM_RECEIPT') or (json.dumps(
        {'id': tid, 'projectId': flag('--project'), 'providerId': flag('--provider'), 'status': 'pending'})
        if json_out or not local else 'Started %s (%s) in %s' % (tid, flag('--title'), flag('--project')))
elif sub == 'tell' and not threads.get(args[2], {'archived': True}).get('archived'):
    with open(flag('--message-file')) as f:
        turn(threads[args[2]], f.read())
    if os.environ.get('FAKE_ROOM_HOLD'):
        open(os.environ['FAKE_ROOM_HOLD'] + '.held', 'w').close()
        while not os.path.exists(os.environ['FAKE_ROOM_HOLD']):
            time.sleep(0.01)
        with open(log, 'a') as f:
            f.write(json.dumps(['thread', 'told']) + '\n')
    out = json.dumps({'ok': True})
elif sub == 'list':
    rows = [{'id': t, 'title': v['title'], 'status': 'active', 'projectId': v.get('projectId'),
             'parentThreadId': v.get('parentThreadId')} for t, v in threads.items() if not v.get('archived')]
    if local and '--project' in args:
        rows = [r for r in rows if r['projectId'] == flag('--project')]
    if not local:
        rows = [{'id': r['id'], 'title': r['title'], 'status': r['status']} for r in rows
                if r['parentThreadId'] == os.environ.get('ROOM_THREAD_ID')]
    rows += json.loads(os.environ.get('FAKE_ROOM_EXTRA') or '[]')
    if not local and set(args[2:]) - {'--json', '--include-archived'}:
        sys.exit(print('Unknown option %s.' % sorted(set(args[2:]) - {'--json', '--include-archived'})[0],
                       file=sys.stderr) or 2)
    if os.environ.get('FAKE_ROOM_LIST') is not None:
        out = os.environ['FAKE_ROOM_LIST']
    elif not local:
        out = json.dumps({'children': rows})
    else:
        out = json.dumps(rows) if json_out else '\n'.join(['ID  TITLE  STATUS'] + [
            '%s  %s  %s' % (r['id'], r['title'], r['status']) for r in rows])
elif sub == 'archive' and args[2] in threads:
    threads[args[2]]['archived'] = True
    for pid in filter(str.isdigit, os.listdir('/proc')):  # every process carrying the thread's mark
        try:
            with open('/proc/%s/environ' % pid, 'rb') as f:
                if mark(args[2]).encode() in f.read().split(b'\0'):
                    os.kill(int(pid), signal.SIGKILL)
        except OSError:
            pass
    out = json.dumps({'archived': [args[2]]})
else:
    sys.exit(print('Synthetic: not a subagent of this thread.', file=sys.stderr) or 1)
if local and not json_out and sub in ('tell', 'archive'):
    out = 'Done: thread %s %s' % (sub, args[2])
with open(log + '.threads', 'w') as f:
    json.dump(threads, f)
print(out)
