#!/usr/bin/env python3
import json, os, re, sys
sys.dont_write_bytecode = True
sys.path.insert(0, os.environ['FAKE_CLI_LIB'])
import fake_cli

HELP = '''The fake agent, after the Cursor CLI parameters reference
(https://cursor.com/docs/cli/reference/parameters). It allows only:
  agent -p --output-format json --model <model> --force <prompt>
  agent -p --output-format json --resume <session> --model <model> --force <prompt>
It prints one JSON object with session_id, as --output-format json does
(https://cursor.com/docs/cli/reference/output-format). Signed out, it prints
the authentication reference's "Not authenticated" line. It has no effort flag.'''
SESSION = r'[A-Za-z0-9._:-]{1,100}'
SIGNED_OUT = 'Not authenticated. Run agent login or set CURSOR_API_KEY.'


def dropped_login_flag(argv):
    kept, skip = [], False
    for arg in argv:
        if skip:
            skip = False
            continue
        if arg == '--api-key':
            skip = True
            continue
        if arg.startswith('--api-key='):
            continue
        kept.append(arg)
    return kept


def parse(argv):
    a = dropped_login_flag(argv)
    if a[:3] != ['-p', '--output-format', 'json']:
        fake_cli.refuse()
    a, session = a[3:], None
    if a[:1] == ['--resume']:
        if len(a) < 2 or not re.fullmatch(SESSION, a[1]):
            fake_cli.refuse()
        session, a = a[1], a[2:]
    if len(a) != 4 or a[:1] != ['--model'] or not a[1] or a[1].startswith('-') or a[2] != '--force' or \
            not a[3] or a[3].startswith('-'):
        fake_cli.refuse()
    return a[3], a[1], session


if sys.argv[1:] == ['--help']:
    print(HELP)
    sys.exit(0)
prompt, model, session = parse(sys.argv[1:])
if prompt.startswith('You were woken') != (session is not None):
    fake_cli.refuse()
fake_cli.turn(prompt, model, session, lambda sid: json.dumps({
    'type': 'result', 'subtype': 'success', 'is_error': False, 'result': 'synthetic', 'session_id': sid}),
    signed_out=SIGNED_OUT)
