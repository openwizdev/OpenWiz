#!/usr/bin/env python3
import os, re, subprocess, sys
sys.dont_write_bytecode = True
sys.path.insert(0, os.environ['FAKE_CLI_LIB'])
import fake_cli

HELP = '''The fake goose (v1.60.2): it allows only these two documented `goose run` lines:
  goose run -n <uuid> --model <m> --output-format json -t <prompt>
  goose run -n <uuid> --resume --model <m> --output-format json -t <prompt>
with GOOSE_MODE=auto, the only goose mode a headless run may use.'''
UUID = r'[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}'


def backgrounded_shell_command(how):
    shell = subprocess.Popen(['sh', '-c', 'sleep 300 & echo $!'], env={'PATH': os.environ['PATH']}, process_group=0,
                             stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    pid = int(shell.stdout.readline())
    shell.wait()
    shell.stdout.close()
    shell.stderr.close()
    return [pid, fake_cli.since(pid)]


fake_cli.background_service = backgrounded_shell_command

if sys.argv[1:] == ['--help']:
    print(HELP)
    sys.exit(0)
a = sys.argv[1:]
resume = a[3:4] == ['--resume']
if resume:
    a = a[:3] + a[4:]
if len(a) != 9 or a[:2] != ['run', '-n'] or not re.fullmatch(UUID, a[2]) or a[3] != '--model' or \
        a[5:8] != ['--output-format', 'json', '-t'] or a[4].startswith('-') or a[8].startswith('-') or \
        os.environ.get('GOOSE_MODE') != 'auto':
    fake_cli.refuse()
if resume != a[8].startswith('You were woken'):
    fake_cli.refuse()
if os.environ.get('FAKE_GOOSE_SETUP_ERROR'):
    print('\n  error: Error %s.\nPlease check your system keychain and run \'goose configure\' again.\n'
          'If your system is unable to use the keyring, please try setting secret key(s) via environment variables.\n'
          'For more info, see: https://goose-docs.ai/docs/troubleshooting/#keychainkeyring-errors\n'
          % os.environ['FAKE_GOOSE_SETUP_ERROR'], flush=True)
    sys.exit(1)
fake_cli.turn(a[8], a[4], a[2], daemon='goose-developer-shell', signed_out="  error: No provider configured. Run 'goose configure' first.")
