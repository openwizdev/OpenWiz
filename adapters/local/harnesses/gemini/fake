#!/usr/bin/env python3
import os, re, sys
sys.dont_write_bytecode = True
sys.path.insert(0, os.environ['FAKE_CLI_LIB'])
import fake_cli

HELP = '''The fake gemini, after gemini-cli v0.70.0's options (packages/cli/src/config/config.ts) and its headless,
session and approval-mode docs. It allows only:
  gemini -p <prompt> -o stream-json --session-id <uuid> -m <model> --approval-mode yolo [--skip-trust]
  gemini -p <prompt> -o stream-json --resume <uuid> -m <model> --approval-mode yolo [--skip-trust]
with default in place of yolo. It refuses plan, which is read-only, and the auto-edit mode, which the row
doesn't offer, and an option-shaped value after -p (yargs: Not enough arguments following: p). It has no effort
flag. Its first turn starts a detached service, as v0.70.0 auto-starts LiteRT-LM
(packages/cli/src/services/liteRtServerManager.ts, packages/cli/src/commands/gemma/start.ts). Signed out, it prints
the v0.70.0 diagnostic FAKE_GEMINI_AUTH names (validateNonInterActiveAuth.ts, config/auth.ts, core oauth2.ts) and exits 41.'''
UUID = r'[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}'
SIGNED_OUT = {
    'no-auth-type': 'Please set an Auth method in your ~/.gemini/settings.json or specify one of the following '
                    'environment variables before running: GEMINI_API_KEY, GOOGLE_GENAI_USE_VERTEXAI, GOOGLE_GENAI_USE_GCA',
    'api-key-missing': 'When using Gemini API, you must specify the GEMINI_API_KEY environment variable.\n'
                       'Update your environment and try again (no reload needed if using .env)!',
    'vertex-missing': 'When using Vertex AI, you must specify either:\n'
                      '\u2022 GOOGLE_CLOUD_PROJECT and GOOGLE_CLOUD_LOCATION environment variables.\n'
                      '\u2022 GOOGLE_API_KEY environment variable (if using express mode).\n'
                      'Update your environment and try again (no reload needed if using .env)!',
    'manual-authorization': 'Manual authorization is required but the current session is non-interactive. '
                            'Please run the Gemini CLI in an interactive terminal to log in, provide a GEMINI_API_KEY, '
                            'or ensure Application Default Credentials are configured.',
}

if sys.argv[1:] == ['--help']:
    print(HELP)
    sys.exit(0)
a = sys.argv[1:]
if a[-1:] == ['--skip-trust']:
    a = a[:-1]
if len(a) != 10 or a[0] != '-p' or a[1].startswith('-') or a[2:4] != ['-o', 'stream-json'] or \
        a[4] not in ('--session-id', '--resume') or \
        not re.fullmatch(UUID, a[5]) or a[6] != '-m' or not a[7] or a[7].startswith('-') or \
        a[8] != '--approval-mode' or a[9] not in ('default', 'yolo'):
    fake_cli.refuse()
if (a[4] == '--resume') != a[1].startswith('You were woken'):
    fake_cli.refuse()
auth = os.environ.get('FAKE_GEMINI_AUTH', 'no-auth-type')
if auth not in SIGNED_OUT:
    fake_cli.refuse()
fake_cli.turn(a[1], a[7], a[5], daemon='detached', signed_out=SIGNED_OUT[auth], signed_out_exit=41)
