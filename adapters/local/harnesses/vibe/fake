#!/usr/bin/env python3
import json, os, re, secrets, sys, time
sys.dont_write_bytecode = True
sys.path.insert(0, os.environ['FAKE_CLI_LIB'])
import fake_cli

HELP = '''The fake vibe (Mistral Vibe 3.1.5 programmatic mode, as mistral-vibe v3.1.5 cli.rs and its docs describe it).
It allows only the row's two lines, and exits 2 on any other command line, including a key flag, --trust,
--thinking anywhere, --model on a resume, and an empty or blank model:
  vibe --prompt <prompt> --output streaming --model <alias> --auto-approve
  vibe --prompt <prompt> --output streaming --resume <session> --auto-approve
--output streaming prints one JSON object per line, and the first one carries sessionId.
With FAKE_CLI_SIGNED_OUT=1, not-signed-in or keyring it prints that headless Error: line and exits 1.
With FAKE_CLI_LIMIT=now it prints Vibe's 429 Error: line on stderr and exits 2, as Vibe does once its own retries
are spent; with FAKE_CLI_LIMIT=first the first turn does that after it has announced its session.'''
SESSION = r'[A-Za-z0-9._:-]{1,100}'
SIGNED_OUT = {
    '1': 'Error: Missing MISTRAL_API_KEY environment variable for mistral provider',
    'not-signed-in': 'Error: You are not signed in to Mistral. Sign in and retry.',
    'keyring': "Error: Can't read MISTRAL_API_KEY from the system keyring for mistral provider (locked). Unlock the "
               "system keyring or approve its prompt, or set the MISTRAL_API_KEY environment variable",
}
LIMIT_LINE = ('Error: API error occurred: Status 429. Body: {"object":"error","message":"Requests rate limit exceeded",'
              '"type":"rate_limited","param":null,"code":"1300"}')


def carries_key(argv):
    for arg in argv:
        low = arg.lower()
        if low in ('--api-key', '--token', '--password', '--secret') or low.startswith(
                ('--api-key=', '--token=', '--password=', '--secret=')) or re.search(
                r'(?i)(?:^|[^a-z0-9])(?:api[_-]?key|token|secret|password)=', arg):
            fake_cli.refuse()


def take(argv, flag):
    if argv[:1] != [flag] or len(argv) < 2 or not argv[1].strip() or argv[1].startswith('-'):
        fake_cli.refuse()
    return argv[1], argv[2:]


def parse(argv):
    carries_key(argv)
    prompt, argv = take(argv, '--prompt')
    if argv[:2] != ['--output', 'streaming']:
        fake_cli.refuse()
    argv = argv[2:]
    model = session = None
    if argv[:1] == ['--model']:
        model, argv = take(argv, '--model')
    elif argv[:1] == ['--resume']:
        session, argv = take(argv, '--resume')
        if not re.fullmatch(SESSION, session):
            fake_cli.refuse()
    else:
        fake_cli.refuse()
    if argv != ['--auto-approve']:
        fake_cli.refuse()
    if (session is not None) != prompt.startswith('You were woken'):
        fake_cli.refuse()
    return prompt, model, session


def model_of(session):
    try:
        with open(os.environ['FAKE_CLI_RECORD']) as f:
            turns = [json.loads(line) for line in f if line.strip()]
    except (OSError, ValueError, KeyError):
        fake_cli.refuse()
    argv = next((t['argv'] for t in turns if t.get('turn') == 'first' and t.get('session') == session), None)
    if not argv or '--model' not in argv:
        fake_cli.refuse()
    return argv[argv.index('--model') + 1]


def announce(sid):
    return json.dumps({'type': 'message', 'role': 'assistant', 'sessionId': sid,
                       'generationStatus': 'completed', 'content': [{'type': 'text', 'text': 'synthetic'}]},
                      separators=(',', ':'))


def hit_the_limit():
    print(LIMIT_LINE, file=sys.stderr, flush=True)
    sys.exit(2)


def first_turn_then_the_limit(prompt, model):
    session = 'fake-' + secrets.token_hex(6)
    print(announce(session), flush=True)
    fake_cli.record({'turn': 'first', 'session': session, 'argv': sys.argv[1:], 'env': {}})
    fake_cli.post(model, prompt.partition('with the ')[2].partition(' skill')[0], False)
    state = os.path.join(os.environ['OPENWIZ_LOCAL_STATE'], os.environ['OPENWIZ_RUN'] + '.json')
    end = time.monotonic() + 60
    while time.monotonic() < end:
        try:
            with open(state) as f:
                if json.load(f).get('starting') is False:
                    break
        except (OSError, ValueError):
            pass
        time.sleep(0.05)
    hit_the_limit()


if sys.argv[1:] == ['--help']:
    print(HELP)
    sys.exit(0)
prompt, model, session = parse(sys.argv[1:])
limit = os.environ.get('FAKE_CLI_LIMIT')
if limit == 'now':
    hit_the_limit()
if session is not None:
    model = model_of(session)
elif limit == 'first' and not os.environ.get('FAKE_CLI_WORKER'):
    first_turn_then_the_limit(prompt, model)
signed_out = SIGNED_OUT.get(os.environ.get('FAKE_CLI_SIGNED_OUT'), SIGNED_OUT['1'])
fake_cli.turn(prompt, model, session, announce, daemon='app-server', signed_out=signed_out)
