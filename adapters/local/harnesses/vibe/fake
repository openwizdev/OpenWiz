#!/usr/bin/env python3
import json, os, sys
sys.dont_write_bytecode = True
sys.path.insert(0, os.environ['FAKE_CLI_LIB'])
import fake_cli

HELP = '''The fake vibe: its synthetic --help allows only these programmatic forms:
  vibe --prompt <p> --output json --model <alias> <mode>
  vibe -p <p> --resume <session id> <mode>
where <mode> is --auto-approve, or --approval-policy accept-edits|ask. As the real vibe does, it
refuses --model on --resume; the row passes no --thinking, so this fake refuses it; --output json prints the history as one
pretty-printed JSON array whose entries carry session_id.'''
MODES = (['--auto-approve'], ['--approval-policy', 'accept-edits'], ['--approval-policy', 'ask'])


PROVIDER = os.environ.get('FAKE_VIBE_PROVIDER') or 'mistral'
MISSING = 'Error: Missing MISTRAL_API_KEY environment variable for %s provider' % PROVIDER
KEYRING = ("Error: Can't read MISTRAL_API_KEY from the system keyring for %s provider (no keyring). "
           'Unlock the system keyring or approve its prompt, or set the MISTRAL_API_KEY environment variable' % PROVIDER)


def history(sid, prompt):
    entries = [{'id': 'entry-1', 'session_id': sid, 'turn_id': 'turn-1', 'type': 'message', 'role': 'user',
                'content': prompt}]
    if os.environ.get('FAKE_VIBE_QUOTES_DIAGNOSTICS'):
        entries += [{'id': 'entry-%d' % i, 'session_id': sid, 'turn_id': 'turn-1', 'type': 'message',
                     'role': 'assistant', 'content': text} for i, text in ((2, MISSING), (3, KEYRING))]
    return json.dumps(entries, indent=2)


if sys.argv[1:] == ['--help']:
    print(HELP)
    sys.exit(0)
args, session = sys.argv[1:], None
if len(args) > 1 and args[0] in ('--prompt', '-p'):
    prompt, args = args[1], args[2:]
else:
    fake_cli.refuse()
if args[:2] == ['--output', 'json'] and args[2:3] == ['--model'] and len(args) > 3:
    model, args = args[3], args[4:]
elif args[:1] == ['--resume'] and len(args) > 1:
    session, model, args = args[1], 'resumed', args[2:]
else:
    fake_cli.refuse()
mode = next((m for m in MODES if args[:len(m)] == m), None) or fake_cli.refuse()
args = args[len(mode):]
if args:
    fake_cli.refuse()
fake_cli.turn(prompt, model, session, lambda sid: history(sid, prompt), daemon='tree',
              signed_out=KEYRING if os.environ.get('FAKE_VIBE_KEYRING') else MISSING)
