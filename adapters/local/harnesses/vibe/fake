#!/usr/bin/env python3
import json, os, re, sys
sys.dont_write_bytecode = True
sys.path.insert(0, os.environ['FAKE_CLI_LIB'])
import fake_cli

HELP = '''The fake vibe (Mistral Vibe programmatic mode, as docs.mistral.ai and mistral-vibe main describe it).
It allows only the row's two lines, and exits 2 on any other command line, including a key flag:
  vibe --prompt <prompt> --output streaming --model <model> --trust --auto-approve [--thinking <level>]
  vibe --prompt <prompt> --output streaming --resume <session> --trust --auto-approve
<level> is off, low, medium, high, xhigh or max. --thinking and --model are new sessions only.
--output streaming prints one JSON object per line, and the first one carries sessionId.
With FAKE_CLI_SIGNED_OUT=1 it prints the missing-key line and exits 1.'''
LEVELS = ('off', 'low', 'medium', 'high', 'xhigh', 'max')
SESSION = r'[A-Za-z0-9._:-]{1,100}'
SIGNED_OUT = 'Missing MISTRAL_API_KEY environment variable for mistral provider'


def carries_key(argv):
    for arg in argv:
        low = arg.lower()
        if low in ('--api-key', '--token', '--password', '--secret') or low.startswith(
                ('--api-key=', '--token=', '--password=', '--secret=')) or re.search(
                r'(?i)(?:^|[^a-z0-9])(?:api[_-]?key|token|secret|password)=', arg):
            fake_cli.refuse()


def take(argv, flag):
    if argv[:1] != [flag] or len(argv) < 2 or not argv[1] or argv[1].startswith('-'):
        fake_cli.refuse()
    return argv[1], argv[2:]


def parse(argv):
    carries_key(argv)
    prompt, argv = take(argv, '--prompt')
    if argv[:2] != ['--output', 'streaming']:
        fake_cli.refuse()
    argv = argv[2:]
    model = session = None
    if argv[:1] == ['--model']:
        model, argv = take(argv, '--model')
    elif argv[:1] == ['--resume']:
        session, argv = take(argv, '--resume')
        if not re.fullmatch(SESSION, session):
            fake_cli.refuse()
    else:
        fake_cli.refuse()
    if argv[:2] != ['--trust', '--auto-approve']:
        fake_cli.refuse()
    argv = argv[2:]
    if argv and (session is not None or argv[:1] != ['--thinking'] or len(argv) != 2 or argv[1] not in LEVELS):
        fake_cli.refuse()
    if (session is not None) != prompt.startswith('You were woken'):
        fake_cli.refuse()
    return prompt, model, session


def model_of(session):
    try:
        with open(os.environ['FAKE_CLI_RECORD']) as f:
            turns = [json.loads(line) for line in f if line.strip()]
    except (OSError, ValueError, KeyError):
        fake_cli.refuse()
    argv = next((t['argv'] for t in turns if t.get('turn') == 'first' and t.get('session') == session), None)
    if not argv or '--model' not in argv:
        fake_cli.refuse()
    return argv[argv.index('--model') + 1]


def announce(sid):
    return json.dumps({'type': 'message', 'role': 'assistant', 'sessionId': sid,
                        'generationStatus': 'completed', 'content': [{'type': 'text', 'text': 'synthetic'}]},
                       separators=(',', ':'))


if sys.argv[1:] == ['--help']:
    print(HELP)
    sys.exit(0)
prompt, model, session = parse(sys.argv[1:])
if session is not None:
    model = model_of(session)
fake_cli.turn(prompt, model, session, announce, signed_out=SIGNED_OUT)
