#!/usr/bin/env python3
import json, os, re, sys, time
sys.dont_write_bytecode = True
sys.path.insert(0, os.environ['FAKE_CLI_LIB'])
import fake_cli

HELP = '''The fake opencode (1.19.6 forms): its synthetic --help allows only:
  opencode run --format json --model <provider/model> [--auto] -- <prompt>
  opencode run --session <id> --format json --model <provider/model> [--auto] -- <prompt>
It never attaches to a server (--attach), never takes --port or --variant, and starts its stand-in for
the detached children of opencode's shell tool in their own session.'''
SESSION_ID = r'[A-Za-z0-9][A-Za-z0-9_-]{0,99}'


def step_start(sid):
    return json.dumps({'type': 'step_start', 'timestamp': int(time.time() * 1000), 'sessionID': sid,
                       'part': {'type': 'step-start', 'sessionID': sid}})


if sys.argv[1:] == ['--help']:
    print(HELP)
    sys.exit(0)
a = sys.argv[1:]
if a[:1] != ['run']:
    fake_cli.refuse()
a, session = a[1:], None
if a[:1] == ['--session'] and len(a) > 1:
    session, a = a[1], a[2:]
    if not re.fullmatch(SESSION_ID, session):
        fake_cli.refuse()
if a[:3] != ['--format', 'json', '--model'] or len(a) < 6 or a[3].startswith('-'):
    fake_cli.refuse()
model, a = a[3], a[4:]
if a[:1] == ['--auto']:
    a = a[1:]
if len(a) != 2 or a[0] != '--' or not a[1] or (session is not None) != a[1].startswith('You were woken'):
    fake_cli.refuse()
fake_cli.turn(a[1], model, session, step_start, daemon='tree')
