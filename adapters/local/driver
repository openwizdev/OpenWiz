def look_after_the_turn_on_macos(run, harness, output):
    kept, looks, marked = {}, 0, False
    while True:
        children_left = any_child_running_after_reaping(harness)
        scanned = looks % LOOKS_PER_OUTPUT_CHECK == 0
        now = members({os.getpid()}, kept, writing_to(output) if scanned else ())
        if not children_left and not now and not scanned:
            now = members({os.getpid()}, kept, writing_to(output))
        looks += 1
        if LSOF_COULD_NOT_CHECK and not marked:
            marked = record_lsof_failed(run)
        if now != kept:
            kept = now
            record_kept(run, kept)
        if not children_left and not kept:
            try:
                os.remove(supervisor_record(run, os.getpid()))
            except OSError:
                pass
            return
        time.sleep(MACOS_SECONDS_BETWEEN_LOOKS)


def since(pid):
    if not LINUX:
        row = ps('-o', 'stat=', '-o', 'lstart=', '-p', str(pid))[0]
        return row[0].split(None, 1)[1].strip() if row and not row[0].lstrip().startswith('Z') else None
    try:
        with open('/proc/%d/stat' % pid) as f:
            fields = f.read().rpartition(')')[2].split()
    except OSError:
        return None
    return None if fields[0] == 'Z' else int(fields[19])


def descendants(pid):
    children = {}
    for p in filter(str.isdigit, os.listdir('/proc')):
        try:
            with open('/proc/%s/stat' % p) as f:
                fields = f.read().rpartition(')')[2].split()
        except OSError:
            continue
        if fields[0] != 'Z':
            children.setdefault(int(fields[1]), []).append(int(p))
    found, todo = set(), [pid]
    while todo:
        for c in children.get(todo.pop(), []):
            if c not in found:
                found.add(c)
                todo.append(c)
    return found


