def permission_mode(folder, repository, harness):
    single, own = MODE_ROW.strip('| '), 'Harness permission mode (%s)' % harness
    try:
        with open(os.path.join(folder, 'docs', 'agents', 'fleet.md')) as f:
            lines = f.read().splitlines()
    except OSError:
        lines = []
    labelled = [(row_label(line), line.strip().split('|', 2)[-1]) for line in lines]
    if not any(label and label.startswith(single + ' (') for label, _ in labelled):
        rows = [line for line in lines if line.startswith(MODE_ROW)]
        mode = row_value(rows[0]) if len(rows) == 1 else None
    else:
        rows, mine = [rest for label, rest in labelled if label == single], [rest for label, rest in labelled if label == own]
        if rows and mine:
            raise Refused('%s saves both the single Harness permission mode row and a %s row in docs/agents/fleet.md; '
                          'nothing was started' % (repository, own), 'keep one of them in docs/agents/fleet.md, with '
                          'the mode approved for %s, then start again' % harness)
