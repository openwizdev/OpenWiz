                return []
            f.seek(start)
            text = f.read().decode(errors='replace')
    except OSError:
        return []
    lines = [l for l in text.splitlines() if l.strip()]
    return lines[-LIMIT_TAIL_LINES:]


def parse_reset_clock(text, now):
    match = RESET_CLOCK.match(text)
    if not match:
        return None
    zone = (match['parenthesized'] or match['zone'] or '').strip()
    if match['minute'] is None and match['ampm'] is None and not zone:
        return None
    hour, minute = int(match['hour']), int(match['minute'] or 0)
    if match['ampm']:
        if not 1 <= hour <= 12:
            return None
        hour = hour % 12 + (12 if match['ampm'].lower() == 'pm' else 0)
    if hour > 23 or minute > 59:
        return None
    tz = timezone.utc
    if zone and zone.upper() not in ('UTC', 'GMT'):
        if '/' not in zone:
            return None
        from zoneinfo import ZoneInfo, ZoneInfoNotFoundError
        try:
            tz = ZoneInfo(zone)
        except (ValueError, ZoneInfoNotFoundError):
            return None
    base = datetime.fromtimestamp(now, tz=tz)
    if match['month'] is None:
        candidate = base.replace(hour=hour, minute=minute, second=0, microsecond=0, fold=0)
        if candidate.timestamp() <= now:
            candidate += timedelta(days=1)
        return candidate.timestamp()
    month = match['month'].lower()
    if month not in RESET_MONTHS:
        return None
    month, day = RESET_MONTHS.index(month) + 1, int(match['day'])
    for year in (base.year, base.year + 1):
        try:
            candidate = datetime(year, month, day, hour, minute, tzinfo=tz)
        except ValueError:
            continue
        if candidate.timestamp() > now:
            return candidate.timestamp()
    return None


def parse_reset_time(text, now, cue=None):
    if cue:
        text = text[cue.end():]
    match = (RESET_ISO.match if cue else RESET_ISO.search)(text)
    if match:
        raw = match[0].replace('Z', '+00:00')
        if re.search(r'[+-]\d{4}$', raw):
            raw = raw[:-2] + ':' + raw[-2:]
        try:
            return datetime.fromisoformat(raw).timestamp()
        except ValueError:
            return None
    match = (RESET_UTC.match if cue else RESET_UTC.search)(text)
    if match:
        try:
            return datetime.fromisoformat('%sT%02d:%s:%s+00:00' %
                                          (match[1], int(match[2]), match[3], match[4] or '00')).timestamp()
        except ValueError:
            return None
    epoch = re.match(r'(\d{10})\b', text) if cue else re.search(r'\|(\d{10})\b', text)
    if epoch and int(epoch[1]) >= 1700000000:
        return float(epoch[1])
    if not cue:
        return None
    match = re.match(
        r'(?:in|after)\s+((?:\d+\s*(?:hours?|hrs?|h|minutes?|mins?|m|seconds?|secs?|s)(?![a-z])(?:\s*(?:,|and)?\s*)?)+)',
        text, re.I)
    if match:
        units = {'h': 3600, 'm': 60, 's': 1}
        seconds = sum(int(amount) * units[unit[0].lower()]
                      for amount, unit in re.findall(r'(\d+)\s*([hms])', match[1], re.I))
        return now + seconds if seconds else None
    return parse_reset_clock(text, now)


def detect_limit(lines, row=None, now=None):
    now = limit_now() if now is None else now
    custom = None
    if row and row.get('limit'):
        try:
            custom = re.compile(row['limit'], re.I)
        except re.error:
            pass
    for index in range(len(lines) - 1, -1, -1):
        text = lines[index]
        if USAGE_LIMIT.search(text):
            kind = 'limit'
        elif OVERLOAD.search(text):
            kind = 'overload'
        elif custom and custom.search(text):
            kind = 'limit'
        else:
            continue
        reset_at = parse_reset_time(text, now, RESET_CUE.search(text))
        if reset_at is None and index + 1 < len(lines):
            following = lines[index + 1].lstrip()
            cue = RESET_CUE.match(following)
            if cue:
                reset_at = parse_reset_time(following, now, cue)
        return {'kind': kind, 'reset_at': reset_at,
                'too_long': reset_at is not None and (reset_at - now) > LIMIT_MAX_WAIT_SECONDS}
    return None


def limit_refusal(run, info, from_start=False, code=None):
    what = 'provider overload' if info.get('kind') == 'overload' else 'usage limit'
    reset_iso = format_reset(info['reset_at']) if info.get('reset_at') is not None else None
    wake_iso = format_reset(info['wake_at']) if info.get('wake_at') is not None else None
    if from_start:
        exit_part = ' (exit %s)' % ('unknown' if code is None else code)
        if reset_iso:
            err = 'run %s: the first turn hit a %s; resets at %s%s' % (run, what, reset_iso, exit_part)
            if info.get('too_long'):
                nxt = 'reset is more than 6 hours away; start again after %s' % reset_iso
            else:
                base = 'wait until after %s, then start again' % reset_iso
                full = "%s; %s has the turn's output" % (base, log_path(run))
                nxt = full if len(full) <= 300 else base
        else:
            err = 'run %s: the first turn hit %s%s' % (run, what, exit_part)
            base = 'wait a minute and start again'
            full = "%s; %s has the turn's output" % (base, log_path(run))
            nxt = full if len(full) <= 300 else base
        return err, nxt
    if info.get('waiting'):
        if reset_iso:
            return ('run %s is waiting out a %s; resets at %s' % (run, what, reset_iso),
                    'the run resumes on its own after %s (around %s); no wake needed' % (reset_iso, wake_iso or reset_iso))
        return ('run %s is waiting out %s until %s' % (run, what, wake_iso),
                'the run resumes on its own at %s; no wake needed' % wake_iso)
    if info.get('too_long') and reset_iso:
        return ('run %s hit a %s; resets at %s (more than 6 hours away)' % (run, what, reset_iso),
                'wake the run after %s' % reset_iso)
    return ('run %s hit a %s' % (run, what), 'wait and wake the run again')


def limit_stop_requested(run):
    if STOP_SIGNALED:
        return True
    try:
        return bool(saved(run).get('stopped'))
    except (OSError, ValueError, Refused):
        return False


def limit_sleep(seconds, run):
    end_at = time.monotonic() + max(0.0, seconds)
    while time.monotonic() < end_at:
        if limit_stop_requested(run):
            return False
        time.sleep(min(0.2, max(0.01, end_at - time.monotonic())))
    return not limit_stop_requested(run)


def check_limit_before_wake(run):
    info = read_limit_state(run)
    if not info:
        return
    if info.get('waiting'):
        sup, sup_since = info.get('supervisor'), info.get('supervisor_since')
        if sup is not None and sup_since is not None and since(sup) == sup_since:
            raise Refused(*limit_refusal(run, info, from_start=False))
        clear_limit_state(run)
        return
    if info.get('too_long') and info.get('reset_at') is not None:
        if limit_now() < info['reset_at']:
            raise Refused(*limit_refusal(run, info, from_start=False))
        clear_limit_state(run)


def next_resume_after_limit(run, output_from, exit_code, counts):
    if exit_code in (None, 0) or limit_stop_requested(run):
        return None
    try:
        state = saved(run)
    except (OSError, ValueError, Refused):
        return None
    if state.get('starting') or state.get('stopped'):
        return None
    info = detect_limit(turn_tail_lines(run, output_from), state.get('row'))
    if info is None:
        return None
    now = limit_now()
    if info['too_long']:
        write_limit_state(run, dict(info, waiting=False, supervisor=os.getpid(), supervisor_since=since(os.getpid())))
        return None
    if info['reset_at'] is not None:
        if counts['limit'] >= 1:
            clear_limit_state(run)
            return None
        counts['limit'] += 1
        wake_at = max(now, info['reset_at']) + LIMIT_BUFFER_SECONDS + limit_jitter()
        wait_s = max(0.0, wake_at - now)
    elif info['kind'] == 'overload':
        if counts['overload'] >= len(OVERLOAD_WAITS):
            clear_limit_state(run)
            return None
        wait_s = float(OVERLOAD_WAITS[counts['overload']])
        counts['overload'] += 1
        wake_at = now + wait_s
    else:
        if counts['limit'] >= 1:
            clear_limit_state(run)
            return None
        counts['limit'] += 1
        wait_s = float(OVERLOAD_WAITS[0])
        wake_at = now + wait_s
    write_limit_state(run, dict(info, waiting=True, wake_at=wake_at,
                                supervisor=os.getpid(), supervisor_since=since(os.getpid())))
    try:
        log = open_log(run)
        try:
            os.write(log, ('driver: %s; waiting until %s to resume on the same model\n'
                           % (info['kind'], format_reset(wake_at))).encode())
        finally:
            os.close(log)
    except OSError:
        pass
    if not limit_sleep(wait_s, run):
        clear_limit_state(run)
        return None
    try:
        lock_fd = os.open(os.path.join(STATE, run + '.lock'), os.O_RDONLY | os.O_CREAT, 0o600)
        try:
            fcntl.flock(lock_fd, fcntl.LOCK_EX)
            state = saved(run)
            if STOP_SIGNALED or state.get('stopped'):
                return None
            if state.get('row') and state.get('session') is None:
                state['session'] = reported_session(run, state['row']['session'], state['turns'][0])
                if state['session'] is None:
                    return None
            return resume_turn(run, state)
        finally:
            clear_limit_state(run)
            os.close(lock_fd)
    except (OSError, ValueError, Refused):
        return None


def resume_turn(run, state):
    cmd, overlay = command(state, True)
    try:
        log = open_log(run)
        output_from = os.fstat(log).st_size
    except OSError:
        log, output_from = subprocess.DEVNULL, 0
    try:
        harness = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=log, stderr=log,
                                   cwd=work(run), env=dict(os.environ, **overlay))
    finally:
        if log != subprocess.DEVNULL:
            os.close(log)
    turn = {'pid': harness.pid, 'since': since(harness.pid), 'supervisor': os.getpid(),
            'supervisor_since': since(os.getpid()), 'output_from': output_from}
    try:
        saved(run, dict(state, turns=state['turns'] + [turn]))
    except OSError:
        harness.kill()
        harness.wait()
        raise
    return harness, output_from


def _on_stop_signal(_sig, _frame):
    global STOP_SIGNALED
    STOP_SIGNALED = True


def supervise(cmd):
    # SECURITY: the row's env and effort setting go to the harness only; the supervisor and its process tools keep
    # the driver's own environment.
    run = os.environ['OPENWIZ_RUN']
    overlay = json.loads(os.environ.pop('OPENWIZ_TURN_ENV', '{}'))
    output_from = int(os.environ.pop('OPENWIZ_OUTPUT_FROM', '0') or '0')
    if LINUX and ctypes.CDLL(None, use_errno=True).prctl(PR_SET_CHILD_SUBREAPER, 1, 0, 0, 0) != 0:
        print(json.dumps({'error': 'this host cannot keep a turn\'s processes together'}), flush=True)
        return
    try:
        harness = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=sys.stderr, stderr=sys.stderr,
                                   cwd=work(run), env=dict(os.environ, **overlay))
    except OSError as e:
        print(json.dumps({'error': e.strerror}), flush=True)
        return
    signal.signal(signal.SIGTERM, _on_stop_signal)
    print(json.dumps({'pid': harness.pid, 'since': since(harness.pid)}), flush=True)
    os.dup2(os.open(os.devnull, os.O_WRONLY), 1)
    if not LINUX:
        os.dup2(os.open(os.devnull, os.O_WRONLY), 2)
    counts = {'limit': 0, 'overload': 0}
    while True:
        exit_code = None
        if not LINUX:
            look_after_the_turn_on_macos(run, harness.pid, log_path(run))
            try:
                with open(exit_file(run, harness.pid)) as f:
                    exit_code = int(f.read())
            except (OSError, ValueError):
                exit_code = None
        else:
            while True:
                try:
                    pid, status = os.wait()
                except ChildProcessError:
                    break
                if pid == harness.pid:
                    exit_code = os.waitstatus_to_exitcode(status)
                saved_exit(pid, status, harness.pid)
        resumed = next_resume_after_limit(run, output_from, exit_code, counts)
        if not resumed:
            return
        harness, output_from = resumed


def saved_exit(pid, status, harness):
    if pid == harness:
        try:
            with open(exit_file(os.environ['OPENWIZ_RUN'], pid), 'w') as f:
                f.write(str(os.waitstatus_to_exitcode(status)))
        except OSError:
            pass


def any_child_running_after_reaping(harness):
    while True:
        try:
            pid, status = os.waitpid(-1, os.WNOHANG)
        except ChildProcessError:
            return False
        if pid == 0:
            return True
        saved_exit(pid, status, harness)


def exit_file(run, pid):
    return os.path.join(STATE, '%s-%d.exit' % (run, pid))


def exited(run, turn):
    deadline = time.monotonic() + 2
    while True:
        try:
            with open(exit_file(run, turn['pid'])) as f:
                return int(f.read())
        except (OSError, ValueError):
            if time.monotonic() > deadline:
                return None
        time.sleep(0.05)


def launch(state, run, woken):
    req = state['request']
    cmd, extra = command(state, woken)
    try:
        log = open_log(run)
        output_from = os.fstat(log).st_size
    except OSError:
        log, output_from = subprocess.DEVNULL, 0
    try:
        sup = subprocess.Popen([sys.executable, '-I', SELF, '--turn'] + cmd,
                               env=dict(os.environ, OPENWIZ_RUN=run, OPENWIZ_TURN_ENV=json.dumps(extra),
                                        OPENWIZ_OUTPUT_FROM=str(output_from)),
                               start_new_session=True,
                               stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=log)
        with sup.stdout:
            line = sup.stdout.readline()
    except OSError as e:
        raise Refused('harness %s did not start: %s' % (req['harness'], e.strerror),
                      'run %s by hand once to check it works, then start again' % req['harness'])
    finally:
        if log != subprocess.DEVNULL:
            os.close(log)
    try:
        turn = json.loads(line)
    except ValueError:
        turn = {'error': 'its supervisor did not answer'}
    if 'pid' not in turn:
        raise Refused('harness %s did not start: %s' % (req['harness'], turn['error']),
                      'run %s by hand once to check it works, then start again' % req['harness'])
    return {'pid': turn['pid'], 'since': turn['since'], 'supervisor': sup.pid, 'supervisor_since': since(sup.pid),
            'output_from': output_from}


def running(turn):
    return bool(turn) and turn['since'] is not None and since(turn['pid']) == turn['since']


def end(turns, run):
    kept = list(dict.fromkeys((t['supervisor'], t['supervisor_since']) for t in turns if t and t['supervisor_since'] is not None))
    if lsof_failed_in(run, kept):
        LSOF_COULD_NOT_CHECK.append(run)
    for sig, wait in ((signal.SIGTERM, GRACE), (signal.SIGKILL, 2)):
        sent, deadline = set(), time.monotonic() + wait
        while time.monotonic() < deadline:
            kept = [(p, t) for p, t in kept if since(p) == t]
            if not kept:
                return
            if not LINUX:
                targets = set(members({s for s, _ in kept}, recorded_by(run, kept), writing_to(log_path(run))))
                if not targets:
                    targets = {s for s, _ in kept}
                for p in targets - sent:
                    try:
                        os.kill(p, sig)
                        sent.add(p)
                    except OSError:
                        pass
                time.sleep(0.1)
                continue
            under = set().union(*(descendants(s) for s, _ in kept))
            idle = {s for s, _ in kept if not descendants(s)}
            pinned = {}
            for p in (under | idle) - sent:
                try:
                    pinned[p] = os.pidfd_open(p)
                except OSError:
                    pass
            under = set().union(*(descendants(s) for s, _ in kept)) | {s for s, t in kept if since(s) == t and not descendants(s)}
            for p, fd in pinned.items():
                try:
                    if p in under:
                        sent.add(p)
                        signal.pidfd_send_signal(fd, sig)
                except OSError:
                    pass
                finally:
                    os.close(fd)
            time.sleep(0.1)
    raise Refused('run %s still has processes after stop' % run,
                  'stop it again, or end its processes by hand: they run under process %s'
                  % ', '.join(str(p) for p, _ in kept))


def lock(run):
    if not os.path.exists(os.path.join(STATE, run + '.json')):
        raise Refused('no run ' + run, 'check the run id that `driver start` printed')
    try:
        fcntl.flock(os.open(os.path.join(STATE, run + '.lock'), os.O_RDONLY | os.O_CREAT, 0o600), fcntl.LOCK_EX)
    except OSError:
        raise Refused('the driver cannot lock run %s in its state folder' % run, WRITABLE)


def saved(run, state=None):
    path = os.path.join(STATE, run + '.json')
    if state is not None:
        os.makedirs(STATE, mode=0o700, exist_ok=True)
        with open(path + '.new', 'w') as f:
            json.dump(state, f)
        os.replace(path + '.new', path)
        return state
    try:
        with open(path) as f:
            return json.load(f)
    except FileNotFoundError:
        raise Refused('no run ' + run, 'check the run id that `driver start` printed')


def signed_out_by_row(row, log):
    patterns = [re.compile(p, re.I) for p in (row or {}).get('signed_out', [])]
    return any(p.search(text) for p in patterns for text in log.splitlines())


def ended_at_once(run, turn, row=None, precheck_output=None):
    deadline = time.monotonic() + SETTLE
    while running(turn) and time.monotonic() < deadline:
        time.sleep(0.1)
    if running(turn):
        return
    code = exited(run, turn)
    try:
        if precheck_output:
            with open(log_path(run), 'rb') as f:
                kept = f.read()
            with io.TextIOWrapper(io.BytesIO(kept[:precheck_output[0]] + kept[precheck_output[1]:]),
                                  errors='replace') as f:
                log = f.read()
        else:
            with open(log_path(run), errors='replace') as f:
                log = f.read()
    except OSError:
        log = ''
    signed_out = SIGNED_OUT.search(log) or signed_out_by_row(row, turn_output(run, turn))
    if not signed_out and not REFUSAL.search(log) and code != 0:
        limit_info = detect_limit(turn_tail_lines(run, turn.get('output_from', 0)), row)
        if limit_info:
            end([turn], run)
            raise Refused(*limit_refusal(run, limit_info, from_start=True, code=code))
    why = ('the harness is not signed in' if signed_out else
           'the harness refused a tool' if REFUSAL.search(log) else None if code == 0 else 'the harness failed')
    if why is None:
        return
    end([turn], run)
    if signed_out and row and 'login_command' in row:
        fix = '%s; %s has the turn\'s output' % (not_signed_in(row), log_path(run))
        fix = fix if len(fix) <= 300 else not_signed_in(row)
    else:
        fix = 'read %s, fix what it says there, then start again' % log_path(run)
    raise Refused('run %s: the first turn ended at once: %s (exit %s)' % (run, why, 'unknown' if code is None else code),
                  fix)


def stopped(run, state):
    try:
        saved(run, dict(state, stopped=True))
    except OSError:
        pass


def unsaved(run, turn, cmd):
    try:
        end([turn], run)
    except Refused:
        raise Refused('run %s began a turn it could not save, and could not confirm the turn ended; its outcome is '
                      'unknown' % run, 'end process %d and everything under it by hand, and read the ticket for '
                      'what its agent did, before you %s it again' % (turn['supervisor'], cmd))
    raise Refused('run %s began a turn it could not save, so the driver ended it; its outcome is unknown' % run,
                  'read the ticket for what its agent did before you %s it again' % cmd)


def answer(cmd):
    if cmd == 'version':
        return VERSION
    if cmd == 'schema':
        with open(os.path.join(HERE, 'schema.json')) as f:
            return json.load(f)
    if cmd == 'start':
        req, run = no_credentials(read(START)), 'run-' + secrets.token_hex(6)
        path, row = program(req['harness'], req.get('effort'))
        state = {'request': req, 'program': path, 'turns': [], 'stopped': False, 'starting': True,
                 'workspace': None, 'mode': None}
        if row:
            state.update(row=row, session=str(uuid.uuid4()) if 'chosen' in row['session'] else None)
        try:
            saved(run, state)
            os.close(os.open(os.path.join(STATE, run + '.lock'), os.O_WRONLY | os.O_CREAT, 0o600))
        except OSError:
            raise Refused('the driver cannot save runs in its state folder; nothing was started', WRITABLE)
        try:
            approved = approved_mode(req['repository'], req['harness'])
            if row and approved not in row['modes']:
                raise Refused('the mode approved on this machine for %s with %s is not one its row lists; nothing '
                              'was started' % (req['repository'], req['harness']),
                              'approve one of the modes in %s, in both places, then start again'
                              % row_file(req['harness']))
            state['workspace'] = workspace(run, req['repository'])
            mode, own = permission_mode(state['workspace'], req['repository'], req['harness'])
            if own and mode != approved:
                raise Refused('the %s row in %s does not match the mode approved on this machine for %s; nothing '
                              'was started' % (own, req['repository'], req['harness']),
                              'save the one mode you approve for %s in both its docs/agents/fleet.md and %s, then '
                              'start again' % (req['harness'], APPROVALS))
            if mode != approved:
                raise Refused('the Harness permission mode row in %s does not match the mode approved on this '
                              'machine; nothing was started' % req['repository'],
                              'save the one mode you approve in both its docs/agents/fleet.md and %s, then start '
                              'again' % APPROVALS)
            state['mode'] = approved
            saved(run, state)
            precheck(run, state)
        except OSError:
            raise Refused('the driver cannot save run %s in its state folder; nothing was started' % run, WRITABLE)
        except Refused:
            stopped(run, state)
            raise
        try:
            turn = launch(state, run, False)
        except Refused:
            stopped(run, state)
            raise
        try:
            saved(run, dict(state, turns=[turn]))
        except OSError:
            unsaved(run, turn, 'start')
        try:
            ended_at_once(run, turn, row, state.get('precheck_output'))
        except Refused:
            stopped(run, dict(state, turns=[turn]))
            raise
        try:
            saved(run, dict(state, turns=[turn], starting=False))
        except OSError:
            unsaved(run, turn, 'start')
        return {'run': run}
    if cmd in ('wake', 'stop'):
        run = read(RUN)['run']
        lock(run)
        state = saved(run)
        if cmd == 'stop':
            try:
                saved(run, dict(state, stopped=True))
                kept = True
            except OSError:
                kept = False
            note = row_stop(run, state)
            if note:
                STOP_NOTES.append('driver: ' + note)
            end(state['turns'], run)
            if note:
                STOP_NOTES[-1] += "; the driver still ended the run's process tree"
            for name in (lsof_failed_record(run, t['supervisor']) for t in state['turns'] if t):
                try:
                    os.remove(name)
                except OSError:
                    pass
            clear_limit_state(run)
            if not kept:
                raise Refused('run %s has ended, but the driver could not save that it is stopped' % run,
                              WRITABLE + ', then stop it again')
            return {'run': run, 'stopped': True}
        if state['stopped']:
            raise Refused('run %s is stopped' % run, 'start a new run')
        if state.get('starting'):
            raise Refused('run %s never finished starting' % run, 'stop it, then start a new run')
        check_limit_before_wake(run)
        found = state.get('row') and state['session'] is None
        if found:
            state['session'] = reported_session(run, state['row']['session'], state['turns'][0])
            if state['session'] is None:
                raise Refused('run %s has no session id from its first turn yet; nothing was started' % run,
                              'wait until its first turn has printed its session id, then wake again')
        busy = state['turns'] and running(state['turns'][-1])
        if found or not busy:
            try:
                saved(run, state)
            except OSError:
                raise Refused('the driver cannot save run %s; nothing was started' % run, WRITABLE)
        if busy:
            return {'run': run, 'woke': True}
        turn = launch(state, run, True)
        try:
            saved(run, dict(state, turns=state['turns'] + [turn]))
        except OSError:
            unsaved(run, turn, 'wake')
        return {'run': run, 'woke': True}
    raise Refused('unknown command', 'run one of: version, schema, start, wake, stop')


def main():
    if len(sys.argv) > 2 and sys.argv[1] == '--turn':
        return supervise(sys.argv[2:])
    try:
        out, code = answer(sys.argv[1] if len(sys.argv) == 2 else ''), 0
    except Refused as e:
        out, code = {'error': e.args[0], 'next': e.args[1]}, 1
    except Exception as e:
        out, code = {'error': 'the driver failed: ' + type(e).__name__, 'next': 'read its code, fix it, retry'}, 1
    if LSOF_COULD_NOT_CHECK:
        print(NO_LSOF, file=sys.stderr)
    for note in STOP_NOTES:
        print(note, file=sys.stderr)
    print(json.dumps(out))
    sys.exit(code)


if __name__ == '__main__':
    main()
