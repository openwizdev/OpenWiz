class Refused(Exception):
    pass


def unique(pairs):
    if len({k for k, _ in pairs}) != len(pairs):
        raise Refused('a key is repeated', 'send each key once')
    return dict(pairs)


def read(fields):
    try:
        req = json.loads(sys.stdin.read(), object_pairs_hook=unique)
    except ValueError:
        raise Refused('the input is not JSON', 'send one JSON object on stdin, as `driver schema` shows')
    if not isinstance(req, dict) or set(req) != set(fields):
        raise Refused('the input needs exactly ' + ', '.join(fields), 'send only those fields; never a login')
    for key, pattern in fields.items():
        v = req[key]
        if not (type(v) is int and v > 0 if pattern is None else isinstance(v, str) and re.fullmatch(pattern, v)):
            raise Refused(key + ' is not valid', 'fix ' + key + ' as `driver schema` shows')
    return req


def holds_credential(text):
    if not hasattr(holds_credential, 'check'):
        try:
            spec = importlib.util.spec_from_loader('openwiz_driver_kit', importlib.machinery.SourceFileLoader(
                'openwiz_driver_kit', KIT))
            kit = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(kit)
            holds_credential.check = kit.holds_credential
        except Exception:
            raise Refused("the driver kit's credential check is missing, so no start field can be checked; nothing "
                          'was started', 'run the driver from an OpenWiz checkout or release that carries '
                          'kernel/driver-kit/kit.py')
    return holds_credential.check(text)


def no_credentials(req):
    # PRIVACY: runs before anything is saved or started, and the refusal names the field, never its value.
    for key in START:
        if isinstance(req[key], str) and holds_credential(req[key]):
            raise Refused('%s looks like a credential, so nothing was saved or started' % key,
                          'send the %s itself in %s; never a login, key or token' % (key, key))
    return req


class Broken(Exception):
    pass


def line(v):
    return isinstance(v, str) and 0 < len(v) <= 300 and '\n' not in v and '\r' not in v


def fixed(v):
    return isinstance(v, list) and all(isinstance(a, str) and a and not any(p in a for p in PLACEHOLDERS) for a in v)


def settings(env, rule):
    if not isinstance(env, dict) or not all(isinstance(k, str) and re.fullmatch(ENV_NAME, k) and line(v)
                                            for k, v in env.items()):
        raise Broken(rule, 'each name is capitals, digits and _, not OPENWIZ_, and each value one line')
    if any(holds_credential(v) or holds_credential('%s=%s' % (k, v)) for k, v in env.items()):
        raise Broken(rule, 'a value looks like a credential; env holds only fixed settings that are not credentials')


def plain(text):
    return line(text) and not re.search(r'\{[a-z]+\}', text) and not holds_credential(text)


def sign_in(row):
    if 'signed_out' in row:
        patterns = row['signed_out']
        if not isinstance(patterns, list) or not patterns or not all(plain(p) for p in patterns):
            raise Broken('signed_out', 'it is not a list of one-line patterns, with no placeholder and nothing '
                                       'credential-shaped')
        try:
            [re.compile(p, re.I) for p in patterns]
        except re.error:
            raise Broken('signed_out', 'a pattern does not compile')
        if 'login_command' not in row:
            raise Broken('login_command', 'a row with signed_out names the command the user runs to sign in')
    if 'login_command' in row and not (plain(row['login_command']) and len(row['login_command']) <= 200):
        raise Broken('login_command', 'it is not one line of up to 200 characters, with no placeholder and nothing '
                                      'credential-shaped')
    if 'login_env' in row:
        # PRIVACY: login_env is a variable's name only; the driver never reads, passes or prints its value.
        name = row['login_env']
        if not isinstance(name, str) or not re.fullmatch(r'[A-Z][A-Z0-9_]{1,63}', name):
            raise Broken('login_env', 'it is not one variable name: a capital, then 1 to 63 capitals, digits or _')
        if holds_credential(name):
            raise Broken('login_env', 'it looks like a credential; login_env names a variable, never its value')
        if 'login_command' not in row:
            raise Broken('login_command', 'a row with login_env names the command the user runs to sign in')
        if isinstance(row['env'], dict) and name in row['env']:
            raise Broken('login_env', "the row's env sets it; only the user sets it, for the CLI")
        if len(not_signed_in(row)) > 300:
            raise Broken('login_env', "with it, the not-signed-in next passes D3's 300 characters; shorten "
                                      'login_command, login_env or program')


def not_signed_in(row):
    if 'login_env' in row:
        return 'sign in with %s, or set %s for %s yourself, then start again' % (
            row['login_command'], row['login_env'], row['program'])
    return 'sign in yourself with `%s` on this machine, then start again' % row['login_command']


def arguments(row, field, needs):
    args = row[field]
    if not isinstance(args, list) or not args or not all(isinstance(a, str) and a for a in args):
        raise Broken(field, 'it is not a list of arguments')
    for a in args:
        if a not in PLACEHOLDERS and re.search(r'\{[a-z]+\}', a):
            raise Broken(field, 'a placeholder sits inside a larger argument; each fills a whole argument'
                         if any(p in a for p in PLACEHOLDERS) else 'it has an unknown placeholder')
    if any(args.count(p) > 1 for p in PLACEHOLDERS):
        raise Broken(field, 'a placeholder appears more than once')
    for p in needs:
        if p not in args:
            raise Broken(field, 'it has no ' + p)


def credential_shaped(args):
    return any(holds_credential(a) for a in args if a) or \
        any(holds_credential('%s=%s' % pair) or holds_credential('%s %s' % pair) for pair in zip(args, args[1:])
            if all(pair))


def no_credential_arguments(row):
    # PRIVACY: a row's fixed arguments are saved in run state and passed in argv, so none may hold a credential;
    # the refusal names the field, never the argument.
    efforts = [a for a in row['effort'].values() if isinstance(a, list)] if isinstance(row['effort'], dict) else []
    for field, lists in (('start', [row['start']]), ('wake', [row['wake']]), ('modes', list(row['modes'].values())),
                         ('effort', efforts)):
        if any(credential_shaped([a if a not in PLACEHOLDERS else '' for a in args]) for args in lists):
            raise Broken(field, 'a fixed argument looks like a credential; a row holds no login, key or token')
    for field in ('start', 'wake'):
        for mode in row['modes'].values():
            for effort in efforts or [[]]:
                fills = {'{mode}': mode, '{effort}': effort}
                if credential_shaped([b for a in row[field] for b in fills.get(a, [a if a not in PLACEHOLDERS else ''])]):
                    raise Broken(field, 'with a mode or effort spliced in, its arguments look like a credential; a '
                                        'row holds no login, key or token')


def command_field(row, field, args, takes):
    if not isinstance(args, list) or not 1 < len(args) <= 30 or not all(line(a) for a in args):
        raise Broken(field, 'it is not a list of the program and its arguments, each one line')
    if args[0] != row['program']:
        raise Broken(field, "it runs another program; it starts with the row's program")
    if any(a not in takes and re.search(r'\{[a-z]+\}', a) for a in args) or any(args.count(p) > 1 for p in takes):
        raise Broken(field, 'it takes only %s, %s' % (' and '.join(takes), 'each once and as a whole argument'
                                                      if len(takes) > 1 else 'once and as a whole argument'))
    if credential_shaped([a if a not in takes else '' for a in args[1:]]):
        raise Broken(field, 'a fixed argument looks like a credential; a row holds no login, key or token')


def match_pattern(pattern, model, effort):
    return pattern.replace('{model}', re.escape(model)).replace('{effort}', re.escape(effort or ''))


def row_commands(row):
    if 'precheck' in row:
        check = row['precheck']
        if not isinstance(check, dict) or set(check) != {'run', 'match'}:
            raise Broken('precheck', 'it is not {"run": [<program>, <arguments>...], "match": "<one-line pattern>"}')
        command_field(row, 'precheck', check['run'], ('{model}', '{effort}'))
        pattern = check['match']
        if not line(pattern) or re.search(r'\{[a-z]+\}', re.sub(r'\{(?:model|effort)\}', '', pattern)) or \
                holds_credential(pattern):
            raise Broken('precheck', 'its match is not one line with only {model} and {effort}, and nothing '
                                     'credential-shaped')
        try:
            matches_empty = re.search(match_pattern(pattern, 'm', 'e'), '', re.M) is not None
        except re.error:
            raise Broken('precheck', 'its match pattern does not compile')
        if matches_empty:
            raise Broken('precheck', 'its match pattern matches empty output, so it would pass anything')
    if 'stop' in row:
        command_field(row, 'stop', row['stop'], ('{session}',))
        if '{session}' not in row['stop']:
            raise Broken('stop', "it has no {session}, so it could reach other runs' sessions")


def check_limit_pattern(row):
    if 'limit' not in row:
        return
    pattern = row['limit']
    if not plain(pattern):
        raise Broken('limit', 'it is not one line with no placeholder and nothing credential-shaped')
    try:
        matches_empty = re.search(pattern, '', re.I) is not None
    except re.error:
        raise Broken('limit', 'its pattern does not compile')
    if matches_empty:
        raise Broken('limit', 'its pattern matches empty output, so it would match any failure')


def check_row(row, name):
    if not isinstance(row, dict):
        raise Broken('fields', 'it is not one JSON object')
    if 'effort' not in row:
        raise Broken('effort', 'it has no effort form; give an effort map or "none: <one line why>"')
    if not set(ROW_FIELDS) <= set(row) <= set(ROW_FIELDS + OPTIONAL_ROW_FIELDS):
        raise Broken('fields', 'needs %s; may add %s' % (', '.join(ROW_FIELDS), ', '.join(
            OPTIONAL_ROW_FIELDS)))
    if isinstance(row['harness'], str) and row['harness'] in HARNESSES:
        raise Broken('harness', '%s is built in, and no row may use a built-in name' % row['harness'])
    if not isinstance(row['harness'], str) or row['harness'] != name or not re.fullmatch(START['harness'], name):
        raise Broken('harness', "it is not its folder's name, or not a valid harness name")
    if not isinstance(row['program'], str) or not re.fullmatch(PROGRAM, row['program']):
        raise Broken('program', 'it is not one plain command name')
    for field in ('login', 'daemon'):
        if not line(row[field]):
            raise Broken(field, 'it is not one line of 1 to 300 characters')
    modes = row['modes']
    if not isinstance(modes, dict) or not modes or \
            not all(re.fullmatch(MODE, m) and fixed(a) for m, a in modes.items()):
        raise Broken('modes', 'it maps no mode value to its fixed arguments')
    settings(row['env'], 'env')
    sign_in(row)
    session = row['session']
    kind = next(iter(session)) if isinstance(session, dict) and len(session) == 1 else None
    how = session[kind] if kind else None
    try:
        good = (kind == 'chosen' and how == 'uuid' or kind == 'json' and isinstance(how, list) and how and
                all(isinstance(k, str) and k for k in how) or kind == 'pattern' and isinstance(how, str) and
                re.compile(how).groups == 1)
    except re.error:
        good = False
    if not good:
        raise Broken('session', 'it is not {"chosen": "uuid"}, {"json": [<key path>]} or {"pattern": <one group>}')
    effort = row['effort']
    if isinstance(effort, str):
        if not (line(effort) and effort.startswith('none: ') and effort[6:].strip()):
            raise Broken('effort', 'a row that can\'t set effort says "none: <one line why>"')
    elif not isinstance(effort, dict) or not effort:
        raise Broken('effort', 'it has no effort form; give an effort map or "none: <one line why>"')
    else:
        for value, setting in effort.items():
            if not re.fullmatch(EFFORT, value):
                raise Broken('effort', 'an effort value is not an effort id')
            if isinstance(setting, dict) and list(setting) == ['env'] and setting['env']:
                settings(setting['env'], 'effort')
            elif not (fixed(setting) and setting):
                raise Broken('effort', 'each value adds fixed arguments, or sets {"env": {...}}')
    arguments(row, 'start', ('{prompt}', '{model}', '{mode}') + (('{session}',) if kind == 'chosen' else ()))
    arguments(row, 'wake', ('{prompt}', '{mode}', '{session}'))
    if kind != 'chosen' and '{session}' in row['start']:
        raise Broken('start', 'it has {session}, but the session is reported, not chosen')
    no_credential_arguments(row)
    row_commands(row)
    check_limit_pattern(row)
    flags = isinstance(effort, dict) and any(isinstance(s, list) for s in effort.values())
    if flags and '{effort}' not in row['start']:
        raise Broken('effort', 'it maps effort values to arguments, but start has no {effort} to pass them')
    if not flags and ('{effort}' in row['start'] or '{effort}' in row['wake']):
        raise Broken('effort', 'it has {effort}, but no effort value adds arguments')
    return row


def read_row(path, name):
    try:
        with open(path) as f:
            row = json.loads(f.read(), object_pairs_hook=unique)
    except FileNotFoundError:
        return None
    except (OSError, ValueError, RecursionError, Refused):
        raise Broken('file', 'it is not one readable JSON object with each key once')
    return check_row(row, name)


def row_file(harness):
    return os.path.join('adapters', 'local', 'harnesses', harness, 'row.json')


def row_folders():
    try:
        return sorted(d for d in os.listdir(ROWS) if re.fullmatch(START['harness'], d) and d not in HARNESSES and
                      os.path.isfile(os.path.join(ROWS, d, 'row.json')))
    except OSError:
        return []


def program(harness, effort):
    row = None
    if harness not in HARNESSES:
        try:
            row = read_row(os.path.join(ROWS, harness, 'row.json'), harness)
        except Broken as e:
            error = '%s breaks the harness-row contract (%s: %s); nothing was started' % (
                row_file(harness), e.args[0], e.args[1])
            if len(error) > 300:
                error = '%s breaks the harness-row contract (%s); nothing was started' % (row_file(harness), e.args[0])
            raise Refused(error, 'fix %s as adapters/local/harness-row.md says, then start again' % row_file(harness))
        if row is None and os.path.isdir(os.path.join(ROWS, harness)):
            raise Refused('%s is missing, so harness %s has no row; nothing was started' % (row_file(harness), harness),
                          'add %s as adapters/local/harness-row.md says, then start again' % row_file(harness))
        if row is None:
            names, choices = list(HARNESSES) + row_folders(), 'use one of: '
            for n in names:
                if len(choices) + len(n) + 2 > 300:
                    break
                choices += n if choices.endswith(': ') else ', ' + n
            raise Refused('harness %s is not one this driver runs' % harness, choices)
    effort_of(harness, row, effort)
    name = row['program'] if row else harness
    path = shutil.which(name)
    if not path:
        raise Refused('harness %s is not installed here' % harness,
                      'install %s on this machine and sign in to it yourself, then start again' % name)
    return path, row


def effort_of(harness, row, effort):
    if effort is None:
        return [], {}
    setting = row['effort'].get(effort) if row and isinstance(row['effort'], dict) else None
    if setting is None:
        raise Refused("harness %s can't set effort %s; nothing was started" % (harness, effort), CANT_SET_EFFORT)
    return (setting, {}) if isinstance(setting, list) else ([], setting['env'])


def command(state, woken):
    req, row = state['request'], state.get('row')
    text = prompt(req, woken)
    if not row:
        effort_of(req['harness'], None, req.get('effort'))
        return [state['program']] + HARNESSES[req['harness']](req['model'], state['mode'], text), {}
    effort, env = effort_of(req['harness'], row, req.get('effort'))
    fills = {'{prompt}': [text], '{model}': [req['model']], '{session}': [state.get('session')],
             '{mode}': row['modes'][state['mode']], '{effort}': effort}
    return [state['program']] + [b for a in row['wake' if woken else 'start'] for b in fills.get(a, [a])], \
        dict(row['env'], **env)


def row_command(run, argv, env, seconds):
    # SECURITY: the row's env reaches only this command; the driver's own environment, and the ps and lsof that
    # stop's tree kill runs, never change. Its output goes only to the owner-only run log.
    log = open_log(run)
    try:
        start = os.fstat(log).st_size
        with tempfile.TemporaryDirectory(prefix='row-command-', dir=STATE) as cwd:
            try:
                p = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=log, stderr=log, cwd=cwd,
                                     env=dict(os.environ, **env), start_new_session=True)
            except OSError:
                return 'error', start, start
            deadline, outcome = time.monotonic() + seconds, 'timeout'
            try:
                while time.monotonic() < deadline:
                    if since(p.pid) is None:
                        outcome = None
                        break
                    time.sleep(0.05 if LINUX else MACOS_SECONDS_BETWEEN_LOOKS)
            finally:
                try:
                    os.killpg(p.pid, signal.SIGKILL)
                except OSError:
                    pass
                code = p.wait()
        return (code if outcome is None else outcome), start, os.fstat(log).st_size
    finally:
        os.close(log)


def failed(outcome, seconds):
    if outcome == 0:
        return None
    if outcome == 'error':
        return 'could not run'
    return 'ran past its %d-second limit' % seconds if outcome == 'timeout' else 'exited %d' % outcome


def precheck(run, state):
    req, row = state['request'], state.get('row')
    if not row or 'precheck' not in row:
        return
    check = row['precheck']
    if req.get('effort') is None and '{effort}' in json.dumps(check):
        return
    fills = {'{model}': req['model'], '{effort}': req.get('effort')}
    env = dict(row['env'], **effort_of(req['harness'], row, req.get('effort'))[1])
    try:
        outcome, start, until = row_command(run, [state['program']] + [fills.get(a, a) for a in check['run'][1:]],
                                            env, PRECHECK_SECONDS)
    except OSError:
        outcome, start, until = 'error', 0, 0
    state['precheck_output'] = [start, until]
    why = failed(outcome, PRECHECK_SECONDS)
    why = why and 'it ' + why
    if why is None:
        try:
            with open(log_path(run), 'rb') as f:
                f.seek(start)
                text = f.read(min(until - start, PRECHECK_OUTPUT)).decode(errors='replace')
        except OSError:
            text = ''
        if not re.search(match_pattern(check['match'], req['model'], req.get('effort')), text, re.M):
            why = "its output did not match the row's pattern"
    if why:
        raise Refused("run %s: harness %s's precheck did not pass: %s; nothing was started" % (run, req['harness'],
                                                                                              why),
                      'read %s, fix what it says there, then start again' % log_path(run))


def row_stop(run, state):
    row = state.get('row')
    if not row or 'stop' not in row or not state['turns']:
        return None
    session = state.get('session')
    try:
        if session is None and 'chosen' not in row['session']:
            session = reported_session(run, row['session'], state['turns'][0])
        if not (isinstance(session, str) and re.fullmatch(SESSION, session) and not session.startswith('-') and
                not holds_credential(session)):
            note = "the row's stop was skipped: the run has no session id it can pass"
        else:
            argv = [state['program']] + [session if a == '{session}' else a for a in row['stop'][1:]]
            why = failed(row_command(run, argv, row['env'], STOP_SECONDS)[0], STOP_SECONDS)
            note = why and "the row's stop " + why
    except Exception as e:
        note = "the row's stop failed in the driver: %s" % type(e).__name__
    if note:
        try:
            log = open_log(run)
            try:
                os.write(log, ('driver: %s; the driver goes on to end the run\'s process tree\n' % note).encode())
            finally:
                os.close(log)
        except OSError:
            pass
    return note


NO_PATH = object()


def turn_output(run, turn):
    try:
        with open(log_path(run), 'rb') as f:
            f.seek(turn.get('output_from', 0))
            return f.read().decode(errors='replace')
    except OSError:
        return ''


def reported_session(run, session, first):
    for text in turn_output(run, first).splitlines():
        if 'pattern' in session:
            m = re.search(session['pattern'], text)
            if not m:
                continue
            found = m.group(1)
        else:
            try:
                found = json.loads(text) if text.lstrip().startswith('{') else None
            except (ValueError, RecursionError):
                found = None
            for key in session['json']:
                found = found[key] if isinstance(found, dict) and key in found else NO_PATH
            if found is NO_PATH:
                continue
        ok = isinstance(found, str) and re.fullmatch(SESSION, found) and not holds_credential(found)
        return found if ok else None
    return None


