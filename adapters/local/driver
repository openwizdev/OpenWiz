LINUX = os.path.isdir('/proc/self') and hasattr(os, 'pidfd_open')
PR_SET_CHILD_SUBREAPER = 36


def ps(*args):
    try:
        p = subprocess.Popen(['ps'] + list(args), stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                             stderr=subprocess.PIPE, text=True)
        out, err = p.communicate(timeout=30)
    except (OSError, subprocess.TimeoutExpired) as e:
        raise OSError('ps did not run: %s' % e)
    if p.returncode and err.strip():
        raise OSError('ps failed: %s' % err.strip()[:100])
    return out.splitlines(), p.pid


MACOS_SECONDS_BETWEEN_LOOKS = 0.2
LOOKS_PER_OUTPUT_CHECK = 5


# PRIVACY: reads only ps's process table (pid, parent, group, state, start time), never any environment.
def members(roots, recorded, writers=()):
    rows, me = ps('-A', '-o', 'pid=', '-o', 'ppid=', '-o', 'pgid=', '-o', 'stat=', '-o', 'lstart=')
    started, children, found = {}, {}, set()
    for row in rows:
        f = row.split(None, 4)
        if len(f) < 5 or f[3].startswith('Z'):
            continue
        pid, ppid, group = int(f[0]), int(f[1]), int(f[2])
        started[pid] = f[4].strip()
        children.setdefault(ppid, []).append(pid)
        if group in roots or recorded.get(pid) == started[pid] or pid in writers:
            found.add(pid)
    todo = list(roots) + list(found)
    while todo:
        for c in children.get(todo.pop(), []):
            if c not in found:
                found.add(c)
                todo.append(c)
    return {p: started[p] for p in found - set(roots) - {os.getpid(), me}}


# PRIVACY: asks lsof only which processes hold this run's own output file open for writing, never any environment.
# PRIVACY: lsof's own text is never repeated.
def writing_to(path):
    try:
        p = subprocess.run(['lsof', '-w', '-F', 'pa', '--', path], stdin=subprocess.DEVNULL, capture_output=True,
                           text=True, errors='replace', timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        p = None
    if p is None or p.returncode not in (0, 1) or p.returncode == 1 and p.stderr.strip():
        LSOF_COULD_NOT_CHECK.append(path)
        return set()
    out = p.stdout
    found, pid = set(), None
    for field in out.splitlines():
        if field[:1] == 'p' and field[1:].isdigit():
            pid = int(field[1:])
        elif field[:1] == 'a' and field[1:2] in ('w', 'u') and pid is not None:
            found.add(pid)
    return found


