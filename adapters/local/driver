                              stderr=log, timeout=600).returncode
    except (OSError, subprocess.TimeoutExpired) as e:
        os.write(log, ('driver: gh repo clone did not finish: %s\n' % type(e).__name__).encode())
        code = None
    finally:
        os.close(log)
    if code != 0 or not os.path.isdir(folder):
        raise Refused('run %s could not clone %s (gh exit %s); nothing was started' % (run, repository, 'unknown'
                      if code is None else code), 'read %s, check that `gh repo clone %s` works on this machine, then start again'
                      % (log_path(run), repository))
    return folder


