{
  "harness": "effort-unpassed",
  "program": "example-none-cli",
  "start": [
    "--print",
    "--session-id",
    "{session}",
    "--model",
    "{model}",
    "{mode}",
    "{prompt}"
  ],
  "wake": [
    "--print",
    "--resume",
    "{session}",
    "--model",
    "{model}",
    "{mode}",
    "{prompt}"
  ],
  "session": {
    "chosen": "uuid"
  },
  "modes": {
    "workspace-write": [
      "--sandbox",
      "workspace-write"
    ]
  },
  "env": {},
  "effort": {
    "high": [
      "--think",
      "high"
    ]
  },
  "login": "example-none-cli's own login, saved by `example-none-cli auth` under ~/.example-none",
  "daemon": "none"
}
