#!/usr/bin/env python3
import os, re, sys
sys.dont_write_bytecode = True
sys.path.insert(0, os.environ['FAKE_CLI_LIB'])
import fake_cli

HELP = '''The fake daemon-survives-cli: its synthetic --help allows only:
  daemon-survives-cli --print (--session-id|--resume) <uuid> --model <m> --sandbox workspace-write <prompt>
and lists no effort flag; it hands work to an already-running hub.'''

if sys.argv[1:] == ['--help']:
    print(HELP)
    sys.exit(0)
a = sys.argv[1:]
if len(a) != 8 or a[0] != '--print' or a[1] not in ('--session-id', '--resume') or a[3] != '--model' or \
        a[5:7] != ['--sandbox', 'workspace-write'] or not re.fullmatch(r'[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}', a[2]):
    fake_cli.refuse()
if (a[1] == '--resume') != a[7].startswith('You were woken'):
    fake_cli.refuse()
fake_cli.turn(a[7], a[4], a[2], daemon='via-running-hub')
