{
  "harness": "effort-crowded",
  "program": "example-cli",
  "start": [
    "run",
    "--format",
    "json",
    "--model",
    "{model}",
    "{mode}",
    "{effort}",
    "{prompt}"
  ],
  "wake": [
    "run",
    "--session",
    "{session}",
    "--model",
    "{model}",
    "{mode}",
    "{prompt}"
  ],
  "session": {
    "json": [
      "session",
      "id"
    ]
  },
  "modes": {
    "auto": [
      "--yes"
    ],
    "ask": []
  },
  "env": {
    "EXAMPLE_CLI_BACKEND": "local"
  },
  "effort": {
    "low": [
      "--effort",
      "low"
    ],
    "medium": [
      "--effort",
      "medium"
    ],
    "unlisted": [
      "--effort",
      "high"
    ],
    "high": [
      "--effort",
      "high"
    ],
    "max": {
      "env": {
        "EXAMPLE_CLI_THINKING": "max"
      }
    }
  },
  "login": "example-cli's own login, saved by `example-cli login` under ~/.config/example-cli",
  "daemon": "example-cli starts a local service under the turn; stop ends it with the process tree",
  "signed_out": [
    "not authenticated\\b"
  ],
  "login_command": "example-cli login"
}
