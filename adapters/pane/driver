#!/usr/bin/env python3
import fcntl, json, os, re, secrets, shlex, shutil, subprocess, sys

HERE = os.path.dirname(os.path.abspath(__file__))
STATE = os.environ.get('OPENWIZ_PANE_STATE') or os.path.expanduser('~/.local/state/openwiz-pane')
VERSION = {'driver': 'pane', 'records': ['openwiz:records v1'], 'can': ['start', 'wake', 'stop', 'many-at-once']}
PROGRAMS = {'claude': 'claude', 'codex': 'codex', 'cursor': 'cursor-agent', 'opencode': 'opencode', 'pi': 'pi'}
START = {'repository': r'[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}', 'ticket': None,
         'skill': r'(?=.{1,60}$)[a-z0-9]+(-[a-z0-9]+)*', 'harness': r'[a-z0-9][a-z0-9._-]{0,59}',
         'model': r'[A-Za-z0-9][A-Za-z0-9 ._:@+-]{0,59}'}
RUN = {'run': r'run-[0-9a-f]{12}'}
ID = re.compile(r'[A-Za-z0-9_.:-]{1,100}')
CODE = re.compile(r'[a-z0-9][a-z0-9._-]{0,59}')
CREDENTIAL = re.compile(r'\bgh[pousr]_[A-Za-z0-9]{8,}|github_pat_|\bAKIA[0-9A-Z]{16}|\bxox[abposr]-|\bsk-[A-Za-z0-9_-]{16,}'
                        r'|\bbearer\s+\S|\b(?:password|passwd|secret|token|key)\s*[:=]', re.I)
ORIGIN = re.compile(r'^(?:[a-z+]+://)?(?:[^@/]+@)?github\.com[:/]+([A-Za-z0-9_.-]{1,100})/([A-Za-z0-9_.-]{1,100}?)(?:\.git)?/*$')
READY_MS = 60000
UNWRITABLE = 'make OPENWIZ_PANE_STATE (or ~/.local/state/openwiz-pane) a folder you can write'


class Refused(Exception):
    pass


class Failed(Refused):
    def __init__(self, what, step, out):
        super().__init__(what, step)
        self.out = out


def line(text):
    text = ' '.join(str(text).split()) or 'no detail'
    return text if len(text) <= 300 else text[:297] + '...'


def unique(pairs):
    if len({k for k, _ in pairs}) != len(pairs):
        raise Refused('a key is repeated', 'send each key once')
    return dict(pairs)


def read(fields):
    try:
        req = json.loads(sys.stdin.read(), object_pairs_hook=unique)
    except ValueError:
        raise Refused('the input is not JSON', 'send one JSON object on stdin, as `driver schema` shows')
    if not isinstance(req, dict) or set(req) != set(fields):
        raise Refused('the input needs exactly ' + ', '.join(fields), 'send only those fields; never a login')
    for key, pattern in fields.items():
        v = req[key]
        if not (type(v) is int and v > 0 if pattern is None else isinstance(v, str) and re.fullmatch(pattern, v)):
            raise Refused(key + ' is not valid', 'fix ' + key + ' as `driver schema` shows')
        if isinstance(v, str) and CREDENTIAL.search(v):
            raise Refused(key + ' looks like a login, token or key; nothing was started',
                          'never send a login; send ' + key + ' as `driver schema` shows')
    return req


def answer_of(text):
    for candidate in (text, (text.strip().splitlines() or [''])[-1]):
        try:
            out = json.loads(candidate)
        except ValueError:
            continue
        if isinstance(out, dict):
            return out
    return None


def runpane(then, *args, wait=100):
    program = shutil.which('runpane')
    if not program:
        raise Refused('the runpane CLI is not installed here',
                      'install Pane and its runpane CLI, open the Pane app, then ' + then)
    try:
        p = subprocess.run([program] + list(args) + ['--json'], stdin=subprocess.DEVNULL, capture_output=True,
                           text=True, timeout=wait)
    except subprocess.TimeoutExpired:
        raise Refused('runpane %s %s took too long; its outcome is unknown' % args[:2],
                      'check the Pane app, then ' + then)
    out = answer_of(p.stdout)
    if p.returncode == 0 and out and out.get('ok') is True:
        return out
    why = [x for x in ((out or {}).get(k) for k in ('error', 'blocked', 'refused')) if isinstance(x, dict)]
    raise Failed('runpane %s %s failed (%s)' % (args[0], args[1], code_of(why[0] if why else {})),
                 'open the Pane app (or start its daemon) if it is closed, and run `runpane %s %s` yourself to see '
                 'why; then %s' % (args[0], args[1], then), out)


def code_of(answer):
    code = answer.get('code')
    return code if isinstance(code, str) and CODE.fullmatch(code) else 'no code'


def text_id(value):
    return value if isinstance(value, str) and ID.fullmatch(value) else None


def git_config(checkout):
    git = os.path.join(checkout, '.git')
    if os.path.isfile(git):
        with open(git) as f:
            pointer = f.read().strip()
        if not pointer.startswith('gitdir:'):
            return ''
        git = os.path.join(checkout, pointer[len('gitdir:'):].strip())
        if os.path.isfile(os.path.join(git, 'commondir')):
            with open(os.path.join(git, 'commondir')) as f:
                git = os.path.join(git, f.read().strip())
    with open(os.path.join(git, 'config')) as f:
        return f.read()


def origin(checkout):
    try:
        text = git_config(checkout) if isinstance(checkout, str) else ''
    except (OSError, UnicodeDecodeError):
        return None
    section, urls = None, []
    for raw in text.splitlines():
        entry = raw.strip()
        if entry.startswith('['):
            section = entry.replace(' ', '').lower()
        elif section == '[remote"origin"]' and re.match(r'url\s*=', entry, re.I):
            urls.append(entry.split('=', 1)[1].strip())
    found = ORIGIN.search(urls[0]) if len(urls) == 1 else None
    return ('%s/%s' % found.groups()).lower() if found else None


def saved_repository(repository):
    found = [r for r in runpane('start again', 'repos', 'list').get('repos') or []
             if isinstance(r, dict) and type(r.get('id')) is int and origin(r.get('path')) == repository.lower()]
    if not found:
        raise Refused('Pane has no saved checkout of %s; nothing was started' % repository,
                      'save a checkout whose origin remote is github.com/%s in Pane (runpane repos add --path '
                      '<that checkout>), then start again' % repository)
    if len(found) > 1:
        raise Refused('Pane has %s saved more than once; nothing was started' % repository,
                      'remove all but one checkout of %s from Pane, then start again' % repository)
    return found[0]['id']


def prompt_text(req, woken):
    where = '%s#%d' % (req['repository'], req['ticket'])
    if woken:
        return 'You were woken: read the ticket %s again and carry on with the %s skill and its status note.' % (
            where, req['skill'])
    return 'Build the ticket %s with the %s skill and keep one status note there.' % (where, req['skill'])


def path(run, name):
    return os.path.join(STATE, '%s.%s' % (run, name))


def saved(run, state=None):
    if state is not None:
        os.makedirs(STATE, mode=0o700, exist_ok=True)
        with open(path(run, 'json.new'), 'w') as f:
            json.dump(state, f)
        os.replace(path(run, 'json.new'), path(run, 'json'))
        return state
    try:
        with open(path(run, 'json')) as f:
            return json.load(f)
    except FileNotFoundError:
        raise Refused('no run ' + run, 'check the run id that `driver start` printed')


def keep(run, state):
    try:
        saved(run, state)
    except OSError:
        pass


def lock(run):
    saved(run)
    try:
        fcntl.flock(os.open(path(run, 'lock'), os.O_RDONLY | os.O_CREAT, 0o600), fcntl.LOCK_EX)
    except OSError:
        raise Refused('the driver cannot lock run %s in its state folder' % run, UNWRITABLE)


def archive(run, state):
    then = 'stop the run again'
    try:
        runpane(then, 'panes', 'archive', '--pane', state['pane'], '--remove-worktree', '--yes')
    except Failed as e:
        blocked = (e.out or {}).get('blocked')
        code = blocked.get('code') if isinstance(blocked, dict) else None
        if code in ('unpushed-commits', 'uncommitted-changes', 'uncommitted-and-unpushed'):
            raise Refused('run %s is stopped and its agent has ended, but Pane kept its Pane openwiz-%s and worktree: '
                          'it holds work not yet committed or pushed (%s)' % (run, run, code),
                          'push or discard that work yourself, then stop the run again to archive its Pane')
        else:
            raise Refused(line('run %s is stopped and its agent has ended, but its Pane was not archived: %s'
                               % (run, e.args[0])), e.args[1])


def created(out):
    items = out.get('items') if isinstance(out, dict) else None
    item = items[0] if isinstance(items, list) and items and isinstance(items[0], dict) else None
    return item if item and text_id(item.get('paneId')) and text_id(item.get('panelId')) else None


def close(state, then):
    runpane(then, 'panels', 'close', '--panel', state['panel'], '--force', '--source', 'agent', '--yes')


def start(req):
    if req['harness'] not in PROGRAMS:
        raise Refused('Pane runs no harness %s' % req['harness'], 'use one of: ' + ', '.join(PROGRAMS))
    repo = saved_repository(req['repository'])
    run = 'run-' + secrets.token_hex(6)
    state = {'request': req, 'pane': None, 'panel': None, 'starting': True, 'stopped': False,
             'closed': False, 'archived': False}
    try:
        saved(run, state)
        os.close(os.open(path(run, 'lock'), os.O_WRONLY | os.O_CREAT, 0o600))
    except OSError:
        raise Refused('the driver cannot save runs in its state folder; nothing was started', UNWRITABLE)
    command = ' '.join(shlex.quote(w) for w in (PROGRAMS[req['harness']], '--model', req['model']))
    name = 'openwiz-' + run
    try:
        out = runpane('start again', 'panes', 'create', '--repo', str(repo), '--name', name, '--agent',
                      req['harness'], '--tool-command', command, '--prompt', prompt_text(req, False),
                      '--source', 'agent', '--no-focus', '--no-expect-report', '--wait-ready',
                      '--ready-timeout-ms', str(READY_MS), '--yes')
    except Refused as e:
        out = e.out if isinstance(e, Failed) and created(e.out) else None
        if out is None:
            keep(run, dict(state, stopped=True))
            raise Refused(e.args[0], line(e.args[1] + '; if Pane shows a Pane named %s, archive it first' % name))
    item = created(out)
    if not item:
        keep(run, dict(state, stopped=True))
        raise Refused('Pane gave no Pane and tab id for %s; its outcome is unknown' % name,
                      'archive the Pane named %s in Pane yourself, then start again' % name)
    state.update(pane=item['paneId'], panel=item['panelId'])
    readiness = item.get('readiness') if isinstance(item.get('readiness'), dict) else {}
    if out.get('ok') is True and item.get('ok') is True and readiness.get('ok') is True:
        try:
            saved(run, dict(state, starting=False))
            return {'run': run}
        except OSError:
            why, step = 'the driver could not save run %s' % run, UNWRITABLE + ', then start again'
    else:
        reason = readiness.get('reason') or out.get('error')
        why = 'the %s agent in Pane %s did not get ready (%s)' % (
            req['harness'], name, code_of(reason if isinstance(reason, dict) else {}))
        step = 'check that `%s` runs and is signed in on this machine, then start again' % PROGRAMS[req['harness']]
    state['stopped'] = True
    failures = []
    for undo in (lambda: close(state, 'start again'), lambda: archive(run, state)):
        try:
            undo()
        except Refused as e:
            failures.append(e)
    keep(run, state)
    if failures:
        raise Refused(line('; '.join([why] + [f.args[0] for f in failures])),
                      line('; '.join([f.args[1] for f in failures])))
    raise Refused(why, step)


def wake(run):
    lock(run)
    state = saved(run)
    if state['stopped']:
        raise Refused('run %s is stopped' % run, 'start a new run')
    if state['starting']:
        raise Refused('run %s never finished starting' % run, 'stop it, then start a new run')
    runpane('wake it again', 'panels', 'submit', '--panel', state['panel'], '--text',
            prompt_text(state['request'], True), '--no-expect-report', '--yes')
    return {'run': run, 'woke': True}


def stop(run):
    lock(run)
    state = saved(run)
    try:
        saved(run, dict(state, stopped=True))
    except OSError:
        raise Refused('the driver cannot save that run %s is stopping; nothing was stopped' % run,
                      UNWRITABLE + ', then stop it again')
    state['stopped'] = True
    if state['panel'] and not state['closed']:
        close(state, 'stop the run again')
        state['closed'] = True
        saved(run, state)
    if state['pane'] and not state['archived']:
        archive(run, state)
        state['archived'] = True
        saved(run, state)
    return {'run': run, 'stopped': True}


def answer(cmd):
    if cmd == 'version':
        return VERSION
    if cmd == 'schema':
        with open(os.path.join(HERE, 'schema.json')) as f:
            return json.load(f)
    if cmd == 'start':
        return start(read(START))
    if cmd in ('wake', 'stop'):
        run = read(RUN)['run']
        return wake(run) if cmd == 'wake' else stop(run)
    raise Refused('unknown command', 'run one of: version, schema, start, wake, stop')


def main():
    try:
        out, code = answer(sys.argv[1] if len(sys.argv) == 2 else ''), 0
    except Refused as e:
        out, code = {'error': e.args[0], 'next': e.args[1]}, 1
    except Exception as e:
        out, code = {'error': 'the driver failed: ' + type(e).__name__,
                     'next': 'read its code and fix it; check the Pane app for a Pane named openwiz-<run>'}, 1
    print(json.dumps(out))
    sys.exit(code)


if __name__ == '__main__':
    main()
