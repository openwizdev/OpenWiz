#!/usr/bin/env python3
import fcntl, json, os, re, signal, subprocess, sys, time

HERE = os.path.dirname(os.path.abspath(__file__))
AGENT = os.path.normpath(os.path.join(HERE, '..', 'fake-agent'))
API = 'https://api.cursor.com/v1'
ACTIVE = ('CREATING', 'RUNNING', 'WAITING_FOR_BACKGROUND_WORK')
CREATE = {'prompt', 'model', 'repos', 'name', 'agentId', 'autoCreatePR'}


def refuse(why):
    print('curl: (2) fake curl: ' + why, file=sys.stderr)
    sys.exit(2)


def args():
    if sys.argv[1:2] != ['--disable']:
        refuse('--disable is not the first argument, so a default curl config would be read')
    a = sys.argv[2:]
    if a == ['--version']:
        if os.environ.get('FAKE_CURSOR_LOG'):
            with open(os.environ['FAKE_CURSOR_LOG'], 'a') as f:
                f.write(json.dumps({'argv': sys.argv[1:], 'call': 'VERSION'}) + '\n')
        print('curl %s (fake) libcurl/%s' % ((os.environ.get('FAKE_CURL_VERSION') or '8.11.0',) * 2))
        sys.exit(0)
    head = ['-sS', '--variable', '%CURSOR_API_KEY', '--expand-oauth2-bearer', '{{CURSOR_API_KEY}}', '--max-time']
    if a[:6] != head or not a[6].isdigit() or a[7] != '-X' or a[9:11] != ['-H', 'Accept: application/json']:
        refuse('unexpected arguments %r' % a)
    if not os.environ.get('CURSOR_API_KEY'):
        print('curl: option --%s' % ('variable: variable expansion failure' if 'CURSOR_API_KEY' not in os.environ
                                     else 'expand-oauth2-bearer: blank argument where content is expected'),
              file=sys.stderr)
        sys.exit(2)
    method, rest = a[8], a[11:]
    has_body = rest[:4] == ['-H', 'Content-Type: application/json', '--data-binary', '@-']
    if has_body:
        rest = rest[4:]
    if rest[:4] != ['-o', '-', '-w', '\\n%{http_code}'] or len(rest) != 5 or not rest[4].startswith(API + '/'):
        refuse('unexpected arguments %r' % a)
    return method, rest[4][len(API):], has_body


def alive(pid):
    try:
        with open('/proc/%d/stat' % pid) as f:
            return f.read().rpartition(')')[2].split()[0] != 'Z'
    except OSError:
        return False


def status(run):
    if run['status'] in ACTIVE and not alive(run['pid']):
        run['status'] = 'FINISHED'
    return run['status']


def spawn(agent, woken):
    p = subprocess.Popen([sys.executable, AGENT, 'woken' if woken else 'first', agent['model'], agent['prompt']],
                         start_new_session=True, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL)
    run = {'id': 'run-%08d' % (len(agent['runs']) + 1), 'status': 'RUNNING', 'pid': p.pid}
    agent['runs'].append(run)
    return {'id': run['id'], 'agentId': agent['id'], 'status': 'CREATING',
            'createdAt': '2026-11-20T00:00:00.000Z', 'updatedAt': '2026-11-20T00:00:00.000Z'}


def public(agent):
    state = 'ARCHIVED' if agent['archived'] else \
        'ACTIVE' if agent['runs'] and status(agent['runs'][-1]) in ACTIVE else 'IDLE'
    return {'id': agent['id'], 'name': agent['name'], 'status': state, 'env': {'type': 'cloud'},
            'repos': agent['repos'], 'workOnCurrentBranch': False, 'autoCreatePR': False,
            'url': 'https://cursor.com/agents/' + agent['id'], 'createdAt': '2026-11-20T00:00:00.000Z',
            'updatedAt': '2026-11-20T00:00:00.000Z', 'latestRunId': agent['runs'][-1]['id']}


def route(method, path, body, agents):
    if method == 'POST' and path == '/agents':
        if set(body) - CREATE or not {'prompt', 'agentId'} <= set(body) or set(body['prompt']) != {'text'}:
            return 400, {'error': {'code': 'validation_error', 'message': 'unexpected body'}}
        if body['agentId'] in agents:
            return 409, {'error': {'code': 'agent_id_conflict', 'message': 'agent exists'}}
        agent = agents[body['agentId']] = {'id': body['agentId'], 'name': body.get('name', ''), 'archived': False,
                                           'repos': body.get('repos', []), 'model': body['model']['id'],
                                           'prompt': body['prompt']['text'], 'runs': []}
        run = spawn(agent, False)
        return 201, {'agent': public(agent), 'run': run}
    m = re.fullmatch(r'/agents/(bc-[0-9a-f-]{36})(/runs|/archive|/runs/(run-[0-9]+)/cancel)?', path)
    agent = agents.get(m.group(1)) if m else None
    if agent is None:
        return 404, {'error': {'code': 'not_found', 'message': 'no such agent'}}
    if method == 'GET' and m.group(2) is None:
        return 200, public(agent)
    if method == 'POST' and m.group(2) == '/runs':
        # External: Cursor's endpoint reference gives no error code for a follow-up on an archived agent, so
        # this one is a guess, https://cursor.com/docs/cloud-agent/api/endpoints
        if agent['archived']:
            return 409, {'error': {'code': 'agent_archived', 'message': 'archived'}}
        if status(agent['runs'][-1]) in ACTIVE:
            return 409, {'error': {'code': 'agent_busy', 'message': 'a run is active'}}
        if set(body) != {'prompt'} or set(body['prompt']) != {'text'}:
            return 400, {'error': {'code': 'validation_error', 'message': 'unexpected body'}}
        agent['prompt'] = body['prompt']['text']
        return 201, {'run': spawn(agent, True)}
    if method == 'POST' and m.group(3):
        run = next((r for r in agent['runs'] if r['id'] == m.group(3)), None)
        if run is None or status(run) not in ACTIVE:
            return 409, {'error': {'code': 'run_not_cancellable', 'message': 'not active'}}
        try:
            os.killpg(run['pid'], signal.SIGKILL)
        except OSError:
            pass
        while alive(run['pid']):
            time.sleep(0.01)
        run['status'] = 'CANCELLED'
        return 200, {'id': run['id']}
    if method == 'POST' and m.group(2) == '/archive':
        agent['archived'] = True
        return 200, {'id': agent['id']}
    return 404, {'error': {'code': 'not_found', 'message': 'no such route'}}


def main():
    method, path, has_body = args()
    text = sys.stdin.read() if has_body else ''
    if os.environ.get('FAKE_CURSOR_LOG'):
        with open(os.environ['FAKE_CURSOR_LOG'], 'a') as f:
            f.write(json.dumps({'argv': sys.argv[1:], 'call': method + ' ' + path, 'body': text,
                                'key_in': sorted(k for k, v in os.environ.items()
                                                 if os.environ['CURSOR_API_KEY'] in v)}) + '\n')
    body = json.loads(text) if has_body else None
    fail = re.fullmatch(r'(\w+) (\S+)=(\d+|lost|pending)', os.environ.get('FAKE_CURSOR_FAIL', ''))
    failing = fail and fail.group(1) == method and path.endswith(fail.group(2))
    if failing and fail.group(3) == 'pending':
        with open(os.environ['FAKE_CURSOR_STATE'] + '.pending', 'w') as f:
            f.write(text)
        print('curl: (28) Operation timed out after 60000 milliseconds with 0 bytes received', file=sys.stderr)
        sys.exit(28)
    if failing and fail.group(3) != 'lost':
        print(json.dumps({'error': {'code': 'fake_failure', 'message': 'the fake was told to fail'}}))
        print(fail.group(3), end='')
        return
    with open(os.environ['FAKE_CURSOR_STATE'] + '.lock', 'w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            with open(os.environ['FAKE_CURSOR_STATE']) as f:
                agents = json.load(f)
        except FileNotFoundError:
            agents = {}
        code, answer = route(method, path, body, agents)
        with open(os.environ['FAKE_CURSOR_STATE'], 'w') as f:
            json.dump(agents, f)
    if failing:
        print('curl: (28) Operation timed out after 60000 milliseconds with 0 bytes received', file=sys.stderr)
        sys.exit(28)
    print(json.dumps(answer))
    print(code, end='')


if __name__ == '__main__':
    main()
