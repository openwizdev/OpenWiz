#!/usr/bin/env python3
import json, os, re, sys, time

woken, model, prompt = sys.argv[1] == 'woken', sys.argv[2], sys.argv[3]
skill = re.search(r'with the ([a-z0-9-]+) skill', prompt).group(1)
path = os.environ.get('KIT_TRACKER')
if path:
    now = time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())
    body = '\n'.join(['<!-- openwiz:status v1 -->', 'agent: builder', 'state: working', 'harness: Cursor',
                      'model: ' + model, 'skills: %s@0.2.0' % skill,
                      'step: ' + ('woke and read the ticket again' if woken else 'started the throwaway ticket'),
                      'time: ' + now]) + '\n'
    with open(path) as f:
        tracker = json.load(f)
    mine = [c for c in tracker['comments'] if c['author'] == 'example-bot[bot]' and 'agent: builder' in c['body']]
    if woken and mine:
        mine[-1].update(body=body, updated_at=now)
    else:
        tracker['comments'].append({'id': 1 + max([c['id'] for c in tracker['comments']], default=0),
                                    'author': 'example-bot[bot]', 'updated_at': now, 'body': body})
    with open(path + '.%d' % os.getpid(), 'w') as f:
        json.dump(tracker, f)
    os.replace(path + '.%d' % os.getpid(), path)
with open(os.environ['FAKE_TURNS'], 'a') as f:
    f.write('%d %s\n' % (os.getpid(), 'woken' if woken else 'first'))
while os.environ.get('FAKE_HOLD') and os.path.exists(os.environ['FAKE_HOLD']):
    time.sleep(0.05)
