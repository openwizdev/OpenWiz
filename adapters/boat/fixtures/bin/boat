#!/usr/bin/env python3
"""A synthetic `boat` CLI for the boat driver's tests. Synthetic assumptions, not observed on a live
account, except where marked: the JSON Lines shapes below follow docs.boat.dev's CLI reference
(2026-11-19). Observed on the owner's live kit run (boat CLI 1.0.103): `boat prompt --json`'s queued
line nests its ids under `data`, and its turn ends with an `{"event": "chat", "final": true}` line. Observed
live twice (#1874): `boat info --json` nests the sandbox's fields under a top-level `sandbox` key; with
FAKE_BOAT_INFO=flat this fake prints the older flat shape, a top-level `state`, instead.

It keeps its sandboxes in the JSON file FAKE_BOAT_STATE. `boat prompt` plays the agent: a new
conversation posts one builder status note in the local tracker KIT_TRACKER, and each later prompt
in that conversation edits the same note; then the turn ends (see `prompt` for FAKE_HOLD).
FAKE_BOAT_PROVIDERS (comma-separated) lists the connected providers; FAKE_BOAT_FAIL (comma-separated) names
commands that fail. `boat exec` runs its script for real, in the sandbox's own home folder, with the
synthetic `git` of fixtures/sandbox-bin; the agent posts its note only if its skill is installed there."""
import fcntl, json, os, re, subprocess, sys, time

STATE, ARGS = os.environ['FAKE_BOAT_STATE'], sys.argv[1:]
PROVIDERS = os.environ.get('FAKE_BOAT_PROVIDERS', 'claude,codex').split(',')


def say(**line):
    print(json.dumps(line), flush=True)


def fail(code, error):
    say(event='error', error=error, code=code, status=409)
    sys.exit(1)


def update(change):
    """Run change(state) under a lock and save what it returns."""
    with open(STATE + '.lock', 'w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            with open(STATE) as f:
                state = json.load(f)
        except FileNotFoundError:
            state = {'sandboxes': {}}
        out = change(state)
        with open(STATE + '.new', 'w') as f:
            json.dump(state, f)
        os.replace(STATE + '.new', STATE)
        return out


def sandbox(state, sid):
    if sid not in state['sandboxes']:
        fail('sandbox_not_found', 'no sandbox ' + sid)
    return state['sandboxes'][sid]


def home(sid):
    """The sandbox's home folder: a folder of its own beside FAKE_BOAT_STATE."""
    return os.path.join(STATE + '.homes', sid)


def run_in_sandbox(args):
    # boat exec <id> --timeout <seconds> -- sh -c <script>: run it with the sandbox's home, and a PATH whose `git`
    # is the synthetic one; print its outcome as one JSON object (piped output is JSON) and exit with its code.
    if len(args) != 7 or args[1] != '--timeout' or args[3:6] != ['--', 'sh', '-c']:
        print('boat exec: unexpected arguments', file=sys.stderr)
        sys.exit(2)
    box = update(lambda s: sandbox(s, args[0]))
    if box['state'] != 'running':
        fail('sandbox_not_ready', 'the sandbox is %s' % box['state'])
    os.makedirs(home(args[0]), exist_ok=True)
    bin = os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'sandbox-bin')
    p = subprocess.run(['sh', '-c', args[6]], capture_output=True, text=True, cwd=home(args[0]),
                       env={'HOME': home(args[0]), 'PATH': bin + os.pathsep + os.environ['PATH'],
                            'FAKE_WIZ_COMMIT': os.environ.get('FAKE_WIZ_COMMIT', ''),
                            'FAKE_WIZ_SAME_TREE': os.environ.get('FAKE_WIZ_SAME_TREE', '')})
    print(json.dumps({'exitCode': p.returncode, 'stdout': p.stdout, 'stderr': p.stderr}))
    sys.exit(p.returncode)


def note(conversation, woken, model, skill):
    """Post or edit this conversation's builder note, as the agent in the sandbox would."""
    path, now = os.environ['KIT_TRACKER'], time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())
    body = '\n'.join(['<!-- openwiz:status v1 -->', 'agent: builder', 'state: working', 'harness: Fake',
                      'model: ' + model, 'skills: %s@0.1.2' % skill,
                      'step: ' + ('woke and read the ticket again' if woken else 'started the throwaway ticket'),
                      'time: ' + now]) + '\n'
    with open(path) as f:
        tracker = json.load(f)
    if conversation['note'] is None:
        conversation['note'] = 1 + max([c['id'] for c in tracker['comments']], default=0)
        tracker['comments'].append({'id': conversation['note'], 'author': 'example-bot[bot]',
                                    'updated_at': now, 'body': body})
    else:
        [c for c in tracker['comments'] if c['id'] == conversation['note']][0].update(body=body, updated_at=now)
    with open(path + '.%d' % os.getpid(), 'w') as f:
        json.dump(tracker, f)
    os.replace(path + '.%d' % os.getpid(), path)


def prompt(args):
    # boat prompt <id> (--new | --resume <conversation>) --provider <p> --model <m> --json <text>
    m = re.fullmatch(r'(\S+)\x00(?:--new|--resume\x00(\S+))\x00--provider\x00(\S+)\x00--model\x00([^\x00]+)'
                     r'\x00--json\x00([^\x00]+)', '\x00'.join(args))
    if not m:
        print('boat prompt: unexpected arguments', file=sys.stderr)
        sys.exit(2)
    sid, resume, provider, model, text = m.groups()
    if provider not in PROVIDERS:
        fail('provider_not_configured', 'connect a %s key or subscription first' % provider)
    skill = re.search(r'the ([a-z0-9-]+) skill', text).group(1)

    def queue(state):
        box = sandbox(state, sid)
        if box['state'] not in ('running', 'idle', 'ready'):  # a live sandbox whose agent's turn has ended
            fail('sandbox_not_ready', 'the sandbox is %s; resume it first' % box['state'])
        if resume is None:
            cid = 'c%d' % (len(box['conversations']) + 1)
            box['conversations'][cid] = {'note': None}
        elif resume not in box['conversations']:
            fail('conversation_not_found', 'no conversation ' + resume)
        cid = resume or cid
        # The agent follows the skill, and posts its note, only if the skill is installed in the sandbox for
        # its harness (live run 3: without it, no note).
        found = os.path.join(home(sid), '.claude' if provider == 'claude' else '.agents', 'skills', skill, 'SKILL.md')
        if os.path.exists(found):
            note(box['conversations'][cid], resume is not None, model, skill)
        return cid, box['interrupts']

    cid, interrupts = update(queue)
    # The live shape (boat CLI 1.0.103): the ids are nested under `data`.
    say(data={'conversationId': cid, 'promptId': 'p%d' % os.getpid(), 'status': 'queued'}, event='queued')
    # The turn leaves a detached worker in its own session behind, as a CLI that starts a helper might
    # (with FAKE_CLEAN, in a clean environment that carries no inherited mark; with FAKE_SAME_GROUP, in the
    # prompt's own process group instead), and logs
    # `<prompt pid> <worker pid> <conversation> first|woken` to FAKE_TURNS.
    worker = subprocess.Popen(['sleep', '120'], start_new_session=not os.environ.get('FAKE_SAME_GROUP'),
                              env={'PATH': os.environ['PATH']} if os.environ.get('FAKE_CLEAN') else None,
                              stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if os.environ.get('FAKE_TURNS'):
        with open(os.environ['FAKE_TURNS'], 'a') as f:
            f.write('%d %d %s %s\n' % (os.getpid(), worker.pid, cid, 'woken' if resume else 'first'))
    # The turn ends at once, or runs while the file FAKE_HOLD exists, its sandbox runs and nobody interrupts it.
    while os.environ.get('FAKE_HOLD') and os.path.exists(os.environ['FAKE_HOLD']):
        box = update(lambda s: s['sandboxes'][sid])
        if box['state'] != 'running' or box['interrupts'] != interrupts:
            say(data={'conversationId': cid, 'status': 'interrupted'}, event='chat', final=True)
            return
        time.sleep(0.05)
    say(data={'conversationId': cid, 'status': 'finished'}, event='chat', final=True)


def main():
    cmd, rest = (ARGS[0], ARGS[1:]) if ARGS else ('', [])
    if cmd in os.environ.get('FAKE_BOAT_FAIL', '').split(','):  # a planted failure of this command
        fail('internal_error', 'boat %s failed' % cmd)
    if cmd not in ('prompt', 'exec'):  # every other call the driver makes passes --json once, anywhere
        rest = [a for a in rest if a != '--json'] + ['--json'] * (rest.count('--json') == 1)
    if cmd == 'new' and len(rest) == 3 and rest[0] == '--name' and rest[2] == '--json':
        def create(state):
            sid = 'bx_fake%04d' % (len(state['sandboxes']) + 1)
            state['sandboxes'][sid] = {'name': rest[1], 'state': 'running', 'conversations': {}, 'interrupts': 0}
            return sid
        sid = update(create)
        say(event='creating', id=sid)
        say(event='ready', id=sid)
    elif cmd == 'info' and len(rest) == 2 and rest[1] == '--json':
        box = update(lambda s: sandbox(s, rest[0]))
        if os.environ.get('FAKE_BOAT_INFO') == 'flat':
            say(id=rest[0], state=box['state'])
        else:
            say(sandbox={'id': rest[0], 'name': box['name'], 'state': box['state']})
    elif cmd in ('resume', 'stop', 'interrupt') and rest[-1] == '--json' and (
            len(rest) == 2 or cmd == 'interrupt' and len(rest) == 4 and rest[1] == '--convo'):
        def act(state):
            box = sandbox(state, rest[0])
            if cmd == 'interrupt':
                box['interrupts'] += 1
            else:
                box['state'] = 'running' if cmd == 'resume' else 'stopped'
        update(act)
        say(event='ready' if cmd == 'resume' else 'done', id=rest[0])
    elif cmd == 'exec':
        run_in_sandbox(rest)
    elif cmd == 'prompt':
        prompt(rest)
    else:
        print('boat: unexpected arguments', file=sys.stderr)
        sys.exit(2)


if __name__ == '__main__':
    main()
