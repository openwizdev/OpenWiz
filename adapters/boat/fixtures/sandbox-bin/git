#!/usr/bin/env python3
"""A synthetic `git` inside the fake sandbox, for the boat driver's tests, with a synthetic GitHub.

GitHub's WizSkills tag v<version> points at the pin of OpenWiz's wizskills.lock; FAKE_WIZ_COMMIT=<sha> points it
elsewhere, and FAKE_WIZ_COMMIT=moved points it elsewhere from the second fetch on (a tag that moves between
fetches); FAKE_WIZ_SAME_TREE makes that other commit a later one, with the pin in its history and the pin's tree. A URL rewritten by `url.<local>.insteadOf` (GIT_CONFIG_KEY_0) reads that local repository instead.
A repository is a folder whose `fake.json` holds its tag's commit and tree. Supported: `init -q --bare`,
`fetch` and `clone` of the tag, `rev-parse` of a tag, commit or HEAD and its tree, and `show <sha>:install.sh`."""
import json, os, shutil, sys

HERE = os.path.dirname(os.path.abspath(__file__))
RELEASE = os.path.join(HERE, '..', 'wizskills')
GITHUB = 'https://github.com/openwizdev/WizSkills.git'
with open(os.path.join(HERE, '..', '..', '..', '..', 'wizskills.lock')) as f:
    LOCK = json.load(f)


def github():
    """The commit and tree the tag has on this fetch from GitHub."""
    seen = os.path.join(os.environ['HOME'], '.fake-github-fetches')
    with open(seen, 'a+') as f:
        f.write('.')
        f.seek(0)
        n = len(f.read())
    moved = os.environ.get('FAKE_WIZ_COMMIT', '')
    commit = LOCK['commit'] if not moved or moved == 'moved' and n == 1 else ('1' * 40 if moved == 'moved' else moved)
    same = commit == LOCK['commit'] or os.environ.get('FAKE_WIZ_SAME_TREE')  # another commit, the same files
    return {'commit': commit, 'tree': LOCK['tree'] if same else '2' * 40}


def source(url):
    """The repository a URL reads, after a `url.<local>.insteadOf` rewrite of exactly that URL."""
    key, value = os.environ.get('GIT_CONFIG_KEY_0', ''), os.environ.get('GIT_CONFIG_VALUE_0')
    if key.startswith('url.') and key.endswith('.insteadOf') and value == url:
        local = key[len('url.'):-len('.insteadOf')]
        with open(os.path.join(local[len('file://'):] if local.startswith('file://') else local, 'fake.json')) as f:
            return json.load(f)
    if url != GITHUB:
        sys.exit('git: unknown remote')
    return github()


def repo(folder):
    with open(os.path.join(folder, 'fake.json')) as f:
        return json.load(f)


args = sys.argv[1:]
where = None
if args[:1] in (['-C'], ['--git-dir']):
    where, args = args[1], args[2:]
    if args[:1] != ['init'] and os.path.isdir(os.path.join(where, '.git')):
        where = os.path.join(where, '.git')
if args[:3] == ['init', '-q', '--bare']:
    os.makedirs(args[3])
    with open(os.path.join(args[3], 'fake.json'), 'w') as f:
        json.dump({}, f)
elif args[:2] == ['init', '-q'] and len(args) == 3:
    os.makedirs(args[2])
    with open(os.path.join(args[2], 'fake.json'), 'w') as f:
        json.dump({}, f)
elif where and args[:4] == ['commit', '-q', '--allow-empty', '-m'] and len(args) == 5:
    pass
elif where and args[:3] == ['push', '-q', '--dry-run'] and len(args) == 5:
    with open(os.path.join(os.environ['HOME'], '.fake-github-pushes'), 'a') as f:
        f.write('dry-run %s %s\n' % (args[3], args[4]))
    if args[4].rpartition(':')[2][len('refs/heads/'):] in os.environ.get('FAKE_GITHUB_BRANCHES', '').split(','):
        sys.stderr.write(' ! [rejected]        %s (fetch first)\n' % args[4])
        sys.exit(1)
    if os.environ.get('FAKE_BOAT_PUSH') == 'denied':
        sys.stderr.write('remote: Permission to %s denied to synthetic-app[bot].\n'
                         "fatal: unable to access '%s': The requested URL returned error: 403\n"
                         % (args[3][len('https://github.com/'):], args[3]))
        sys.exit(128)
elif where and args[:1] == ['fetch'] and args[-1] == 'refs/tags/v%s:refs/tags/v%s' % ((LOCK['version'],) * 2):
    with open(os.path.join(where, 'fake.json'), 'w') as f:
        json.dump(source(args[-2]), f)
elif args[:1] == ['clone'] and args[args.index('--branch') + 1] == 'v' + LOCK['version']:
    tag = source(args[-2])
    shutil.copytree(RELEASE, args[-1])
    os.makedirs(os.path.join(args[-1], '.git'))
    with open(os.path.join(args[-1], '.git', 'fake.json'), 'w') as f:
        json.dump(tag, f)
elif where and args[:1] == ['rev-parse'] and len(args) == 2:
    state, ref = repo(where), args[1]
    name, _, kind = ref.partition('^')
    if name == LOCK['commit'] and os.environ.get('FAKE_WIZ_SAME_TREE'):  # the pin, earlier in the tag's history
        state = {'commit': LOCK['commit'], 'tree': LOCK['tree']}
    elif name not in ('HEAD', 'refs/tags/v' + LOCK['version'], state.get('commit')):
        sys.exit('git: unknown revision')
    print(state['tree'] if kind == '{tree}' else state['commit'])
elif where and args[:1] == ['show'] and args[1] in ['%s:install.sh' % c for c in (repo(where).get('commit'),
        LOCK['commit'] if os.environ.get('FAKE_WIZ_SAME_TREE') else None)]:
    with open(os.path.join(RELEASE, 'install.sh')) as f:
        sys.stdout.write(f.read())
else:
    sys.exit('git: unexpected arguments')
