class Refused(Exception):
    pass


def line(text):
    text = ' '.join(str(text).split()) or 'no detail'
    return text if len(text) <= 300 else text[:297] + '...'


def unique(pairs):
    if len({k for k, _ in pairs}) != len(pairs):
        raise Refused('a key is repeated', 'send each key once')
    return dict(pairs)


def read(fields):
    try:
        req = json.loads(sys.stdin.read(), object_pairs_hook=unique)
    except ValueError:
        raise Refused('the input is not JSON', 'send one JSON object on stdin, as `driver schema` shows')
    optional = OPTIONAL if fields is START else {}
    if not isinstance(req, dict) or not set(fields) <= set(req) <= set(fields) | set(optional):
        raise Refused('the input needs exactly ' + ', '.join(fields) + ''.join(', and optionally ' + k for k in optional),
                      'send only those fields; never a login')
    for key, pattern in dict(fields, **optional).items():
        if key not in req:
            continue
        v = req[key]
        if not (type(v) is int and v > 0 if pattern is None else isinstance(v, str) and re.fullmatch(pattern, v)):
            raise Refused(key + ' is not valid', 'fix ' + key + ' as `driver schema` shows')
    return req


def looks_like_credential(text):
    return bool(CREDENTIAL_SHAPES.search(text))


def no_credentials(req):
    # PRIVACY: runs before anything is saved or started, and the refusal names the field, never its value.
    for key in dict(START, **OPTIONAL):
        if isinstance(req.get(key), str) and looks_like_credential(req[key]):
            raise Refused('%s looks like a credential, so nothing was saved or started' % key,
                          'send the %s itself in %s; never a login, key or token' % (key, key))
    return req


def fit_for_ssh(req, nothing, then):
    # PRIVACY: names only the field, never its value.
    for key in dict(START, **OPTIONAL):
        v = req.get(key) if isinstance(req, dict) else None
        if isinstance(v, str) and (re.search(r'\s', v) or any(n in v.upper() for n in RESERVED_SECRETS)):
            raise Refused('%s holds a space or a secret name such as GH_TOKEN, so %s' % (key, nothing),
                          'send the %s itself, with no space and no secret name, then %s' % (key, then))
    return req


def settle_seconds():
    raw = os.environ.get('OPENWIZ_CODESPACES_SETTLE') or str(DEFAULT_SETTLE_SECONDS)
    try:
        seconds = float(raw)
    except ValueError:
        seconds = float('nan')
    if not 0 < seconds <= MAX_SETTLE_SECONDS:
        raise Refused('OPENWIZ_CODESPACES_SETTLE is not a number of seconds above 0 and at most %d; nothing was '
                      'started' % MAX_SETTLE_SECONDS, 'unset it, or set it to a number of seconds up to %d, then try '
                      'again' % MAX_SETTLE_SECONDS)
    return seconds


def gh_program():
    found = shutil.which('gh')
    if not found:
        raise Refused('the gh CLI is not installed here, so nothing was created',
                      "install GitHub's gh CLI (cli.github.com) and sign in to it yourself first")
    return found


def gh_error(what, stderr, then):
    if SIGNED_OUT.search(stderr):
        why, step = 'gh is not signed in with the codespace scope', SIGN_IN
    elif what == 'codespace create' and re.search(r'machine', stderr, re.I):
        why, step = 'gh asks for a machine type', ('set OPENWIZ_CODESPACES_MACHINE to a machine type the repository '
                                                   'offers')
    else:
        why = 'gh gave an error the driver does not repeat' if stderr.strip() else 'gh gave no answer'
        step = 'run `gh %s` by hand to read what it says' % what
    return Refused(line('gh %s failed: %s' % (what, why)), line('%s, then %s' % (step, then)))


def gh(what, then, args, wait=API_WAIT_SECONDS):
    try:
        p = subprocess.run([gh_program()] + args, stdin=subprocess.DEVNULL, capture_output=True, text=True,
                           timeout=wait)
    except subprocess.TimeoutExpired:
        raise Refused('gh %s took too long; its outcome is unknown' % what, line(then))
    if p.returncode != 0:
        raise gh_error(what, p.stderr[-400:], then)
    return p.stdout


def lines_of(text):
    return [x.strip() for x in text.splitlines() if x.strip()]


def prechecks(req):
    nothing = ', so nothing was created'
    then = 'start again'
    try:
        hosts = json.loads(gh('auth status', then, ['auth', 'status', '--active', '--hostname', 'github.com',
                                                    '--json', 'hosts']))
        accounts = [a for a in hosts['hosts']['github.com'] if a.get('active')]
        scopes = [s.strip() for s in accounts[0].get('scopes', '').split(',')]
        signed_in = accounts[0].get('state') == 'success'
    except (Refused, ValueError, KeyError, IndexError, TypeError, AttributeError):
        raise Refused('gh is not signed in to github.com' + nothing, SIGN_IN + ', then start again')
    if not signed_in or 'codespace' not in scopes:
        raise Refused('gh lacks the codespace scope' + nothing,
                      'run `gh auth refresh -h github.com -s codespace` yourself, then start again')
    names, _ = HARNESSES[req['harness']]
    try:
        listed = lines_of(gh('api /user/codespaces/secrets', then,
                             ['api', '--paginate', '/user/codespaces/secrets', '--jq', '.secrets[].name']))
    except Refused:
        raise Refused('gh could not list your Codespaces secrets' + nothing,
                      'run `gh api /user/codespaces/secrets` by hand to read what it says, then start again')
    held = [n for n in names if n in listed]
    if not held:
        raise Refused(line('no Codespaces secret %s is set on your account%s' % (' or '.join(names), nothing)),
                      line('set one yourself, by name: `gh secret set %s --user --repos %s`, typing its value into '
                           'gh, then start again' % (names[0], req['repository'])))
    for name in held:
        try:
            repos = lines_of(gh('api', then, ['api', '--paginate', '/user/codespaces/secrets/%s/repositories' % name,
                                              '--jq', '.repositories[].full_name']))
        except Refused:
            raise Refused('gh could not list the repositories of your Codespaces secret %s%s' % (name, nothing),
                          'run `gh api /user/codespaces/secrets/%s/repositories` by hand, then start again' % name)
        if req['repository'].lower() in (r.lower() for r in repos):
            return
    raise Refused(line('your Codespaces secret %s is not set for %s%s' % (held[0], req['repository'], nothing)),
                  line('add %s to its repositories yourself in github.com/settings/codespaces, then start again'
                       % req['repository']))


def machine():
    value = os.environ.get('OPENWIZ_CODESPACES_MACHINE') or DEFAULT_MACHINE
    if not MACHINE.fullmatch(value):
        raise Refused('OPENWIZ_CODESPACES_MACHINE is not a machine type, so nothing was created',
                      'unset it for %s, or set it to a machine type such as standardLinux32gb, then start again'
                      % DEFAULT_MACHINE)
    return ['-m', value]


def ssh(name, command):
    return [gh_program(), 'codespace', 'ssh', '-c', name, '--', command]


def pinned_skills():
    try:
        with open(os.path.join(HERE, '..', '..', 'wizskills.lock')) as f:
            lock = json.load(f)
        assert set(lock) == {'version', 'commit', 'tree'} and re.fullmatch(r'[0-9]+\.[0-9]+\.[0-9]+', lock['version'])
        assert all(re.fullmatch(r'[0-9a-f]{40}', lock[k]) for k in ('commit', 'tree'))
        return lock
    except (OSError, ValueError, TypeError, AssertionError):
        raise Refused("OpenWiz's wizskills.lock is missing or malformed, so nothing was created",
                      'run the driver from an OpenWiz checkout whose wizskills.lock pins a WizSkills release')


