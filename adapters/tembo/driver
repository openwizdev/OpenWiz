#!/usr/bin/env python3
# SECURITY: driver v1 N4. Every Tembo call goes through the kit's key helper, which alone reads the key and picks
# the address; this driver sends it only a host name, a method, a path and a body, and never names, reads or prints
# the key. It shows no text the host answered: each error names only the status, the method and the path.
import json, os, re, subprocess, sys, urllib.parse, uuid
sys.dont_write_bytecode = True

HERE = os.path.dirname(os.path.abspath(__file__))
HELPER = os.path.realpath(os.path.join(HERE, '..', '..', 'kernel', 'driver-kit', 'hostkey.py'))
HOST = 'tembo'
VERSION = {'driver': 'tembo', 'records': ['openwiz:records v1'], 'can': ['start', 'wake', 'stop', 'effort']}
START = {'repository': r'[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}', 'ticket': None,
         'skill': r'(?=.{1,60}$)[a-z0-9]+(-[a-z0-9]+)*', 'harness': r'[a-z0-9][a-z0-9._-]{0,59}',
         'model': r'[A-Za-z0-9][A-Za-z0-9 ._:@+-]{0,59}'}
RUN = {'run': r'[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}'}
AGENTS = {'claude': 'claudeCode', 'claude-code': 'claudeCode', 'codex': 'codex'}
EFFORT = r'[a-z][a-z0-9-]{0,19}'
# External: Tembo documents reasoning levels only for Codex, https://docs.tembo.io/features/agents
EFFORTS = {'codex': ('low', 'medium', 'high', 'xhigh')}
NO_EFFORT = ("this host can't set effort: remove the effort for this harness in your Models table or Roster to run it "
             "at the host's default")
WOKEN = 'You were woken: read the ticket again and carry on.'


class Refused(Exception):
    pass


def unique(pairs):
    if len({k for k, _ in pairs}) != len(pairs):
        raise Refused('a key is repeated', 'send each key once')
    return dict(pairs)


def read(fields):
    try:
        req = json.loads(sys.stdin.read(), object_pairs_hook=unique)
    except ValueError:
        raise Refused('the input is not JSON', 'send one JSON object on stdin, as `driver schema` shows')
    optional = {'effort': EFFORT} if fields is START else {}
    if not isinstance(req, dict) or not set(fields) <= set(req) <= set(fields) | set(optional):
        raise Refused('the input needs exactly ' + ', '.join(fields) + (', and optionally effort' if optional else ''),
                      'send only those fields; never a login')
    for key, pattern in dict(fields, **optional).items():
        if key not in req:
            continue
        v = req[key]
        if not (type(v) is int and v > 0 if pattern is None else isinstance(v, str) and re.fullmatch(pattern, v)):
            raise Refused(key + ' is not valid', 'fix ' + key + ' as `driver schema` shows')
    return req


def ask(method, path, body=None, also=()):
    request = {'host': HOST, 'method': method, 'path': path}
    if body is not None:
        request['body'] = body
    try:
        p = subprocess.run([sys.executable, '-I', HELPER], input=json.dumps(request), capture_output=True,
                           text=True, timeout=110)
        out = json.loads(p.stdout)
    except (OSError, subprocess.TimeoutExpired, ValueError):
        raise Refused('the key helper gave no answer', 'run kernel/driver-kit/hostkey.py by hand to see why')
    if p.returncode:
        raise Refused('the key helper refused: ' + out['error'], out['next'])
    if not (200 <= out['status'] < 300 or out['status'] in also):
        raise Refused('Tembo answered %d to %s %s' % (out['status'], method, path.partition('?')[0]),
                      'check your key and Tembo\'s status, then retry')
    return out['status'], out['body']


def repository(full):
    owner, name = full.split('/')
    _, found = ask('GET', '/v1/repositories?' + urllib.parse.urlencode({'search': name, 'limit': 100}))
    for r in (found or {}).get('items') or []:
        if isinstance(r, dict) and isinstance(r.get('id'), str) and str(r.get('owner')).lower() == owner.lower() \
                and str(r.get('name')).lower() == name.lower():
            return r['id']
    raise Refused('Tembo has no connected repository ' + full,
                  'connect %s to Tembo (Settings, Integrations, GitHub), then start again' % full)


def session(run):
    status, found = ask('GET', '/v1/sessions/' + run, also=(404,))
    if status == 404 or not isinstance(found, dict):
        return 'unknown'
    return 'stopped' if found.get('level') == 0 else 'live'


def answer(cmd):
    if cmd == 'version':
        return VERSION
    if cmd == 'schema':
        with open(os.path.join(HERE, 'schema.json')) as f:
            return json.load(f)
    if cmd == 'start':
        req = read(START)
        agent = AGENTS.get(req['harness'])
        if agent is None:
            raise Refused('harness %s is not one Tembo runs for OpenWiz' % req['harness'],
                          'use claude-code (or claude) or codex')
        if 'effort' in req and req['effort'] not in EFFORTS.get(agent, ()):
            raise Refused('Tembo cannot set effort %s for harness %s' % (req['effort'], req['harness']), NO_EFFORT)
        repo, run = repository(req['repository']), str(uuid.uuid4())
        create = {'id': run, 'description': 'Build the ticket: %s#%d, with the %s skill.'
                  % (req['repository'], req['ticket'], req['skill']),
                  'agent': '%s:%s' % (agent, req['model']), 'codeRepositoryIds': [repo], 'queueRightAway': True}
        if 'effort' in req:
            create['agentOptions'] = {'reasoningLevel': req['effort']}
        try:
            ask('POST', '/v1/sessions', create)
        except Refused as e:
            raise Refused('run %s may have started: %s' % (run, e.args[0]),
                          'stop run %s with `driver stop`, then start again' % run)
        return {'run': run}
    if cmd == 'wake':
        run = read(RUN)['run']
        state = session(run)
        if state != 'live':
            raise Refused(('Tembo has no run %s' if state == 'unknown' else 'run %s is stopped') % run,
                          'start a new run')
        ask('POST', '/v1/messages', {'sessionId': run, 'content': WOKEN, 'deliveryMode': 'queue'})
        return {'run': run, 'woke': True}
    if cmd == 'stop':
        run = read(RUN)['run']
        if session(run) == 'live':
            ask('POST', '/v1/sessions/%s/stop?cancelQueued=true' % run, also=(404,))
            ask('DELETE', '/v1/sessions/' + run, also=(404,))
        return {'run': run, 'stopped': True}
    raise Refused('unknown command', 'run one of: version, schema, start, wake, stop')


def main():
    try:
        out, code = answer(sys.argv[1] if len(sys.argv) == 2 else ''), 0
    except Refused as e:
        out, code = {'error': e.args[0], 'next': e.args[1]}, 1
    except Exception as e:
        out, code = {'error': 'the driver failed: ' + type(e).__name__, 'next': 'read its code, fix it, retry'}, 1
    print(json.dumps(out))
    sys.exit(code)


if __name__ == '__main__':
    main()
