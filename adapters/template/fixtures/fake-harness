#!/usr/bin/env python3
import os, subprocess, sys, time

args = sys.argv[1:]
woken = args[args.index('-p') + 1].startswith('You were woken')
child = subprocess.Popen(['sleep', '120'], start_new_session=not os.environ.get('FAKE_SAME_GROUP'),
                         env={'PATH': os.environ['PATH']} if os.environ.get('FAKE_CLEAN') else None,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
with open(os.environ['FAKE_TURNS'], 'a') as f:
    f.write('%d %d %s\n' % (os.getpid(), child.pid, 'woken' if woken else 'first'))
while os.environ.get('FAKE_HOLD') and os.path.exists(os.environ['FAKE_HOLD']):
    time.sleep(0.05)
