#!/usr/bin/env python3
import ctypes, fcntl, json, os, re, secrets, shutil, signal, subprocess, sys, time

HERE = os.path.dirname(os.path.abspath(__file__))
STATE = os.environ.get('OPENWIZ_TEMPLATE_STATE') or os.path.expanduser('~/.local/state/openwiz-template')
VERSION = {'driver': 'template', 'records': ['openwiz:records v1'], 'can': ['start', 'wake', 'stop', 'effort']}
START = {'repository': r'[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}', 'ticket': None,
         'skill': r'(?=.{1,60}$)[a-z0-9]+(-[a-z0-9]+)*', 'harness': r'[a-z0-9][a-z0-9._-]{0,59}',
         'model': r'(?=.{1,100}$)[A-Za-z0-9][A-Za-z0-9 ._:@+-]*(/[A-Za-z0-9][A-Za-z0-9 ._:@+-]*)*'}
RUN = {'run': r'run-[0-9a-f]{12}'}
EFFORT = {'effort': r'[a-z][a-z0-9-]{0,19}'}
EFFORTS = {'fake-harness': ('--effort', ('low', 'medium', 'high', 'xhigh', 'max'))}
CANT_SET_EFFORT = ("this host can't set effort: remove the effort for this harness in your Models table or Roster to "
                   "run it at the host's default")
GRACE = 10
KILL_GRACE = 2
LSOF_COULD_NOT_CHECK = []
NO_LSOF = ('driver: lsof could not run or failed, so the driver could not check which processes hold this '
           "run's output files open; it ended only the turns' process groups and the processes their "
           'supervisors recorded')


class Refused(Exception):
    pass


def unique(pairs):
    if len({k for k, _ in pairs}) != len(pairs):
        raise Refused('a key is repeated', 'send each key once')
    return dict(pairs)


def read(fields):
    need = [k for k in fields if k not in EFFORT]
    try:
        req = json.loads(sys.stdin.read(), object_pairs_hook=unique)
    except ValueError:
        raise Refused('the input is not JSON', 'send one JSON object on stdin, as `driver schema` shows')
    if not isinstance(req, dict) or not set(need) <= set(req) <= set(fields):
        may = ''.join(', and may carry ' + k for k in fields if k not in need)
        raise Refused('the input needs exactly ' + ', '.join(need) + may, 'send only those fields; never a login')
    for key, pattern in fields.items():
        if key not in req:
            continue
        v = req[key]
        if not (type(v) is int and v > 0 if pattern is None else isinstance(v, str) and re.fullmatch(pattern, v)):
            raise Refused(key + ' is not valid', 'fix ' + key + ' as `driver schema` shows')
    return req


def command(req, woken):
    if os.environ.get('OPENWIZ_TEMPLATE_LIVE') != '1':
        raise Refused('the template starts no harness unless OPENWIZ_TEMPLATE_LIVE=1 is set',
                      'write your own command for your harness, '
                      'or set OPENWIZ_TEMPLATE_LIVE=1 on purpose for a live check')
    what = 'You were woken: read the ticket again and carry on' if woken else 'Build the ticket'
    prompt = '%s: %s#%d, with the %s skill.' % (what, req['repository'], req['ticket'], req['skill'])
    effort = [EFFORTS[req['harness']][0], req['effort']] if 'effort' in req else []
    return [req['harness'], '--model', req['model']] + effort + ['-p', prompt]


LINUX = os.path.isdir('/proc/self') and hasattr(os, 'pidfd_open')
PR_SET_CHILD_SUBREAPER = 36


def ps(*args):
    try:
        p = subprocess.Popen(['ps'] + list(args), stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                             stderr=subprocess.PIPE, text=True)
        out, err = p.communicate(timeout=30)
    except (OSError, subprocess.TimeoutExpired) as e:
        raise OSError('ps did not run: %s' % e)
    if p.returncode and err.strip():
        raise OSError('ps failed: %s' % err.strip()[:100])
    return out.splitlines(), p.pid


MACOS_SECONDS_BETWEEN_LOOKS = 0.2
LOOKS_PER_OUTPUT_CHECK = 5


# PRIVACY: reads only ps's process table (pid, parent, group, state, start time), never any environment.
def members(roots, recorded, writers=()):
    rows, me = ps('-A', '-o', 'pid=', '-o', 'ppid=', '-o', 'pgid=', '-o', 'stat=', '-o', 'lstart=')
    started, children, found = {}, {}, set()
    for row in rows:
        f = row.split(None, 4)
        if len(f) < 5 or f[3].startswith('Z'):
            continue
        pid, ppid, group = int(f[0]), int(f[1]), int(f[2])
        started[pid] = f[4].strip()
        children.setdefault(ppid, []).append(pid)
        if group in roots or recorded.get(pid) == started[pid] or pid in writers:
            found.add(pid)
    todo = list(roots) + list(found)
    while todo:
        for c in children.get(todo.pop(), []):
            if c not in found:
                found.add(c)
                todo.append(c)
    return {p: started[p] for p in found - set(roots) - {os.getpid(), me}}


# PRIVACY: asks lsof only which processes hold this run's own output file open for writing, never any environment.
# PRIVACY: lsof's own text is never repeated.
def writing_to(path):
    if not os.path.exists(path):
        return set()
    try:
        p = subprocess.run(['lsof', '-w', '-F', 'pa', '--', path], stdin=subprocess.DEVNULL, capture_output=True,
                           text=True, errors='replace', timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        p = None
    if p is None or p.returncode not in (0, 1) or p.returncode == 1 and p.stderr.strip():
        LSOF_COULD_NOT_CHECK.append(path)
        return set()
    out = p.stdout
    found, pid = set(), None
    for field in out.splitlines():
        if field[:1] == 'p' and field[1:].isdigit():
            pid = int(field[1:])
        elif field[:1] == 'a' and field[1:2] in ('w', 'u') and pid is not None:
            found.add(pid)
    return found


def turn_output(run, supervisor):
    return os.path.join(STATE, '%s.%d.out' % (run, supervisor))


def supervisor_record(run, supervisor):
    return os.path.join(STATE, '%s.%d.sup' % (run, supervisor))


def record_kept(run, kept):
    record = supervisor_record(run, os.getpid())
    try:
        with open(record + '.new', 'w') as f:
            json.dump({'supervisor_since': since(os.getpid()), 'kept': {str(p): t for p, t in kept.items()}}, f)
        os.replace(record + '.new', record)
    except OSError:
        pass


def lsof_failed_record(run, supervisor):
    return os.path.join(STATE, '%s.%d.nolsof' % (run, supervisor))


def record_lsof_failed(run):
    try:
        with open(lsof_failed_record(run, os.getpid()), 'w') as f:
            json.dump({'supervisor_since': since(os.getpid())}, f)
        return True
    except OSError:
        return False


def lsof_failed_in(run, supervisors):
    for pid, started in supervisors:
        try:
            with open(lsof_failed_record(run, pid)) as f:
                if json.load(f)['supervisor_since'] == started:
                    return True
        except FileNotFoundError:
            continue
        except (OSError, ValueError, KeyError, TypeError):
            return True
    return False


def recorded_by(run, supervisors):
    recorded = {}
    for pid, started in supervisors:
        try:
            with open(supervisor_record(run, pid)) as f:
                record = json.load(f)
            if record['supervisor_since'] == started:
                recorded.update({int(p): t for p, t in record['kept'].items() if isinstance(t, str)})
        except (OSError, ValueError, KeyError, TypeError, AttributeError):
            continue
    return recorded


def look_after_the_turn_on_macos(run, output):
    kept, looks, marked = {}, 0, False
    while True:
        children_left = any_child_running_after_reaping()
        scanned = looks % LOOKS_PER_OUTPUT_CHECK == 0
        now = members({os.getpid()}, kept, writing_to(output) if scanned else ())
        if not children_left and not now and not scanned:
            now = members({os.getpid()}, kept, writing_to(output))
        looks += 1
        if LSOF_COULD_NOT_CHECK and not marked:
            marked = record_lsof_failed(run)
        if now != kept:
            kept = now
            record_kept(run, kept)
        if not children_left and not kept:
            try:
                os.remove(supervisor_record(run, os.getpid()))
            except OSError:
                pass
            return
        time.sleep(MACOS_SECONDS_BETWEEN_LOOKS)


def since(pid):
    if not LINUX:
        row = ps('-o', 'stat=', '-o', 'lstart=', '-p', str(pid))[0]
        return row[0].split(None, 1)[1].strip() if row and not row[0].lstrip().startswith('Z') else None
    try:
        with open('/proc/%d/stat' % pid) as f:
            fields = f.read().rpartition(')')[2].split()
    except OSError:
        return None
    return None if fields[0] == 'Z' else int(fields[19])


def descendants(pid):
    children = {}
    for p in filter(str.isdigit, os.listdir('/proc')):
        try:
            with open('/proc/%s/stat' % p) as f:
                fields = f.read().rpartition(')')[2].split()
        except OSError:
            continue
        if fields[0] != 'Z':
            children.setdefault(int(fields[1]), []).append(int(p))
    found, todo = set(), [pid]
    while todo:
        for c in children.get(todo.pop(), []):
            if c not in found:
                found.add(c)
                todo.append(c)
    return found


def supervise(cmd):
    if LINUX and ctypes.CDLL(None, use_errno=True).prctl(PR_SET_CHILD_SUBREAPER, 1, 0, 0, 0) != 0:
        print(json.dumps({'error': 'this host cannot keep a turn\'s processes together'}), flush=True)
        return
    output = turn_output(os.environ['OPENWIZ_RUN'], os.getpid())
    try:
        out = subprocess.DEVNULL if LINUX else os.open(output, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
        harness = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=out, stderr=out)
        if out != subprocess.DEVNULL:
            os.close(out)
    except OSError as e:
        print(json.dumps({'error': e.strerror}), flush=True)
        return
    signal.signal(signal.SIGTERM, signal.SIG_IGN)
    print(json.dumps({'pid': harness.pid, 'since': since(harness.pid)}), flush=True)
    os.dup2(os.open(os.devnull, os.O_WRONLY), 1)
    if not LINUX:
        return look_after_the_turn_on_macos(os.environ['OPENWIZ_RUN'], output)
    while True:
        try:
            os.wait()
        except ChildProcessError:
            return


def any_child_running_after_reaping():
    while True:
        try:
            if os.waitpid(-1, os.WNOHANG)[0] == 0:
                return True
        except ChildProcessError:
            return False


def launch(req, run, woken):
    cmd = command(req, woken)
    if not shutil.which(req['harness']):
        raise Refused('harness %s is not installed here' % req['harness'],
                      'install %s and sign in to it yourself, then start again' % req['harness'])
    try:
        sup = subprocess.Popen([sys.executable, '-I', os.path.abspath(__file__), '--turn'] + cmd,
                               env=dict(os.environ, OPENWIZ_RUN=run), start_new_session=True,
                               stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        with sup.stdout:
            line = sup.stdout.readline()
    except OSError as e:
        raise Refused('harness %s did not start: %s' % (req['harness'], e.strerror), 'check that it runs by hand')
    try:
        turn = json.loads(line)
    except ValueError:
        turn = {'error': 'its supervisor did not answer'}
    if 'pid' not in turn:
        raise Refused('harness %s did not start: %s' % (req['harness'], turn['error']), 'check that it runs by hand')
    return {'pid': turn['pid'], 'since': turn['since'], 'supervisor': sup.pid, 'supervisor_since': since(sup.pid)}


def running(turn, run):
    return bool(turn) and turn['since'] is not None and since(turn['pid']) == turn['since']


def legacy_turns(turns):
    return isinstance(turns, list) and bool(turns) and any(not isinstance(t, dict) for t in turns)


def format_pids(pids):
    ordered = sorted(pids)
    shown = ', '.join(str(p) for p in ordered[:10])
    return shown + (' (and %d more)' % (len(ordered) - 10) if len(ordered) > 10 else '')


def proc_table(run):
    try:
        entries = os.listdir('/proc')
    except OSError:
        raise Refused('run %s could not be checked because /proc is not readable' % run,
                      'check and end processes carrying OPENWIZ_RUN=%s by hand' % run)
    table, children = {}, {}
    for name in entries:
        if not name.isdigit():
            continue
        pid = int(name)
        try:
            with open('/proc/%d/stat' % pid) as f:
                fields = f.read().rpartition(')')[2].split()
        except OSError:
            continue
        if len(fields) < 20 or fields[0] == 'Z':
            continue
        ppid, pgid, sid, started = int(fields[1]), int(fields[2]), int(fields[3]), int(fields[19])
        table[pid] = (ppid, pgid, sid, started)
        children.setdefault(ppid, []).append(pid)
    return table, children


# PRIVACY: legacy pre-#1590 records store only turn pids; read /proc/<pid>/environ only for candidates
# already tied to those turns' pids, process groups or sessions to verify OPENWIZ_RUN, never repeating it.
def scan_legacy(turn_ids, run, mark, tracked, verified_groups, verified_sessions, checked_unmarked):
    table, children = proc_table(run)
    self_chain, cur = set(), os.getpid()
    while cur in table and cur not in self_chain:
        self_chain.add(cur)
        cur = table[cur][0]
    for p in [p for p, st in tracked.items() if p not in table or table[p][3] != st]:
        del tracked[p]
    live_groups = {pgid for _, pgid, _, _ in table.values()}
    live_sessions = {sid for _, _, sid, _ in table.values()}
    verified_groups &= live_groups
    verified_sessions &= live_sessions
    unreadable = set()
    for p, (_, pgid, sid, st) in table.items():
        if p in self_chain or p in tracked or (p, st) in checked_unmarked:
            continue
        if p not in turn_ids and pgid not in turn_ids and sid not in turn_ids:
            continue
        try:
            with open('/proc/%d/environ' % p, 'rb') as f:
                raw = f.read()
        except (FileNotFoundError, ProcessLookupError):
            continue
        except PermissionError:
            try:
                if os.stat('/proc/%d' % p).st_uid != os.geteuid():
                    checked_unmarked.add((p, st))
                else:
                    unreadable.add(p)
            except OSError:
                pass
            continue
        except OSError:
            if since(p) == st:
                unreadable.add(p)
            continue
        if since(p) != st:
            continue
        if mark in raw.split(b'\0'):
            tracked[p] = st
            if pgid in turn_ids:
                verified_groups.add(pgid)
            if sid in turn_ids:
                verified_sessions.add(sid)
        else:
            checked_unmarked.add((p, st))
    for p, (_, pgid, sid, st) in table.items():
        if p not in self_chain and (pgid in verified_groups or sid in verified_sessions):
            tracked[p] = st
    todo = list(tracked)
    while todo:
        for c in children.get(todo.pop(), ()):
            if c not in tracked and c not in self_chain and c in table:
                tracked[c] = table[c][3]
                todo.append(c)
    return unreadable - set(tracked)


def signal_pinned(targets, sig, sent):
    pinned = {}
    for p, st in targets.items():
        if (p, st) in sent:
            continue
        try:
            pinned[p] = (os.pidfd_open(p), st)
        except OSError:
            pass
    for p, (fd, st) in pinned.items():
        try:
            if since(p) == st:
                signal.pidfd_send_signal(fd, sig)
                sent.add((p, st))
        except OSError:
            pass
        finally:
            os.close(fd)


def end_legacy(turns, run, already_stopped=False):
    if not all(type(pid) is int and pid > 0 for pid in turns):
        raise Refused('run %s was saved by an older template and a turn is not a pid, so it was not stopped' % run,
                      'end its processes by hand')
    if not LINUX:
        if already_stopped:
            return
        raise Refused('run %s was saved by an older template and this host cannot confirm its processes ended' % run,
                      'stop it on Linux, or end processes carrying OPENWIZ_RUN=%s by hand' % run)
    turn_ids, mark = set(turns), ('OPENWIZ_RUN=' + run).encode()
    tracked, verified_groups, verified_sessions, checked_unmarked = {}, set(), set(), set()
    for sig, wait in ((signal.SIGTERM, GRACE), (signal.SIGKILL, KILL_GRACE)):
        sent, deadline = set(), time.monotonic() + wait
        while True:
            unreadable = scan_legacy(turn_ids, run, mark, tracked, verified_groups, verified_sessions, checked_unmarked)
            if not tracked:
                if unreadable:
                    raise Refused('run %s has processes the driver cannot inspect to confirm it stopped' % run,
                                  'check and end these processes by hand: %s' % format_pids(unreadable))
                return
            signal_pinned(tracked, sig, sent)
            if time.monotonic() >= deadline:
                break
            time.sleep(min(0.1, max(0, deadline - time.monotonic())))
    unreadable = scan_legacy(turn_ids, run, mark, tracked, verified_groups, verified_sessions, checked_unmarked)
    if not tracked and not unreadable:
        return
    if not tracked:
        raise Refused('run %s has processes the driver cannot inspect to confirm it stopped' % run,
                      'check and end these processes by hand: %s' % format_pids(unreadable))
    raise Refused('run %s still has processes after stop' % run,
                  'stop it again, or end these processes by hand: %s' % format_pids(tracked))


def end(turns, run):
    kept = [(t['supervisor'], t['supervisor_since']) for t in turns if t and t['supervisor_since'] is not None]
    if lsof_failed_in(run, kept):
        LSOF_COULD_NOT_CHECK.append(run)
    for sig, wait in ((signal.SIGTERM, GRACE), (signal.SIGKILL, KILL_GRACE)):
        sent, deadline = set(), time.monotonic() + wait
        while time.monotonic() < deadline:
            kept = [(p, t) for p, t in kept if since(p) == t]
            if not kept:
                return
            if not LINUX:
                writers = set().union(*(writing_to(turn_output(run, s)) for s, _ in kept))
                for p in set(members({s for s, _ in kept}, recorded_by(run, kept), writers)) - sent:
                    try:
                        os.kill(p, sig)
                        sent.add(p)
                    except OSError:
                        pass
                time.sleep(0.1)
                continue
            pinned = {}
            for p in set().union(*(descendants(s) for s, _ in kept)) - sent:
                try:
                    pinned[p] = os.pidfd_open(p)
                except OSError:
                    pass
            under = set().union(*(descendants(s) for s, _ in kept))
            for p, fd in pinned.items():
                try:
                    if p in under:
                        sent.add(p)
                        signal.pidfd_send_signal(fd, sig)
                except OSError:
                    pass
                finally:
                    os.close(fd)
            time.sleep(0.1)
    raise Refused('run %s still has processes after stop' % run,
                  'stop it again, or end its processes by hand: they run under process %s'
                  % ', '.join(str(p) for p, _ in kept))


def lock(run):
    if not os.path.exists(os.path.join(STATE, run + '.json')):
        raise Refused('no run ' + run, 'check the run id that `driver start` printed')
    try:
        fcntl.flock(os.open(os.path.join(STATE, run + '.lock'), os.O_RDONLY | os.O_CREAT, 0o600), fcntl.LOCK_EX)
    except OSError:
        raise Refused('the driver cannot lock run %s in its state folder' % run,
                      'make OPENWIZ_TEMPLATE_STATE (or ~/.local/state/openwiz-template) a folder you can write')


def saved(run, state=None):
    path = os.path.join(STATE, run + '.json')
    if state is not None:
        os.makedirs(STATE, mode=0o700, exist_ok=True)
        with open(path + '.new', 'w') as f:
            json.dump(state, f)
        os.replace(path + '.new', path)
        return state
    try:
        with open(path) as f:
            return json.load(f)
    except FileNotFoundError:
        raise Refused('no run ' + run, 'check the run id that `driver start` printed')


def unsaved(run, turn, cmd):
    try:
        end([turn], run)
    except Refused:
        raise Refused('run %s began a turn it could not save, and could not confirm the turn ended; its outcome is '
                      'unknown' % run, 'end process %d and everything under it by hand, and read the ticket for '
                      'what its agent did, before you %s it again' % (turn['supervisor'], cmd))
    raise Refused('run %s began a turn it could not save, so the driver ended it; its outcome is unknown' % run,
                  'read the ticket for what its agent did before you %s it again' % cmd)


def answer(cmd):
    if cmd == 'version':
        return VERSION
    if cmd == 'schema':
        with open(os.path.join(HERE, 'schema.json')) as f:
            return json.load(f)
    if cmd == 'start':
        req, run = read(dict(START, **EFFORT) if 'effort' in VERSION['can'] else START), 'run-' + secrets.token_hex(6)
        if 'effort' in req and req['effort'] not in EFFORTS.get(req['harness'], (None, ()))[1]:
            raise Refused('harness %s cannot run at effort %s' % (req['harness'], req['effort']), CANT_SET_EFFORT)
        state = {'request': req, 'turns': [], 'stopped': False, 'starting': True}
        try:
            saved(run, state)
            os.close(os.open(os.path.join(STATE, run + '.lock'), os.O_WRONLY | os.O_CREAT, 0o600))
        except OSError:
            raise Refused('the driver cannot save runs in its state folder; nothing was started',
                          'make OPENWIZ_TEMPLATE_STATE (or ~/.local/state/openwiz-template) a folder you can write')
        try:
            turn = launch(req, run, False)
        except Refused:
            try:
                saved(run, dict(state, stopped=True))
            except OSError:
                pass
            raise
        try:
            saved(run, dict(state, turns=[turn], starting=False))
        except OSError:
            unsaved(run, turn, 'start')
        return {'run': run}
    if cmd in ('wake', 'stop'):
        run = read(RUN)['run']
        lock(run)
        state = saved(run)
        if cmd == 'stop':
            if legacy_turns(state['turns']):
                end_legacy(state['turns'], run, state.get('stopped'))
                try:
                    saved(run, dict(state, stopped=True))
                except OSError:
                    raise Refused('run %s has ended, but the driver could not save that it is stopped' % run,
                                  'make OPENWIZ_TEMPLATE_STATE (or ~/.local/state/openwiz-template) a folder you can '
                                  'write, then stop it again')
                return {'run': run, 'stopped': True}
            try:
                saved(run, dict(state, stopped=True))
                kept = True
            except OSError:
                kept = False
            end(state['turns'], run)
            for name in (n for t in state['turns'] if t
                         for n in (lsof_failed_record(run, t['supervisor']), turn_output(run, t['supervisor']))):
                try:
                    os.remove(name)
                except OSError:
                    pass
            if not kept:
                raise Refused('run %s has ended, but the driver could not save that it is stopped' % run,
                              'make OPENWIZ_TEMPLATE_STATE (or ~/.local/state/openwiz-template) a folder you can '
                              'write, then stop it again')
            return {'run': run, 'stopped': True}
        if state['stopped']:
            raise Refused('run %s is stopped' % run, 'start a new run')
        if legacy_turns(state['turns']):
            raise Refused('run %s was saved by an older template, so it was not woken' % run,
                          'stop it, then start a new run')
        if state.get('starting'):
            raise Refused('run %s never finished starting' % run, 'stop it, then start a new run')
        if state['turns'] and running(state['turns'][-1], run):
            return {'run': run, 'woke': True}
        try:
            saved(run, state)
        except OSError:
            raise Refused('the driver cannot save run %s; nothing was started' % run,
                          'make OPENWIZ_TEMPLATE_STATE (or ~/.local/state/openwiz-template) a folder you can write')
        turn = launch(state['request'], run, True)
        try:
            saved(run, dict(state, turns=state['turns'] + [turn]))
        except OSError:
            unsaved(run, turn, 'wake')
        return {'run': run, 'woke': True}
    raise Refused('unknown command', 'run one of: version, schema, start, wake, stop')


def main():
    if len(sys.argv) > 2 and sys.argv[1] == '--turn':
        return supervise(sys.argv[2:])
    try:
        out, code = answer(sys.argv[1] if len(sys.argv) == 2 else ''), 0
    except Refused as e:
        out, code = {'error': e.args[0], 'next': e.args[1]}, 1
    except Exception as e:
        out, code = {'error': 'the driver failed: ' + type(e).__name__, 'next': 'read its code, fix it, retry'}, 1
    if LSOF_COULD_NOT_CHECK:
        print(NO_LSOF, file=sys.stderr)
    print(json.dumps(out))
    sys.exit(code)


if __name__ == '__main__':
    main()
