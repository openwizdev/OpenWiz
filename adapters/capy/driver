#!/usr/bin/env python3
# SECURITY: driver v1 N4. Every Capy call goes through the kit's key helper, which alone reads the key and picks the
# address; this driver sends it only a host name, a method, a path and a body, and never names, reads or prints the
# key. It shows no text the host answered: each error names only the status, the method and the path.
import fcntl, json, os, re, subprocess, sys, time, uuid
sys.dont_write_bytecode = True

HERE = os.path.dirname(os.path.abspath(__file__))
HELPER = os.path.realpath(os.path.join(HERE, '..', '..', 'kernel', 'driver-kit', 'hostkey.py'))
HOST = 'capy'
VERSION = {'driver': 'capy', 'records': ['openwiz:records v1'], 'can': ['start', 'wake', 'stop', 'effort']}
START = {'repository': r'[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}', 'ticket': None,
         'skill': r'(?=.{1,60}$)[a-z0-9]+(-[a-z0-9]+)*', 'harness': r'[a-z0-9][a-z0-9._-]{0,59}',
         'model': r'(?=.{1,100}$)[A-Za-z0-9][A-Za-z0-9 ._:@+-]*(/[A-Za-z0-9][A-Za-z0-9 ._:@+-]*)*'}
RUN = {'run': r'[A-Za-z0-9][A-Za-z0-9_-]{0,99}'}
EFFORT = r'[a-z][a-z0-9-]{0,19}'
PROJECT = r'[A-Za-z0-9][A-Za-z0-9_.:-]{0,190}'
PROVIDERS = {'claude': 'anthropic', 'claude-code': 'anthropic', 'codex': 'openai'}
POLL = float(os.environ.get('OPENWIZ_CAPY_POLL') or 3)
WAIT_AT_MOST = 30
STATE = os.environ.get('OPENWIZ_CAPY_STATE') or os.path.expanduser('~/.local/state/openwiz/capy')
UNSENT = tuple('the key helper refused: ' + why for why in (
    'no key in either ', 'the key in ', "the kit's fake host gave no test key", 'the request holds the key',
    'OPENWIZ_HOSTKEY_TEST_ORIGIN is not'))
NO_EFFORT = ("this host can't set effort: remove the effort for this harness in your Models table or Roster to run it "
             "at the host's default")
WOKEN = 'You were woken: read the ticket again and carry on.'
STOPPED = 'start a new run'
UNSURE = 'open the run in Capy to see its state, then retry'
# External: the shapes below are Capy's documented answers (https://docs.capy.ai/openapi.json): every field a
# schema requires; a field Capy adds later is ignored. An answer off its shape is never read as success or absence.
REASONING = ('none', 'instant', 'minimal', 'low', 'medium', 'high', 'xhigh', 'max')
STATUSES = ('working', 'waiting', 'idle', 'failed', 'archived')
THREAD = set('id projectId authorId previousAuthorId title titleCustom status archived lastModelId queuedAt linearIssue '
             'pullRequestAuthor usage createdAt updatedAt lastActivityAt hasUnreads mentionCount owed member'.split())
PROJECT_KEYS = set('id name description code visibility repos createdAt updatedAt'.split())
MODEL_KEYS = set('id name billing route reasoningModes fast pro ultrafast'.split())


class Refused(Exception):
    pass


def unique(pairs):
    if len({k for k, _ in pairs}) != len(pairs):
        raise Refused('a key is repeated', 'send each key once')
    return dict(pairs)


def read(fields):
    try:
        req = json.loads(sys.stdin.read(), object_pairs_hook=unique)
    except ValueError:
        raise Refused('the input is not JSON', 'send one JSON object on stdin, as `driver schema` shows')
    optional = {'effort': EFFORT} if fields is START else {}
    if not isinstance(req, dict) or not set(fields) <= set(req) <= set(fields) | set(optional):
        raise Refused('the input needs exactly ' + ', '.join(fields) + (', and optionally effort' if optional else ''),
                      'send only those fields; never a login')
    for key, pattern in dict(fields, **optional).items():
        if key not in req:
            continue
        v = req[key]
        if not (type(v) is int and v > 0 if pattern is None else isinstance(v, str) and re.fullmatch(pattern, v)):
            raise Refused(key + ' is not valid', 'fix ' + key + ' as `driver schema` shows')
    return req


def ask(method, path, body=None, also=()):
    request = {'host': HOST, 'method': method, 'path': path}
    if body is not None:
        request['body'] = body
    try:
        p = subprocess.run([sys.executable, '-I', HELPER], input=json.dumps(request), capture_output=True,
                           text=True, timeout=110)
        out = json.loads(p.stdout)
    except (OSError, subprocess.TimeoutExpired, ValueError):
        raise Refused('the key helper gave no answer', 'run kernel/driver-kit/hostkey.py by hand to see why')
    if p.returncode:
        raise Refused('the key helper refused: ' + out['error'], out['next'])
    if not (200 <= out['status'] < 300 or out['status'] in also):
        raise Refused('Capy answered %d to %s %s' % (out['status'], method, path),
                      'check your key and Capy\'s status, then retry')
    return out['status'], out['body']


def obj(value):
    return value if isinstance(value, dict) else {}


def shaped(value, required):
    return isinstance(value, dict) and set(required) <= set(value)


def fit(line, fallback):
    return line if len(line) <= 300 else fallback


def a_thread(value, run, receipt=()):
    # External: an archived thread doesn't run (https://docs.capy.ai/threads#archive-a-thread), so a running archived one
    # is not a state the driver can read.
    if not (shaped(value, THREAD | set(receipt)) and value['id'] == run and value['status'] in STATUSES
            and type(value['archived']) is bool and (value['projectId'] is None or isinstance(value['projectId'], str))):
        return None
    if value['archived'] and value['status'] in ('working', 'waiting') or value['status'] == 'archived' and not value[
            'archived']:
        return None
    return value


def admitted(status, value):
    return status == 200 and shaped(value, {'id', 'deduped'}) and isinstance(value['id'], str) and len(
        value['id']) == 26 and type(value['deduped']) is bool


def no_effort(req):
    return Refused('Capy cannot run %s (model %s) at effort %s' % (req['harness'], req['model'], req['effort']),
                   NO_EFFORT)


def project(repository):
    chosen = os.environ.get('CAPY_PROJECT_ID')
    if chosen is not None:
        if not re.fullmatch(PROJECT, chosen):
            raise Refused('CAPY_PROJECT_ID is not a Capy project id',
                          'set CAPY_PROJECT_ID to a project id from Capy\'s Settings, Projects & setup, or unset it')
        return chosen
    status, listed = ask('GET', '/api/v1/projects')
    items = listed['items'] if status == 200 and shaped(listed, {'items'}) else None
    if not (isinstance(items, list) and all(
            shaped(p, PROJECT_KEYS) and isinstance(p['id'], str) and re.fullmatch(PROJECT, p['id'])
            and isinstance(p['repos'], list) and all(
                shaped(r, {'repoFullName', 'baseBranch', 'mode'}) and isinstance(r['repoFullName'], str)
                and isinstance(r['baseBranch'], str) and r['mode'] in ('primary', 'lazy') for r in p['repos'])
            for p in items)):
        raise Refused('Capy answered GET /api/v1/projects in a shape the driver cannot read',
                      'set CAPY_PROJECT_ID to the project to run it in (Settings, Projects & setup), then start again')
    lists = [p['id'] for p in items if any(r['repoFullName'].lower() == repository.lower() for r in p['repos'])]
    if len(lists) > 1:
        raise Refused('more than one Capy project lists ' + repository,
                      'set CAPY_PROJECT_ID to the project to run it in, then start again')
    if not lists:
        raise Refused('no Capy project lists ' + repository,
                      'add the repository to one Capy project (Settings, Projects & setup), or set CAPY_PROJECT_ID to '
                      'the project to run it in, then start again')
    return lists[0]


def rejected(req, model):
    status, listed = ask('GET', '/api/v1/models')
    items = listed['items'] if status == 200 and shaped(listed, {'items', 'default'}) and isinstance(
        listed['default'], dict) else None
    found = [m for m in items if shaped(m, MODEL_KEYS) and m['id'] == model['modelId']] if isinstance(
        items, list) and all(shaped(m, MODEL_KEYS) and isinstance(m['id'], str) and isinstance(
            m['reasoningModes'], list) and all(r in REASONING for r in m['reasoningModes']) for m in items) else None
    if found is None or len(found) > 1:
        raise Refused('Capy refused model %s%s, and answered GET /api/v1/models in a shape the driver cannot read'
                      % (model['modelId'], ' at effort ' + req['effort'] if 'effort' in req else ''),
                      'check the model and its effort in Capy\'s Settings, Models, then start again')
    if found and 'reasoningMode' in model and model['reasoningMode'] not in found[0]['reasoningModes']:
        raise no_effort(req)
    raise Refused('Capy cannot run model %s for this key' % model['modelId'],
                  'pick a model Capy lists for your key (Settings, Models), or connect the subscription that serves '
                  'it, then start again')


def model_id(req):
    provider = PROVIDERS[req['harness']]
    if '/' not in req['model']:
        return provider + '/' + req['model']
    if req['model'].partition('/')[0] != provider:
        raise Refused('model %s is not an %s model, as harness %s needs' % (req['model'], provider, req['harness']),
                      'name the model bare, or as %s/<model>' % provider)
    return req['model']


def waited(got):
    if not (shaped(got, {'_tag', 'retryAfterSeconds'}) and got['_tag'] == 'capy/RateLimited'
            and type(got['retryAfterSeconds']) is int and got['retryAfterSeconds'] >= 0):
        return POLL
    if got['retryAfterSeconds'] > WAIT_AT_MOST:
        raise Refused('Capy answered 429 to POST /api/v1/threads and asked to wait %d seconds'
                      % got['retryAfterSeconds'], 'wait that long, then start again')
    return got['retryAfterSeconds']


def create(req):
    model = {'modelId': model_id(req)}
    if 'effort' in req:
        if req['effort'] not in REASONING:
            raise no_effort(req)
        model['reasoningMode'] = req['effort']
    title = 'OpenWiz: %s#%d' % (req['repository'], req['ticket'])
    # External: a resent create with the same requestId converges on the same Capy thread, never a second billable
    # run (https://docs.capy.ai/api-reference/overview#idempotency).
    body = {'requestId': str(uuid.uuid4()), 'projectId': project(req['repository']), 'title': title,
            'message': 'Build the ticket: %s#%d, with the %s skill.' % (req['repository'], req['ticket'], req['skill']),
            'model': model}
    lost = fit('archive the Capy thread titled %s if it is there, then start again' % title,
               'archive the Capy thread titled OpenWiz: <the repository>#<the ticket> if it is there, then start again')
    unsure = None
    for attempt in (1, 2):
        try:
            status, got = ask('POST', '/api/v1/threads', body, also=tuple(range(400, 600)))
        except Refused as e:
            if not unsure and e.args[0].startswith(UNSENT):
                raise
            status, got, unsure = None, None, unsure or e.args[0]
        if status is not None and status < 300:
            break
        if status is not None and status >= 500:
            unsure = unsure or 'Capy answered %d to POST /api/v1/threads' % status
        if unsure and attempt == 2:
            raise Refused(unsure + ', so a thread may have started', lost)
        if status == 429 and attempt == 2:
            raise Refused('Capy answered 429 to POST /api/v1/threads twice', 'wait a minute, then start again')
        if unsure or status == 429:
            time.sleep(POLL if unsure else waited(got))
            continue
        if status == 400 and shaped(got, {'_tag', 'message', 'candidates'}) and got[
                '_tag'] == 'ModelSelection.Rejected':
            rejected(req, model)
        raise Refused('Capy answered %d to POST /api/v1/threads' % status,
                      'check your key, your Capy project and the start\'s fields, then start again')
    run = obj(got).get('id')
    run = run if isinstance(run, str) and re.fullmatch(RUN['run'], run) else None
    found = a_thread(got, run) if run and status == 200 else None
    if not found or found['projectId'] not in (None, body['projectId']) or found['archived']:
        raise Refused('Capy answered POST /api/v1/threads in a shape the driver cannot read, so %s may have started'
                      % ('thread ' + run if run else 'a thread'), lost)
    return run


def thread(run):
    status, found = ask('GET', '/api/v1/threads/' + run, also=(404,))
    if status == 404 and shaped(found, {'_tag', 'threadId'}) and (found['_tag'], found['threadId']) == (
            'capy/ThreadNotFound', run):
        raise Refused('Capy has no run ' + run, STOPPED)
    if status != 200 or not a_thread(found, run):
        raise Refused('Capy answered %d to GET /api/v1/threads/%s in a shape the driver cannot read' % (status, run),
                      UNSURE)
    return found


def lock(run):
    # External: a message unarchives and wakes an archived Capy thread
    # (https://docs.capy.ai/threads#archive-is-dormant), so a wake and a stop of one run take turns on its lock.
    try:
        os.makedirs(STATE, mode=0o700, exist_ok=True)
        fcntl.flock(os.open(os.path.join(STATE, run + '.lock'), os.O_RDONLY | os.O_CREAT, 0o600), fcntl.LOCK_EX)
    except OSError:
        raise Refused('the driver cannot lock run ' + run,
                      'make OPENWIZ_CAPY_STATE (or ~/.local/state/openwiz/capy) a folder you can write')


def answer(cmd):
    if cmd == 'version':
        return VERSION
    if cmd == 'schema':
        with open(os.path.join(HERE, 'schema.json')) as f:
            return json.load(f)
    if cmd == 'start':
        req = read(START)
        if req['harness'] not in PROVIDERS and 'effort' in req:
            raise no_effort(req)
        if req['harness'] not in PROVIDERS:
            raise Refused('harness %s is not one Capy runs for OpenWiz' % req['harness'],
                          'use claude-code (or claude) or codex')
        return {'run': create(req)}
    if cmd == 'wake':
        run = read(RUN)['run']
        lock(run)
        if thread(run)['archived']:
            raise Refused('run %s is stopped' % run, STOPPED)
        if not admitted(*ask('POST', '/api/v1/threads/%s/message' % run, {'text': WOKEN, 'delivery': 'steer'})):
            raise Refused('Capy did not confirm it took the wake for run ' + run,
                          'open the run in Capy to see if the message arrived before you wake it again')
        return {'run': run, 'woke': True}
    if cmd == 'stop':
        run = read(RUN)['run']
        lock(run)
        if not thread(run)['archived']:
            if not admitted(*ask('POST', '/api/v1/threads/%s/interrupt' % run)):
                raise Refused('Capy did not confirm it interrupted run %s, so it may still be running' % run,
                              'stop the run in Capy itself, then stop it here again')
            status, got = ask('POST', '/api/v1/threads/%s/archive' % run)
            if not (status == 200 and a_thread(got, run, {'automation'}) and got['archived']):
                raise Refused('Capy did not confirm it archived run ' + run,
                              'archive the run in Capy itself, then stop it here again')
        return {'run': run, 'stopped': True}
    raise Refused('unknown command', 'run one of: version, schema, start, wake, stop')


def main():
    try:
        out, code = answer(sys.argv[1] if len(sys.argv) == 2 else ''), 0
    except Refused as e:
        out, code = {'error': e.args[0], 'next': e.args[1]}, 1
    except Exception as e:
        out, code = {'error': 'the driver failed: ' + type(e).__name__, 'next': 'read its code, fix it, retry'}, 1
    print(json.dumps(out))
    sys.exit(code)


if __name__ == '__main__':
    main()
