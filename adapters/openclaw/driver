#!/usr/bin/env python3
import ctypes, fcntl, json, os, re, secrets, select, shutil, signal, subprocess, sys, threading, time

HERE = os.path.dirname(os.path.abspath(__file__))
STATE = os.environ.get('OPENWIZ_OPENCLAW_STATE') or os.path.expanduser('~/.local/state/openwiz-openclaw')
VERSION = {'driver': 'openclaw', 'records': ['openwiz:records v1'], 'can': ['start', 'wake', 'stop']}
START = {'repository': r'[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}', 'ticket': None,
         'skill': r'(?=.{1,60}$)[a-z0-9]+(-[a-z0-9]+)*', 'harness': r'[a-z0-9][a-z0-9._-]{0,59}',
         'model': r'(?=.{1,100}$)[A-Za-z0-9][A-Za-z0-9 ._:@+-]*(/[A-Za-z0-9][A-Za-z0-9 ._:@+-]*)*'}
RUN = {'run': r'run-[0-9a-f]{12}'}
GRACE = 10
AGENTS = {'claude': 'npx -y --package=@agentclientprotocol/claude-agent-acp@^0.95.0 -- claude-agent-acp',
          'codex': 'npx -y --package=@agentclientprotocol/codex-acp@^1.1.5 -- codex-acp',
          'droid': 'droid exec --output-format acp', 'opencode': 'npx -y --package=opencode-ai -- opencode acp'}
POLICY = json.dumps({'autoApprove': ['read', 'search', 'edit', 'move', 'execute', 'think', 'fetch'],
                     'autoDeny': ['delete', 'switch_mode'], 'defaultAction': 'deny'}, separators=(',', ':'))
TTL = 60
STEP = 120
CREDENTIAL = re.compile(r'\b(?:[a-z_]*token|[a-z_]*key|secret|password|passwd|pwd|sig|signature|auth|credentials?)\s*='
                        r'|\b(?:password|passwd|secret|token)\s*:\s*\S|\bbearer\s+\S'
                        r'|gh[pousr]_[A-Za-z0-9]{8,}|github_pat_|AKIA[0-9A-Z]{16}|xox[abposr]-|sk-[A-Za-z0-9_-]{16,}',
                        re.I)


class Refused(Exception):
    pass


def unique(pairs):
    if len({k for k, _ in pairs}) != len(pairs):
        raise Refused('a key is repeated', 'send each key once')
    return dict(pairs)


def read(fields):
    try:
        req = json.loads(sys.stdin.read(), object_pairs_hook=unique)
    except ValueError:
        raise Refused('the input is not JSON', 'send one JSON object on stdin, as `driver schema` shows')
    if not isinstance(req, dict) or set(req) != set(fields):
        raise Refused('the input needs exactly ' + ', '.join(fields), 'send only those fields; never a login')
    for key, pattern in fields.items():
        v = req[key]
        if not (type(v) is int and v > 0 if pattern is None else isinstance(v, str) and re.fullmatch(pattern, v)):
            raise Refused(key + ' is not valid', 'fix ' + key + ' as `driver schema` shows')
        if isinstance(v, str) and CREDENTIAL.search(v):
            raise Refused(key + ' looks like a login or token, so nothing was saved or started',
                          'never send a login or token: the driver uses your own sign-ins on this machine')
    return req


class Project(Refused):
    pass


def escape(text):
    return ''.join('\\' + c for c in text)


def acpx(run, *args, harness):
    work = os.path.abspath(os.path.join(STATE, 'work', run))
    project = os.path.join(work, '.acpxrc.json')
    if os.path.lexists(project):
        raise Project('the run\'s folder holds %s, an acpx project config, so acpx was not run' % project,
                      'delete that file without opening it (the driver never reads it), then try again')
    folder = os.path.abspath(os.path.join(STATE, 'acpx', run))
    os.makedirs(folder, mode=0o700, exist_ok=True)
    launch = os.path.join(folder, '.acpxrc.json')
    if os.path.lexists(launch):
        raise Project('the acpx launch folder holds %s, an acpx project config, so acpx was not run' % launch,
                      'delete that file without opening it (the driver never reads it), then try again')
    cmd = [os.path.realpath(sys.executable), '-I', os.path.abspath(__file__), '--acp', os.path.expanduser('~'), work,
           folder, '--']
    agent = ' '.join(escape(part) for part in cmd + AGENTS[harness].split())
    return ['acpx', '--cwd', folder, '--agent', agent] + list(args)


def rewrite_to_agent(line, work, launch):
    try:
        msg = json.loads(line)
    except ValueError:
        return line
    if not isinstance(msg, dict):
        return line
    params = msg.get('params')
    if msg.get('method') in ('session/new', 'session/load', 'session/resume') and isinstance(params, dict):
        cwd = params.get('cwd')
        if isinstance(cwd, str) and os.path.normpath(cwd) == launch:
            params['cwd'] = work
            return (json.dumps(msg, separators=(',', ':')) + '\n').encode('utf-8')
    return line


def rewrite_to_client(line, work, launch):
    try:
        msg = json.loads(line)
    except ValueError:
        return line, None
    if not isinstance(msg, dict):
        return line, None
    method, params = msg.get('method'), msg.get('params')
    if not isinstance(params, dict):
        return line, None
    if method in ('fs/read_text_file', 'fs/write_text_file') and isinstance(params.get('path'), str):
        norm = os.path.normpath(params['path'])
        real_work = os.path.join(launch, 'work')
        if norm == work or norm.startswith(work + os.sep):
            rel = os.path.relpath(norm, work)
            params['path'] = real_work if rel == '.' else os.path.join(real_work, rel)
            return (json.dumps(msg, separators=(',', ':')) + '\n').encode('utf-8'), None
        if (norm == launch or norm.startswith(launch + os.sep)) and not (
                norm == real_work or norm.startswith(real_work + os.sep)):
            if 'id' in msg:
                err = {'jsonrpc': '2.0', 'id': msg['id'],
                       'error': {'code': -32602, 'message': 'path is outside the work folder'}}
                return None, (json.dumps(err, separators=(',', ':')) + '\n').encode('utf-8')
            return None, None
    elif method == 'terminal/create':
        cwd = params.get('cwd')
        if cwd in (None, '') or (isinstance(cwd, str) and os.path.normpath(cwd) == launch):
            params['cwd'] = work
            return (json.dumps(msg, separators=(',', ':')) + '\n').encode('utf-8'), None
    return line, None


def relay(home, work, launch, cmd):
    work, launch = os.path.abspath(work), os.path.abspath(launch)
    try:
        child = subprocess.Popen(cmd, cwd=work, env=dict(os.environ, HOME=home),
                                 stdin=subprocess.PIPE, stdout=subprocess.PIPE)
    except OSError:
        sys.exit(127)
    for sig in (signal.SIGTERM, signal.SIGINT):
        signal.signal(sig, lambda signum, _: child.send_signal(signum) if child.poll() is None else None)
    stdin_lock = threading.Lock()

    def send(data):
        with stdin_lock:
            if not child.stdin.closed:
                child.stdin.write(data)
                child.stdin.flush()

    def to_agent():
        try:
            while True:
                line = sys.stdin.buffer.readline()
                if not line:
                    break
                send(rewrite_to_agent(line, work, launch))
        except OSError:
            pass
        finally:
            try:
                with stdin_lock:
                    child.stdin.close()
            except OSError:
                pass

    threading.Thread(target=to_agent, daemon=True).start()
    try:
        while True:
            line = child.stdout.readline()
            if not line:
                break
            out, reply = rewrite_to_client(line, work, launch)
            if reply is not None:
                send(reply)
            elif out is not None:
                sys.stdout.buffer.write(out)
                sys.stdout.buffer.flush()
    except OSError:
        pass
    rc = child.wait()
    sys.exit(128 - rc if rc < 0 else rc)


def opening(req, run):
    return acpx(run, '--model', req['model'], '--auth-policy', 'fail', '--permission-policy', POLICY,
                '--non-interactive-permissions', 'deny', harness=req['harness']) + ['sessions', 'new', '--name', run]


def command(req, woken, run):
    what = 'You were woken: read the ticket again and carry on' if woken else 'Build the ticket'
    prompt = '%s: %s#%d, with the %s skill.' % (what, req['repository'], req['ticket'], req['skill'])
    return acpx(run, '--auth-policy', 'fail', '--permission-policy', POLICY, '--non-interactive-permissions', 'deny',
                '--ttl', str(TTL), harness=req['harness']) + ['prompt', '-s', run, '--no-wait', prompt]


def since(pid):
    try:
        with open('/proc/%d/stat' % pid) as f:
            fields = f.read().rpartition(')')[2].split()
    except OSError:
        return None
    return None if fields[0] == 'Z' else int(fields[19])


def descendants(pid):
    children = {}
    for p in filter(str.isdigit, os.listdir('/proc')):
        try:
            with open('/proc/%s/stat' % p) as f:
                fields = f.read().rpartition(')')[2].split()
        except OSError:
            continue
        if fields[0] != 'Z':
            children.setdefault(int(fields[1]), []).append(int(p))
    found, todo = set(), [pid]
    while todo:
        for c in children.get(todo.pop(), []):
            if c not in found:
                found.add(c)
                todo.append(c)
    return found


def supervise(cmd):
    if ctypes.CDLL(None, use_errno=True).prctl(36, 1, 0, 0, 0) != 0:
        print(json.dumps({'error': 'this host cannot keep a turn\'s processes together'}), flush=True)
        return
    try:
        harness = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                   stderr=subprocess.DEVNULL)
    except OSError as e:
        print(json.dumps({'error': e.strerror}), flush=True)
        return
    signal.signal(signal.SIGTERM, signal.SIG_IGN)
    print(json.dumps({'pid': harness.pid, 'since': since(harness.pid)}), flush=True)
    while True:
        try:
            pid, status = os.wait()
        except ChildProcessError:
            return
        if pid == harness.pid:
            try:
                print(json.dumps({'exit': os.waitstatus_to_exitcode(status)}), flush=True)
            except OSError:
                pass
            os.dup2(os.open(os.devnull, os.O_WRONLY), 1)


def installed():
    if not shutil.which('acpx'):
        raise Refused('acpx is not installed here', 'install it with `npm install -g acpx`, sign in to your harness '
                      'yourself, then start again')


def supervised(cmd, run):
    installed()
    try:
        os.makedirs(os.path.join(STATE, 'home'), mode=0o700, exist_ok=True)
        sup = subprocess.Popen([sys.executable, '-I', os.path.abspath(__file__), '--turn'] + cmd,
                               env=dict(os.environ, OPENWIZ_RUN=run, HOME=os.path.join(STATE, 'home')),
                               start_new_session=True,
                               stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                               bufsize=0)
        line = sup.stdout.readline()
    except OSError as e:
        raise Refused('acpx did not start: %s' % e.strerror, 'check that `acpx --version` runs by hand')
    try:
        turn = json.loads(line)
    except ValueError:
        turn = {'error': 'its supervisor did not answer'}
    if 'pid' not in turn:
        sup.stdout.close()
        raise Refused('acpx did not start: %s' % turn['error'], 'check that `acpx --version` runs by hand')
    turn = {'pid': turn['pid'], 'since': turn['since'], 'supervisor': sup.pid, 'supervisor_since': since(sup.pid)}
    return sup, turn


def exit_code(sup):
    with sup.stdout:
        if select.select([sup.stdout], [], [], STEP)[0]:
            try:
                return json.loads(sup.stdout.readline())['exit']
            except (ValueError, KeyError, TypeError):
                pass
    return None


def launch(req, run, woken):
    sup, turn = supervised(command(req, woken, run), run)
    code = exit_code(sup)
    if code == 0:
        return turn
    end([turn], run)
    if code is None:
        raise Refused('acpx did not say whether it queued the prompt for run %s, so the driver ended it; its outcome '
                      'is unknown' % run, 'read the ticket for what its agent did before you try again')
    raise Refused('acpx refused the prompt for run %s (exit %d); nothing new was started' % (run, code),
                  'check that you are signed in to %s yourself and that acpx runs it by hand' % req['harness'])


def step(cmd, run):
    sup, turn = supervised(cmd, run)
    deadline, code = time.monotonic() + STEP, exit_code(sup)
    try:
        sup.wait(max(0, deadline - time.monotonic()))
    except subprocess.TimeoutExpired:
        end([turn], run)
        return None
    return code


def end(turns, run):
    kept = [(t['supervisor'], t['supervisor_since']) for t in turns if t and t['supervisor_since'] is not None]
    for sig, wait in ((signal.SIGTERM, GRACE), (signal.SIGKILL, 2)):
        sent, deadline = set(), time.monotonic() + wait
        while time.monotonic() < deadline:
            kept = [(p, t) for p, t in kept if since(p) == t]
            if not kept:
                return
            pinned = {}
            for p in set().union(*(descendants(s) for s, _ in kept)) - sent:
                try:
                    pinned[p] = os.pidfd_open(p)
                except OSError:
                    pass
            under = set().union(*(descendants(s) for s, _ in kept))
            for p, fd in pinned.items():
                try:
                    if p in under:
                        sent.add(p)
                        signal.pidfd_send_signal(fd, sig)
                except OSError:
                    pass
                finally:
                    os.close(fd)
            time.sleep(0.1)
    raise Refused('run %s still has processes after stop' % run,
                  'stop it again, or end its processes by hand: they run under process %s'
                  % ', '.join(str(p) for p, _ in kept))


def lock(run):
    if not os.path.exists(os.path.join(STATE, run + '.json')):
        raise Refused('no run ' + run, 'check the run id that `driver start` printed')
    try:
        fcntl.flock(os.open(os.path.join(STATE, run + '.lock'), os.O_RDONLY | os.O_CREAT, 0o600), fcntl.LOCK_EX)
    except OSError:
        raise Refused('the driver cannot lock run %s in its state folder' % run,
                      'make OPENWIZ_OPENCLAW_STATE (or ~/.local/state/openwiz-openclaw) a folder you can write')


def saved(run, state=None):
    path = os.path.join(STATE, run + '.json')
    if state is not None:
        os.makedirs(STATE, mode=0o700, exist_ok=True)
        with open(path + '.new', 'w') as f:
            json.dump(state, f)
        os.replace(path + '.new', path)
        return state
    try:
        with open(path) as f:
            return json.load(f)
    except FileNotFoundError:
        raise Refused('no run ' + run, 'check the run id that `driver start` printed')


def unsaved(run, turn, cmd):
    try:
        end([turn], run)
    except Refused:
        raise Refused('run %s began a turn it could not save, and could not confirm the turn ended; its outcome is '
                      'unknown' % run, 'end process %d and everything under it by hand, and read the ticket for '
                      'what its agent did, before you %s it again' % (turn['supervisor'], cmd))
    raise Refused('run %s began a turn it could not save, so the driver ended it; its outcome is unknown' % run,
                  'read the ticket for what its agent did before you %s it again' % cmd)


def answer(cmd):
    if cmd == 'version':
        return VERSION
    if cmd == 'schema':
        with open(os.path.join(HERE, 'schema.json')) as f:
            return json.load(f)
    if cmd == 'start':
        req, run = read(START), 'run-' + secrets.token_hex(6)
        if req['harness'] not in AGENTS:
            raise Refused('the harness is not one this driver runs through acpx',
                          'use one of: ' + ', '.join(AGENTS))
        installed()
        state = {'request': req, 'turns': [], 'stopped': False, 'starting': True}
        try:
            saved(run, state)
            os.close(os.open(os.path.join(STATE, run + '.lock'), os.O_WRONLY | os.O_CREAT, 0o600))
            os.makedirs(os.path.join(STATE, 'acpx', run, 'work'), mode=0o700)
            os.makedirs(os.path.join(STATE, 'work'), mode=0o700, exist_ok=True)
            os.symlink(os.path.join('..', 'acpx', run, 'work'), os.path.join(STATE, 'work', run))
        except OSError:
            raise Refused('the driver cannot save runs in its state folder; nothing was started',
                          'make OPENWIZ_OPENCLAW_STATE (or ~/.local/state/openwiz-openclaw) a folder you can write')
        try:
            code = step(opening(req, run), run)
            if code != 0:
                raise Refused('acpx could not open a %s session for run %s (exit %s); nothing was started'
                              % (req['harness'], run, 'unknown' if code is None else code),
                              'check that you are signed in to %s yourself and that acpx runs it by hand'
                              % req['harness'])
            turn = launch(req, run, False)
        except Refused:
            try:
                saved(run, dict(state, stopped=True))
            except OSError:
                pass
            raise
        try:
            saved(run, dict(state, turns=[turn], starting=False))
        except OSError:
            unsaved(run, turn, 'start')
        return {'run': run}
    if cmd in ('wake', 'stop'):
        run = read(RUN)['run']
        lock(run)
        state = saved(run)
        if cmd == 'stop':
            try:
                saved(run, dict(state, stopped=True))
                kept = True
            except OSError:
                kept = False
            try:
                if state['turns'] and shutil.which('acpx'):
                    for call in (['cancel', '-s', run], ['sessions', 'close', run]):
                        step(acpx(run, harness=state['request']['harness']) + call, run)
            except Project:
                pass
            finally:
                end(state['turns'], run)
            if not kept:
                raise Refused('run %s has ended, but the driver could not save that it is stopped' % run,
                              'make OPENWIZ_OPENCLAW_STATE (or ~/.local/state/openwiz-openclaw) a folder you can '
                              'write, then stop it again')
            return {'run': run, 'stopped': True}
        if state['stopped']:
            raise Refused('run %s is stopped' % run, 'start a new run')
        if state.get('starting'):
            raise Refused('run %s never finished starting' % run, 'stop it, then start a new run')
        try:
            saved(run, state)
        except OSError:
            raise Refused('the driver cannot save run %s; nothing was started' % run,
                          'make OPENWIZ_OPENCLAW_STATE (or ~/.local/state/openwiz-openclaw) a folder you can write')
        turn = launch(state['request'], run, True)
        try:
            saved(run, dict(state, turns=state['turns'] + [turn]))
        except OSError:
            unsaved(run, turn, 'wake')
        return {'run': run, 'woke': True}
    raise Refused('unknown command', 'run one of: version, schema, start, wake, stop')


def main():
    if len(sys.argv) > 2 and sys.argv[1] == '--turn':
        return supervise(sys.argv[2:])
    if len(sys.argv) > 6 and sys.argv[1] == '--acp' and sys.argv[5] == '--':
        return relay(sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[6:])
    try:
        out, code = answer(sys.argv[1] if len(sys.argv) == 2 else ''), 0
    except Refused as e:
        out, code = {'error': e.args[0], 'next': e.args[1]}, 1
    except Exception as e:
        out, code = {'error': 'the driver failed: ' + type(e).__name__, 'next': 'read its code, fix it, retry'}, 1
    print(json.dumps(out))
    sys.exit(code)


if __name__ == '__main__':
    main()
