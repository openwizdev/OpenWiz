#!/usr/bin/env python3
import json
import os
import sys
import time

args = sys.argv[1:]
log = os.environ.get('OPENWIZ_SSH_LOG')
if log:
    with open(log, 'a') as handle:
        handle.write(json.dumps(args) + '\n')
hold = os.environ.get('OPENWIZ_SSH_HOLD', '')
if hold.isdigit():
    time.sleep(int(hold))
    sys.exit(0)
if '--' not in args:
    sys.exit(2)
command = args[args.index('--') + 1:]
if not command:
    sys.exit(2)
os.execvp(command[0], command)
