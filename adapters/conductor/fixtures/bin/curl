#!/usr/bin/env python3
"""A synthetic Conductor, behind a synthetic `curl`, for the Conductor driver's tests. Its request and answer
shapes follow Conductor's public API reference and OpenAPI document (api.conductor.build/v0, beta, read
2026-11-20); everything else (ids, the agent's behaviour, the refusals) is synthetic, never observed live.

It takes only the one curl call shape the driver makes, and answers as `curl -w '\\n%{http_code}'` does: the
response body, a newline and the status code. The caller's key is `CONDUCTOR_API_KEY` in curl's own environment,
named on the command line only by `--variable`; a key other than FAKE_CONDUCTOR_KEY gets a 401.

State is the JSON file FAKE_CONDUCTOR_STATE; each call's argv is a JSON line in FAKE_CONDUCTOR_LOG. The agent of a
new workspace posts one builder status note in the local tracker KIT_TRACKER, naming the skill its first message
names; each later message to that session edits the same note. FAKE_CONDUCTOR_FAIL=`<METHOD> <route>=<status>`
answers that call with that error and changes nothing; FAKE_CONDUCTOR_LOSE=`<METHOD> <route>` does the call, then
loses the reply (curl exit 52), as a dropped connection would. A route is the path with ids as `{id}`."""
import fcntl, json, os, re, sys, time

KEY_ARGS = ['--variable', '%CONDUCTOR_API_KEY', '--expand-oauth2-bearer', '{{CONDUCTOR_API_KEY}}']
API = 'https://api.conductor.build'
STATE, LOG = os.environ['FAKE_CONDUCTOR_STATE'], os.environ.get('FAKE_CONDUCTOR_LOG')


def answer(status, body):
    sys.stdout.write(json.dumps(body) + '\n%d' % status)
    sys.exit(0)


def refuse(status, code, message):
    answer(status, {'code': code, 'userMessage': message})


def update(change):
    """Run change(state) under a lock and save the state."""
    with open(STATE + '.lock', 'w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            with open(STATE) as f:
                state = json.load(f)
        except FileNotFoundError:
            state = {'workspaces': {}, 'sessions': {}}
        out = change(state)
        with open(STATE + '.new', 'w') as f:
            json.dump(state, f)
        os.replace(STATE + '.new', STATE)
        return out


def note(session, model, skill, woken):
    """Post or edit this session's builder note, as the agent in the cloud workspace would."""
    path, now = os.environ['KIT_TRACKER'], time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())
    body = '\n'.join(['<!-- openwiz:status v1 -->', 'agent: builder', 'state: working', 'harness: Fake',
                      'model: ' + model, 'skills: %s@0.1.2' % skill,
                      'step: ' + ('woke and read the ticket again' if woken else 'started the throwaway ticket'),
                      'time: ' + now]) + '\n'
    with open(path) as f:
        tracker = json.load(f)
    if session['note'] is None:
        session['note'] = 1 + max([c['id'] for c in tracker['comments']], default=0)
        tracker['comments'].append({'id': session['note'], 'author': 'example-bot[bot]', 'updated_at': now,
                                    'body': body})
    else:
        [c for c in tracker['comments'] if c['id'] == session['note']][0].update(body=body, updated_at=now)
    with open(path + '.%d' % os.getpid(), 'w') as f:
        json.dump(tracker, f)
    os.replace(path + '.%d' % os.getpid(), path)


def call(method, path, body):
    """The API: (status, answer), changing the state under its lock."""
    def run(state):
        ws, ss = state['workspaces'], state['sessions']
        if method == 'POST' and path == '/v0/workspaces':
            if set(body) != {'repositoryUrl', 'name', 'agent', 'model', 'message'} or body['agent'] not in (
                    'claude', 'codex', 'cursor'):
                return 400, {'code': 'invalid_request', 'userMessage': 'Invalid request body.'}
            wid, sid = 'ws_fake%04d' % (len(ws) + 1), 'se_fake%04d' % (len(ss) + 1)
            ws[wid] = {'name': body['name'], 'repositoryUrl': body['repositoryUrl'], 'status': 'ready'}
            ss[sid] = {'workspace': wid, 'model': body['model'], 'status': 'working', 'note': None, 'messages': 1}
            skill = re.search(r'with the ([a-z0-9-]+) skill', body['message'])
            if skill:
                note(ss[sid], body['model'], skill.group(1), False)
            return 201, {'workspaceId': wid, 'sessionId': sid, 'deepLink': 'conductor://workspace/' + wid}
        m = re.fullmatch(r'/v0/(sessions|workspaces)/([^/]+)/(messages|cancel|archive)', path)
        if method != 'POST' or not m or (m.group(1) == 'sessions') == (m.group(3) == 'archive'):
            return 404, {'code': 'not_found', 'userMessage': 'Not found.'}
        kind, id_, act = m.groups()
        if id_ not in (ss if kind == 'sessions' else ws):
            return 404, {'code': 'not_found', 'userMessage': 'No such %s.' % kind[:-1]}
        if act == 'archive':
            ws[id_]['status'] = 'archived'
            for s in ss.values():
                if s['workspace'] == id_:
                    s['status'] = 'idle'
            return 200, {'workspaceId': id_, 'status': 'archived'}
        session = ss[id_]
        if act == 'cancel':
            session['status'] = 'idle'
            return 200, {'workspaceId': session['workspace'], 'sessionId': id_, 'status': 'idle',
                         'canceledQueuedMessages': 0}
        if set(body) != {'message'} or not body['message']:
            return 400, {'code': 'invalid_request', 'userMessage': 'Invalid request body.'}
        if ws[session['workspace']]['status'] == 'archived':
            return 409, {'code': 'workspace_archived', 'userMessage': 'This workspace is archived.'}
        session['status'], session['messages'] = 'working', session['messages'] + 1
        skill = re.search(r'with the ([a-z0-9-]+) skill', body['message'])
        if skill:
            note(session, session['model'], skill.group(1), True)
        return 201, {'messageId': '00000000-0000-4000-8000-%012d' % session['messages'], 'state': 'sent',
                     'deepLink': 'conductor://session/' + id_}
    return update(run)


def main():
    args = sys.argv[1:]
    if LOG:
        with open(LOG, 'a') as f:
            f.write(json.dumps(args) + '\n')
    # curl -sS --max-time <s> -X <METHOD> <KEY_ARGS> -H <ct> -H <accept> [--data-binary @-] -w '\n%{http_code}' <url>
    shape = ['-sS', '--max-time', args[2] if len(args) > 2 else '', '-X', args[4] if len(args) > 4 else ''] + KEY_ARGS + \
        ['-H', 'Content-Type: application/json', '-H', 'Accept: application/json'] + \
        (['--data-binary', '@-'] if '--data-binary' in args else []) + ['-w', '\n%{http_code}', args[-1] if args else '']
    if args != shape or not args[2].isdigit() or not args[-1].startswith(API + '/'):
        print('curl: (2) the fake takes only the driver\'s one call shape', file=sys.stderr)
        sys.exit(2)
    if 'CONDUCTOR_API_KEY' not in os.environ:
        print('curl: (2) Variable "CONDUCTOR_API_KEY" was not set', file=sys.stderr)
        sys.exit(2)
    method, path = args[4], args[-1][len(API):]
    try:
        body = json.loads(sys.stdin.read()) if '--data-binary' in args else {}
    except ValueError:
        refuse(400, 'invalid_json', 'Malformed JSON body.')
    if os.environ['CONDUCTOR_API_KEY'] != os.environ['FAKE_CONDUCTOR_KEY']:
        refuse(401, 'unauthorized', 'Invalid API key.')
    route = '%s %s' % (method, re.sub(r'/(ws|se)_[^/]+', '/{id}', path))
    fail = dict(x.rsplit('=', 1) for x in os.environ.get('FAKE_CONDUCTOR_FAIL', '').split(',') if '=' in x)
    if route in fail:
        refuse(int(fail[route]), 'planted', 'A planted failure.')
    status, out = call(method, path, body)
    if route in os.environ.get('FAKE_CONDUCTOR_LOSE', '').split(','):
        print('curl: (52) Empty reply from server', file=sys.stderr)
        sys.exit(52)
    answer(status, out)


if __name__ == '__main__':
    main()
