def install(name, org, lock, req, run, urls):
    found = HARNESSES[req['harness']]
    exports = dict(urls, **{found['key']: PLACEHOLDER_KEY})
    env = ''.join("export %s='%s'\n" % (k, v) for k, v in sorted(exports.items()))
    env += 'export PATH="$HOME/.openwiz/bin:$PATH"\n'
    script = (INSTALL % dict(lock, harness=req['harness'], package=found['package'], run=run)).replace(
        '@@OPENWIZ_PUSH_HELPER@@', PUSH_HELPER).replace('@@OPENWIZ_ENV@@', env)
    try:
        p = subprocess.run([sprite_program(), 'exec', '-o', org, '-s', name, '--stdin', '--', 'sh', '-s'], input=script,
                           capture_output=True, text=True, timeout=INSTALL_WAIT_SECONDS)
        out = p.stdout + p.stderr
        done = p.returncode == 0 and ('openwiz-ready ' + lock['version']) in p.stdout
    except subprocess.TimeoutExpired:
        out, done = '', False
    if not done:
        refused = [why for pattern, why in INSTALL_REFUSALS if re.search(pattern, out)]
        raise Refused(line('the pinned WizSkills skills (%s), %s and openwiz-push could not be installed in Sprite %s: '
                           '%s' % (lock['version'], req['harness'], name, refused[0] if refused else
                                   'sprite gave an error the driver does not repeat')),
                      line('check that the Sprite reaches github.com and npm, and that no other skill of that name '
                           'is installed there, then start again'))


def reach(name, org, run):
    then = 'wake it again'
    try:
        p = subprocess.run(execute(name, org, ['sh', '-c', REACH, 'openwiz-reach', run]), stdin=subprocess.DEVNULL,
                           capture_output=True, text=True, timeout=REACH_WAIT_SECONDS)
    except subprocess.TimeoutExpired:
        raise Refused('sprite exec did not reach Sprite %s in time, so the run is not woken' % name,
                      'check `sprite list -o %s --prefix %s` for it, then %s' % (org, name, then))
    found = lines_of(p.stdout)
    if p.returncode == 0 and found[-1:] == ['openwiz-home-lost']:
        raise Refused(line('Sprite %s lost its run\'s files, and the agent\'s session with them, so run %s is not '
                           'woken' % (name, run)), 'stop it, then start a new run')
    if p.returncode != 0 or found[-1:] != ['openwiz-home-ok']:
        raise sprite_error('exec -o %s -s %s' % (org, name), p.stderr[-400:], then)


def prompt_text(req, woken):
    what = 'You were woken: read the ticket again and carry on' if woken else 'Build the ticket'
    folder = req['repository'].partition('/')[2]
    effort = '%s effort' % req['effort'] if req.get('effort') else 'default effort'
    return ('%s: GitHub repository %s, ticket #%d, with the %s skill (~/wizskills/skills/%s/SKILL.md). This Sprite '
            'has no GitHub login of its own: the Sprites gateway holds it. Clone the repository into ~/%s if it is '
            'not there yet (git clone https://github.com/%s.git), and follow its instructions. Make every GitHub '
            'API call (your status note, comments, the pull request, CI reads) as a plain REST call to '
            '$OPENWIZ_GITHUB_API in place of https://api.github.com, with no Authorization header: the gateway adds '
            'the login. Publish your branch with `openwiz-push <branch>`, never `git push`: it sends the branch\'s '
            'new commits through the gateway and only fast-forwards. Make your commits with TZ=UTC and unsigned. '
            'This run uses the %s, so your status note\'s model field is `<your model> %s`, such as `Opus 5.5 %s`.'
            % (what, req['repository'], req['ticket'], req['skill'], req['skill'], folder, req['repository'],
               'host\'s default effort' if effort == 'default effort' else effort, effort, effort))


def harness_command(state):
    req, woken, session = state['request'], bool(state['turns']), state['session']
    effort = req.get('effort')
    if req['harness'] == 'claude':
        words = ['claude', '-p', '--dangerously-skip-permissions', '--model', req['model']] + (
            ['--effort', effort] if effort else []) + ['--resume' if woken else '--session-id', session]
    else:
        words = ['codex', 'exec'] + (['resume'] if woken else []) + [
            '--json', '--dangerously-bypass-approvals-and-sandbox', '--skip-git-repo-check', '-m', req['model']] + (
            ['-c', 'model_reasoning_effort=' + effort] if effort else []) + ([session] if woken else [])
    return ['sh', '-c', TURN, 'openwiz-turn', req['repository'].partition('/')[2]] + words + [prompt_text(req, woken)]


def turn(state, run, settle):
    woken = bool(state['turns'])
    log = path(run, '%d.log' % len(state['turns']))
    command = harness_command(state)
    os.close(private(log))
    then = 'wake it again' if woken else 'start again'
    os.environ['OPENWIZ_RUN'] = run
    try:
        sup = subprocess.Popen([sys.executable, '-I', os.path.abspath(__file__), '--turn', run, log] +
                               execute(state['sprite'], state['org'], command), start_new_session=True,
                               stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        with sup.stdout:
            first = sup.stdout.readline()
    except OSError as e:
        raise Refused('sprite exec did not start: %s' % e.strerror, 'check that `sprite` runs by hand, then ' + then)
    try:
        started = json.loads(first)
    except ValueError:
        started = {'error': 'its supervisor did not answer'}
    if 'pid' not in started:
        raise Refused('sprite exec did not start: %s' % started['error'],
                      'check that `sprite` runs by hand, then ' + then)
    now = {'pid': started['pid'], 'since': started['since'], 'supervisor': sup.pid, 'supervisor_since': since(sup.pid)}
    needs_thread = not woken and state['request']['harness'] == 'codex'
    deadline = time.monotonic() + TURN_BEGAN_WAIT_SECONDS
    while True:
        ended_before_this_read = not running(now)
        with open(log, errors='replace') as f:
            text = f.read().splitlines()
        began = TURN_BEGAN in (x.strip() for x in text)
        found = [x.get('thread_id') for x in map(event, text) if x.get('type') == 'thread.started']
        thread = found[0] if found and isinstance(found[0], str) and SESSION.fullmatch(found[0]) else None
        if began and (thread or not needs_thread):
            settled(run, state, now, log, settle)
            return now, thread or state['session']
        if ended_before_this_read or (found and not thread) or time.monotonic() > deadline:
            end([now], run, [log])
            what = 'the %s turn did not begin' % state['request']['harness'] if not began else 'codex printed no thread id'
            raise Refused(line('%s in Sprite %s, so the run did not %s' % (what, state['sprite'],
                                                                         'wake' if woken else 'start')),
                          line('read %s for why; check that its connector lets Sprites labelled %s in, then %s'
                               % (log, LABEL, then)))
        time.sleep(0.1)


def exit_of(log, supervisor):
    try:
        with open(supervisor_record(log, supervisor)) as f:
            code = json.load(f).get('exit')
    except (OSError, ValueError, AttributeError):
        return None
    return code if type(code) is int else None


def settled(run, state, now, log, settle):
    woken, harness = bool(state['turns']), state['request']['harness']
    deadline, ended_at = time.monotonic() + settle, None
    while True:
        ended_before_this_read = not running(now)
        if ended_before_this_read and ended_at is None:
            ended_at = time.monotonic()
        with open(log, errors='replace') as f:
            text = f.read().splitlines()
        after = text[[x.strip() for x in text].index(TURN_BEGAN) + 1:]
        code = exit_of(log, now['supervisor']) if ended_before_this_read else None
        if any(HARNESS_REFUSALS.search(x) for x in after if event(x).get('type', 'error') in ('error', 'turn.failed')):
            why = 'refused to %s' % ('resume its session' if woken else 'start')
            break
        if ended_before_this_read and code == 0:
            return
        if ended_before_this_read and code is not None:
            why = 'exited with status %d' % code
            break
        if ended_before_this_read and time.monotonic() > ended_at + EXIT_RECORD_WAIT_SECONDS:
            why = 'ended with no exit status'
            break
        if not ended_before_this_read and time.monotonic() > deadline:
            return
        time.sleep(0.1)
    end([now], run, [log])
    raise Refused(line('the %s turn %s in Sprite %s, so the run did not %s'
                       % (harness, why, state['sprite'], 'wake' if woken else 'start')),
                  line('read %s for why; check that its connector lets Sprites labelled %s in%s, then %s'
                       % (log, LABEL, '; if it lost its session, stop the run and start a new one' if woken else '',
                          'wake it again' if woken else 'start again')))


def event(text):
    try:
        item = json.loads(text)
    except ValueError:
        return {}
    return item if isinstance(item, dict) else {}


def sprite_read(name, org):
    try:
        out = sprite('api', 'stop the run again', ['api', '-o', org, '/sprites/' + name, '--'] + READ_SPRITE)
    except Refused:
        return None
    body, _, code = out.rstrip('\n').rpartition('\n')
    try:
        shown = json.loads(body)
    except ValueError:
        return None
    if not isinstance(shown, dict):
        return None
    if code == '404':
        note = (str(shown.get('message', '')) + ' ' + str(shown.get('error', ''))).lower()
        return False if shown.get('error') == 'not_found' or 'not found' in note else None
    return shown if code == '200' and (shown.get('name'), shown.get('organization')) == (name, org) and \
        isinstance(shown.get('id'), str) and shown['id'] else None


def sprite_gone(name, org, known):
    shown = sprite_read(name, org)
    if shown is None or shown is False and not known:
        return None
    return shown is False or bool(known) and shown['id'] != known


def destroy_sprite(name, org, known):
    failed = None
    for attempt in range(DESTROY_TRIES):
        gone = sprite_gone(name, org, known) if known else False
        if gone is False:
            try:
                sprite('destroy', 'stop the run again', ['destroy', '-o', org, '--force', name])
                failed = Refused('sprite destroy answered, but Sprite %s is still there' % name, 'stop the run again')
            except Refused as e:
                failed = e
            gone = sprite_gone(name, org, known)
        if gone:
            return
        if gone is None:
            failed = Refused('sprite api could not confirm that Sprite %s is gone' % name, 'stop the run again')
        if attempt + 1 < DESTROY_TRIES:
            time.sleep(DESTROY_RETRY_PAUSE_SECONDS)
    raise failed


def confirm_absent(name, org, allow_404):
    failed = None
    for attempt in range(DESTROY_TRIES):
        shown = sprite_read(name, org)
        if shown is False and allow_404:
            return
        if shown:
            raise Refused('Sprite %s exists, with no saved id to prove ownership, so it was not destroyed' % name,
                          'check `sprite api -o %s /sprites/%s` before destroying it yourself' % (org, name))
        if shown is False:
            raise Refused('sprite api could not confirm that Sprite %s is gone' % name, 'stop the run again')
        failed = Refused('sprite api could not confirm whether Sprite %s exists' % name, 'stop the run again')
        if attempt + 1 < DESTROY_TRIES:
            time.sleep(DESTROY_RETRY_PAUSE_SECONDS)
    raise failed


def shutdown(run, turns, name, org, known, logs=None, created=True, rollback=False):
    failures = []
    try:
        end(turns + strays(run, {t['supervisor'] for t in turns}), run, turn_logs(run) if logs is None else logs)
    except Refused as e:
        failures.append(e)
    except Exception as e:
        failures.append(Refused('the driver could not end its local processes: %s' % type(e).__name__,
                                "end this run's processes by hand: they carry OPENWIZ_RUN=%s" % run))
    if name:
        try:
            if known or rollback:
                destroy_sprite(name, org, known)
            else:
                confirm_absent(name, org, not created)
        except Refused as e:
            if known or rollback:
                guidance = ('stop run %s again, or run `sprite destroy -o %s --force %s` yourself, and '
                            'check `sprite info -o %s %s` says it is not found' % (run, org, name, org, name))
            else:
                guidance = ('check `sprite api -o %s /sprites/%s` to verify ownership before destroying it yourself, '
                            'then stop run %s again' % (org, name, run))
            failures.append(Refused(line('its Sprite %s may still be there, billing storage: %s' % (name, e.args[0])),
                                    line(guidance)))
    return failures


def abandon(run, state, error):
    what = error.args[0] if isinstance(error, Refused) else 'the driver failed: ' + type(error).__name__
    failures = shutdown(run, [], state['sprite'], state['org'], state.get('id'),
                        [path(run, '%d.log' % len(state['turns']))], state.get('created', True), rollback=True)
    try:
        saved(run, dict(state, stopped=True))
    except OSError:
        pass
    return reported(what, failures, '') if failures else None


def unsaved(run, state, now, cmd, log):
    failures = shutdown(run, [now], state['sprite'] if cmd == 'start' else None, state['org'], state.get('id'), [log],
                        state.get('created', True), rollback=cmd == 'start')
    if failures:
        raise reported('run %s began a turn it could not save, and could not confirm everything ended; its '
                       'outcome is unknown' % run, failures, 'read the ticket for what its agent did')
    raise Refused('run %s began a turn it could not save, so the driver ended it; its outcome is unknown' % run,
                  'read the ticket for what its agent did before you %s' % (
                      'start a new run' if cmd == 'start' else 'wake it again'))


def start(req):
    harness_of(req)
    urls, org = gateways(req['harness']), organization()
    sprite_program()
    lock, settle = pinned_skills(), settle_seconds()
    run = 'sp-' + secrets.token_hex(6)
    name = 'openwiz-' + run
    state = {'request': req, 'sprite': name, 'session': str(uuid.uuid4()) if req['harness'] == 'claude' else None,
             'org': org, 'id': None, 'turns': [], 'stopped': False, 'starting': True, 'created': False}
    try:
        saved(run, state)
        os.close(private(path(run, 'lock'), os.O_WRONLY | os.O_CREAT))
    except OSError:
        raise Refused('the driver cannot save runs in its state folder, so nothing was created', UNWRITABLE)
    try:
        sprite('create', 'check `sprite api -o %s /sprites/%s` before destroying, then stop %s and start again'
                         % (org, name, run),
               ['create', '-o', org, '--skip-console', '--label', LABEL, name], CREATE_WAIT_SECONDS)
    except Refused:
        try:
            saved(run, dict(state, stopped=True))
        except OSError:
            pass
        raise
    state['created'] = True
    try:
        try:
            saved(run, state)
        except OSError:
            raise Refused('the driver cannot save run %s; its new Sprite is destroyed' % run,
                          UNWRITABLE + ', then start again')
        shown = sprite_read(name, org)
        if not shown:
            raise Refused('sprite api could not read its new Sprite back, so no stop could be confirmed; the run did '
                          'not start', 'check that `sprite api -o %s /sprites/%s` answers that Sprite, then start '
                          'again' % (org, name))
        state['id'] = shown['id']
        try:
            saved(run, state)
        except OSError:
            raise Refused('the driver cannot save run %s; its new Sprite is destroyed' % run,
                          UNWRITABLE + ', then start again')
        install(name, org, lock, req, run, urls)
        now, session = turn(state, run, settle)
        if looks_like_credential(session):
            end([now], run, [path(run, '0.log')])
            raise Refused('codex printed a thread id that looks like a credential, so the run did not start',
                          'start again')
        try:
            saved(run, dict(state, turns=[now], session=session, starting=False))
        except OSError:
            unsaved(run, state, now, 'start', path(run, '0.log'))
    except Exception as e:
        instead = abandon(run, state, e)
        if instead:
            raise instead from e
        raise
    return {'run': run}


def wake(run):
    lock(run, False)
    state = saved(run)
    if state['stopped']:
        raise Refused('run %s is stopped' % run, 'start a new run')
    if stopping(run):
        raise Refused('a stop of run %s could not save that the run is stopped' % run,
                      'stop it again; it stays stopped and is never woken')
    if state.get('starting'):
        raise Refused('run %s never finished starting' % run, 'stop it, then start a new run')
    if state['turns'] and running(state['turns'][-1]):
        return {'run': run, 'woke': True}
    settle = settle_seconds()
    try:
        saved(run, state)
    except OSError:
        raise Refused('the driver cannot save run %s; nothing was started' % run, UNWRITABLE + ', then wake it')
    reach(state['sprite'], state['org'], run)
    now, _ = turn(state, run, settle)
    try:
        saved(run, dict(state, turns=state['turns'] + [now]))
    except OSError:
        unsaved(run, state, now, 'wake', path(run, '%d.log' % len(state['turns'])))
    return {'run': run, 'woke': True}


def stop(run):
    lock(run, True)
    state = saved(run)
    marked = mark_stopping(run)
    try:
        saved(run, dict(state, stopped=True))
        kept = True
    except OSError:
        kept = False
    failures = shutdown(run, state['turns'], state['sprite'], state['org'], state.get('id'),
                        created=state.get('created', True))
    every_process_ended = not failures
    for name in os.listdir(STATE):
        if name.startswith(run + '.') and (name.endswith('.log') or name.endswith('.sup') and every_process_ended):
            try:
                os.remove(os.path.join(STATE, name))
            except OSError:
                pass
    if not kept:
        failures.append(Refused('the driver could not save that it is stopped%s' % (
                                    '' if marked else ', nor mark it stopping: do not wake it'),
                                UNWRITABLE + ', then stop it again'))
    if failures:
        raise reported('run %s did not stop cleanly' % run, failures, '')
    return {'run': run, 'stopped': True}


def answer(cmd):
    if cmd == 'version':
        return VERSION
    if cmd == 'schema':
        with open(os.path.join(HERE, 'schema.json')) as f:
            return json.load(f)
    if cmd == 'start':
        return start(no_credentials(read(START, OPTIONAL)))
    if cmd in ('wake', 'stop'):
        run = read(RUN)['run']
        return wake(run) if cmd == 'wake' else stop(run)
    raise Refused('unknown command', 'run one of: version, schema, start, wake, stop')


def main():
    if len(sys.argv) > 4 and sys.argv[1] == '--turn':
        return supervise(sys.argv[2], sys.argv[3], sys.argv[4:])
    try:
        out, code = answer(sys.argv[1] if len(sys.argv) == 2 else ''), 0
    except Refused as e:
        out, code = {'error': e.args[0], 'next': e.args[1]}, 1
    except Exception as e:
        out, code = {'error': 'the driver failed: ' + type(e).__name__,
                     'next': 'read its code and fix it; check `sprite list --prefix openwiz-` for what is running'}, 1
    print(json.dumps(out))
    sys.exit(code)


if __name__ == '__main__':
    main()
