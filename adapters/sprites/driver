class Refused(Exception):
    pass


def line(text):
    text = ' '.join(str(text).split()) or 'no detail'
    return text if len(text) <= 300 else text[:297] + '...'


def unique(pairs):
    if len({k for k, _ in pairs}) != len(pairs):
        raise Refused('a key is repeated', 'send each key once')
    return dict(pairs)


def read(fields, optional=None):
    optional = optional or {}
    try:
        req = json.loads(sys.stdin.read(), object_pairs_hook=unique)
    except ValueError:
        raise Refused('the input is not JSON', 'send one JSON object on stdin, as `driver schema` shows')
    if not isinstance(req, dict) or not set(fields) <= set(req) or set(req) - set(fields) - set(optional):
        raise Refused('the input needs exactly ' + ', '.join(fields) + (', and optionally ' + ', '.join(optional)
                                                                        if optional else ''),
                      'send only those fields; never a login')
    for key, pattern in list(fields.items()) + [(k, p) for k, p in optional.items() if k in req]:
        v = req[key]
        if not (type(v) is int and v > 0 if pattern is None else isinstance(v, str) and re.fullmatch(pattern, v)):
            raise Refused(key + ' is not valid', 'fix ' + key + ' as `driver schema` shows')
    return req


def looks_like_credential(text):
    return bool(CREDENTIAL_SHAPES.search(text))


def no_credentials(req):
    # PRIVACY: runs before anything is saved or started, and the refusal names the field, never its value.
    for key in list(START) + list(OPTIONAL):
        if isinstance(req.get(key), str) and looks_like_credential(req[key]):
            raise Refused('%s looks like a credential, so nothing was saved or started' % key,
                          'send the %s itself in %s; never a login, key or token' % (key, key))
    return req


def harness_of(req):
    if req['harness'] not in HARNESSES and 'effort' in req:
        raise Refused('Sprites runs no harness %s here, so it takes no effort %s, and nothing was created'
                      % (req['harness'], req['effort']), REFUSE_EFFORT)
    if req['harness'] not in HARNESSES:
        raise Refused('Sprites runs no harness %s here, so nothing was created' % req['harness'],
                      'use one of: ' + ', '.join(HARNESSES))
    found = HARNESSES[req['harness']]
    if 'effort' in req and req['effort'] not in found['efforts']:
        raise Refused('harness %s here takes no effort %s, so nothing was created' % (req['harness'], req['effort']),
                      REFUSE_EFFORT)
    return found


def connection(name):
    # PRIVACY: a connection id names a connector and is not a secret, but a refusal still names only the variable.
    value = os.environ.get(name) or ''
    if not value:
        raise Refused('%s is not set, so nothing was created' % name,
                      'set %s to your connector\'s connection id, from its page in the Fly.io dashboard, then start '
                      'again' % name)
    if not CONNECTION_ID.fullmatch(value) or looks_like_credential(value):
        raise Refused('%s is not a connection id, so nothing was created' % name,
                      'set %s to the connection id on the connector\'s page, never a key, then start again' % name)
    return value


def gateways(harness):
    found = HARNESSES[harness]
    return {found['base']: GATEWAY + found['provider'] + '/' + connection(found['connection']) + found['path'],
            'OPENWIZ_GITHUB_API': GATEWAY + 'github/' + connection(GITHUB_CONNECTION)}


def organization():
    value = os.environ.get(ORGANIZATION) or ''
    if not CONNECTION_ID.fullmatch(value) or looks_like_credential(value):
        raise Refused('%s does not name a Fly organization, so nothing was created' % ORGANIZATION,
                      'set %s to the Fly organization your connectors are in, as `sprite org list` names it, then '
                      'start again' % ORGANIZATION)
    return value


def settle_seconds():
    raw = os.environ.get('OPENWIZ_SPRITES_SETTLE') or str(DEFAULT_SETTLE_SECONDS)
    try:
        seconds = float(raw)
    except ValueError:
        seconds = float('nan')
    if not 0 < seconds <= MAX_SETTLE_SECONDS:
        raise Refused('OPENWIZ_SPRITES_SETTLE is not a number of seconds above 0 and at most %d; nothing was '
                      'started' % MAX_SETTLE_SECONDS, 'unset it, or set it to a number of seconds up to %d, then try '
                      'again' % MAX_SETTLE_SECONDS)
    return seconds


def sprite_program():
    found = shutil.which('sprite')
    if not found:
        raise Refused('the sprite CLI is not installed here, so nothing was created',
                      "install Fly's sprite CLI (docs.fly.io/sprites/cli/installation) and sign in to it yourself")
    return found


def sprite_error(what, stderr, then):
    if SIGNED_OUT.search(stderr):
        why, step = 'sprite is not signed in', SIGN_IN
    else:
        why = 'sprite gave an error the driver does not repeat' if stderr.strip() else 'sprite gave no answer'
        step = 'run `sprite %s` by hand to read what it says' % what
    return Refused(line('sprite %s failed: %s' % (what, why)), line('%s, then %s' % (step, then)))


def sprite(what, then, args, wait=API_WAIT_SECONDS, stdin=None):
    try:
        p = subprocess.run([sprite_program()] + args, input=stdin, stdin=None if stdin is not None else
                           subprocess.DEVNULL, capture_output=True, text=True, timeout=wait)
    except subprocess.TimeoutExpired:
        raise Refused('sprite %s took too long; its outcome is unknown' % what, line(then))
    if p.returncode != 0:
        raise sprite_error(what, p.stderr[-400:], then)
    return p.stdout


def execute(name, org, words):
    return [sprite_program(), 'exec', '-o', org, '-s', name, '--no-stdin', '--'] + words


def lines_of(text):
    return [x.strip() for x in text.splitlines() if x.strip()]


def pinned_skills():
    try:
        with open(os.path.join(HERE, '..', '..', 'wizskills.lock')) as f:
            lock = json.load(f)
        assert set(lock) == {'version', 'commit', 'tree'} and re.fullmatch(r'[0-9]+\.[0-9]+\.[0-9]+', lock['version'])
        assert all(re.fullmatch(r'[0-9a-f]{40}', lock[k]) for k in ('commit', 'tree'))
        return lock
    except (OSError, ValueError, TypeError, AssertionError):
        raise Refused("OpenWiz's wizskills.lock is missing or malformed, so nothing was created",
                      'run the driver from an OpenWiz checkout whose wizskills.lock pins a WizSkills release')
PUSH_HELPER = r'''#!/usr/bin/env python3
import base64, json, os, re, subprocess, sys, urllib.error, urllib.parse, urllib.request
from datetime import datetime, timezone

ABOUT = """openwiz-push <branch>: publish a local branch to GitHub through the Sprites gateway's GitHub connector, in
place of `git push`, which this Sprite has no login for. It sends the branch's new commits with GitHub's Git Database
API (blobs, trees, commits, then the ref) to $OPENWIZ_GITHUB_API, with no Authorization header: the gateway adds the
login. It only fast-forwards, uploads no blob a commit GitHub holds already reaches, refuses a push of more than 200 changed
files, checks that GitHub wrote every object with the same sha as here, and moves the branch last, so a refusal
leaves the branch on GitHub as it was."""
ORIGIN = re.compile(r'(?:https://github\.com/|git@github\.com:|ssh://git@github\.com/)'
                    r'([A-Za-z0-9_.-]+)/([A-Za-z0-9_.-]+?)(?:\.git)?/?')
WHO = re.compile(r'(.*) <(.*)> ([0-9]+) ([+-][0-9]{4})')
MOST_FILES = 200


def refuse(why):
    sys.stderr.write('openwiz-push: refused: %s\n' % why)
    sys.exit(1)


def git(*args, data=None):
    p = subprocess.run(['git'] + list(args), input=data, capture_output=True)
    if p.returncode:
        refuse('git %s failed: %s' % (args[0], p.stderr.decode(errors='replace').strip()[:300]))
    return p.stdout


def text(*args):
    return git(*args).decode().strip()


def holds(*args):
    return subprocess.run(['git'] + list(args), capture_output=True).returncode == 0


class GitHub:
    def __init__(self, base, repo):
        self.base, self.repo = base.rstrip('/'), repo

    def call(self, method, path, body=None):
        request = urllib.request.Request(
            '%s/repos/%s/git/%s' % (self.base, self.repo, urllib.parse.quote(path, safe='/')), method=method,
            data=None if body is None else json.dumps(body).encode(),
            headers={'Accept': 'application/vnd.github+json', 'X-GitHub-Api-Version': '2022-11-28',
                     'User-Agent': 'openwiz-push', 'Content-Type': 'application/json'})
        try:
            with urllib.request.urlopen(request, timeout=120) as answer:
                return answer.status, json.loads(answer.read() or b'null')
        except urllib.error.HTTPError as e:
            try:
                message = json.loads(e.read()).get('message')
            except (ValueError, AttributeError):
                message = None
            return e.code, {'message': message}
        except (urllib.error.URLError, OSError) as e:
            refuse('the gateway at $OPENWIZ_GITHUB_API did not answer: %s' % e)

    def made(self, method, path, body, want, what):
        code, answer = self.call(method, path, body)
        if code not in (200, 201) or not isinstance(answer, dict):
            refuse('GitHub refused %s with HTTP %d: %s' % (what, code, (answer or {}).get('message')))
        if want is not None and answer.get('sha') != want:
            refuse('GitHub wrote %s as %s, not %s as here, so nothing was moved' % (what, answer.get('sha'), want))
        return answer


def parsed(sha):
    raw = git('cat-file', 'commit', sha)
    head, _, message = raw.partition(b'\n\n')
    commit = {'parents': []}
    for row in head.decode(errors='replace').split('\n'):
        key, _, value = row.partition(' ')
        if key == 'tree':
            commit['tree'] = value
        elif key == 'parent':
            commit['parents'].append(value)
        elif key in ('author', 'committer'):
            who = WHO.fullmatch(value)
            if not who:
                refuse('commit %s has an %s line this helper cannot read' % (sha, key))
            name, email, stamp, zone = who.groups()
            if zone != '+0000':
                refuse('commit %s was made at time zone %s, and GitHub writes commit dates in UTC, so it would get '
                       'another sha: make your commits with TZ=UTC (git commit --amend --reset-author for the last '
                       'one), then push again' % (sha, zone))
            commit[key] = {'name': name, 'email': email, 'date': datetime.fromtimestamp(
                int(stamp), timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')}
        else:
            refuse('commit %s carries a %s header, which GitHub\'s API cannot write again; make it again '
                   'without one (no signing), then push again' % (sha, key or 'continuation'))
    try:
        commit['message'] = message.decode()
    except UnicodeDecodeError:
        refuse('commit %s has a message that is not UTF-8' % sha)
    return commit


def changes(parent, sha):
    out = git('diff-tree', '-r', '-z', '--no-renames', '--no-commit-id', *([parent, sha] if parent else ['--root', sha]))
    fields, found = out.split(b'\0'), []
    for at in range(0, len(fields) - 1, 2):
        old_mode, new_mode, old_sha, new_sha, status = fields[at].decode()[1:].split(' ')
        found.append((status, fields[at + 1].decode(), old_mode, new_mode, old_sha, new_sha))
    return found


def kind(mode):
    return 'commit' if mode == '160000' else 'blob'


def blobs_under(commits):
    found = git('rev-list', '--objects', '--no-object-names', *commits) if commits else b''
    kinds = git('cat-file', '--batch-check=%(objecttype) %(objectname)', data=found) if found else b''
    return {sha for kind, sha in (row.split() for row in kinds.decode().splitlines()) if kind == 'blob'}


def main():
    if len(sys.argv) != 2 or sys.argv[1] in ('-h', '--help'):
        sys.stderr.write('usage: openwiz-push <branch>\n%s\n' % ABOUT)
        sys.exit(2)
    branch = sys.argv[1]
    if branch.startswith('-') or not holds('check-ref-format', '--branch', branch):
        refuse('%r is not a branch name' % branch)
    base = os.environ.get('OPENWIZ_GITHUB_API', '')
    if not re.match(r'https?://', base):
        refuse('OPENWIZ_GITHUB_API is not set: run openwiz-push in the Sprite the OpenWiz driver started')
    origin = ORIGIN.fullmatch(text('remote', 'get-url', 'origin')) if holds('remote', 'get-url', 'origin') else None
    if not origin:
        refuse('origin is not a github.com repository: clone it from https://github.com/<owner>/<name>.git')
    github = GitHub(base, '%s/%s' % origin.groups())
    if not holds('rev-parse', '--verify', '-q', 'refs/heads/%s^{commit}' % branch):
        refuse('there is no local branch %s here' % branch)
    local = text('rev-parse', 'refs/heads/%s^{commit}' % branch)
    code, answer = github.call('GET', 'ref/heads/' + branch)
    if code not in (200, 404):
        refuse('GitHub did not say where %s is: HTTP %d: %s' % (branch, code, (answer or {}).get('message')))
    remote = answer['object']['sha'] if code == 200 else None
    if remote == local:
        git('update-ref', 'refs/remotes/origin/' + branch, local)
        print('openwiz-push: %s is up to date on GitHub at %s' % (branch, local))
        return
    if remote and not (holds('cat-file', '-e', remote + '^{commit}') and
                       holds('merge-base', '--is-ancestor', remote, local)):
        refuse('%s on GitHub is at %s, and this is not a fast-forward of it: bring that commit in (git fetch '
               'origin %s), rebase onto it, then push again' % (branch, remote, branch))
    new = text('rev-list', '--topo-order', '--reverse', local, '--not', *([remote] if remote else []),
               '--remotes=origin').split()
    commits = {sha: parsed(sha) for sha in new}
    changed = {sha: changes(commits[sha]['parents'][0] if commits[sha]['parents'] else None, sha) for sha in new}
    paths = {c[1] for found in changed.values() for c in found}
    if len(paths) > MOST_FILES:
        refuse('this push changes %d files, more than the %d openwiz-push sends at once: push it in smaller '
               'steps' % (len(paths), MOST_FILES))
    under = sorted({p for c in commits.values() for p in c['parents']} - set(commits) - {remote})
    for parent in under:
        if github.call('GET', 'commits/' + parent)[0] != 200:
            refuse('commit %s, under the new ones, is not on GitHub: push the branch it came from first' % parent)
    held = blobs_under(under + ([remote] if remote else []))
    for sha in new:
        commit = commits[sha]
        first = commit['parents'][0] if commit['parents'] else None
        entries = []
        for status, path, old_mode, new_mode, old_sha, new_sha in changed[sha]:
            if status == 'D':
                entries.append({'path': path, 'mode': old_mode, 'type': kind(old_mode), 'sha': None})
                continue
            if kind(new_mode) == 'blob' and new_sha not in held:
                github.made('POST', 'blobs', {'encoding': 'base64', 'content': base64.b64encode(
                    git('cat-file', 'blob', new_sha)).decode()}, new_sha, 'blob %s of %s' % (new_sha, path))
                held.add(new_sha)
            entries.append({'path': path, 'mode': new_mode, 'type': kind(new_mode), 'sha': new_sha})
        if entries:
            body = {'tree': entries}
            if first:
                body['base_tree'] = text('rev-parse', first + '^{tree}')
            github.made('POST', 'trees', body, commit['tree'], 'the tree of commit %s' % sha)
        github.made('POST', 'commits', {k: commit[k] for k in ('message', 'tree', 'parents', 'author', 'committer')},
                    sha, 'commit %s' % sha)
    if remote:
        moved = github.made('PATCH', 'refs/heads/' + branch, {'sha': local, 'force': False}, None,
                            'the fast-forward of %s (someone may have moved it: fetch, rebase, push again)' % branch)
    else:
        moved = github.made('POST', 'refs', {'ref': 'refs/heads/' + branch, 'sha': local}, None,
                            'the new branch %s (it may exist now: push again)' % branch)
    if (moved.get('ref'), (moved.get('object') or {}).get('sha')) != ('refs/heads/' + branch, local):
        refuse('GitHub answered the move of %s without naming %s: check the branch on GitHub' % (branch, local))
    git('update-ref', 'refs/remotes/origin/' + branch, local)
    print('openwiz-push: pushed %s to GitHub at %s (%d new commits) through the Sprites gateway'
          % (branch, local, len(new)))


if __name__ == '__main__':
    main()
'''


def path(run, name):
    return os.path.join(STATE, '%s.%s' % (run, name))


def private_state():
    os.makedirs(STATE, mode=0o700, exist_ok=True)
    os.chmod(STATE, 0o700)
    found = os.stat(STATE)
    if found.st_uid != os.getuid() or found.st_mode & 0o077:
        raise PermissionError('the state folder is not owner-only')


def private(name, flags=os.O_WRONLY | os.O_CREAT | os.O_TRUNC):
    fd = os.open(name, flags | os.O_NOFOLLOW, 0o600)
    try:
        os.fchmod(fd, 0o600)
    except OSError:
        os.close(fd)
        raise
    return fd


LINUX = os.path.isdir('/proc/self') and hasattr(os, 'pidfd_open')
PR_SET_CHILD_SUBREAPER = 36


def ps(*args):
    try:
        p = subprocess.Popen(['ps'] + list(args), stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                             stderr=subprocess.PIPE, text=True)
        out, err = p.communicate(timeout=30)
    except (OSError, subprocess.TimeoutExpired) as e:
        raise OSError('ps did not run: %s' % e)
    if p.returncode and err.strip():
        raise OSError('ps failed: %s' % err.strip()[:100])
    return out.splitlines(), p.pid


# PRIVACY: reads only ps's process table (pid, parent, group, state, start time), never any environment.
def members(roots, recorded, writers=()):
    rows, me = ps('-A', '-o', 'pid=', '-o', 'ppid=', '-o', 'pgid=', '-o', 'stat=', '-o', 'lstart=')
    started, children, found = {}, {}, set()
    for row in rows:
        f = row.split(None, 4)
        if len(f) < 5 or f[3].startswith('Z'):
            continue
        pid, ppid, group = int(f[0]), int(f[1]), int(f[2])
        started[pid] = f[4].strip()
        children.setdefault(ppid, []).append(pid)
        if group in roots or recorded.get(pid) == started[pid] or pid in writers:
            found.add(pid)
    todo = list(roots) + list(found)
    while todo:
        for c in children.get(todo.pop(), []):
            if c not in found:
                found.add(c)
                todo.append(c)
    return {p: started[p] for p in found - set(roots) - {os.getpid(), me}}


# PRIVACY: asks lsof only which processes hold this run's own turn logs open for writing, never any environment.
def writing_to(paths):
    if not paths:
        return set()
    try:
        out = subprocess.run(['lsof', '-F', 'pa', '--'] + list(paths), stdin=subprocess.DEVNULL,
                             capture_output=True, text=True, timeout=30).stdout
    except (OSError, subprocess.TimeoutExpired):
        return set()
    found, pid = set(), None
    for field in out.splitlines():
        if field[:1] == 'p' and field[1:].isdigit():
            pid = int(field[1:])
        elif field[:1] == 'a' and field[1:2] in ('w', 'u') and pid is not None:
            found.add(pid)
    return found


def turn_logs(run):
    try:
        names = os.listdir(STATE)
    except FileNotFoundError:
        return []
    return sorted(os.path.join(STATE, n) for n in names if n.startswith(run + '.') and n.endswith('.log'))


def since(pid):
    if not LINUX:
        row = ps('-o', 'stat=', '-o', 'lstart=', '-p', str(pid))[0]
        return row[0].split(None, 1)[1].strip() if row and not row[0].lstrip().startswith('Z') else None
    try:
        with open('/proc/%d/stat' % pid) as f:
            fields = f.read().rpartition(')')[2].split()
    except OSError:
        return None
    return None if fields[0] == 'Z' else int(fields[19])


def descendants(pid):
    children = {}
    for p in filter(str.isdigit, os.listdir('/proc')):
        try:
            with open('/proc/%s/stat' % p) as f:
                fields = f.read().rpartition(')')[2].split()
        except OSError:
            continue
        if fields[0] != 'Z':
            children.setdefault(int(fields[1]), []).append(int(p))
    found, todo = set(), [pid]
    while todo:
        for c in children.get(todo.pop(), []):
            if c not in found:
                found.add(c)
                todo.append(c)
    return found


def supervisor_record(log, supervisor):
    return '%s.%d.sup' % (log[:-len('.log')], supervisor)


def record_this_supervisor(log, kept=None, exited=None):
    record = supervisor_record(log, os.getpid())
    with os.fdopen(private(record + '.new'), 'w') as f:
        json.dump({'supervisor': os.getpid(), 'supervisor_since': since(os.getpid()), 'kept': kept or {},
                   'exit': exited}, f)
    os.replace(record + '.new', record)


def supervise(run, log, cmd):
    if not re.fullmatch(RUN['run'], run):
        print(json.dumps({'error': 'the run id is not valid'}), flush=True)
        return
    os.environ['OPENWIZ_RUN'] = run
    if LINUX and ctypes.CDLL(None, use_errno=True).prctl(PR_SET_CHILD_SUBREAPER, 1, 0, 0, 0) != 0:
        print(json.dumps({'error': "this host cannot keep a turn's processes together"}), flush=True)
        return
    try:
        record_this_supervisor(log)
        with open(log, 'a') as out:
            turn = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT)
    except OSError as e:
        print(json.dumps({'error': e.strerror}), flush=True)
        return
    signal.signal(signal.SIGTERM, signal.SIG_IGN)
    print(json.dumps({'pid': turn.pid, 'since': since(turn.pid)}), flush=True)
    os.dup2(os.open(os.devnull, os.O_WRONLY), 1)
    kept, exited = {}, []

    def reaped(pid, status):
        if pid == turn.pid and not exited:
            exited.append(os.waitstatus_to_exitcode(status))
            try:
                record_this_supervisor(log, {str(p): t for p, t in kept.items()}, exited[0])
            except OSError:
                pass
    if LINUX:
        while True:
            try:
                reaped(*os.wait())
            except ChildProcessError:
                return
    looks = 0
    while True:
        children_left = any_child_running_after_reaping(reaped)
        scanned = looks % LOOKS_PER_OUTPUT_CHECK == 0
        now = members({os.getpid()}, kept, writing_to([log]) if scanned else ())
        if not children_left and not now and not scanned:
            now = members({os.getpid()}, kept, writing_to([log]))
        looks += 1
        if now != kept:
            kept = now
            try:
                record_this_supervisor(log, {str(p): t for p, t in kept.items()}, exited[0] if exited else None)
            except OSError:
                pass
        if not children_left and not kept:
            return
        time.sleep(MACOS_SECONDS_BETWEEN_LOOKS)


def any_child_running_after_reaping(reaped):
    while True:
        try:
            pid, status = os.waitpid(-1, os.WNOHANG)
        except ChildProcessError:
            return False
        if pid == 0:
            return True
        reaped(pid, status)


def running(turn):
    return bool(turn) and turn['since'] is not None and since(turn['pid']) == turn['since']


def end(turns, run, logs):
    kept = [(t['supervisor'], t['supervisor_since']) for t in turns if t and t['supervisor_since'] is not None]
    left = set()
    for sig, wait in ((signal.SIGTERM, GRACE_SECONDS_BEFORE_KILL), (signal.SIGKILL, 2)):
        sent, deadline = set(), time.monotonic() + wait
        while time.monotonic() < deadline:
            kept = [(p, t) for p, t in kept if since(p) == t]
            if not LINUX:
                supervisors = {s for s, _ in kept}
                left = set(members(supervisors, recorded_by(run, supervisors), writing_to(logs)))
                if not kept and not left:
                    return
                for p in left - sent:
                    try:
                        os.kill(p, sig)
                        sent.add(p)
                    except OSError:
                        pass
                time.sleep(0.1)
                continue
            if not kept:
                return
            pinned = {}
            for p in set().union(*(descendants(s) for s, _ in kept)) - sent:
                try:
                    pinned[p] = os.pidfd_open(p)
                except OSError:
                    pass
            under = set().union(*(descendants(s) for s, _ in kept))
            for p, fd in pinned.items():
                try:
                    if p in under:
                        sent.add(p)
                        signal.pidfd_send_signal(fd, sig)
                except OSError:
                    pass
                finally:
                    os.close(fd)
            time.sleep(0.1)
    raise Refused('run %s still has local processes after stop' % run,
                  'stop it again, or end its processes by hand: they run under process %s'
                  % ', '.join(str(p) for p in [p for p, _ in kept] or sorted(left)))


def saved(run, state=None):
    if state is not None:
        private_state()
        with os.fdopen(private(path(run, 'json.new')), 'w') as f:
            json.dump(state, f)
        os.replace(path(run, 'json.new'), path(run, 'json'))
        return state
    try:
        with open(path(run, 'json')) as f:
            return json.load(f)
    except FileNotFoundError:
        raise Refused('no run ' + run, 'check the run id that `driver start` printed')


def lock(run, create):
    if not os.path.exists(path(run, 'json')):
        raise Refused('no run ' + run, 'check the run id that `driver start` printed')
    if not create and not os.path.exists(path(run, 'lock')):
        raise Refused('run %s has lost its lock file, which may have marked a stop' % run,
                      'stop it, then start a new run')
    try:
        private_state()
        fcntl.flock(private(path(run, 'lock'), os.O_RDONLY | (os.O_CREAT if create else 0)), fcntl.LOCK_EX)
    except OSError:
        raise Refused('the driver cannot lock run %s in its state folder' % run, UNWRITABLE)


STOP_MARK_MTIME = 1


def mark_stopping(run):
    marked = False
    try:
        fd = os.open(path(run, 'lock'), os.O_WRONLY | os.O_TRUNC)
        try:
            marked = os.write(fd, b'stopping\n') == 9
        finally:
            os.close(fd)
    except OSError:
        pass
    try:
        os.utime(path(run, 'lock'), (STOP_MARK_MTIME, STOP_MARK_MTIME))
        marked = True
    except OSError:
        pass
    return marked


def stopping(run):
    try:
        with open(path(run, 'lock'), 'rb') as f:
            return f.read(9) == b'stopping\n' or os.fstat(f.fileno()).st_mtime == STOP_MARK_MTIME
    except FileNotFoundError:
        return True


def supervisor_records(run):
    try:
        names = os.listdir(STATE)
    except FileNotFoundError:
        return []
    return sorted(os.path.join(STATE, n) for n in names if n.startswith(run + '.') and n.endswith('.sup'))


def recorded_by(run, supervisors):
    recorded = {}
    for name in supervisor_records(run):
        try:
            with open(name) as f:
                kept = json.load(f)
            if kept['supervisor'] in supervisors:
                recorded.update({int(p): t for p, t in kept['kept'].items() if isinstance(t, str)})
        except (OSError, ValueError, KeyError, TypeError, AttributeError):
            continue
    return recorded


# PRIVACY: finds a run's unsaved turns only by the records their supervisors wrote in its state folder, never
def strays(run, known):
    found = []
    for name in supervisor_records(run):
        try:
            with open(name) as f:
                kept = json.load(f)
            p, t = kept['supervisor'], kept['supervisor_since']
        except (OSError, ValueError, KeyError, TypeError):
            continue
        if type(p) is int and p > 0 and p not in known and t is not None and since(p) == t:
            found.append({'supervisor': p, 'supervisor_since': t})
    return found


def reported(what, failures, then):
    return Refused(line('; '.join([what] + [f.args[0] for f in failures])),
                   line('; '.join([f.args[1] for f in failures] + ([then] if then else []))))



