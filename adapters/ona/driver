#!/usr/bin/env python3
# SECURITY: driver v1 N4. Every Ona call goes through the kit's key helper, which alone reads the key and picks the
# address; this driver sends it only a host name, a method, a path and a body, and never names, reads or prints the
# key. It shows no text the host answered: each error names only the status, the method and the path.
import json, os, re, subprocess, sys, uuid
sys.dont_write_bytecode = True

HERE = os.path.dirname(os.path.abspath(__file__))
HELPER = os.path.realpath(os.path.join(HERE, '..', '..', 'kernel', 'driver-kit', 'hostkey.py'))
HOST = 'ona'
VERSION = {'driver': 'ona', 'records': ['openwiz:records v1'], 'can': ['start', 'wake', 'stop', 'effort']}
START = {'repository': r'[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}', 'ticket': None,
         'skill': r'(?=.{1,60}$)[a-z0-9]+(-[a-z0-9]+)*', 'harness': r'[a-z0-9][a-z0-9._-]{0,59}',
         'model': r'[A-Za-z0-9][A-Za-z0-9 ._:@+-]{0,59}'}
RUN = {'run': r'[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}'}
EFFORT = r'[a-z][a-z0-9-]{0,19}'
AGENT = '/api/gitpod.v1.AgentService/'
ENVIRONMENT = '/api/gitpod.v1.EnvironmentService/'
CODEX = '00000000-0000-0000-0000-000000007800'
MODELS = ('GPT_5_5', 'GPT_5_4', 'GPT_5_6_SOL', 'GPT_5_6_TERRA', 'GPT_5_6_LUNA', 'GPT_6_ASTRA', 'GPT_6_SOL',
          'GPT_6_LUNA', 'GPT_6_1_SOL')
EFFORTS = {'low': 'LOW', 'medium': 'MEDIUM', 'high': 'HIGH', 'xhigh': 'EXTRA_HIGH', 'max': 'MAX', 'ultra': 'ULTRA'}
NO_EFFORT = ("this host can't set effort: remove the effort for this harness in your Models table or Roster to run it "
             "at the host's default")
PHASES = ('PHASE_PENDING', 'PHASE_RUNNING', 'PHASE_WAITING_FOR_INPUT', 'PHASE_STOPPED')
GONE = ('ENVIRONMENT_PHASE_STOPPING', 'ENVIRONMENT_PHASE_STOPPED', 'ENVIRONMENT_PHASE_DELETING',
        'ENVIRONMENT_PHASE_DELETED')
WOKEN = 'You were woken: read the ticket again and carry on.'
AMBIGUOUS_START = (
    'the key helper gave no answer',
    'the key helper refused: the helper could not reach the host, or its answer was unreadable',
    'the key helper refused: the host answered more than 1 MiB',
    "the key helper refused: the host's answer held the key, so the helper did not pass it on",
)


class Refused(Exception):
    pass


def unique(pairs):
    if len({k for k, _ in pairs}) != len(pairs):
        raise Refused('a key is repeated', 'send each key once')
    return dict(pairs)


def read(fields):
    try:
        req = json.loads(sys.stdin.read(), object_pairs_hook=unique)
    except ValueError:
        raise Refused('the input is not JSON', 'send one JSON object on stdin, as `driver schema` shows')
    optional = {'effort': EFFORT} if fields is START else {}
    if not isinstance(req, dict) or not set(fields) <= set(req) <= set(fields) | set(optional):
        raise Refused('the input needs exactly ' + ', '.join(fields) + (', and optionally effort' if optional else ''),
                      'send only those fields; never a login')
    for key, pattern in dict(fields, **optional).items():
        if key not in req:
            continue
        v = req[key]
        if not (type(v) is int and v > 0 if pattern is None else isinstance(v, str) and re.fullmatch(pattern, v)):
            raise Refused(key + ' is not valid', 'fix ' + key + ' as `driver schema` shows')
    return req


def ask(method, body):
    request = {'host': HOST, 'method': 'POST', 'path': method, 'body': body}
    try:
        p = subprocess.run([sys.executable, '-I', HELPER], input=json.dumps(request), capture_output=True,
                           text=True, timeout=110)
        out = json.loads(p.stdout)
    except (OSError, subprocess.TimeoutExpired, ValueError):
        out, p = None, None
    if p and p.returncode == 1 and isinstance(out, dict) and set(out) == {'error', 'next'} and \
            all(isinstance(v, str) for v in out.values()):
        raise Refused('the key helper refused: ' + out['error'], out['next'])
    if not (p and p.returncode == 0 and isinstance(out, dict) and set(out) == {'status', 'body'} and
            type(out['status']) is int):
        raise Refused('the key helper gave no answer', 'run kernel/driver-kit/hostkey.py by hand to see why')
    return out['status'], out['body']


def acknowledged(status, found):
    return status == 200 and isinstance(found, dict) and 'code' not in found


def check(method, status, found, unsure="check your key and Ona's status, then retry"):
    if acknowledged(status, found):
        return found
    refused = status != 200 and isinstance(found, dict) and isinstance(found.get('code'), str)
    shape = '' if refused else ' with an error object' if status == 200 and isinstance(found, dict) else \
        ' in a shape OpenWiz does not know'
    raise Refused('Ona answered %d to POST %s%s' % (status, method, shape),
                  "check your key and Ona's status, then retry" if refused else unsure)


def ok(method, body, unsure="check your key and Ona's status, then retry"):
    return check(method, *ask(method, body), unsure)


def missing(status, found):
    return status == 404 and isinstance(found, dict) and found.get('code') == 'not_found'


def send(run, text):
    ok(AGENT + 'SendToAgentExecution', {'agentExecutionId': run, 'userInput': {
        'id': str(uuid.uuid4()), 'inputs': [{'text': {'content': text}}]}})


def execution(run):
    status, found = ask(AGENT + 'GetAgentExecution', {'agentExecutionId': run})
    if missing(status, found):
        return None
    if status != 200 or not isinstance(found, dict):
        raise Refused('Ona answered %d to POST %sGetAgentExecution' % (status, AGENT), "check Ona's status")
    found = found.get('agentExecution')
    state = found.get('status') if isinstance(found, dict) and found.get('id') == run else None
    if not (isinstance(state, dict) and state.get('phase') in PHASES):
        raise Refused('Ona described the run in a shape OpenWiz does not know', "check the run in Ona's dashboard")
    return state


def environments(state):
    used = state.get('usedEnvironments', [])
    if not isinstance(used, list) or not all(
            isinstance(u, dict) and isinstance(u.get('environmentId'), str) and
            re.fullmatch(RUN['run'], u['environmentId']) and type(u.get('createdByAgent', False)) is bool
            for u in used):
        raise Refused("Ona listed the run's environments in a shape OpenWiz does not know",
                      "stop the run and its environments in Ona's dashboard")
    return [u['environmentId'] for u in used if u.get('createdByAgent')]


def stop_environment(env):
    path = ENVIRONMENT + 'StopEnvironment'
    status, found = ask(path, {'environmentId': env})
    if acknowledged(status, found) or missing(status, found):
        return
    again, raw = ask(ENVIRONMENT + 'GetEnvironment', {'environmentId': env})
    found = raw.get('environment') if acknowledged(again, raw) else None
    state = found.get('status') if isinstance(found, dict) and found.get('id') == env else None
    if not (missing(again, raw) or isinstance(state, dict) and state.get('phase') in GONE):
        raise Refused('Ona answered %d to POST %s for environment %s' % (status, path, env),
                      "stop that environment in Ona's dashboard, then retry")


def begun(run, e):
    return Refused('run %s may have started: %s' % (run, e.args[0]),
                   'stop run %s with `driver stop`, then start again' % run)


def unsure(run, e):
    return Refused('run %s: %s' % (run, e.args[0]), 'run %s may still be active in Ona: %s' % (run, e.args[1]))


def run_name(repository, ticket):
    name = 'OpenWiz: %s#%d' % (repository, ticket)
    if len(name) <= 100:
        return name
    head, tail = 'OpenWiz: ', '#%d' % ticket
    room = 100 - len(head) - len(tail)
    return head + repository[:room] + tail if room > 0 else (head + tail)[:100]


def answer(cmd):
    if cmd == 'version':
        return VERSION
    if cmd == 'schema':
        with open(os.path.join(HERE, 'schema.json')) as f:
            return json.load(f)
    if cmd == 'start':
        req = read(START)
        if req['harness'] != 'codex' and 'effort' in req:
            raise Refused('Ona cannot set effort %s for harness %s' % (req['effort'], req['harness']), NO_EFFORT)
        if req['harness'] != 'codex':
            raise Refused('harness %s is not one Ona runs through its API' % req['harness'], 'use harness codex')
        model = re.sub(r'[-.]', '_', req['model'].upper())
        if model not in MODELS or not re.fullmatch(r'[A-Za-z0-9.-]+', req['model']):
            raise Refused('model %s is not a Codex model Ona offers' % req['model'],
                          'use one of: ' + ', '.join(m.lower().replace('_', '-') for m in MODELS))
        settings = {'model': 'CODEX_OPEN_AI_MODEL_' + model}
        if 'effort' in req:
            if req['effort'] not in EFFORTS:
                raise Refused('Ona cannot set effort %s for harness codex' % req['effort'], NO_EFFORT)
            settings['reasoningEffort'] = 'CODEX_REASONING_EFFORT_' + EFFORTS[req['effort']]
        lost = 'look for a new OpenWiz run in Ona, stop it, then retry'
        try:
            status, started = ask(AGENT + 'StartAgent', {
                'agentId': CODEX, 'codeContext': {'contextUrl': {'url': 'https://github.com/' + req['repository']}},
                'name': run_name(req['repository'], req['ticket']), 'codexSettings': settings})
        except Refused as e:
            if e.args[0] in AMBIGUOUS_START:
                raise Refused(e.args[0], lost)
            raise
        run = started.get('agentExecutionId') if isinstance(started, dict) else None
        named = isinstance(run, str) and re.fullmatch(RUN['run'], run)
        try:
            check(AGENT + 'StartAgent', status, started, lost)
        except Refused as e:
            raise begun(run, e) if named else e
        if not named:
            raise Refused('Ona named no run for the start', lost)
        try:
            send(run, 'Build the ticket: %s#%d, with the %s skill.' % (req['repository'], req['ticket'], req['skill']))
        except Refused as e:
            raise begun(run, e)
        return {'run': run}
    if cmd == 'wake':
        run = read(RUN)['run']
        try:
            state = execution(run)
            if state and state['phase'] != 'PHASE_STOPPED':
                send(run, WOKEN)
        except Refused as e:
            raise unsure(run, e)
        if state is None:
            raise Refused('Ona has no run %s' % run, 'start a new run')
        if state['phase'] == 'PHASE_STOPPED':
            raise Refused('run %s is stopped' % run, 'start a new run')
        return {'run': run, 'woke': True}
    if cmd == 'stop':
        run = read(RUN)['run']
        try:
            state = execution(run)
            if state is not None:
                envs = environments(state)
                if state['phase'] != 'PHASE_STOPPED':
                    ok(AGENT + 'StopAgentExecution', {'agentExecutionId': run})
                for env in envs:
                    stop_environment(env)
        except Refused as e:
            raise unsure(run, e)
        return {'run': run, 'stopped': True}
    raise Refused('unknown command', 'run one of: version, schema, start, wake, stop')


def main():
    try:
        out, code = answer(sys.argv[1] if len(sys.argv) == 2 else ''), 0
    except Refused as e:
        out, code = {'error': e.args[0][:300], 'next': e.args[1][:300]}, 1
    except Exception as e:
        out, code = {'error': 'the driver failed: ' + type(e).__name__, 'next': 'read its code, fix it, retry'}, 1
    print(json.dumps(out))
    sys.exit(code)


if __name__ == '__main__':
    main()
