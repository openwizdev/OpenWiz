#!/usr/bin/env python3
# SECURITY: driver v1 N4. Every Ona call goes through the kit's key helper, which alone reads the key and picks the
# address; this driver sends it only a host name, a method, a path and a body, and never names, reads or prints the
# key. It shows no text the host answered: each error names only the status, the method and the path.
import json, os, re, subprocess, sys, uuid
sys.dont_write_bytecode = True

HERE = os.path.dirname(os.path.abspath(__file__))
HELPER = os.path.realpath(os.path.join(HERE, '..', '..', 'kernel', 'driver-kit', 'hostkey.py'))
HOST = 'ona'
VERSION = {'driver': 'ona', 'records': ['openwiz:records v1'], 'can': ['start', 'wake', 'stop', 'effort']}
START = {'repository': r'[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}', 'ticket': None,
         'skill': r'(?=.{1,60}$)[a-z0-9]+(-[a-z0-9]+)*', 'harness': r'[a-z0-9][a-z0-9._-]{0,59}',
         'model': r'[A-Za-z0-9][A-Za-z0-9 ._:@+-]{0,59}'}
RUN = {'run': r'[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}'}
EFFORT = r'[a-z][a-z0-9-]{0,19}'
AGENT = '/api/gitpod.v1.AgentService/'
ENVIRONMENT = '/api/gitpod.v1.EnvironmentService/'
CODEX = '00000000-0000-0000-0000-000000007800'
MODELS = ('GPT_5_5', 'GPT_5_4', 'GPT_5_6_SOL', 'GPT_5_6_TERRA', 'GPT_5_6_LUNA', 'GPT_6_ASTRA', 'GPT_6_SOL',
          'GPT_6_LUNA', 'GPT_6_1_SOL')
EFFORTS = {'low': 'LOW', 'medium': 'MEDIUM', 'high': 'HIGH', 'xhigh': 'EXTRA_HIGH', 'max': 'MAX', 'ultra': 'ULTRA'}
NO_EFFORT = ("this host can't set effort: remove the effort for this harness in your Models table or Roster to run it "
             "at the host's default")
WOKEN = 'You were woken: read the ticket again and carry on.'


class Refused(Exception):
    pass


def unique(pairs):
    if len({k for k, _ in pairs}) != len(pairs):
        raise Refused('a key is repeated', 'send each key once')
    return dict(pairs)


def read(fields):
    try:
        req = json.loads(sys.stdin.read(), object_pairs_hook=unique)
    except ValueError:
        raise Refused('the input is not JSON', 'send one JSON object on stdin, as `driver schema` shows')
    optional = {'effort': EFFORT} if fields is START else {}
    if not isinstance(req, dict) or not set(fields) <= set(req) <= set(fields) | set(optional):
        raise Refused('the input needs exactly ' + ', '.join(fields) + (', and optionally effort' if optional else ''),
                      'send only those fields; never a login')
    for key, pattern in dict(fields, **optional).items():
        if key not in req:
            continue
        v = req[key]
        if not (type(v) is int and v > 0 if pattern is None else isinstance(v, str) and re.fullmatch(pattern, v)):
            raise Refused(key + ' is not valid', 'fix ' + key + ' as `driver schema` shows')
    return req


def ask(method, body, also=()):
    request = {'host': HOST, 'method': 'POST', 'path': method, 'body': body}
    try:
        p = subprocess.run([sys.executable, '-I', HELPER], input=json.dumps(request), capture_output=True,
                           text=True, timeout=110)
        out = json.loads(p.stdout)
    except (OSError, subprocess.TimeoutExpired, ValueError):
        raise Refused('the key helper gave no answer', 'run kernel/driver-kit/hostkey.py by hand to see why')
    if p.returncode:
        raise Refused('the key helper refused: ' + out['error'], out['next'])
    if not (200 <= out['status'] < 300 or out['status'] in also):
        raise Refused('Ona answered %d to POST %s' % (out['status'], method),
                      'check your key and Ona\'s status, then retry')
    return out['status'], out['body'] if isinstance(out['body'], dict) else {}


def send(run, text):
    ask(AGENT + 'SendToAgentExecution', {'agentExecutionId': run, 'userInput': {
        'id': str(uuid.uuid4()), 'inputs': [{'text': {'content': text}}]}})


def execution(run):
    status, found = ask(AGENT + 'GetAgentExecution', {'agentExecutionId': run}, also=(404,))
    found = found.get('agentExecution') if status == 200 else None
    if not (isinstance(found, dict) and found.get('id') == run):
        return None
    return found.get('status') if isinstance(found.get('status'), dict) else {}


def answer(cmd):
    if cmd == 'version':
        return VERSION
    if cmd == 'schema':
        with open(os.path.join(HERE, 'schema.json')) as f:
            return json.load(f)
    if cmd == 'start':
        req = read(START)
        if req['harness'] != 'codex':
            raise Refused('harness %s is not one Ona runs through its API' % req['harness'], 'use harness codex')
        model = re.sub(r'[-.]', '_', req['model'].upper())
        if model not in MODELS or not re.fullmatch(r'[A-Za-z0-9.-]+', req['model']):
            raise Refused('model %s is not a Codex model Ona offers' % req['model'],
                          'use one of: ' + ', '.join(m.lower().replace('_', '-') for m in MODELS))
        settings = {'model': 'CODEX_OPEN_AI_MODEL_' + model}
        if 'effort' in req:
            if req['effort'] not in EFFORTS:
                raise Refused('Ona cannot set effort %s for harness codex' % req['effort'], NO_EFFORT)
            settings['reasoningEffort'] = 'CODEX_REASONING_EFFORT_' + EFFORTS[req['effort']]
        _, started = ask(AGENT + 'StartAgent', {
            'agentId': CODEX, 'codeContext': {'contextUrl': {'url': 'https://github.com/' + req['repository']}},
            'name': 'OpenWiz: %s#%d' % (req['repository'], req['ticket']), 'codexSettings': settings})
        run = started.get('agentExecutionId')
        if not (isinstance(run, str) and re.fullmatch(RUN['run'], run)):
            raise Refused('Ona named no run for the start', 'look for a new OpenWiz run in Ona, stop it, then retry')
        try:
            send(run, 'Build the ticket: %s#%d, with the %s skill.' % (req['repository'], req['ticket'], req['skill']))
        except Refused as e:
            raise Refused('run %s may have started: %s' % (run, e.args[0]),
                          'stop run %s with `driver stop`, then start again' % run)
        return {'run': run}
    if cmd == 'wake':
        run = read(RUN)['run']
        status = execution(run)
        if status is None:
            raise Refused('Ona has no run %s' % run, 'start a new run')
        if status.get('phase') == 'PHASE_STOPPED':
            raise Refused('run %s is stopped' % run, 'start a new run')
        send(run, WOKEN)
        return {'run': run, 'woke': True}
    if cmd == 'stop':
        run = read(RUN)['run']
        status = execution(run)
        if status is None:
            return {'run': run, 'stopped': True}
        if status.get('phase') != 'PHASE_STOPPED':
            ask(AGENT + 'StopAgentExecution', {'agentExecutionId': run})
        for used in status.get('usedEnvironments') or []:
            env = used.get('environmentId') if isinstance(used, dict) and used.get('createdByAgent') is True else None
            if isinstance(env, str) and re.fullmatch(RUN['run'], env):
                ask(ENVIRONMENT + 'StopEnvironment', {'environmentId': env}, also=(400, 404))
        return {'run': run, 'stopped': True}
    raise Refused('unknown command', 'run one of: version, schema, start, wake, stop')


def main():
    try:
        out, code = answer(sys.argv[1] if len(sys.argv) == 2 else ''), 0
    except Refused as e:
        out, code = {'error': e.args[0], 'next': e.args[1]}, 1
    except Exception as e:
        out, code = {'error': 'the driver failed: ' + type(e).__name__, 'next': 'read its code, fix it, retry'}, 1
    print(json.dumps(out))
    sys.exit(code)


if __name__ == '__main__':
    main()
