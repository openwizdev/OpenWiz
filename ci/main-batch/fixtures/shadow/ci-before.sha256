56820befdd6f70436c178cd4d1db6c93cac992df3b851cfef86607ee6b35118c
{
  "source_before": "dcd532b2d7578d74702a56839dbe84f466bd46b2",
  "source_after": "cf44ac9cccfd0bcaca778f48b07615c9f794606f",
  "historical_after": "# X5: changes writes one plan; independent lanes read it; ci checks every expected result.\n# X7 fork routing, pinned setup and trusted caches apply to every executing lane.\nname: CI\n\non:\n  pull_request:\n    branches: [main, 'release-*']\n    types: [opened, synchronize, reopened, ready_for_review, converted_to_draft]\n  push:\n    branches: [main]\n  # Full safety run on main, regardless of changed paths.\n  schedule:\n    - cron: '23 9 * * *' # 09:23 UTC every day\n  # The merge queue (#190): GitHub re-tests each pull request on top of the\n  # latest main just before it lands, in a merge group, and merges it only\n  # if the required ci check passes there too. A merge group always runs\n  # every job (decide.sh).\n  merge_group:\n    types: [checks_requested]\n    branches: [main]\n\npermissions:\n  contents: read\n  pull-requests: read # decide.sh reads the PR live\n  id-token: write # cache.sh save: the token GitHub signs, which the PC's runner checks before it keeps a cache (#180)\n\n# Scheduled safety runs have their own admission slot (#1462). Main pushes\n# deliberately keep one running and only the latest pending push; false below\n# prevents cancelling the running push, not replacement of pending pushes.\nconcurrency:\n  group: ci-${{ github.event_name }}-${{ github.event.pull_request.number || github.ref }}\n  cancel-in-progress: ${{ github.event_name == 'pull_request' }}\n\nenv:\n  RUST_VERSION: 1.99.1\n  NODE_VERSION: 24.22.1\n  CARGO_TERM_COLOR: always\n  CARGO_INCREMENTAL: 0\n  NEXT_TELEMETRY_DISABLED: 1\n  CIRCLE_NODE_TOTAL: 2\n\njobs:\n\n  changes:\n    runs-on: ${{ github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name != github.repository && 'ubuntu-24.04' || vars.CI_SMALL_RUNS_ON || vars.CI_WEB_RUNS_ON || 'namespace-profile-closedwiz-rust' }}\n    timeout-minutes: 10\n    outputs:\n      rust: ${{ steps.plan.outputs.rust }}\n      toolkit: ${{ steps.plan.outputs.toolkit }}\n      web: ${{ steps.plan.outputs.web }}\n      site: ${{ steps.plan.outputs.site }}\n      release: ${{ steps.plan.outputs.release }}\n      skills: ${{ steps.plan.outputs.skills }}\n      build-web: ${{ steps.plan.outputs.build-web }}\n      export-rust: ${{ steps.plan.outputs.export-rust }}\n      export-web: ${{ steps.plan.outputs.export-web }}\n      trace: ${{ steps.plan.outputs.trace }}\n      planted: ${{ steps.plan.outputs.planted }}\n    steps:\n      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n        with:\n          persist-credentials: false\n          fetch-depth: 0\n          filter: blob:none\n          sparse-checkout-cone-mode: false\n          sparse-checkout: |\n            /*\n            !/private/\n      - name: The runner guard\n        id: guard\n        env:\n          HEAD_REPO: ${{ github.event.pull_request.head.repo.full_name }}\n        run: sh ci/hosted/guard.sh\n      - name: Python for the offline installer and release proofs\n        run: sh .github/actions/docs-only/python.sh\n      - name: Restore the select-map cache\n        uses: actions/cache/restore@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0\n        with:\n          path: ~/.cache/closedwiz-ci-select\n          key: ci-select-map-none\n          restore-keys: ci-select-map-\n      - name: Write the CI plan\n        id: plan\n        env:\n          GH_TOKEN: ${{ github.token }}\n        run: python3 -I .github/actions/docs-only/plan.py \"$RUNNER_TEMP/ci-plan\"\n      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2\n        with:\n          name: ci-selection-${{ github.run_attempt }}\n          path: ${{ runner.temp }}/ci-plan/*.json\n          if-no-files-found: error\n          retention-days: 30\n\n  always:\n    needs: changes\n    if: ${{ !cancelled() && needs.changes.result == 'success' }}\n    runs-on: ${{ github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name != github.repository && 'ubuntu-24.04' || vars.CI_RUST_RUNS_ON || 'namespace-profile-closedwiz-rust' }}\n    timeout-minutes: 60\n    steps:\n      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n        with:\n          persist-credentials: false\n          fetch-depth: 0\n          filter: blob:none\n          sparse-checkout-cone-mode: false\n          sparse-checkout: |\n            /*\n            !/private/\n      - name: The runner guard\n        id: guard\n        env:\n          HEAD_REPO: ${{ github.event.pull_request.head.repo.full_name }}\n        run: sh ci/hosted/guard.sh\n      - name: Prune unused inputs\n        run: sh .github/actions/docs-only/prune.sh .github/actions/docs-only/ci-reads.txt rust\n      - name: Prepare lane\n        uses: ./.github/actions/docs-only/setup\n        with:\n          hosted: ${{ steps.guard.outputs.hosted }}\n          save: ${{ steps.guard.outputs.save }}\n          rust-version: ${{ env.RUST_VERSION }}\n          node-version: ${{ env.NODE_VERSION }}\n          cargo: 'true'\n          npm: 'false'\n          browser: 'false'\n      - name: Python for the offline installer and release proofs\n        run: sh .github/actions/docs-only/python.sh\n      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2\n        with:\n          name: ci-selection-${{ github.run_attempt }}\n          path: ${{ runner.temp }}/ci-plan\n      - name: Build and lint Rust\n        run: python3 -I .github/actions/docs-only/run.py lint-always \"$RUNNER_TEMP/ci-plan\"\n      - name: The always-run checks\n        run: python3 -I .github/actions/docs-only/run.py execute \"$RUNNER_TEMP/ci-plan\" always\n      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2\n        if: needs.changes.outputs.trace == 'true' || needs.changes.outputs.planted == 'true'\n        with:\n          name: select-records-always-${{ github.run_attempt }}\n          path: ${{ runner.temp }}/select-records/*.json*\n          if-no-files-found: ignore\n          retention-days: 7\n      - name: Save the cargo-rust cache\n        if: github.ref == 'refs/heads/main' && (github.event_name == 'push' || github.event_name == 'schedule')\n        run: sh ci/runner/cache.sh save cargo-rust \"$HOME/.cargo/registry\" \"$GITHUB_WORKSPACE/target\"\n      - name: Save the GitHub cargo-rust cache\n        if: steps.guard.outputs.save == 'true'\n        uses: actions/cache/save@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0\n        with:\n          path:  |\n            ~/.cargo/registry\n            target\n          key: cargo-rust-${{ runner.os }}-${{ env.RUST_VERSION }}-${{ hashFiles('Cargo.lock') }}-${{ github.sha }}\n      - name: Record passed lane\n        run: python3 -I .github/actions/docs-only/run.py stamp \"$RUNNER_TEMP/ci-plan\" always \"$RUNNER_TEMP/receipts\"\n      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2\n        with:\n          name: lane-always-${{ github.run_attempt }}\n          path: ${{ runner.temp }}/receipts/*.json\n          if-no-files-found: error\n          retention-days: 30\n\n  web-build:\n    needs: changes\n    if: ${{ !cancelled() && needs.changes.result == 'success' && needs.changes.outputs.build-web == 'true' }}\n    runs-on: ${{ github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name != github.repository && 'ubuntu-24.04' || vars.CI_WEB_RUNS_ON || 'namespace-profile-closedwiz-rust' }}\n    timeout-minutes: 30\n    steps:\n      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n        with:\n          persist-credentials: false\n          fetch-depth: 0\n          filter: blob:none\n          sparse-checkout-cone-mode: false\n          sparse-checkout: |\n            /*\n            !/private/\n      - name: The runner guard\n        id: guard\n        env:\n          HEAD_REPO: ${{ github.event.pull_request.head.repo.full_name }}\n        run: sh ci/hosted/guard.sh\n      - name: Prune unused inputs\n        run: sh .github/actions/docs-only/prune.sh .github/actions/docs-only/ci-reads.txt web-build\n      - name: Prepare lane\n        uses: ./.github/actions/docs-only/setup\n        with:\n          hosted: ${{ steps.guard.outputs.hosted }}\n          save: ${{ steps.guard.outputs.save }}\n          rust-version: ${{ env.RUST_VERSION }}\n          node-version: ${{ env.NODE_VERSION }}\n          cargo: 'false'\n          npm: 'true'\n          browser: 'false'\n      - name: Python for the offline installer and release proofs\n        run: sh .github/actions/docs-only/python.sh\n      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2\n        with:\n          name: ci-selection-${{ github.run_attempt }}\n          path: ${{ runner.temp }}/ci-plan\n      - name: Run npm run build\n        run: python3 -I .github/actions/docs-only/run.py execute \"$RUNNER_TEMP/ci-plan\" build:web_export\n      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2\n        with:\n          name: web-out\n          path: apps/web/out\n          if-no-files-found: error\n          retention-days: 1\n      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2\n        if: needs.changes.outputs.trace == 'true' || needs.changes.outputs.planted == 'true'\n        with:\n          name: select-records-web-build-${{ github.run_attempt }}\n          path: ${{ runner.temp }}/select-records/*.json*\n          if-no-files-found: ignore\n          retention-days: 7\n      - name: Save the npm cache\n        if: github.ref == 'refs/heads/main' && (github.event_name == 'push' || github.event_name == 'schedule')\n        run: sh ci/runner/cache.sh save npm \"$HOME/.npm\"\n      - name: Save the GitHub npm cache\n        if: steps.guard.outputs.save == 'true'\n        uses: actions/cache/save@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0\n        with:\n          path: ~/.npm\n          key: npm-${{ runner.os }}-${{ hashFiles('apps/web/package-lock.json') }}\n      - name: Record passed lane\n        run: python3 -I .github/actions/docs-only/run.py stamp \"$RUNNER_TEMP/ci-plan\" build:web_export \"$RUNNER_TEMP/receipts\"\n      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2\n        with:\n          name: lane-web-build-${{ github.run_attempt }}\n          path: ${{ runner.temp }}/receipts/*.json\n          if-no-files-found: error\n          retention-days: 30\n\n  rust:\n    needs: changes\n    if: ${{ !cancelled() && needs.changes.result == 'success' && (needs.changes.outputs.rust == 'true' || needs.changes.outputs.toolkit == 'true') && needs.changes.outputs.export-rust == 'false' }}\n    runs-on: ${{ github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name != github.repository && 'ubuntu-24.04' || vars.CI_RUST_RUNS_ON || 'namespace-profile-closedwiz-rust' }}\n    timeout-minutes: 60\n    # #1266: the Rust tests split across this many members, a setting per\n    # runner kind (its runs-on label); a kind not named runs one, so a paid\n    # runner never fans out. Traced and planted runs keep one: they run the\n    # whole lane through run.py.\n    strategy:\n      fail-fast: false\n      matrix:\n        shard: ${{ fromJSON((needs.changes.outputs.trace == 'true' || needs.changes.outputs.planted == 'true') && '[1]' || fromJSON('{\"closedwiz-pc\":\"[1]\",\"ubuntu-24.04\":\"[1,2,3,4]\"}')[github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name != github.repository && 'ubuntu-24.04' || vars.CI_RUST_RUNS_ON || 'namespace-profile-closedwiz-rust'] || '[1]') }}\n    steps:\n      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n        with:\n          persist-credentials: false\n          fetch-depth: 0\n          filter: blob:none\n          sparse-checkout-cone-mode: false\n          sparse-checkout: |\n            /*\n            !/private/\n      - name: The runner guard\n        id: guard\n        env:\n          HEAD_REPO: ${{ github.event.pull_request.head.repo.full_name }}\n        run: sh ci/hosted/guard.sh\n      - name: Prune unused inputs\n        run: sh .github/actions/docs-only/prune.sh .github/actions/docs-only/ci-reads.txt rust\n      - name: Prepare lane\n        uses: ./.github/actions/docs-only/setup\n        with:\n          hosted: ${{ steps.guard.outputs.hosted }}\n          save: ${{ steps.guard.outputs.save }}\n          rust-version: ${{ env.RUST_VERSION }}\n          node-version: ${{ env.NODE_VERSION }}\n          cargo: 'true'\n          npm: ${{ needs.changes.outputs.planted == 'true' }}\n          browser: 'false'\n      - name: Python for the offline installer and release proofs\n        run: sh .github/actions/docs-only/python.sh\n      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2\n        with:\n          name: ci-selection-${{ github.run_attempt }}\n          path: ${{ runner.temp }}/ci-plan\n      - name: Build and lint Rust\n        if: strategy.job-index == 0\n        run: python3 -I .github/actions/docs-only/run.py lint \"$RUNNER_TEMP/ci-plan\"\n      # #1266: the shard balancer's, its check's and this wiring's own proofs.\n      - name: The shard balancer's tests\n        if: strategy.job-index == 0\n        run: python3 -I ci/shard/test.py\n      # #2081: the persisted plan selects only the fast core/plan proofs.\n      # Historical preparation, inherited suites, dry runs and mutants are nightly.\n      - name: The live-check toolkit (fixtures only)\n        id: toolkit\n        if: needs.changes.outputs.toolkit == 'true'\n        shell: bash\n        run: |\n          export PYTHONDONTWRITEBYTECODE=1\n          python3 tools/live-check/test_core.py\n          python3 tools/live-check/plans/test_plans.py\n      - name: Record passed toolkit\n        env:\n          TOOLKIT_RESULT: ${{ steps.toolkit.outcome }}\n        run: python3 -I .github/actions/docs-only/run.py toolkit \"$RUNNER_TEMP/ci-plan\" \"$TOOLKIT_RESULT\" \"$RUNNER_TEMP/receipts\"\n      # #1266: this member's share of the selected Rust tests, balanced by\n      # ci/shard/times.tsv. One member runs the whole lane through run.py, as\n      # before; the ci job checks that every share passed and together they\n      # hold every selected Rust test exactly once.\n      - name: The Rust shard\n        env:\n          SHARDS: ${{ strategy.job-total }}\n          SHARD: ${{ matrix.shard }}\n        run: |\n          python3 -I ci/shard/shard.py share \"$RUNNER_TEMP/ci-plan/ci-selection.json\" --shards \"$SHARDS\" --shard \"$SHARD\" --times ci/shard/times.tsv > \"$RUNNER_TEMP/rust-share.txt\"\n          echo \"rust shard $SHARD of $SHARDS: $(paste -sd ' ' \"$RUNNER_TEMP/rust-share.txt\")\"\n      - name: Run cargo test --workspace\n        env:\n          SHARDS: ${{ strategy.job-total }}\n          SHARD: ${{ matrix.shard }}\n        run: |\n          if [ \"$SHARDS\" = 1 ]; then\n            python3 -I .github/actions/docs-only/run.py execute \"$RUNNER_TEMP/ci-plan\" rust\n          elif [ -s \"$RUNNER_TEMP/rust-share.txt\" ]; then\n            # Only the first member builds the workspace (Build and lint\n            # Rust), yet tests run its binaries (tests/loops' target/debug/\n            # openwiz): each member builds them first (R2 on #2113).\n            cargo build --workspace --bins --locked\n            sh ci/rust-tests.sh --only \"$(paste -sd ' ' \"$RUNNER_TEMP/rust-share.txt\")\"\n          else\n            echo \"rust shard $SHARD of $SHARDS: no test for this member\"\n          fi\n      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2\n        if: needs.changes.outputs.trace == 'true' || needs.changes.outputs.planted == 'true'\n        with:\n          name: select-records-rust-${{ github.run_attempt }}\n          path: ${{ runner.temp }}/select-records/*.json*\n          if-no-files-found: ignore\n          retention-days: 7\n      - name: Save the cargo-rust cache\n        if: github.ref == 'refs/heads/main' && (github.event_name == 'push' || github.event_name == 'schedule') && strategy.job-index == 0\n        run: sh ci/runner/cache.sh save cargo-rust \"$HOME/.cargo/registry\" \"$GITHUB_WORKSPACE/target\"\n      - name: Save the GitHub cargo-rust cache\n        if: steps.guard.outputs.save == 'true' && strategy.job-index == 0\n        uses: actions/cache/save@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0\n        with:\n          path:  |\n            ~/.cargo/registry\n            target\n          key: cargo-rust-${{ runner.os }}-${{ env.RUST_VERSION }}-${{ hashFiles('Cargo.lock') }}-${{ github.sha }}\n      # Only once its tests passed: the ci job counts these records.\n      - name: Record passed lane\n        env:\n          SHARD: ${{ matrix.shard }}\n        run: mkdir -p \"$RUNNER_TEMP/rust-ran\" && cp \"$RUNNER_TEMP/rust-share.txt\" \"$RUNNER_TEMP/rust-ran/ran-$SHARD.txt\"\n      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2\n        with:\n          name: rust-ran-${{ github.run_attempt }}-${{ matrix.shard }}\n          path: ${{ runner.temp }}/rust-ran/ran-${{ matrix.shard }}.txt\n          if-no-files-found: error\n          retention-days: 30\n      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2\n        if: strategy.job-index == 0\n        with:\n          name: lane-rust-${{ github.run_attempt }}\n          path: ${{ runner.temp }}/receipts/*.json\n          if-no-files-found: ignore\n          retention-days: 30\n\n  rust-export:\n    needs: [changes, web-build]\n    if: ${{ !cancelled() && needs.changes.result == 'success' && (needs.changes.outputs.rust == 'true' || needs.changes.outputs.toolkit == 'true') && needs.changes.outputs.export-rust == 'true' && needs.web-build.result == 'success' }}\n    runs-on: ${{ github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name != github.repository && 'ubuntu-24.04' || vars.CI_RUST_RUNS_ON || 'namespace-profile-closedwiz-rust' }}\n    timeout-minutes: 60\n    # #1266: the Rust tests split across this many members, a setting per\n    # runner kind (its runs-on label); a kind not named runs one, so a paid\n    # runner never fans out. Traced and planted runs keep one: they run the\n    # whole lane through run.py.\n    strategy:\n      fail-fast: false\n      matrix:\n        shard: ${{ fromJSON((needs.changes.outputs.trace == 'true' || needs.changes.outputs.planted == 'true') && '[1]' || fromJSON('{\"closedwiz-pc\":\"[1]\",\"ubuntu-24.04\":\"[1,2,3,4]\"}')[github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name != github.repository && 'ubuntu-24.04' || vars.CI_RUST_RUNS_ON || 'namespace-profile-closedwiz-rust'] || '[1]') }}\n    steps:\n      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n        with:\n          persist-credentials: false\n          fetch-depth: 0\n          filter: blob:none\n          sparse-checkout-cone-mode: false\n          sparse-checkout: |\n            /*\n            !/private/\n      - name: The runner guard\n        id: guard\n        env:\n          HEAD_REPO: ${{ github.event.pull_request.head.repo.full_name }}\n        run: sh ci/hosted/guard.sh\n      - name: Prune unused inputs\n        run: sh .github/actions/docs-only/prune.sh .github/actions/docs-only/ci-reads.txt rust\n      - name: Prepare lane\n        uses: ./.github/actions/docs-only/setup\n        with:\n          hosted: ${{ steps.guard.outputs.hosted }}\n          save: ${{ steps.guard.outputs.save }}\n          rust-version: ${{ env.RUST_VERSION }}\n          node-version: ${{ env.NODE_VERSION }}\n          cargo: 'true'\n          npm: ${{ needs.changes.outputs.planted == 'true' }}\n          browser: 'false'\n      - name: Python for the offline installer and release proofs\n        run: sh .github/actions/docs-only/python.sh\n      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2\n        with:\n          name: ci-selection-${{ github.run_attempt }}\n          path: ${{ runner.temp }}/ci-plan\n      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2\n        with:\n          name: web-out\n          path: apps/web/out\n      - name: Build and lint Rust\n        if: strategy.job-index == 0\n        run: python3 -I .github/actions/docs-only/run.py lint \"$RUNNER_TEMP/ci-plan\"\n      # #1266: the shard balancer's, its check's and this wiring's own proofs.\n      - name: The shard balancer's tests\n        if: strategy.job-index == 0\n        run: python3 -I ci/shard/test.py\n      # #2081: the persisted plan selects only the fast core/plan proofs.\n      # Historical preparation, inherited suites, dry runs and mutants are nightly.\n      - name: The live-check toolkit (fixtures only)\n        id: toolkit\n        if: needs.changes.outputs.toolkit == 'true'\n        shell: bash\n        run: |\n          export PYTHONDONTWRITEBYTECODE=1\n          python3 tools/live-check/test_core.py\n          python3 tools/live-check/plans/test_plans.py\n      - name: Record passed toolkit\n        env:\n          TOOLKIT_RESULT: ${{ steps.toolkit.outcome }}\n        run: python3 -I .github/actions/docs-only/run.py toolkit \"$RUNNER_TEMP/ci-plan\" \"$TOOLKIT_RESULT\" \"$RUNNER_TEMP/receipts\"\n      # #1266: this member's share of the selected Rust tests, balanced by\n      # ci/shard/times.tsv. One member runs the whole lane through run.py, as\n      # before; the ci job checks that every share passed and together they\n      # hold every selected Rust test exactly once.\n      - name: The Rust shard\n        env:\n          SHARDS: ${{ strategy.job-total }}\n          SHARD: ${{ matrix.shard }}\n        run: |\n          python3 -I ci/shard/shard.py share \"$RUNNER_TEMP/ci-plan/ci-selection.json\" --shards \"$SHARDS\" --shard \"$SHARD\" --times ci/shard/times.tsv > \"$RUNNER_TEMP/rust-share.txt\"\n          echo \"rust shard $SHARD of $SHARDS: $(paste -sd ' ' \"$RUNNER_TEMP/rust-share.txt\")\"\n      - name: Run cargo test --workspace\n        env:\n          SHARDS: ${{ strategy.job-total }}\n          SHARD: ${{ matrix.shard }}\n        run: |\n          if [ \"$SHARDS\" = 1 ]; then\n            python3 -I .github/actions/docs-only/run.py execute \"$RUNNER_TEMP/ci-plan\" rust\n          elif [ -s \"$RUNNER_TEMP/rust-share.txt\" ]; then\n            # Only the first member builds the workspace (Build and lint\n            # Rust), yet tests run its binaries (tests/loops' target/debug/\n            # openwiz): each member builds them first (R2 on #2113).\n            cargo build --workspace --bins --locked\n            sh ci/rust-tests.sh --only \"$(paste -sd ' ' \"$RUNNER_TEMP/rust-share.txt\")\"\n          else\n            echo \"rust shard $SHARD of $SHARDS: no test for this member\"\n          fi\n      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2\n        if: needs.changes.outputs.trace == 'true' || needs.changes.outputs.planted == 'true'\n        with:\n          name: select-records-rust-export-${{ github.run_attempt }}\n          path: ${{ runner.temp }}/select-records/*.json*\n          if-no-files-found: ignore\n          retention-days: 7\n      - name: Save the cargo-rust cache\n        if: github.ref == 'refs/heads/main' && (github.event_name == 'push' || github.event_name == 'schedule') && strategy.job-index == 0\n        run: sh ci/runner/cache.sh save cargo-rust \"$HOME/.cargo/registry\" \"$GITHUB_WORKSPACE/target\"\n      - name: Save the GitHub cargo-rust cache\n        if: steps.guard.outputs.save == 'true' && strategy.job-index == 0\n        uses: actions/cache/save@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0\n        with:\n          path:  |\n            ~/.cargo/registry\n            target\n          key: cargo-rust-${{ runner.os }}-${{ env.RUST_VERSION }}-${{ hashFiles('Cargo.lock') }}-${{ github.sha }}\n      # Only once its tests passed: the ci job counts these records.\n      - name: Record passed lane\n        env:\n          SHARD: ${{ matrix.shard }}\n        run: mkdir -p \"$RUNNER_TEMP/rust-ran\" && cp \"$RUNNER_TEMP/rust-share.txt\" \"$RUNNER_TEMP/rust-ran/ran-$SHARD.txt\"\n      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2\n        with:\n          name: rust-ran-${{ github.run_attempt }}-${{ matrix.shard }}\n          path: ${{ runner.temp }}/rust-ran/ran-${{ matrix.shard }}.txt\n          if-no-files-found: error\n          retention-days: 30\n      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2\n        if: strategy.job-index == 0\n        with:\n          name: lane-rust-export-${{ github.run_attempt }}\n          path: ${{ runner.temp }}/receipts/*.json\n          if-no-files-found: ignore\n          retention-days: 30\n\n  web:\n    needs: changes\n    if: ${{ !cancelled() && needs.changes.result == 'success' && needs.changes.outputs.web == 'true' && needs.changes.outputs.export-web == 'false' }}\n    runs-on: ${{ github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name != github.repository && 'ubuntu-24.04' || vars.CI_WEB_RUNS_ON || 'namespace-profile-closedwiz-rust' }}\n    timeout-minutes: 60\n    steps:\n      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n        with:\n          persist-credentials: false\n          fetch-depth: 0\n          filter: blob:none\n          sparse-checkout-cone-mode: false\n          sparse-checkout: |\n            /*\n            !/private/\n      - name: The runner guard\n        id: guard\n        env:\n          HEAD_REPO: ${{ github.event.pull_request.head.repo.full_name }}\n        run: sh ci/hosted/guard.sh\n      - name: Prune unused inputs\n        run: sh .github/actions/docs-only/prune.sh .github/actions/docs-only/ci-reads.txt web-test\n      - name: Prepare lane\n        uses: ./.github/actions/docs-only/setup\n        with:\n          hosted: ${{ steps.guard.outputs.hosted }}\n          save: ${{ steps.guard.outputs.save }}\n          rust-version: ${{ env.RUST_VERSION }}\n          node-version: ${{ env.NODE_VERSION }}\n          cargo: 'true'\n          cache: cargo-web-test\n          npm: 'true'\n          browser: 'true'\n      - name: Python for the offline installer and release proofs\n        run: sh .github/actions/docs-only/python.sh\n      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2\n        with:\n          name: ci-selection-${{ github.run_attempt }}\n          path: ${{ runner.temp }}/ci-plan\n      - name: Run npm test\n        run: python3 -I .github/actions/docs-only/run.py execute \"$RUNNER_TEMP/ci-plan\" web\n      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2\n        if: needs.changes.outputs.trace == 'true' || needs.changes.outputs.planted == 'true'\n        with:\n          name: select-records-web-${{ github.run_attempt }}\n          path: ${{ runner.temp }}/select-records/*.json*\n          if-no-files-found: ignore\n          retention-days: 7\n      - name: Save the cargo-web-test cache\n        if: github.ref == 'refs/heads/main' && (github.event_name == 'push' || github.event_name == 'schedule')\n        run: sh ci/runner/cache.sh save cargo-web-test \"$HOME/.cargo/registry\" \"$GITHUB_WORKSPACE/target\"\n      - name: Save the GitHub cargo-web-test cache\n        if: steps.guard.outputs.save == 'true'\n        uses: actions/cache/save@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0\n        with:\n          path:  |\n            ~/.cargo/registry\n            target\n          key: cargo-web-test-${{ runner.os }}-${{ env.RUST_VERSION }}-${{ hashFiles('Cargo.lock') }}-${{ github.sha }}\n      - name: Save the npm cache\n        if: github.ref == 'refs/heads/main' && (github.event_name == 'push' || github.event_name == 'schedule')\n        run: sh ci/runner/cache.sh save npm \"$HOME/.npm\"\n      - name: Save the GitHub npm cache\n        if: steps.guard.outputs.save == 'true'\n        uses: actions/cache/save@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0\n        with:\n          path: ~/.npm\n          key: npm-${{ runner.os }}-${{ hashFiles('apps/web/package-lock.json') }}\n      - name: Record passed lane\n        run: python3 -I .github/actions/docs-only/run.py stamp \"$RUNNER_TEMP/ci-plan\" web \"$RUNNER_TEMP/receipts\"\n      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2\n        with:\n          name: lane-web-${{ github.run_attempt }}\n          path: ${{ runner.temp }}/receipts/*.json\n          if-no-files-found: error\n          retention-days: 30\n\n  web-export:\n    needs: [changes, web-build]\n    if: ${{ !cancelled() && needs.changes.result == 'success' && needs.changes.outputs.web == 'true' && needs.changes.outputs.export-web == 'true' && needs.web-build.result == 'success' }}\n    runs-on: ${{ github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name != github.repository && 'ubuntu-24.04' || vars.CI_WEB_RUNS_ON || 'namespace-profile-closedwiz-rust' }}\n    timeout-minutes: 60\n    steps:\n      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n        with:\n          persist-credentials: false\n          fetch-depth: 0\n          filter: blob:none\n          sparse-checkout-cone-mode: false\n          sparse-checkout: |\n            /*\n            !/private/\n      - name: The runner guard\n        id: guard\n        env:\n          HEAD_REPO: ${{ github.event.pull_request.head.repo.full_name }}\n        run: sh ci/hosted/guard.sh\n      - name: Prune unused inputs\n        run: sh .github/actions/docs-only/prune.sh .github/actions/docs-only/ci-reads.txt web-test\n      - name: Prepare lane\n        uses: ./.github/actions/docs-only/setup\n        with:\n          hosted: ${{ steps.guard.outputs.hosted }}\n          save: ${{ steps.guard.outputs.save }}\n          rust-version: ${{ env.RUST_VERSION }}\n          node-version: ${{ env.NODE_VERSION }}\n          cargo: 'true'\n          cache: cargo-web-test\n          npm: 'true'\n          browser: 'true'\n      - name: Python for the offline installer and release proofs\n        run: sh .github/actions/docs-only/python.sh\n      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2\n        with:\n          name: ci-selection-${{ github.run_attempt }}\n          path: ${{ runner.temp }}/ci-plan\n      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2\n        with:\n          name: web-out\n          path: apps/web/out\n      - name: Run npm test\n        run: python3 -I .github/actions/docs-only/run.py execute \"$RUNNER_TEMP/ci-plan\" web\n      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2\n        if: needs.changes.outputs.trace == 'true' || needs.changes.outputs.planted == 'true'\n        with:\n          name: select-records-web-export-${{ github.run_attempt }}\n          path: ${{ runner.temp }}/select-records/*.json*\n          if-no-files-found: ignore\n          retention-days: 7\n      - name: Save the cargo-web-test cache\n        if: github.ref == 'refs/heads/main' && (github.event_name == 'push' || github.event_name == 'schedule')\n        run: sh ci/runner/cache.sh save cargo-web-test \"$HOME/.cargo/registry\" \"$GITHUB_WORKSPACE/target\"\n      - name: Save the GitHub cargo-web-test cache\n        if: steps.guard.outputs.save == 'true'\n        uses: actions/cache/save@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0\n        with:\n          path:  |\n            ~/.cargo/registry\n            target\n          key: cargo-web-test-${{ runner.os }}-${{ env.RUST_VERSION }}-${{ hashFiles('Cargo.lock') }}-${{ github.sha }}\n      - name: Save the npm cache\n        if: github.ref == 'refs/heads/main' && (github.event_name == 'push' || github.event_name == 'schedule')\n        run: sh ci/runner/cache.sh save npm \"$HOME/.npm\"\n      - name: Save the GitHub npm cache\n        if: steps.guard.outputs.save == 'true'\n        uses: actions/cache/save@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0\n        with:\n          path: ~/.npm\n          key: npm-${{ runner.os }}-${{ hashFiles('apps/web/package-lock.json') }}\n      - name: Record passed lane\n        run: python3 -I .github/actions/docs-only/run.py stamp \"$RUNNER_TEMP/ci-plan\" web \"$RUNNER_TEMP/receipts\"\n      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2\n        with:\n          name: lane-web-export-${{ github.run_attempt }}\n          path: ${{ runner.temp }}/receipts/*.json\n          if-no-files-found: error\n          retention-days: 30\n\n  site:\n    needs: changes\n    if: ${{ !cancelled() && needs.changes.result == 'success' && needs.changes.outputs.site == 'true' }}\n    runs-on: ${{ github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name != github.repository && 'ubuntu-24.04' || vars.CI_WEB_RUNS_ON || 'namespace-profile-closedwiz-rust' }}\n    timeout-minutes: 30\n    steps:\n      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n        with:\n          persist-credentials: false\n          fetch-depth: 0\n          filter: blob:none\n          sparse-checkout-cone-mode: false\n          sparse-checkout: |\n            /*\n            !/private/\n      - name: The runner guard\n        id: guard\n        env:\n          HEAD_REPO: ${{ github.event.pull_request.head.repo.full_name }}\n        run: sh ci/hosted/guard.sh\n      - name: Prune unused inputs\n        run: sh .github/actions/docs-only/prune.sh .github/actions/docs-only/ci-reads.txt web-build\n      - name: Prepare lane\n        uses: ./.github/actions/docs-only/setup\n        with:\n          hosted: ${{ steps.guard.outputs.hosted }}\n          save: ${{ steps.guard.outputs.save }}\n          rust-version: ${{ env.RUST_VERSION }}\n          node-version: ${{ env.NODE_VERSION }}\n          cargo: 'false'\n          npm: 'true'\n          browser: 'true'\n      - name: Python for the offline installer and release proofs\n        run: sh .github/actions/docs-only/python.sh\n      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2\n        with:\n          name: ci-selection-${{ github.run_attempt }}\n          path: ${{ runner.temp }}/ci-plan\n      - name: Build and test the public static site\n        run: python3 -I .github/actions/docs-only/run.py execute \"$RUNNER_TEMP/ci-plan\" site\n      - name: Save the npm cache\n        if: github.ref == 'refs/heads/main' && (github.event_name == 'push' || github.event_name == 'schedule')\n        run: sh ci/runner/cache.sh save npm \"$HOME/.npm\"\n      - name: Save the GitHub npm cache\n        if: steps.guard.outputs.save == 'true'\n        uses: actions/cache/save@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0\n        with:\n          path: ~/.npm\n          key: npm-${{ runner.os }}-${{ hashFiles('apps/web/package-lock.json') }}\n      - name: Record passed lane\n        run: python3 -I .github/actions/docs-only/run.py stamp \"$RUNNER_TEMP/ci-plan\" site \"$RUNNER_TEMP/receipts\"\n      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2\n        with:\n          name: lane-site-${{ github.run_attempt }}\n          path: ${{ runner.temp }}/receipts/*.json\n          if-no-files-found: error\n          retention-days: 30\n\n  release:\n    needs: changes\n    if: ${{ !cancelled() && needs.changes.result == 'success' && needs.changes.outputs.release == 'true' }}\n    runs-on: ${{ github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name != github.repository && 'ubuntu-24.04' || vars.CI_WEB_RUNS_ON || 'namespace-profile-closedwiz-rust' }}\n    timeout-minutes: 60\n    steps:\n      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n        with:\n          persist-credentials: false\n          fetch-depth: 0\n          filter: blob:none\n          sparse-checkout-cone-mode: false\n          sparse-checkout: |\n            /*\n            !/private/\n      - name: The runner guard\n        id: guard\n        env:\n          HEAD_REPO: ${{ github.event.pull_request.head.repo.full_name }}\n        run: sh ci/hosted/guard.sh\n      - name: Prune unused inputs\n        run: sh .github/actions/docs-only/prune.sh .github/actions/docs-only/ci-reads.txt release\n      - name: Prepare lane\n        uses: ./.github/actions/docs-only/setup\n        with:\n          hosted: ${{ steps.guard.outputs.hosted }}\n          save: ${{ steps.guard.outputs.save }}\n          rust-version: ${{ env.RUST_VERSION }}\n          node-version: ${{ env.NODE_VERSION }}\n          cargo: 'true'\n          cache: cargo-web-test\n          npm: 'true'\n          browser: 'true'\n      - name: Python for the offline installer and release proofs\n        run: sh .github/actions/docs-only/python.sh\n      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2\n        with:\n          name: ci-selection-${{ github.run_attempt }}\n          path: ${{ runner.temp }}/ci-plan\n      - name: The release proofs\n        run: python3 -I .github/actions/docs-only/run.py execute \"$RUNNER_TEMP/ci-plan\" release\n      - name: Save the npm cache\n        if: github.ref == 'refs/heads/main' && (github.event_name == 'push' || github.event_name == 'schedule')\n        run: sh ci/runner/cache.sh save npm \"$HOME/.npm\"\n      - name: Save the GitHub npm cache\n        if: steps.guard.outputs.save == 'true'\n        uses: actions/cache/save@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0\n        with:\n          path: ~/.npm\n          key: npm-${{ runner.os }}-${{ hashFiles('apps/web/package-lock.json') }}\n      - name: Record passed lane\n        run: python3 -I .github/actions/docs-only/run.py stamp \"$RUNNER_TEMP/ci-plan\" release \"$RUNNER_TEMP/receipts\"\n      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2\n        with:\n          name: lane-release-${{ github.run_attempt }}\n          path: ${{ runner.temp }}/receipts/*.json\n          if-no-files-found: error\n          retention-days: 30\n\n  skills:\n    needs: changes\n    if: ${{ !cancelled() && needs.changes.result == 'success' && needs.changes.outputs.skills != '[]' && needs.changes.outputs.skills != '' }}\n    runs-on: ${{ github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name != github.repository && 'ubuntu-24.04' || vars.CI_WEB_RUNS_ON || 'namespace-profile-closedwiz-rust' }}\n    timeout-minutes: ${{ matrix.skill == 'launch-fleet' && 60 || 30 }}\n    strategy:\n      fail-fast: false\n      matrix:\n        skill: ${{ fromJSON(needs.changes.outputs.skills) }}\n    steps:\n      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n        with:\n          persist-credentials: false\n          fetch-depth: 0\n          filter: blob:none\n          sparse-checkout-cone-mode: false\n          sparse-checkout: |\n            /*\n            !/private/\n      - name: The runner guard\n        id: guard\n        env:\n          HEAD_REPO: ${{ github.event.pull_request.head.repo.full_name }}\n        run: sh ci/hosted/guard.sh\n      - name: Prune unused inputs\n        run: sh .github/actions/docs-only/prune.sh .github/actions/docs-only/ci-reads.txt rust\n      - name: Prepare lane\n        uses: ./.github/actions/docs-only/setup\n        with:\n          hosted: ${{ steps.guard.outputs.hosted }}\n          save: ${{ steps.guard.outputs.save }}\n          rust-version: ${{ env.RUST_VERSION }}\n          node-version: ${{ env.NODE_VERSION }}\n          cargo: 'false'\n          npm: ${{ matrix.skill == 'image' }}\n          browser: ${{ matrix.skill == 'image' }}\n      - name: Python for the offline installer and release proofs\n        run: sh .github/actions/docs-only/python.sh\n      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2\n        with:\n          name: ci-selection-${{ github.run_attempt }}\n          path: ${{ runner.temp }}/ci-plan\n      - name: The skills' tests\n        run: python3 -I .github/actions/docs-only/run.py execute \"$RUNNER_TEMP/ci-plan\" skill:${{ matrix.skill }}\n      - name: Record passed lane\n        run: python3 -I .github/actions/docs-only/run.py stamp \"$RUNNER_TEMP/ci-plan\" skill:${{ matrix.skill }} \"$RUNNER_TEMP/receipts\"\n      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2\n        with:\n          name: lane-skill-${{ matrix.skill }}-${{ github.run_attempt }}\n          path: ${{ runner.temp }}/receipts/*.json\n          if-no-files-found: error\n          retention-days: 30\n\n  toolkit-nightly:\n    if: github.event_name == 'schedule' && github.ref == 'refs/heads/main'\n    runs-on: ${{ github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name != github.repository && 'ubuntu-24.04' || vars.CI_RUST_RUNS_ON || 'namespace-profile-closedwiz-rust' }}\n    timeout-minutes: 360\n    permissions:\n      contents: read\n    steps:\n      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n        with:\n          persist-credentials: false\n          fetch-depth: 0\n          filter: blob:none\n          sparse-checkout-cone-mode: false\n          sparse-checkout: |\n            /*\n            !/private/\n      # The runner guard (#1265), before anything the change ships runs: a\n      # fork's pull request fails off GitHub's runners, and whether this job\n      # may save GitHub's cache (ci/hosted/guard.sh).\n      - name: The runner guard\n        id: guard\n        env:\n          HEAD_REPO: ${{ github.event.pull_request.head.repo.full_name }}\n        run: sh ci/hosted/guard.sh\n      # LT3 (#242): the same reviewed checkout action fetches only the pinned\n      # fixture inputs during initial preparation and removes its credentials\n      # before returning. The main checkout/private exclusion stays unchanged.\n      - name: Private live-check fixture destination\n        shell: bash\n        run: |\n          git_version=\"$(git --version)\"\n          if [[ ! \"$git_version\" =~ ^git\\ version\\ ([0-9]+)\\.([0-9]+)\\.[0-9]+[^[:cntrl:]]*$ ]] ||\n             (( 10#${BASH_REMATCH[1]} < 2 || (10#${BASH_REMATCH[1]} == 2 && 10#${BASH_REMATCH[2]} < 28) )); then\n            echo \"sparse-capable Git 2.28 or newer is required\" >&2\n            exit 1\n          fi\n          install -d -m 0700 \"$GITHUB_WORKSPACE/.lt3-fixture-source\"\n      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n        name: The reviewed live-check fixture source\n        with:\n          ref: 660c1692f3343cec36883abd57b5c88237ac5f44\n          persist-credentials: false\n          fetch-depth: 1\n          filter: blob:none\n          sparse-checkout-cone-mode: false\n          path: .lt3-fixture-source\n          sparse-checkout: |\n            /Cargo.toml\n            /Cargo.lock\n            /crates/\n            /tests/\n            /contracts/\n            /apps/web/\n      - name: Seal the live-check fixture source\n        shell: bash\n        run: |\n          source=\"$GITHUB_WORKSPACE/.lt3-fixture-source\"\n          # The action warns rather than failing on some auth-cleanup errors.\n          # Verify its credential files are gone and only known non-auth Git\n          # metadata remains; never read includes or print configuration values.\n          test -d \"$RUNNER_TEMP\" && test -r \"$RUNNER_TEMP\" && test -x \"$RUNNER_TEMP\"\n          shopt -s nullglob\n          checkout_credentials=(\"$RUNNER_TEMP\"/git-credentials-*.config)\n          if [ \"${#checkout_credentials[@]}\" -ne 0 ]; then\n            echo \"checkout credential cleanup is incomplete; no tests started\" >&2\n            exit 1\n          fi\n          for repository in \"$GITHUB_WORKSPACE\" \"$source\"; do\n            for configuration in \"$repository/.git/config\" \"$repository/.git/config.worktree\"; do\n              if [[ \"$configuration\" == */config.worktree && ! -e \"$configuration\" && ! -L \"$configuration\" ]]; then\n                continue\n              fi\n              if ! config_names=\"$(git config --file \"$configuration\" --no-includes --name-only --list 2>/dev/null)\"; then\n                echo \"cannot verify checkout credential cleanup; no tests started\" >&2\n                exit 1\n              fi\n              while IFS= read -r key; do\n                case \"${key,,}\" in\n                  core.repositoryformatversion|core.filemode|core.bare|core.logallrefupdates|core.sparsecheckout|core.sparsecheckoutcone|extensions.worktreeconfig|extensions.partialclone|extensions.objectformat|remote.origin.url|remote.origin.fetch|remote.origin.promisor|remote.origin.partialclonefilter|gc.auto|branch.*.remote|branch.*.merge|'') ;;\n                  *)\n                    echo \"checkout credential cleanup is incomplete; no tests started\" >&2\n                    exit 1 ;;\n                esac\n              done <<< \"$config_names\"\n            done\n          done\n          if [ \"$(git -C \"$source\" rev-parse HEAD)\" != 660c1692f3343cec36883abd57b5c88237ac5f44 ]; then\n            echo \"live-check fixture source revision mismatch\" >&2\n            exit 1\n          fi\n          for path in Cargo.toml Cargo.lock; do\n            if [ ! -f \"$source/$path\" ]; then\n              echo \"missing live-check fixture prerequisite: $path\" >&2\n              exit 1\n            fi\n          done\n          for path in crates tests contracts apps/web; do\n            if [ ! -d \"$source/$path\" ]; then\n              echo \"missing live-check fixture prerequisite: $path\" >&2\n              exit 1\n            fi\n          done\n          test ! -e \"$source/private\"\n          test ! -e \"$RUNNER_TEMP/live-check-source\"\n          git -C \"$source\" remote remove origin\n          mv \"$source\" \"$RUNNER_TEMP/live-check-source\"\n          chmod 0700 \"$RUNNER_TEMP/live-check-source\"\n      - name: Python for the offline installer and release proofs\n        run: |\n          if ! command -v python3 > /dev/null; then\n            case \"$(uname -m)\" in\n              x86_64) sum=df15fe60d3ff55bf9dcf25824b5572756bb8816ff93865a273d3301d7066a8b7 ;;\n              aarch64) sum=578d9da1983463ffb0c8c98ab0da2f18177f44069328eb0af847860c1eb05c3e ;;\n              *) echo \"no pinned Python for $(uname -m)\" >&2; exit 1 ;;\n            esac\n            curl -fsSL --retry 5 --retry-delay 10 -o \"$RUNNER_TEMP/python.tar.gz\" \\\n              \"https://github.com/astral-sh/python-build-standalone/releases/download/20261026/cpython-3.13.18+20261026-$(uname -m)-unknown-linux-gnu-install_only_stripped.tar.gz\"\n            echo \"$sum  $RUNNER_TEMP/python.tar.gz\" | sha256sum -c -\n            python=\"$(mktemp -d \"$RUNNER_TEMP/python.XXXXXX\")\"\n            tar -xzf \"$RUNNER_TEMP/python.tar.gz\" -C \"$python\" --strip-components=1\n            export PATH=\"$python/bin:$PATH\"\n            echo \"$python/bin\" >> \"$GITHUB_PATH\"\n          fi\n      - name: Rust ${{ env.RUST_VERSION }}\n        run: |\n          rustup toolchain install \"$RUST_VERSION\" --profile minimal --no-self-update\n          rustup default \"$RUST_VERSION\"\n          rustc --version && cargo --version\n      - name: zsh\n        run: |\n          command -v zsh > /dev/null || { sudo apt-get update -q && sudo apt-get install -y zsh; }\n          zsh --version\n      - name: The live-check toolkit (nightly fixtures and mutants)\n        shell: bash\n        run: |\n          export PYTHONDONTWRITEBYTECODE=1\n          fixture=\"$(mktemp -d \"$RUNNER_TEMP/live-check.XXXXXX\")\"\n          evidence=\"$RUNNER_TEMP/live-check-evidence\"\n          mkdir -m 0700 \"$evidence\"\n          export KIT_SOURCE_ROOT=\"$RUNNER_TEMP/live-check-source\"\n          export KIT_TARGET=\"$fixture/target\"\n          export CARGO_BUILD_JOBS=2\n          finish_live_check() {\n            toolkit_status=$?\n            set +e\n            trap - EXIT\n            if [ \"$toolkit_status\" -ne 0 ]; then\n              for log in \"$evidence\"/plan-*.log \"$evidence\"/mutants/*.log; do\n                [ -f \"$log\" ] || continue\n                case \"$log\" in\n                  \"$evidence\"/mutants/*)\n                    record=\"${log%.log}.json\"\n                    if [ -f \"$record\" ] && jq -e '.ok == true' \"$record\" >/dev/null 2>&1; then\n                      continue\n                    fi ;;\n                esac\n                printf '\\nLive-check failure details: %s\\n' \"${log##*/}\"\n                cat \"$log\" || echo \"could not read live-check failure log\" >&2\n              done\n            fi\n            if ! rm -rf \"$fixture\" \"$KIT_SOURCE_ROOT\"; then\n              [ \"$toolkit_status\" -ne 0 ] || toolkit_status=1\n            fi\n            printf '{\"exit\": %s}\\n' \"$toolkit_status\" > \"$evidence/result.json\" || toolkit_status=1\n            exit \"$toolkit_status\"\n          }\n          trap finish_live_check EXIT\n          # tee finishes before the step ends; pipefail preserves any failing\n          # command. Keep the full stream and all plan/mutant records, even red.\n          {\n          command -v lsof > /dev/null\n          command -v jq > /dev/null\n          test -f \"$KIT_SOURCE_ROOT/Cargo.lock\"\n          fixture_remotes=\"$(git -C \"$KIT_SOURCE_ROOT\" remote)\"\n          test -z \"$fixture_remotes\"\n          git -C \"$KIT_SOURCE_ROOT\" rev-parse HEAD > \"$evidence/source-head.txt\"\n          git rev-parse HEAD > \"$evidence/toolkit-head.txt\"\n          CARGO_TARGET_DIR=\"$KIT_TARGET\" cargo build --manifest-path \"$KIT_SOURCE_ROOT/Cargo.toml\" --release --locked \\\n            -p openwiz-cli -p openwiz-server -p openwiz-tests\n          export KIT_NO_BUILD=1\n          python3 tools/live-check/test_mutants.py\n          sh tools/live-check/send/scripts/test/c8-tests.sh\n          sh tools/live-check/send/scripts/test/kit-tests.sh\n          sh tools/live-check/send/scripts/test/sol-tests.sh\n          sh tools/live-check/new/scripts/test/kit-tests.sh\n          python3 tools/live-check/plans/dry-run.py --profile send --log \"$evidence/plan-send.log\"\n          python3 tools/live-check/plans/dry-run.py --profile new --log \"$evidence/plan-new.log\"\n          python3 tools/live-check/mutants.py --logs \"$evidence/mutants\" --jobs 2\n          } 2>&1 | tee \"$evidence/full.log\"\n      - name: Keep the nightly toolkit evidence\n        if: always()\n        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2\n        with:\n          name: live-check-evidence-${{ github.run_id }}-${{ github.run_attempt }}\n          path: ${{ runner.temp }}/live-check-evidence\n          if-no-files-found: error\n          retention-days: 7\n\n  # The next map (#432): after a traced run whose three jobs all passed, the\n  # records each traced job kept become one map (map.py, which refuses a map\n  # missing any test). A push or the nightly run on main signs it (GitHub's\n  # OIDC token, bound to the map's bytes) and keeps both in GitHub's cache,\n  # where web-build's selector finds the newest; any run keeps them as an\n  # artifact too (a PR that changes the tracer: its proof map). Not a\n  # required check: without it, pull requests run every test.\n  select-map:\n    needs: [changes, ci]\n    # Its failure never fails the run: main's and the nightly's results are\n    # the three required jobs'. A failed select-map only means no new map.\n    continue-on-error: true\n    if: ${{ !cancelled() && needs.changes.outputs.trace == 'true' && needs.ci.result == 'success' }}\n    runs-on: ${{ github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name != github.repository && 'ubuntu-24.04' || vars.CI_SMALL_RUNS_ON || vars.CI_WEB_RUNS_ON || 'namespace-profile-closedwiz-rust' }}\n    timeout-minutes: 10\n    steps:\n      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n        with:\n          persist-credentials: false\n          fetch-depth: 0\n          filter: blob:none\n          sparse-checkout-cone-mode: false\n          sparse-checkout: |\n            /*\n            !/private/\n      # The runner guard (#1265), before anything the change ships runs: a\n      # fork's pull request fails off GitHub's runners, and whether this job\n      # may save GitHub's cache (ci/hosted/guard.sh).\n      - name: The runner guard\n        id: guard\n        working-directory: .\n        env:\n          HEAD_REPO: ${{ github.event.pull_request.head.repo.full_name }}\n        run: sh ci/hosted/guard.sh\n      - name: Python for the offline installer and release proofs\n        run: sh .github/actions/docs-only/python.sh\n      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2\n        with:\n          pattern: select-records-*-${{ github.run_attempt }}\n          merge-multiple: true\n          path: ${{ runner.temp }}/select-records\n      - name: Save the select-map cache\n        id: map\n        env:\n          MAIN: ${{ github.ref == 'refs/heads/main' && (github.event_name == 'push' || github.event_name == 'schedule') }}\n        run: |\n          dir=\"$HOME/.cache/closedwiz-ci-select\"\n          mkdir -p \"$dir\"\n          python3 -I ci/select/map.py \"$dir/map.json\" --commit \"$GITHUB_SHA\" --root . \"$RUNNER_TEMP/select-records\"\n          if [ \"$MAIN\" = true ]; then\n            python3 -I ci/select/job.py sign \"$dir/map.json\" \"$dir/map.jwt\"\n            echo \"save=true\" >> \"$GITHUB_OUTPUT\"\n          fi\n      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2\n        with:\n          name: ci-select-map\n          path: ~/.cache/closedwiz-ci-select\n          if-no-files-found: error\n          retention-days: 30\n      - name: Save the select-map GitHub cache\n        if: steps.map.outputs.save == 'true'\n        uses: actions/cache/save@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0\n        with:\n          path: ~/.cache/closedwiz-ci-select\n          key: ci-select-map-${{ github.run_id }}-${{ github.run_attempt }}\n\n  ci:\n    needs: [changes, always, web-build, rust, rust-export, web, web-export, site, release, skills]\n    if: ${{ always() }}\n    runs-on: ${{ github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name != github.repository && 'ubuntu-24.04' || vars.CI_SMALL_RUNS_ON || vars.CI_WEB_RUNS_ON || 'namespace-profile-closedwiz-rust' }}\n    timeout-minutes: 10\n    steps:\n      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n        with:\n          persist-credentials: false\n          fetch-depth: 0\n          filter: blob:none\n          sparse-checkout-cone-mode: false\n          sparse-checkout: |\n            /*\n            !/private/\n      - name: The runner guard\n        id: guard\n        env:\n          HEAD_REPO: ${{ github.event.pull_request.head.repo.full_name }}\n        run: sh ci/hosted/guard.sh\n      - name: Python for the offline installer and release proofs\n        run: sh .github/actions/docs-only/python.sh\n      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2\n        with:\n          name: ci-selection-${{ github.run_attempt }}\n          path: ${{ runner.temp }}/ci-plan\n      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2\n        with:\n          pattern: lane-*-${{ github.run_attempt }}\n          merge-multiple: true\n          path: ${{ runner.temp }}/receipts\n      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333 # v8.0.2\n        if: needs.rust.result == 'success' || needs.rust-export.result == 'success'\n        with:\n          pattern: rust-ran-${{ github.run_attempt }}-*\n          merge-multiple: true\n          path: ${{ runner.temp }}/rust-ran\n      # #1266: the Rust lane's shards, counted. Each member that passed left\n      # its share; together they must hold every selected Rust test exactly\n      # once, and only then is the Rust lane's receipt written.\n      - name: Every Rust test ran exactly once\n        if: needs.rust.result == 'success' || needs.rust-export.result == 'success'\n        run: |\n          python3 -I ci/shard/shard.py check \"$RUNNER_TEMP/ci-plan/ci-selection.json\" \"$RUNNER_TEMP\"/rust-ran/ran-*.txt\n          python3 -I .github/actions/docs-only/run.py stamp \"$RUNNER_TEMP/ci-plan\" rust \"$RUNNER_TEMP/receipts\"\n      - name: Every planned lane passed\n        env:\n          NEEDS: ${{ toJSON(needs) }}\n        run: |\n          printf '%s' \"$NEEDS\" > \"$RUNNER_TEMP/needs.json\"\n          python3 -I .github/actions/docs-only/run.py finish \"$RUNNER_TEMP/ci-plan\" \"$RUNNER_TEMP/needs.json\" \"$RUNNER_TEMP/receipts\"\n      # C7 shadow evidence: finish is not terminal ci or complete coverage.\n      - name: Preserve incomplete combined-main evidence\n        id: main_shadow\n        continue-on-error: true\n        if: success() && ((github.event_name == 'push' && github.ref == 'refs/heads/main') || (github.event_name == 'merge_group' && github.event.merge_group.base_ref == 'refs/heads/main'))\n        run: |\n          mkdir -p \"$RUNNER_TEMP/main-shadow\"\n          python3 -I ci/main-batch/shadow.py capture \"$RUNNER_TEMP/ci-plan\" \"$RUNNER_TEMP/needs.json\" \"$RUNNER_TEMP/receipts\" \"$RUNNER_TEMP/main-shadow/observation.json\"\n      - name: Keep the incomplete combined-main evidence\n        continue-on-error: true\n        if: success() && steps.main_shadow.outcome == 'success' && ((github.event_name == 'push' && github.ref == 'refs/heads/main') || (github.event_name == 'merge_group' && github.event.merge_group.base_ref == 'refs/heads/main'))\n        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2\n        with:\n          name: main-shadow-${{ github.run_attempt }}\n          path: ${{ runner.temp }}/main-shadow/observation.json\n          if-no-files-found: error\n          retention-days: 30\n\n  # Transition bridge: the ruleset still names web-test until the orchestrator\n  # switches it at merge. It follows ci so that this PR can satisfy that old\n  # name without letting any new lane failure through the old ruleset.\n  web-test:\n    needs: ci\n    if: ${{ always() }}\n    runs-on: ${{ github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name != github.repository && 'ubuntu-24.04' || vars.CI_SMALL_RUNS_ON || vars.CI_WEB_RUNS_ON || 'namespace-profile-closedwiz-rust' }}\n    timeout-minutes: 10\n    steps:\n      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1\n        with:\n          persist-credentials: false\n          fetch-depth: 0\n          filter: blob:none\n          sparse-checkout-cone-mode: false\n          sparse-checkout: |\n            /*\n            !/private/\n      - name: The runner guard\n        id: guard\n        env:\n          HEAD_REPO: ${{ github.event.pull_request.head.repo.full_name }}\n        run: sh ci/hosted/guard.sh\n      - name: Legacy checks follow ci\n        env:\n          CI_RESULT: ${{ needs.ci.result }}\n        run: test \"$CI_RESULT\" = success\n"
}
