[Unit]
Description=OpenWiz service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/.local/lib/openwiz/source
ExecStart=%h/.local/lib/openwiz/current/openwiz-service
Restart=always
RestartSec=5
UMask=0077
Environment=OPENWIZ_STATE_DIR=%h/.local/state/openwiz
KillMode=control-group

[Install]
WantedBy=default.target
