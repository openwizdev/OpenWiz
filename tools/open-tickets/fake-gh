    prefix = 'repos/' + public + '/git/matching-refs/heads/'
    if args[:3] == ['api', '--method', 'GET'] and args[-1].startswith(prefix):
        ref = 'refs/heads/' + args[-1][len(prefix):]
        answer([{'ref': key, 'object': {'sha': value}} for key, value in world['refs'].items() if key.startswith(ref)])
    if args[:3] == ['api', '--method', 'PATCH'] and args[-2:] == ['--input', '-']:
        prefix = 'repos/' + public + '/issues/'
        if not args[3].startswith(prefix):
            sys.exit('fake-gh: prohibited patch')
        n = args[3][len(prefix):]
        payload = json.load(sys.stdin)
