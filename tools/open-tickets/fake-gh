        match = re.fullmatch('repos/' + private + r'/issues/([1-9][0-9]*)/comments\?per_page=100', endpoint)
        if match:
            if world.get('collect_fault') == 'stale-approval' and match[1] == '9001':
                answer([[{'id': 9000000001, 'body': '**Plan graph approved by Synthetic, 2030-01-02:** approved\nFingerprint: `' + '0' * 64 + '`'}]])
            answer([[] if world.get('hide_comments_for') == match[1] else world['comments'].get(match[1], [])])
        if endpoint != 'repos/' + private + '/issues?state=open&per_page=100':
            sys.exit('fake-gh: unknown paginated read')
