    if args == ['api', '--method', 'GET', 'repos/' + private]:
        answer({'open_issues_count': sum(i['state'] == 'open' for i in fixture['graph']['items']) +
                (1 if world.get('collect_fault') == 'count-changed' else 0)})
    if args == ['api', '--method', 'GET', '--paginate', '--slurp', 'repos/' + private + '/issues?state=open&per_page=100']:
        rows = [dict(number=i['number'], **({'pull_request': {}} if i['kind'] == 'pull_request' else {}))
                for i in fixture['graph']['items'] if i['state'] == 'open']
        if world.get('collect_fault') == 'inventory-changed' and Path(os.environ['OPEN_TICKETS_LOG']).read_text().count(args[-1]) % 2 == 0:
            next(row for row in rows if row['number'] == 9003)['pull_request'] = {}
        answer([rows])
    if args == ['api', '--method', 'GET', 'repos/' + private + '/issues/1257']:
        answer({'sub_issues_summary': {'total': len(world.get('remaining', [1283]))}})
    if args[:3] == ['api', '--method', 'POST'] and args[-2:] == ['--input', '-']:
        if args[3] == 'repos/' + public + '/issues':
            payload = json.load(sys.stdin)
            if set(payload) != {'title', 'body', 'labels', 'milestone'} or not isinstance(payload['labels'], list):
                sys.exit('fake-gh: invalid creation payload')
            n = max([4000] + list(map(int, world['created']))) + 1
            milestone = next((m for m in fixture['graph']['milestones'] if m['number'] == payload['milestone']), None)
            world['created'][str(n)] = {'number': n, 'title': payload['title'], 'body': payload['body'],
                'labels': [{'name': label} for label in payload['labels']],
                'milestone': milestone, 'parent': None, 'blockedBy': {'nodes': [], 'totalCount': 0}}
            answer({'number': n}, write=True)
        if args[3] == 'repos/' + public + '/pulls':
            payload = json.load(sys.stdin)
            if set(payload) != {'title', 'body', 'base', 'head'} or payload['base'] != 'main':
                sys.exit('fake-gh: invalid PR creation')
            ref = 'refs/heads/' + payload['head']
            if ref not in world['refs']:
                sys.exit('fake-gh: absent PR head')
            n = max([4000] + list(map(int, world['created']))) + 1
            world['created'][str(n)] = dict(number=n, title=payload['title'], body=payload['body'],
                labels=[], milestone=None, pull_request={}, state='OPEN', headRefName=payload['head'],
                headRefOid=world['refs'][ref], baseRefName='main', baseRefOid=world['public_base'], isCrossRepository=False)
            answer({'number': n}, write=True)
        match = re.fullmatch('repos/' + private + r'/issues/([1-9][0-9]*)/comments', args[3])
        if not match:
            sys.exit('fake-gh: prohibited source mutation')
        body = json.load(sys.stdin)['body']
        if not (body.startswith('**Private record for OpenWiz #') or body.startswith('moved to [OpenWiz #')):
            sys.exit('fake-gh: non-contract source comment')
        rows = world['comments'].setdefault(match[1], [])
        new = 9000000001 + sum(len(v) for v in world['comments'].values())
        rows.append({'id': new, 'body': body})
        answer({'id': new}, write=True)
    if args[:2] in (['issue', 'create'], ['issue', 'edit'], ['pr', 'edit']):
        verb = args[1]
