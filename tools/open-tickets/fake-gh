                descriptor = fixture['pulls'][n]
                source.update(baseRefOid=descriptor.get('observed_base', descriptor['source_base']), headRefOid=descriptor['source_head'])
            if world.get('collect_fault') == 'partial-graph' and 'subIssues' in fields:
                source['subIssues']['totalCount'] += 1
            if world.get('collect_fault') == 'changed-source' and 'subIssues' in fields:
                calls = Path(os.environ['OPEN_TICKETS_LOG']).read_text().count('subIssues')
                if calls > 4:
