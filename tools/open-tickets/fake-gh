                    value['url'] = 'https://github.com/foreign-synthetic/repo/issues/' + str(node['number'])
                return value
            if value.get('parent') is not None:
                value['parent'] = decorate(value['parent'])
            if 'blockedBy' in value:
                value['blockedBy'] = dict(value['blockedBy'], nodes=[decorate(node) for node in value['blockedBy']['nodes']])
            answer(value)
        sys.exit('fake-gh: unknown destination view')
    if args[:5] == ['api', '--method', 'GET', '--paginate', '--slurp']:
        endpoint = args[-1]
        if endpoint == 'repos/' + private + '/issues/1257/sub_issues?per_page=100':
