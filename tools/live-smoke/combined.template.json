{
  "schema": "openwiz.live-smoke-kit.v1",
  "mode": "@mode",
  "cwd": "@scratch_checkout",
  "openwiz": "@openwiz",
  "artifacts": "@artifacts",
  "source": "@source",
  "env": "@env",
  "timeout_seconds": 70,
  "steps": [
    {"id": "quiet_before", "claim": "read_safety", "kind": "read", "argv": ["@room_cli", "thread", "show", "@control_thread", "--json"], "exit": 0, "checks": [{"path": "/thread/status", "equals": "idle"}, {"path": "/thread/runtime/displayStatus", "equals": "idle"}, {"path": "/thread/queuedMessageCount", "equals": 0}]},
    {"id": "accepted_swarms", "claim": "swarms", "kind": "read", "argv": ["@gh", "issue", "view", "236", "--repo", "jparker2006/ClosedWiz", "--json", "state,comments"], "exit": 0, "checks": [{"path": "/state", "equals": "CLOSED"}, {"path": "/comments", "equals": "@accepted_236_comments"}]},
    {"id": "service_before", "claim": "service", "kind": "read", "argv": ["@service", "status", "--json"], "exit": 0, "checks": "@service_checks"},
    {"id": "app_installation", "claim": "app", "kind": "read", "argv": ["@gh", "api", "--method", "GET", "installation/repositories"], "exit": 0, "checks": [{"path": "/total_count", "equals": "@app_repository_count"}], "token_env": "OPENWIZ_SMOKE_APP_TOKEN"},
    {"id": "app_denied", "claim": "app", "kind": "read", "argv": ["@gh", "api", "--method", "GET", "@outside_installation_route"], "exit": 1, "checks": [{"path": "/status", "equals": "404"}], "token_env": "OPENWIZ_SMOKE_APP_TOKEN"},
    {"id": "fleet_repository", "claim": "fleet", "kind": "read", "argv": ["@gh", "repo", "view", "--json", "nameWithOwner"], "exit": 0, "checks": [{"path": "/nameWithOwner", "equals": "@scratch_repository"}], "token_env": "OPENWIZ_SMOKE_APP_TOKEN"},
    {"id": "fleet_plan", "claim": "fleet", "kind": "read", "argv": ["@openwiz", "fleet", "tick", "--dry-run", "--json"], "exit": 0, "checks": [{"path": "/schema", "equals": "openwiz.fleet-tick.v1"}, {"path": "/mode", "equals": "dry_run"}, {"path": "/default_branch", "equals": "@scratch_branch"}, {"path": "/actions", "actions_in": "@fleet_scope"}], "token_env": "OPENWIZ_SMOKE_APP_TOKEN"},
    {"id": "fleet_tick", "claim": "fleet", "kind": "write", "argv": ["@openwiz", "fleet", "tick", "--json"], "exit": 0, "checks": [{"path": "/schema", "equals": "openwiz.fleet-tick.v1"}, {"path": "/mode", "equals": "run"}, {"path": "/default_branch", "equals": "@scratch_branch"}, {"path": "/actions", "actions_in": "@fleet_scope"}], "token_env": "OPENWIZ_SMOKE_APP_TOKEN"},
    {"id": "fleet_event", "claim": "fleet", "kind": "event"},
    {"id": "fleet_progress", "claim": "fleet", "kind": "await", "argv": "@fleet_progress_argv", "exit": 0, "checks": "@fleet_progress_checks", "again_from": "fleet_repository", "until": "@fleet_ready_for_reply_checks", "token_env": "OPENWIZ_SMOKE_APP_TOKEN"},
    {"id": "fleet_reply", "claim": "fleet", "kind": "write", "argv": ["@node", "@browser_probe", "@fleet_reply_browser"], "exit": 0, "checks": [{"path": "/facts", "equals": "@fleet_reply_dom"}, {"path": "/errors", "equals": 0}, {"path": "/writes", "equals": 1}]},
    {"id": "fleet_reply_readback", "claim": "fleet", "kind": "await", "argv": "@fleet_reply_readback_argv", "exit": 0, "checks": "@fleet_reply_readback_checks", "until": "@fleet_reply_delivered_checks"},
    {"id": "fleet_t3_unlabel", "claim": "fleet", "kind": "write", "argv": ["@python", "-I", "@cleanup_probe", "--gh", "@gh", "--repo", "@scratch_repository", "--ticket", "@t3_ticket", "--action", "unlabel"], "exit": 0, "checks": [{"path": "/state", "equals": "OPEN"}, {"path": "/needs_info", "equals": false}], "token_env": "OPENWIZ_SMOKE_APP_TOKEN"},
    {"id": "fleet_t3_close", "claim": "fleet", "kind": "write", "argv": ["@python", "-I", "@cleanup_probe", "--gh", "@gh", "--repo", "@scratch_repository", "--ticket", "@t3_ticket", "--action", "close"], "exit": 0, "checks": [{"path": "/state", "equals": "CLOSED"}, {"path": "/needs_info", "equals": false}], "token_env": "OPENWIZ_SMOKE_APP_TOKEN"},
    {"id": "fleet_final_repository", "claim": "fleet", "kind": "read", "argv": ["@gh", "repo", "view", "--json", "nameWithOwner"], "exit": 0, "checks": [{"path": "/nameWithOwner", "equals": "@scratch_repository"}], "token_env": "OPENWIZ_SMOKE_APP_TOKEN"},
    {"id": "fleet_final_plan", "claim": "fleet", "kind": "read", "argv": ["@openwiz", "fleet", "tick", "--dry-run", "--json"], "exit": 0, "checks": [{"path": "/schema", "equals": "openwiz.fleet-tick.v1"}, {"path": "/mode", "equals": "dry_run"}, {"path": "/default_branch", "equals": "@scratch_branch"}, {"path": "/actions", "actions_in": "@fleet_scope"}], "token_env": "OPENWIZ_SMOKE_APP_TOKEN"},
    {"id": "fleet_final_tick", "claim": "fleet", "kind": "write", "argv": ["@openwiz", "fleet", "tick", "--json"], "exit": 0, "checks": [{"path": "/schema", "equals": "openwiz.fleet-tick.v1"}, {"path": "/mode", "equals": "run"}, {"path": "/default_branch", "equals": "@scratch_branch"}, {"path": "/actions", "actions_in": "@fleet_scope"}], "token_env": "OPENWIZ_SMOKE_APP_TOKEN"},
    {"id": "fleet_final_event", "claim": "fleet", "kind": "event"},
    {"id": "fleet_readback", "claim": "fleet", "kind": "await", "argv": "@fleet_readback_argv", "exit": 0, "checks": "@fleet_readback_checks", "until": "@fleet_complete_checks", "again_from": "fleet_final_repository", "token_env": "OPENWIZ_SMOKE_APP_TOKEN"},
    {"id": "loops_api", "claim": "loops", "kind": "read", "argv": ["@python", "-I", "@http_probe", "@port", "/api/v1/loops"], "exit": 0, "checks": [{"path": "/schema", "equals": "openwiz.loops-view.v1"}, {"path": "/loops", "equals": "@expected_loops"}]},
    {"id": "loops_page", "claim": "loops", "kind": "read", "argv": ["@node", "@browser_probe", "@loops_browser"], "exit": 0, "checks": [{"path": "/facts", "equals": "@loops_dom"}, {"path": "/errors", "equals": 0}, {"path": "/writes", "equals": 0}]},
    {"id": "cockpit_api", "claim": "cockpit", "kind": "read", "argv": ["@python", "-I", "@http_probe", "@port", "/api/v1/cockpit"], "exit": 0, "checks": "@cockpit_checks"},
    {"id": "cockpit_page", "claim": "cockpit", "kind": "read", "argv": ["@node", "@browser_probe", "@cockpit_browser"], "exit": 0, "checks": [{"path": "/facts", "equals": "@cockpit_dom"}, {"path": "/errors", "equals": 0}, {"path": "/writes", "equals": 0}]},
    {"id": "decisions_api", "claim": "decisions", "kind": "read", "argv": ["@python", "-I", "@http_probe", "@port", "/api/v1/decisions"], "exit": 0, "checks": [{"path": "/schema", "equals": "openwiz.decisions.v1"}, {"path": "/coverage/state", "equals": "complete"}, {"path": "/freshness/state", "equals": "fresh"}, {"path": "/items", "equals": "@expected_decisions"}, {"path": "/orchestrator/target/known", "equals": "@orchestrator_thread"}]},
    {"id": "decision_answer", "claim": "decisions", "kind": "write", "argv": ["@node", "@browser_probe", "@answer_browser"], "exit": 0, "checks": [{"path": "/facts", "equals": "@answer_dom"}, {"path": "/errors", "equals": 0}, {"path": "/writes", "equals": 1}]},
    {"id": "answer_readback", "claim": "decisions", "kind": "await", "argv": "@answer_readback_argv", "exit": 0, "checks": "@answer_readback_checks", "until": "@answer_saved_checks"},
    {"id": "catalogue", "claim": "json", "kind": "read", "argv": ["@openwiz", "help", "--agent"], "exit": 0, "checks": [{"path": "/schema", "equals": "openwiz.cli.v1"}, {"path": "/kind", "equals": "catalogue"}, {"path": "/commands", "equals": "@expected_catalogue_commands"}]},
    {"id": "inventory", "claim": "json", "kind": "read", "argv": ["@openwiz", "ls", "--json"], "exit": 0, "checks": [{"path": "/schema", "equals": "openwiz.inventory.v1"}, {"path": "/coverage/state", "equals": "complete"}]},
    {"id": "json_error", "claim": "json", "kind": "read", "argv": ["@openwiz", "ls", "--unknown", "--json"], "exit": 2, "checks": [{"path": "/schema", "equals": "openwiz.cli-error.v1"}, {"path": "/command", "equals": "ls"}, {"path": "/exit_code", "equals": 2}, {"path": "/error/kind", "equals": "usage"}]},
    {"id": "capability", "claim": "json", "kind": "read", "argv": ["@openwiz", "ui", "--json"], "exit": 0, "checks": "@capability_checks"},
    {"id": "terminal_ui", "claim": "terminal", "kind": "read", "argv": ["@python", "-I", "@pty_driver", "120", "40", "@terminal_steps", "@openwiz", "ui", "--port", "@port"], "exit": 0, "checks": [{"path": "/exit", "equals": 0}, {"path": "/restored", "equals": true}, {"path": "/steps", "equals": "@terminal_results"}]},
    {"id": "terminal_default", "claim": "terminal", "kind": "read", "argv": ["@python", "-I", "@pty_driver", "120", "40", "@default_steps", "@openwiz"], "exit": 0, "checks": [{"path": "/exit", "equals": 0}, {"path": "/restored", "equals": true}, {"path": "/steps", "equals": "@default_results"}]},
    {"id": "send_preview", "claim": "send", "kind": "read", "argv": ["@openwiz", "send", "@send_thread", "--preview", "--json"], "exit": 0, "checks": "@send_preview_checks"},
    {"id": "send_once", "claim": "send", "kind": "write", "argv": ["@openwiz", "send", "@send_thread", "--op-id", "@send_op", "--json", "--", "Live smoke synthetic message."], "exit": 0, "checks": [{"path": "/schema", "equals": "openwiz.messaging.v1"}, {"path": "/status", "one_of": ["accepted", "queued"]}, {"path": "/target/id", "equals": "@send_thread"}, {"path": "/op_id", "equals": "@send_op"}, {"path": "/requested_mode", "equals": "queue"}, {"path": "/result/kind", "equals": "outcome"}, {"path": "/result/delivery/kind", "one_of": ["accepted", "queued"]}, {"path": "/result/replayed", "equals": false}]},
    {"id": "send_lookup", "claim": "send", "kind": "read", "argv": ["@openwiz", "send", "@send_thread", "--op-id", "@send_op", "--check", "--json"], "exit": 0, "checks": "@send_lookup_checks"},
    {"id": "new_preview", "claim": "new", "kind": "read", "argv": ["@openwiz", "new", "--project-id", "@project", "--harness", "@harness", "--model", "@model", "--effort", "@effort", "--op-id", "@new_op", "--json", "--", "Live smoke synthetic first prompt."], "exit": 12, "checks": "@new_preview_checks"},
    {"id": "new_once", "claim": "new", "kind": "write", "argv": ["@openwiz", "new", "--project-id", "@project", "--harness", "@harness", "--model", "@model", "--effort", "@effort", "--op-id", "@new_op", "--yes", "--json", "--", "Live smoke synthetic first prompt."], "exit": 0, "checks": [{"path": "/schema", "equals": "openwiz.new-thread.v1"}, {"path": "/status", "equals": "created"}, {"path": "/project/id", "equals": "@project"}, {"path": "/result/replayed", "equals": false}]},
    {"id": "new_status", "claim": "new", "kind": "read", "argv": ["@openwiz", "new", "--status", "@new_op", "--json"], "exit": 0, "checks": "@new_status_checks"},
    {"id": "service_after", "claim": "service", "kind": "read", "argv": ["@service", "status", "--json"], "exit": 0, "checks": "@service_checks"},
    {"id": "quiet_after", "claim": "read_safety", "kind": "read", "argv": ["@room_cli", "thread", "show", "@control_thread", "--json"], "exit": 0, "checks": [{"path": "/thread/id", "same_as": {"step": "quiet_before", "path": "/thread/id"}}, {"path": "/thread/status", "same_as": {"step": "quiet_before", "path": "/thread/status"}}, {"path": "/thread/runtime/displayStatus", "same_as": {"step": "quiet_before", "path": "/thread/runtime/displayStatus"}}, {"path": "/thread/updatedAt", "same_as": {"step": "quiet_before", "path": "/thread/updatedAt"}}, {"path": "/thread/lastReadAt", "same_as": {"step": "quiet_before", "path": "/thread/lastReadAt"}}, {"path": "/thread/latestAttentionAt", "same_as": {"step": "quiet_before", "path": "/thread/latestAttentionAt"}}, {"path": "/thread/queuedMessageCount", "same_as": {"step": "quiet_before", "path": "/thread/queuedMessageCount"}}]}
  ],
  "default_terminal_port": "@port",
  "release": "@release"
}
