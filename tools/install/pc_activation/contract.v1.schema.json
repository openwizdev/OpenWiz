{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openwiz.dev/schemas/pc-activation.v1.schema.json",
  "description": "Structural request and companion-journal shapes. The contract defines cross-field and fresh-evidence constraints.",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/journal"
    },
    {
      "$ref": "#/$defs/authority"
    },
    {
      "$ref": "#/$defs/observation"
    },
    {
      "$ref": "#/$defs/record"
    }
  ],
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_uid",
        "unit",
        "root",
        "state_root",
        "repository",
        "project",
        "runtime",
        "build",
        "config_sha256",
        "unit_sha256",
        "app_id",
        "installation_id",
        "service_issue"
      ],
      "properties": {
        "owner_uid": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unit": {
          "const": "openwiz.service"
        },
        "root": {
          "type": "string",
          "pattern": "^(?:/(?:(?!\\.{1,2}(?:/|$))[\\u0020-\\u002e\\u0030-\\u007e]+/)*(?!\\.{1,2}(?:/|$))[\\u0020-\\u002e\\u0030-\\u007e]+)$(?![\\s\\S])",
          "maxLength": 1024
        },
        "state_root": {
          "type": "string",
          "pattern": "^(?:/(?:(?!\\.{1,2}(?:/|$))[\\u0020-\\u002e\\u0030-\\u007e]+/)*(?!\\.{1,2}(?:/|$))[\\u0020-\\u002e\\u0030-\\u007e]+)$(?![\\s\\S])",
          "maxLength": 1024
        },
        "repository": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9-]{1,39}/(?!\\.{1,2}$)[A-Za-z0-9_.-]{1,100})$(?![\\s\\S])"
        },
        "project": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9_][A-Za-z0-9_-]{0,127})$(?![\\s\\S])"
        },
        "runtime": {
          "type": "string",
          "pattern": "^(?:0\\.[0-9]{1,10}\\.[0-9]{1,10} [0-9a-f]{40})$(?![\\s\\S])"
        },
        "build": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40})$(?![\\s\\S])"
        },
        "config_sha256": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{64})$(?![\\s\\S])"
        },
        "unit_sha256": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{64})$(?![\\s\\S])"
        },
        "app_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "installation_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "service_issue": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "host",
        "action",
        "operation_id",
        "binding",
        "revision",
        "request_hash"
      ],
      "properties": {
        "schema": {
          "const": "openwiz.pc-activation.v1"
        },
        "host": {
          "const": "pc"
        },
        "action": {
          "const": "enable_start"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{32})$(?![\\s\\S])"
        },
        "binding": {
          "$ref": "#/$defs/binding"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "request_hash": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{64})$(?![\\s\\S])"
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "kind",
        "phase",
        "fingerprint",
        "effects",
        "reason"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{32})$(?![\\s\\S])"
        },
        "kind": {
          "const": "activate_engine"
        },
        "phase": {
          "type": "string",
          "enum": [
            "proposed",
            "uncertain",
            "applied",
            "refused"
          ]
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{64})$(?![\\s\\S])"
        },
        "effects": {
          "const": [
            "Enable and start the owner user unit openwiz.service."
          ]
        },
        "reason": {
          "const": "Reconcile the exact PC activation and App record before continuing."
        }
      }
    },
    "journal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "request",
        "operation",
        "created_at",
        "updated_at",
        "started_at",
        "record_at",
        "record_state",
        "outcome"
      ],
      "properties": {
        "schema": {
          "const": "openwiz.pc-activation.v1.journal"
        },
        "request": {
          "$ref": "#/$defs/request"
        },
        "operation": {
          "$ref": "#/$defs/operation"
        },
        "created_at": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "updated_at": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "started_at": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          ]
        },
        "record_at": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          ]
        },
        "record_state": {
          "type": "string",
          "enum": [
            "pending",
            "unsent",
            "uncertain",
            "confirmed"
          ]
        },
        "outcome": {
          "type": "string",
          "enum": [
            "proposed",
            "held",
            "applied"
          ]
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "challenge",
        "at",
        "authorized"
      ],
      "properties": {
        "request": {
          "$ref": "#/$defs/request"
        },
        "challenge": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{32})$(?![\\s\\S])"
        },
        "at": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "authorized": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request",
        "challenge",
        "at",
        "state",
        "lock"
      ],
      "properties": {
        "request": {
          "$ref": "#/$defs/request"
        },
        "challenge": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{32})$(?![\\s\\S])"
        },
        "at": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "state": {
          "type": "string",
          "enum": [
            "healthy",
            "not_applied",
            "unknown"
          ]
        },
        "lock": {
          "type": "string",
          "enum": [
            "held",
            "free",
            "unknown"
          ]
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "operation_id",
        "request_hash",
        "build",
        "outcome",
        "at"
      ],
      "properties": {
        "schema": {
          "const": "openwiz.pc-activation.v1.record"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{32})$(?![\\s\\S])"
        },
        "request_hash": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{64})$(?![\\s\\S])"
        },
        "build": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40})$(?![\\s\\S])"
        },
        "outcome": {
          "const": "applied"
        },
        "at": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
