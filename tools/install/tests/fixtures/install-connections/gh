#!/usr/bin/env python3
"""Test-only fake `gh` (the agent's own GitHub login) for #1105. Synthetic data only.
Serves `gh api <path>` from $SYNTHETIC_SCENARIO and the consumer fixture."""
import base64
import json
import os
from pathlib import Path
import sys

scenario = json.load(open(os.environ['SYNTHETIC_SCENARIO']))
with open(os.environ['SYNTHETIC_CALLS'], 'a') as calls:
    calls.write(json.dumps(['gh', *sys.argv[1:]]) + '\n')
args = sys.argv[1:]
identity = scenario['identity']
if args[:1] != ['api'] or len(args) != 2:
    sys.exit(2)
if identity == 'signed_out':
    print('synthetic: not logged in', file=sys.stderr)
    sys.exit(4)
path = args[1]
repo = scenario['repository']
if path == 'user':
    print(json.dumps({'login': 'synthetic-agent[bot]' if identity == 'bot' else 'synthetic-agent',
                      'type': 'Bot' if identity == 'bot' else 'User'}))
elif path == f'repos/{repo}':
    print(json.dumps({'full_name': repo, 'permissions': {'pull': True, 'push': identity != 'read_only'}}))
elif path == f'repos/{repo}/issues/{scenario["issue"]["number"]}':
    print(json.dumps({'number': scenario['issue']['number'], 'state': scenario['issue']['state']}))
elif path == f'repos/{repo}/contents/docs/agents/fleet.md' and scenario['settings']:
    # true: the consumer's filled settings; 'empty' or 'template': unusable ones.
    name = {True: 'consumer/docs/agents/fleet.md', 'empty': 'fleet-empty.md',
            'template': 'fleet-template.md', 'merge-scaffold': 'fleet-merge-scaffold.md',
            'small-builder': 'fleet-small-builder-placeholder.md'}[scenario['settings']]
    data = (Path(__file__).parent / name).read_bytes()
    print(json.dumps({'type': 'file', 'encoding': 'base64', 'content': base64.b64encode(data).decode()}))
else:
    print('synthetic: HTTP 404', file=sys.stderr)
    sys.exit(1)
