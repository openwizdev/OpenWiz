#!/usr/bin/env python3
"""A fake `gh` for the bench's tests: a synthetic GitHub, read only.

FAKE_GH_WORLD names a JSON file mapping each exact call (its arguments,
joined by single spaces) to {"stdout": <text>, "exit": <status>}. Every call
is appended to FAKE_GH_LOG, one line each. A call the world doesn't know
exits 3: the bench made a call nobody expected.
"""
import json
import os
import sys

call = " ".join(sys.argv[1:])
with open(os.environ["FAKE_GH_LOG"], "a") as log:
    log.write(call + "\n")
with open(os.environ["FAKE_GH_WORLD"]) as f:
    world = json.load(f)
if call not in world:
    sys.stderr.write("fake gh: unknown call: " + call + "\n")
    sys.exit(3)
answer = world[call]
sys.stdout.write(answer["stdout"])
sys.exit(answer["exit"])
