#!/usr/bin/env python3
"""Synthetic exact-call gh, never a network fallback."""
import json
import os
import sys

args = sys.argv[1:]
with open(os.environ['FAKE_GH_LOG'], 'a') as f:
    f.write(json.dumps({'args': args, 'token_seen': os.environ.get('GH_TOKEN') == 'synthetic-app-token'}) + '\n')
with open(os.environ['FAKE_GH_WORLD']) as f:
    world = json.load(f)
key = json.dumps(args)
answer = world.get(key, {'exit': 9, 'stdout': ''})
sys.stdout.write(answer['stdout'])
sys.exit(answer.get('exit', 0))
