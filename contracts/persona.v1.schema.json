{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openwiz.dev/contracts/persona.v1.schema.json",
  "title": "OpenWiz persona and theme files, version 1",
  "description": "A persona styles Wiz's human-facing words; a theme gives colours, sound cues and a room look. Neither can carry facts, rules, tools or permissions: every object refuses fields it doesn't name.",
  "oneOf": [{"$ref": "#/$defs/persona"}, {"$ref": "#/$defs/theme"}],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$", "maxLength": 40},
    "line": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[^\\n\\r]+$"},
    "word": {"type": "string", "minLength": 1, "maxLength": 24, "pattern": "^[a-z][a-z-]*$"},
    "template": {
      "type": "string",
      "maxLength": 400,
      "pattern": "^([^{}\\n\\r]*\\n)*\\{facts\\}\\n([^{}\\n\\r]*\\n)*\\{next\\}(\\n[^{}\\n\\r]*)*$"
    },
    "colour": {"type": "string", "pattern": "^#[0-9a-f]{6}$"},
    "palette": {
      "type": "object",
      "additionalProperties": false,
      "required": ["background", "surface", "text", "muted", "accent", "warning", "danger"],
      "properties": {
        "background": {"$ref": "#/$defs/colour"},
        "surface": {"$ref": "#/$defs/colour"},
        "text": {"$ref": "#/$defs/colour"},
        "muted": {"$ref": "#/$defs/colour"},
        "accent": {"$ref": "#/$defs/colour"},
        "warning": {"$ref": "#/$defs/colour"},
        "danger": {"$ref": "#/$defs/colour"}
      }
    },
    "cue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wave", "frequency_hz", "duration_ms", "gain"],
      "properties": {
        "wave": {"enum": ["sine", "triangle", "square", "sawtooth"]},
        "frequency_hz": {"type": "number", "minimum": 100, "maximum": 2000},
        "duration_ms": {"type": "integer", "minimum": 20, "maximum": 400},
        "gain": {"type": "number", "minimum": 0, "maximum": 0.3}
      }
    },
    "persona": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "kind", "id", "name", "family", "vibe", "tone", "vocabulary", "greeting",
                   "sign_off", "frame", "error_style", "docs_tone", "speech", "faces", "theme"],
      "properties": {
        "schema": {"const": "openwiz.persona.v1"},
        "kind": {"const": "persona"},
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[^\\n\\r]+$"},
        "family": {"enum": ["film-ai", "character", "pro", "fun"]},
        "vibe": {"$ref": "#/$defs/line"},
        "tone": {"$ref": "#/$defs/line"},
        "vocabulary": {"type": "array", "minItems": 1, "maxItems": 24, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[^\\n\\r]+$"}},
        "greeting": {"$ref": "#/$defs/line"},
        "sign_off": {"$ref": "#/$defs/line"},
        "frame": {"$ref": "#/$defs/template"},
        "error_style": {"$ref": "#/$defs/template"},
        "docs_tone": {"$ref": "#/$defs/line"},
        "speech": {
          "type": "object",
          "additionalProperties": false,
          "required": ["engine", "voice", "pace", "original"],
          "properties": {
            "engine": {"const": "local"},
            "voice": {"type": "string", "pattern": "^local:[a-z][a-z0-9]*(-[a-z0-9]+)*$", "maxLength": 64},
            "pace": {"type": "number", "minimum": 0.5, "maximum": 2},
            "original": {"const": true}
          }
        },
        "faces": {"type": "array", "const": ["human"]},
        "theme": {"$ref": "#/$defs/id"}
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "kind", "id", "colors", "sounds", "room"],
      "properties": {
        "schema": {"const": "openwiz.persona.v1"},
        "kind": {"const": "theme"},
        "id": {"$ref": "#/$defs/id"},
        "colors": {
          "type": "object",
          "additionalProperties": false,
          "required": ["light", "dark"],
          "properties": {"light": {"$ref": "#/$defs/palette"}, "dark": {"$ref": "#/$defs/palette"}}
        },
        "sounds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "cues"],
          "properties": {
            "enabled": {"const": false},
            "cues": {
              "type": "object",
              "propertyNames": {"enum": ["done", "needs_you", "failed", "started"]},
              "additionalProperties": {"$ref": "#/$defs/cue"}
            }
          }
        },
        "room": {
          "type": "object",
          "additionalProperties": false,
          "required": ["palette", "lighting", "mood"],
          "properties": {
            "palette": {"type": "array", "minItems": 2, "maxItems": 6, "items": {"$ref": "#/$defs/colour"}},
            "lighting": {"type": "string", "minLength": 1, "maxLength": 60, "pattern": "^[^\\n\\r]+$"},
            "mood": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/word"}}
          }
        }
      }
    }
  }
}
