{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openwiz:schema:service:v1",
  "title": "openwiz.service.v1",
  "description": "OpenWiz service config (openwiz.service-config.v1): the config definition that crates/cli/src/state/loops/ reads. Status, state and record definitions left with the retired service (#1264). contracts/service.v1.md has the rules this schema cannot express.",
  "$ref": "#/$defs/config",
  "$defs": {
    "loop_approval_repository_name": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^[.]*[-A-Za-z0-9_][-A-Za-z0-9_.]*$"
        },
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^[.][.][.][.]*$"
        }
      ]
    },
    "loop_approval_repository": {
      "type": "object",
      "required": [
        "owner",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "owner": {
          "$ref": "#/$defs/owner"
        },
        "name": {
          "$ref": "#/$defs/loop_approval_repository_name"
        }
      }
    },
    "loop_approval_revision": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 40,
          "maxLength": 40,
          "pattern": "^[0-9a-f]*$"
        },
        {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]*$"
        }
      ]
    },
    "loop_approval_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]*$"
    },
    "loop_approval_text": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[\u0001-\udbff\udfff]*[\u0001-\b\u000e-\u001f!-\u0084\u0086-\u009f\u00a1-\u167f\u1681-\u1fff\u200b-\u2027\u202a-\u202e\u2030-\u205e\u2060-\u2fff\u3001-\udbff\udfff][\u0001-\udbff\udfff]*$",
      "description": "Nonblank Unicode text without NUL; positive ranges exclude Unicode White_Space from the required nonblank character."
    },
    "loop_approval_ref": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^https[:][/][/]github[.]com[/][A-Za-z0-9][-A-Za-z0-9]*[/][.]*[-A-Za-z0-9_][-A-Za-z0-9_.]*[/]issues[/][1-9][0-9]*[#]issuecomment-[1-9][0-9]*$"
        },
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^https[:][/][/]github[.]com[/][A-Za-z0-9][-A-Za-z0-9]*[/][.][.][.][.]*[/]issues[/][1-9][0-9]*[#]issuecomment-[1-9][0-9]*$"
        },
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^https[:][/][/]github[.]com[/][A-Za-z0-9][-A-Za-z0-9]*[/][.]*[-A-Za-z0-9_][-A-Za-z0-9_.]*[/]pull[/][1-9][0-9]*[#]issuecomment-[1-9][0-9]*$"
        },
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^https[:][/][/]github[.]com[/][A-Za-z0-9][-A-Za-z0-9]*[/][.][.][.][.]*[/]pull[/][1-9][0-9]*[#]issuecomment-[1-9][0-9]*$"
        }
      ],
      "description": "Canonical private GitHub issue/PR comment URL; setup verifies the comment is private and explicitly approves the entire exact binding. Repository path must be an ordinary component."
    },
    "loop_approval": {
      "type": "object",
      "required": [
        "repository",
        "project",
        "loop_id",
        "definition_revision",
        "sha256",
        "approved_by",
        "scope",
        "approval_ref"
      ],
      "additionalProperties": false,
      "properties": {
        "repository": {
          "$ref": "#/$defs/loop_approval_repository"
        },
        "project": {
          "$ref": "#/$defs/id"
        },
        "loop_id": {
          "$ref": "#/$defs/op_id"
        },
        "definition_revision": {
          "$ref": "#/$defs/loop_approval_revision"
        },
        "sha256": {
          "$ref": "#/$defs/loop_approval_sha256"
        },
        "approved_by": {
          "$ref": "#/$defs/loop_approval_text"
        },
        "scope": {
          "$ref": "#/$defs/loop_approval_text"
        },
        "approval_ref": {
          "$ref": "#/$defs/loop_approval_ref"
        }
      }
    },
    "loop_approvals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/loop_approval"
      },
      "description": "LP1 required loops.approvals record, installed by Jake\u2019s setup only after explicit approval. Empty admits nothing. Duplicate or conflicting bindings refuse the entire record; every repository/project must match the installation. Enclosing config registration belongs to L12."
    },
    "loop_limits": {
      "type": "object",
      "description": "LP1 required loops.limits record: loop checks and original agents only; maxima include urgent reserves. Enclosing config registration belongs to L12.",
      "required": [
        "checks",
        "agents"
      ],
      "additionalProperties": false,
      "properties": {
        "checks": {
          "$ref": "#/$defs/loop_check_capacity"
        },
        "agents": {
          "$ref": "#/$defs/loop_agent_capacity"
        }
      }
    },
    "loop_check_capacity": {
      "type": "object",
      "required": [
        "max",
        "urgent_reserve"
      ],
      "additionalProperties": false,
      "properties": {
        "max": {
          "type": "integer",
          "const": 4
        },
        "urgent_reserve": {
          "type": "integer",
          "const": 1
        }
      }
    },
    "loop_agent_capacity": {
      "type": "object",
      "required": [
        "max",
        "urgent_reserve"
      ],
      "additionalProperties": false,
      "properties": {
        "max": {
          "type": "integer",
          "const": 16
        },
        "urgent_reserve": {
          "type": "integer",
          "const": 4
        }
      }
    },
    "seconds": {
      "type": "integer",
      "minimum": 1,
      "description": "A duration in whole seconds, at least 1."
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "description": "1 to 65535. The maximum is the md's rule: this checker has no maximum keyword."
    },
    "issue": {
      "type": "integer",
      "minimum": 1,
      "description": "A GitHub issue's number."
    },
    "github_id": {
      "type": "integer",
      "minimum": 1,
      "description": "A GitHub App's or installation's id: not a secret."
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_][-A-Za-z0-9_]*$",
      "description": "A CloudRoom id (thread, loop, project): the adapter's rule, 1 to 128 ASCII letters, digits, _ or -, not starting with -."
    },
    "op_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][-A-Za-z0-9_]*$",
      "description": "A send op id: 1 to 64 ASCII letters, digits, _ or -, starting with a letter or digit."
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][-A-Za-z0-9]*$"
    },
    "repo_name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[-A-Za-z0-9_.]*$"
    },
    "loops": {
      "type": "object",
      "description": "Optional L12 composition; both setup-owned records are required for loop admission. Absence enables no loop execution.",
      "required": [
        "approvals",
        "limits"
      ],
      "additionalProperties": false,
      "properties": {
        "approvals": {
          "$ref": "#/$defs/loop_approvals"
        },
        "limits": {
          "$ref": "#/$defs/loop_limits"
        }
      }
    },
    "config": {
      "type": "object",
      "description": "service/config.json: written by Jake's setup, never by the service.",
      "required": [
        "schema",
        "repository",
        "project",
        "orchestrator_thread",
        "service_issue",
        "github_app",
        "tick",
        "health",
        "server"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "openwiz.service-config.v1"
        },
        "repository": {
          "type": "object",
          "required": [
            "owner",
            "name"
          ],
          "additionalProperties": false,
          "properties": {
            "owner": {
              "$ref": "#/$defs/owner"
            },
            "name": {
              "$ref": "#/$defs/repo_name"
            }
          }
        },
        "operator": {
          "type": "string",
          "minLength": 1,
          "description": "Optional explicit local operator identity set at install. Switch writes require it and refuse blank or NUL-containing values. Never inferred from an owner or request."
        },
        "project": {
          "$ref": "#/$defs/id"
        },
        "orchestrator_thread": {
          "$ref": "#/$defs/id"
        },
        "service_issue": {
          "$ref": "#/$defs/issue"
        },
        "github_app": {
          "type": "object",
          "required": [
            "app_id",
            "installation_id"
          ],
          "additionalProperties": false,
          "properties": {
            "app_id": {
              "$ref": "#/$defs/github_id"
            },
            "installation_id": {
              "$ref": "#/$defs/github_id"
            }
          }
        },
        "loops": {
          "$ref": "#/$defs/loops"
        },
        "tick": {
          "type": "object",
          "required": [
            "every_s"
          ],
          "additionalProperties": false,
          "properties": {
            "every_s": {
              "$ref": "#/$defs/seconds"
            }
          }
        },
        "health": {
          "type": "object",
          "required": [
            "every_s"
          ],
          "additionalProperties": false,
          "properties": {
            "every_s": {
              "$ref": "#/$defs/seconds"
            }
          }
        },
        "server": {
          "type": "object",
          "required": [
            "port",
            "allowed_host",
            "probe_timeout_s"
          ],
          "additionalProperties": false,
          "properties": {
            "port": {
              "$ref": "#/$defs/port"
            },
            "allowed_host": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/text"
                }
              ]
            },
            "probe_timeout_s": {
              "$ref": "#/$defs/seconds"
            }
          }
        },
        "notifications": {
          "$ref": "#/$defs/notification_job"
        },
        "events": {
          "type": "object",
          "description": "Optional existing repository webhook delivery polling. Absent leaves intake off; hook_id is explicit, never discovered.",
          "required": [
            "hook_id"
          ],
          "additionalProperties": false,
          "properties": {
            "hook_id": {
              "$ref": "#/$defs/github_id"
            }
          }
        },
        "decision_repositories": {
          "type": "object",
          "description": "Optional explicit decision-feed roles; absent uses cwd as the single repository. Roles must differ case-insensitively.",
          "required": [
            "public",
            "private"
          ],
          "additionalProperties": false,
          "properties": {
            "public": {
              "$ref": "#/$defs/decision_repository"
            },
            "private": {
              "$ref": "#/$defs/decision_repository"
            }
          }
        }
      }
    },
    "notification_job": {
      "type": "object",
      "required": [
        "every_s"
      ],
      "additionalProperties": false,
      "properties": {
        "every_s": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "decision_repository": {
      "type": "object",
      "required": [
        "owner",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "owner": {
          "$ref": "#/$defs/owner"
        },
        "name": {
          "$ref": "#/$defs/repo_name",
          "description": "One ordinary repository path component; neither dot nor dot-dot.",
          "oneOf": [
            {
              "minLength": 3
            },
            {
              "type": "string",
              "maxLength": 2,
              "pattern": "^[-A-Za-z0-9_][-A-Za-z0-9_.]*$"
            },
            {
              "type": "string",
              "maxLength": 2,
              "pattern": "^[.][-A-Za-z0-9_]$"
            }
          ]
        }
      }
    }
  }
}
