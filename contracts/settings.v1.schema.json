{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openwiz:schema:settings:v1",
  "title": "openwiz.settings.v1",
  "description": "The home settings file, .openwiz/settings.json (spec #3375, ticket #3376). contracts/settings.v1.md has the rules this schema can't express: an account a role names exists, is of the role's harness and is not reserved; every host is a turned-on driver; history holds exactly the versions before this one.",
  "type": "object",
  "required": ["schema", "roles", "accounts", "hosts", "drivers", "budgets", "keys", "channels", "telemetry", "updates", "version", "changed_at", "changed_by", "history"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "openwiz.settings.v1"},
    "roles": {"$ref": "#/$defs/roles"},
    "accounts": {"$ref": "#/$defs/accounts"},
    "hosts": {"$ref": "#/$defs/hosts"},
    "drivers": {"$ref": "#/$defs/drivers"},
    "budgets": {"$ref": "#/$defs/budgets"},
    "keys": {"$ref": "#/$defs/keys"},
    "channels": {"$ref": "#/$defs/channels"},
    "telemetry": {"type": "boolean"},
    "updates": {"const": "ask"},
    "version": {"type": "integer", "minimum": 1},
    "changed_at": {"$ref": "#/$defs/utc"},
    "changed_by": {"$ref": "#/$defs/changed_by"},
    "history": {"type": "array", "maxItems": 10, "items": {"$ref": "#/$defs/earlier"}}
  },
  "$defs": {
    "no_key": {
      "description": "Refuses anything shaped like a key or token value, wherever a free string may stand.",
      "not": {"pattern": "sk-[A-Za-z0-9_-]{16,}|gh[pousr]_[A-Za-z0-9]{16,}|github_pat_|glpat-|xox[abprs]-|AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{20,}|eyJ[A-Za-z0-9_-]{8,}\\.|-----BEGIN|[A-Za-z0-9+=_-]{40,}"}
    },
    "id": {
      "description": "models v1's provider or effort id.",
      "type": "string", "pattern": "^[A-Za-z0-9._-]+$", "allOf": [{"$ref": "#/$defs/no_key"}]
    },
    "model_id": {
      "description": "models v1's model id: segments joined by '/', none empty. A good id matches exactly one branch; one holding '//' matches two and is refused.",
      "oneOf": [
        {"type": "string", "pattern": "^[A-Za-z0-9._-]$", "allOf": [{"$ref": "#/$defs/no_key"}]},
        {"type": "string", "pattern": "^[A-Za-z0-9._-][A-Za-z0-9._/-]*[A-Za-z0-9._-]$", "allOf": [{"$ref": "#/$defs/no_key"}]},
        {"type": "string", "pattern": "^[A-Za-z0-9._-][A-Za-z0-9._/-]*//[A-Za-z0-9._/-]*[A-Za-z0-9._-]$", "allOf": [{"$ref": "#/$defs/no_key"}]}
      ]
    },
    "label": {
      "description": "An account or key name the owner picks: 1 to 32 letters, digits, '-' or '_'. Never an email, account id or token, so never an '@'.",
      "type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$", "allOf": [{"$ref": "#/$defs/no_key"}]
    },
    "host": {
      "description": "A driver's name, as records v1 section 6 names a host.",
      "type": "string", "maxLength": 40, "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "allOf": [{"$ref": "#/$defs/no_key"}]
    },
    "utc": {
      "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "allOf": [{"$ref": "#/$defs/no_key"}]
    },
    "changed_by": {"enum": ["settings tab", "Wiz chat", "fill"]},
    "fallback_entry": {
      "type": "object",
      "required": ["harness", "model", "effort", "account"],
      "additionalProperties": false,
      "properties": {
        "harness": {"$ref": "#/$defs/id"},
        "model": {"$ref": "#/$defs/model_id"},
        "effort": {"$ref": "#/$defs/id"},
        "account": {"$ref": "#/$defs/label"}
      }
    },
    "choice": {
      "type": "object",
      "required": ["harness", "model", "effort", "account", "fallback"],
      "additionalProperties": false,
      "properties": {
        "harness": {"$ref": "#/$defs/id"},
        "model": {"$ref": "#/$defs/model_id"},
        "effort": {"$ref": "#/$defs/id"},
        "account": {"$ref": "#/$defs/label"},
        "fallback": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/fallback_entry"}}
      }
    },
    "own_role": {"oneOf": [{"$ref": "#/$defs/choice"}, {"const": "not set"}]},
    "following_role": {"oneOf": [{"$ref": "#/$defs/choice"}, {"const": "follows builder"}, {"const": "not set"}]},
    "reviewer_role": {"oneOf": [{"$ref": "#/$defs/choice"}, {"const": "waits"}, {"const": "not set"}]},
    "builder_is_claude": {
      "type": "object", "required": ["builder"],
      "properties": {"builder": {"type": "object", "required": ["harness"], "properties": {"harness": {"const": "claude-code"}}}}
    },
    "builder_is_gpt": {
      "type": "object", "required": ["builder"],
      "properties": {"builder": {"type": "object", "required": ["harness"], "properties": {"harness": {"const": "codex"}}}}
    },
    "reviewer_not_claude": {
      "properties": {"reviewer": {"if": {"type": "object"}, "then": {"properties": {
        "harness": {"not": {"const": "claude-code"}},
        "fallback": {"items": {"properties": {"harness": {"not": {"const": "claude-code"}}}}}
      }}}}
    },
    "reviewer_not_gpt": {
      "properties": {"reviewer": {"if": {"type": "object"}, "then": {"properties": {
        "harness": {"not": {"const": "codex"}},
        "fallback": {"items": {"properties": {"harness": {"not": {"const": "codex"}}}}}
      }}}}
    },
    "roles": {
      "type": "object",
      "required": ["orchestrator", "builder", "fixer", "reviewer", "small_builder"],
      "additionalProperties": false,
      "properties": {
        "orchestrator": {"$ref": "#/$defs/own_role"},
        "builder": {"$ref": "#/$defs/own_role"},
        "fixer": {"$ref": "#/$defs/following_role"},
        "reviewer": {"$ref": "#/$defs/reviewer_role"},
        "small_builder": {"$ref": "#/$defs/following_role"}
      },
      "allOf": [
        {"if": {"$ref": "#/$defs/builder_is_claude"}, "then": {"$ref": "#/$defs/reviewer_not_claude"}},
        {"if": {"$ref": "#/$defs/builder_is_gpt"}, "then": {"$ref": "#/$defs/reviewer_not_gpt"}}
      ]
    },
    "accounts": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/label"},
      "additionalProperties": {
        "type": "object",
        "required": ["harness", "host", "reserved"],
        "additionalProperties": false,
        "properties": {
          "harness": {"$ref": "#/$defs/id"},
          "host": {"$ref": "#/$defs/host"},
          "reserved": {"type": "boolean"},
          "profile": {
            "type": "object",
            "required": ["variable", "folder"],
            "additionalProperties": false,
            "properties": {
              "variable": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$", "allOf": [{"$ref": "#/$defs/no_key"}]},
              "folder": {"type": "string", "maxLength": 200, "pattern": "^~(/[A-Za-z0-9._-]+)+$", "allOf": [{"$ref": "#/$defs/no_key"}]}
            }
          }
        }
      }
    },
    "hosts": {
      "type": "object",
      "required": ["home", "overflow", "max_agents", "projects"],
      "additionalProperties": false,
      "properties": {
        "home": {
          "type": "object",
          "required": ["orchestrator", "builder", "reviewer"],
          "additionalProperties": false,
          "properties": {"orchestrator": {"$ref": "#/$defs/host"}, "builder": {"$ref": "#/$defs/host"}, "reviewer": {"$ref": "#/$defs/host"}}
        },
        "overflow": {
          "type": ["object", "null"],
          "required": ["serves", "host"],
          "additionalProperties": false,
          "properties": {"serves": {"const": "builder"}, "host": {"$ref": "#/$defs/host"}}
        },
        "max_agents": {"type": ["integer", "null"], "minimum": 1},
        "projects": {
          "type": "object",
          "propertyNames": {"type": "string", "pattern": "^[A-Za-z0-9](-?[A-Za-z0-9]){0,38}/[A-Za-z0-9._-]{1,100}$", "allOf": [{"$ref": "#/$defs/no_key"}]},
          "additionalProperties": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/host"}}
        }
      }
    },
    "drivers": {
      "type": "object",
      "required": ["local"],
      "propertyNames": {"$ref": "#/$defs/host"},
      "additionalProperties": {"type": "boolean"}
    },
    "budgets": {
      "type": "object",
      "propertyNames": {"type": "string", "maxLength": 120, "pattern": "^[a-z0-9]+(-[a-z0-9]+)*:[A-Za-z0-9._-]+:[A-Za-z0-9_-]{1,32}$", "allOf": [{"$ref": "#/$defs/no_key"}]},
      "additionalProperties": {
        "type": "object",
        "required": ["amount", "unit", "by"],
        "additionalProperties": false,
        "properties": {
          "amount": {"type": "number", "exclusiveMinimum": 0},
          "unit": {"enum": ["percent", "credits", "seconds", "dollars"]},
          "by": {"$ref": "#/$defs/utc"}
        },
        "if": {"properties": {"unit": {"const": "percent"}}},
        "then": {"properties": {"amount": {"maximum": 100}}}
      }
    },
    "keys": {
      "type": "object",
      "propertyNames": {"$ref": "#/$defs/label"},
      "additionalProperties": {
        "type": "object",
        "required": ["store", "entry", "opt_in", "on", "set_at"],
        "additionalProperties": false,
        "properties": {
          "store": {"enum": ["token-service-key", "boat-env", "macos-keychain", "linux-secret-service", "env-file", "cloudroom-secret"]},
          "entry": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]{1,128}$", "allOf": [{"$ref": "#/$defs/no_key"}]},
          "opt_in": {"type": "boolean"},
          "on": {"type": "boolean"},
          "set_at": {"oneOf": [{"$ref": "#/$defs/utc"}, {"type": "null"}]}
        },
        "if": {"properties": {"opt_in": {"const": false}}},
        "then": {"properties": {"on": {"const": true}}}
      }
    },
    "channels": {
      "type": "object",
      "required": ["t3"],
      "propertyNames": {"$ref": "#/$defs/host"},
      "properties": {"t3": {"const": true}},
      "additionalProperties": {"type": "boolean"}
    },
    "earlier": {
      "description": "One earlier version, whole but for its own schema and history, so undo can put it back.",
      "type": "object",
      "required": ["roles", "accounts", "hosts", "drivers", "budgets", "keys", "channels", "telemetry", "updates", "version", "changed_at", "changed_by"],
      "additionalProperties": false,
      "properties": {
        "roles": {"$ref": "#/$defs/roles"},
        "accounts": {"$ref": "#/$defs/accounts"},
        "hosts": {"$ref": "#/$defs/hosts"},
        "drivers": {"$ref": "#/$defs/drivers"},
        "budgets": {"$ref": "#/$defs/budgets"},
        "keys": {"$ref": "#/$defs/keys"},
        "channels": {"$ref": "#/$defs/channels"},
        "telemetry": {"type": "boolean"},
        "updates": {"const": "ask"},
        "version": {"type": "integer", "minimum": 1},
        "changed_at": {"$ref": "#/$defs/utc"},
        "changed_by": {"$ref": "#/$defs/changed_by"}
      }
    }
  }
}
