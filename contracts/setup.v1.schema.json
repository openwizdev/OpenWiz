{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "ready",
    "components",
    "engine",
    "cost",
    "operations"
  ],
  "properties": {
    "schema": {
      "const": "openwiz.setup.v1"
    },
    "ready": {
      "type": "boolean"
    },
    "components": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "state",
          "reason",
          "next"
        ],
        "properties": {
          "id": {
            "enum": [
              "cloudroom",
              "harness",
              "personal_github",
              "github_app",
              "project",
              "remote_access"
            ]
          },
          "state": {
            "enum": [
              "verified",
              "missing",
              "refused",
              "unknown"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "next": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "id": {
                "const": "cloudroom"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "harness"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "personal_github"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "github_app"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "project"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        {
          "contains": {
            "properties": {
              "id": {
                "const": "remote_access"
              }
            },
            "required": [
              "id"
            ]
          }
        }
      ]
    },
    "engine": {
      "enum": [
        "unselected",
        "cloud",
        "local"
      ]
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenance",
        "credits",
        "window_s",
        "monthly_projection",
        "free_allowance",
        "reason"
      ],
      "properties": {
        "provenance": {
          "enum": [
            "measured",
            "estimated",
            "unknown"
          ]
        },
        "credits": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "window_s": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "monthly_projection": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "free_allowance": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "kind",
          "phase",
          "fingerprint",
          "effects",
          "reason"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "kind": {
            "enum": [
              "connect_app",
              "prepare_project",
              "activate_engine",
              "configure_access"
            ]
          },
          "phase": {
            "enum": [
              "proposed",
              "applied",
              "refused",
              "uncertain"
            ]
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "effects": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected",
        "app_choice",
        "acting_login"
      ],
      "properties": {
        "selected": {
          "enum": [
            "app",
            "personal_login",
            "unselected"
          ]
        },
        "app_choice": {
          "enum": [
            "create",
            "reuse",
            "skip",
            "undecided"
          ]
        },
        "acting_login": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]{1,39}$"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "selected": {
                "const": "personal_login"
              }
            }
          },
          "then": {
            "properties": {
              "app_choice": {
                "const": "skip"
              },
              "acting_login": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "brain": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "location",
            "brain_repository",
            "folder"
          ],
          "properties": {
            "location": {
              "enum": [
                "in_repository",
                "companion"
              ]
            },
            "brain_repository": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]{1,39}/[A-Za-z0-9_.-]{1,100}$"
            },
            "folder": {
              "const": ".openwiz/brain"
            }
          }
        }
      ]
    },
    "host": {
      "$ref": "#/$defs/host_name"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenWiz resumable setup v1",
  "allOf": [
    {
      "if": {
        "properties": {
          "ready": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "components": {
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "id": {
                      "const": "harness"
                    },
                    "state": {
                      "const": "verified"
                    }
                  },
                  "required": [
                    "id",
                    "state"
                  ]
                }
              },
              {
                "contains": {
                  "properties": {
                    "id": {
                      "const": "personal_github"
                    },
                    "state": {
                      "const": "verified"
                    }
                  },
                  "required": [
                    "id",
                    "state"
                  ]
                }
              },
              {
                "contains": {
                  "properties": {
                    "id": {
                      "const": "project"
                    },
                    "state": {
                      "const": "verified"
                    }
                  },
                  "required": [
                    "id",
                    "state"
                  ]
                }
              }
            ]
          }
        },
        "anyOf": [
          {
            "properties": {
              "components": {
                "contains": {
                  "properties": {
                    "id": {
                      "const": "github_app"
                    },
                    "state": {
                      "const": "verified"
                    }
                  },
                  "required": [
                    "id",
                    "state"
                  ]
                }
              }
            }
          },
          {
            "required": [
              "identity"
            ],
            "properties": {
              "identity": {
                "properties": {
                  "selected": {
                    "const": "personal_login"
                  },
                  "app_choice": {
                    "const": "skip"
                  }
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "ready": {
            "const": true
          },
          "host": {
            "const": "cloud"
          }
        }
      },
      "then": {
        "properties": {
          "components": {
            "contains": {
              "properties": {
                "id": {
                  "const": "cloudroom"
                },
                "state": {
                  "const": "verified"
                }
              },
              "required": [
                "id",
                "state"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "host": {
            "const": "cloud"
          }
        }
      },
      "then": {
        "properties": {
          "components": {
            "not": {
              "contains": {
                "properties": {
                  "reason": {
                    "const": "cloudroom_not_needed"
                  }
                },
                "required": [
                  "reason"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "host"
        ],
        "not": {
          "properties": {
            "host": {
              "const": "cloud"
            }
          }
        }
      },
      "then": {
        "properties": {
          "components": {
            "contains": {
              "properties": {
                "id": {
                  "const": "cloudroom"
                },
                "state": {
                  "const": "unknown"
                },
                "reason": {
                  "const": "cloudroom_not_needed"
                }
              },
              "required": [
                "id",
                "state",
                "reason"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "cost": {
            "properties": {
              "provenance": {
                "const": "unknown"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "cost": {
            "properties": {
              "credits": {
                "const": null
              },
              "window_s": {
                "const": null
              },
              "monthly_projection": {
                "const": null
              },
              "free_allowance": {
                "const": null
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "cost": {
            "properties": {
              "provenance": {
                "const": "measured"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "cost": {
            "properties": {
              "window_s": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "host_name": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "not": {
        "const": "cloudroom"
      }
    },
    "models_host_selection": {
      "description": "The models host selector and the source marker on the offered-list response, projected together. host is the explicit flag and saved_host is the saved project host. An omitted saved host includes a legacy cloud project.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "$ref": "#/$defs/host_name"
        },
        "saved_host": {
          "$ref": "#/$defs/host_name"
        },
        "source": {
          "const": "local"
        }
      },
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "host"
                ],
                "properties": {
                  "host": {
                    "not": {
                      "const": "cloud"
                    }
                  }
                }
              },
              {
                "required": [
                  "saved_host"
                ],
                "not": {
                  "required": [
                    "host"
                  ]
                },
                "properties": {
                  "saved_host": {
                    "not": {
                      "const": "cloud"
                    }
                  }
                }
              }
            ]
          },
          "then": {
            "required": [
              "source"
            ]
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "host"
                ],
                "properties": {
                  "host": {
                    "const": "cloud"
                  }
                }
              },
              {
                "not": {
                  "required": [
                    "host"
                  ]
                },
                "properties": {
                  "saved_host": {
                    "const": "cloud"
                  }
                }
              }
            ]
          },
          "then": {
            "not": {
              "required": [
                "source"
              ]
            }
          }
        }
      ]
    },
    "prepared_project": {
      "description": "The project settings prepare saves: a cloud project's nine keys exactly as today, or another host's ten, naming the host and holding no CloudRoom id.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "project",
            "operator",
            "service_issue",
            "answer_thread",
            "harness",
            "model",
            "effort",
            "runtime"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]{1,39}/[A-Za-z0-9_.-]{1,100}$",
              "not": {
                "pattern": "/\\.\\.?$"
              }
            },
            "project": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,128}$"
            },
            "operator": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f]([^\\u0000-\\u001f\\u007f-\\u009f]*[^\\s\\u0000-\\u001f\\u007f-\\u009f])?$"
            },
            "service_issue": {
              "type": "integer",
              "minimum": 1,
              "not": {
                "minimum": 9007199254740992
              }
            },
            "answer_thread": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,128}$"
            },
            "harness": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:/-]{1,128}$"
            },
            "model": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:/-]{1,128}$"
            },
            "effort": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:/-]{1,128}$"
            },
            "runtime": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^0\\.[0-9]{1,10}\\.[0-9]{1,10} [0-9a-f]{40}$"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "project",
            "operator",
            "service_issue",
            "answer_thread",
            "harness",
            "model",
            "effort",
            "runtime",
            "host"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]{1,39}/[A-Za-z0-9_.-]{1,100}$",
              "not": {
                "pattern": "/\\.\\.?$"
              }
            },
            "project": {
              "type": "null"
            },
            "operator": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[^\\s\\u0000-\\u001f\\u007f-\\u009f]([^\\u0000-\\u001f\\u007f-\\u009f]*[^\\s\\u0000-\\u001f\\u007f-\\u009f])?$"
            },
            "service_issue": {
              "type": "integer",
              "minimum": 1,
              "not": {
                "minimum": 9007199254740992
              }
            },
            "answer_thread": {
              "type": "null"
            },
            "harness": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:/-]{1,128}$"
            },
            "model": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:/-]{1,128}$"
            },
            "effort": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:/-]{1,128}$"
            },
            "runtime": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^0\\.[0-9]{1,10}\\.[0-9]{1,10} [0-9a-f]{40}$"
                }
              ]
            },
            "host": {
              "allOf": [
                {
                  "type": "string",
                  "maxLength": 40,
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                  "not": {
                    "const": "cloudroom"
                  }
                },
                {
                  "not": {
                    "const": "cloud"
                  }
                }
              ]
            }
          }
        }
      ]
    }
  }
}
