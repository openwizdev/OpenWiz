{
  "schema": "openwiz.settings.v1",
  "roles": {
    "orchestrator": {
      "harness": "claude-code",
      "model": "claude-opus-5-5",
      "effort": "high",
      "account": "work",
      "fallback": [
        {
          "harness": "claude-code",
          "model": "claude-sonnet-5-5",
          "effort": "high",
          "account": "personal"
        }
      ]
    },
    "builder": {
      "harness": "claude-code",
      "model": "claude-opus-5-5",
      "effort": "medium",
      "account": "work",
      "fallback": [
        {
          "harness": "claude-code",
          "model": "claude-opus-5-5",
          "effort": "medium",
          "account": "personal"
        }
      ]
    },
    "fixer": {
      "harness": "claude-code",
      "model": "claude-sonnet-5-5",
      "effort": "medium",
      "account": "personal",
      "fallback": []
    },
    "reviewer": {
      "harness": "codex",
      "model": "gpt-6.2-sol",
      "effort": "medium",
      "account": "codex-work",
      "fallback": [
        {
          "harness": "codex",
          "model": "vendor/demo",
          "effort": "medium",
          "account": "codex-work"
        }
      ]
