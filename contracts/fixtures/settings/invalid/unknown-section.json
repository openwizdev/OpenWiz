  "accounts": {
    "work": {
      "harness": "claude-code",
      "host": "local",
      "reserved": false,
      "profile": {
        "variable": "CLAUDE_CONFIG_DIR",
        "folder": "~/.claude-work"
      }
    },
    "personal": {
      "harness": "claude-code",
      "host": "local",
      "reserved": false,
      "profile": {
        "variable": "CLAUDE_CONFIG_DIR",
        "folder": "~/.claude-personal"
      }
    },
    "codex-work": {
      "harness": "codex",
      "host": "local",
      "reserved": false
    },
    "family": {
      "harness": "claude-code",
      "host": "local",
      "reserved": true,
      "profile": {
        "variable": "CLAUDE_CONFIG_DIR",
        "folder": "~/.claude-family"
      }
    }
  },
  "hosts": {
    "home": {
      "orchestrator": "local",
      "builder": "local",
      "reviewer": "local"
    },
    "overflow": {
      "serves": "builder",
      "host": "boat"
    },
    "max_agents": 8,
    "projects": {
      "syn-owner/syn-app": [
