{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openwiz:schema:first-hour:v1",
  "title": "openwiz.first-hour.v1",
  "description": "One first-hour result or one recovery case (contracts/first-hour.v1.md). The schema checks shape only; the contract's cross-field rules decide eligibility.",
  "oneOf": [
    { "$ref": "#/$defs/result" },
    { "$ref": "#/$defs/recovery" }
  ],
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 500 },
    "ms": { "type": "integer", "minimum": 0 },
    "hex32": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "hex40": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "hex64": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "issue": { "type": "integer", "minimum": 1 },
    "unknown": {
      "type": "object",
      "required": ["unknown"],
      "additionalProperties": false,
      "properties": { "unknown": { "$ref": "#/$defs/text" } }
    },
    "pointer": {
      "type": "string",
      "pattern": "^https://github\\.com/jparker2006/ClosedWiz/(issues|pull)/[1-9][0-9]*#issuecomment-[1-9][0-9]*$"
    },
    "proof_class": { "enum": ["fixture", "recording", "live"] },
    "verdict": { "enum": ["pass", "fail", "unverified"] },
    "synthetic_assumptions": { "type": "array", "items": { "$ref": "#/$defs/text" } },
    "private_record": { "oneOf": [{ "$ref": "#/$defs/pointer" }, { "type": "null" }] },
    "candidate": {
      "type": "object",
      "required": ["version", "source", "target", "manifest_sha256"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string", "pattern": "^0\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
        "source": { "$ref": "#/$defs/hex40" },
        "target": { "enum": ["aarch64-apple-darwin", "x86_64-apple-darwin", "x86_64-unknown-linux-gnu"] },
        "manifest_sha256": { "$ref": "#/$defs/hex64" }
      }
    },
    "candidate_fact": {
      "oneOf": [
        {
          "type": "object",
          "required": ["known"],
          "additionalProperties": false,
          "properties": { "known": { "$ref": "#/$defs/candidate" } }
        },
        { "$ref": "#/$defs/unknown" }
      ]
    },
    "repository_fact": {
      "oneOf": [
        {
          "type": "object",
          "required": ["known"],
          "additionalProperties": false,
          "properties": {
            "known": {
              "type": "object",
              "required": ["full_name", "selected_by_owner"],
              "additionalProperties": false,
              "properties": {
                "full_name": { "type": "string", "pattern": "^[A-Za-z0-9-]{1,39}/[A-Za-z0-9._-]{1,100}$" },
                "selected_by_owner": { "type": "boolean", "const": true }
              }
            }
          }
        },
        { "$ref": "#/$defs/unknown" }
      ]
    },
    "ms_fact": {
      "oneOf": [
        {
          "type": "object",
          "required": ["known"],
          "additionalProperties": false,
          "properties": { "known": { "$ref": "#/$defs/ms" } }
        },
        { "$ref": "#/$defs/unknown" }
      ]
    },
    "clock": {
      "type": "object",
      "required": ["started_at_ms", "ended_at_ms", "limit_ms"],
      "additionalProperties": false,
      "properties": {
        "started_at_ms": { "$ref": "#/$defs/ms_fact" },
        "ended_at_ms": { "$ref": "#/$defs/ms_fact" },
        "limit_ms": { "type": "integer", "const": 3600000 }
      }
    },
    "stage_id": {
      "enum": ["public_instruction", "install", "connections", "idea", "spec_confirmation",
               "plan_approval", "fleet", "review", "ci", "merge"]
    },
    "state": { "enum": ["verified", "missing", "refused", "unknown", "failed"] },
    "basis": {
      "enum": ["instruction_opened", "install_result", "setup_component_verified", "idea_saved",
               "decision_saved", "agents_running", "review_approve_exact_head", "ci_green_exact_head",
               "merge_read_back", "harness_run_observed",
               "cloudroom_reachable", "harness_listed", "answer_accepted", "pr_closed"]
    },
    "evidence": {
      "type": "object",
      "required": ["basis", "at_ms", "detail"],
      "additionalProperties": false,
      "properties": {
        "basis": { "$ref": "#/$defs/basis" },
        "at_ms": { "$ref": "#/$defs/ms" },
        "detail": { "$ref": "#/$defs/text" }
      }
    },
    "stage": {
      "type": "object",
      "required": ["id", "state", "evidence", "reason"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/stage_id" },
        "state": { "$ref": "#/$defs/state" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "reason": { "$ref": "#/$defs/text" }
      }
    },
    "seat": {
      "type": "object",
      "required": ["harness", "model", "effort", "location", "usable", "evidence", "extra_prerequisites"],
      "additionalProperties": false,
      "properties": {
        "harness": { "enum": ["codex", "claude_code"] },
        "model": { "$ref": "#/$defs/text" },
        "effort": { "$ref": "#/$defs/text" },
        "location": { "enum": ["cloud", "local"] },
        "usable": { "$ref": "#/$defs/state" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "extra_prerequisites": { "type": "array", "items": { "$ref": "#/$defs/text" } }
      }
    },
    "wait": {
      "type": "object",
      "required": ["stage", "kind", "started_at_ms", "ended_at_ms", "detail"],
      "additionalProperties": false,
      "properties": {
        "stage": { "$ref": "#/$defs/stage_id" },
        "kind": { "enum": ["install", "account", "approval", "queue", "review", "ci", "other"] },
        "started_at_ms": { "$ref": "#/$defs/ms" },
        "ended_at_ms": { "$ref": "#/$defs/ms" },
        "detail": { "$ref": "#/$defs/text" }
      }
    },
    "help": {
      "type": "object",
      "required": ["stage", "at_ms", "source", "detail"],
      "additionalProperties": false,
      "properties": {
        "stage": { "$ref": "#/$defs/stage_id" },
        "at_ms": { "$ref": "#/$defs/ms" },
        "source": { "enum": ["public_docs", "product_message", "owner", "operator", "private_instruction", "prepared_plan"] },
        "detail": { "$ref": "#/$defs/text" }
      }
    },
    "work_item": {
      "type": "object",
      "required": ["kind", "id", "content", "basis"],
      "additionalProperties": false,
      "oneOf": [
        { "properties": {
          "kind": { "enum": ["draft", "setup_state", "pending_operation"] },
          "content": { "$ref": "#/$defs/hex64" }
        } },
        { "properties": {
          "kind": { "enum": ["branch", "commit"] },
          "content": { "$ref": "#/$defs/hex40" }
        } }
      ],
      "properties": {
        "kind": { "enum": ["draft", "setup_state", "branch", "commit", "pending_operation"] },
        "id": { "type": "string", "pattern": "^[A-Za-z0-9._:/-]{1,200}$" },
        "content": { "type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$" },
        "basis": { "enum": ["owner_state_read_back", "repository_read_back", "provider_read_back", "tab_session_storage"] }
      }
    },
    "operation_kind": {
      "enum": ["connect_app", "prepare_project", "activate_engine", "configure_access",
               "send", "new_thread", "start_agent", "merge"]
    },
    "phase": { "enum": ["proposed", "applied", "refused", "uncertain"] },
    "reconciliation": { "enum": ["none", "provider_read_back"] },
    "operation": {
      "type": "object",
      "required": ["operation_id", "kind", "phase", "effect_count", "attempts", "reconciliation"],
      "additionalProperties": false,
      "properties": {
        "operation_id": { "$ref": "#/$defs/hex32" },
        "kind": { "$ref": "#/$defs/operation_kind" },
        "phase": { "$ref": "#/$defs/phase" },
        "effect_count": { "$ref": "#/$defs/ms" },
        "attempts": { "type": "integer", "minimum": 0 },
        "reconciliation": { "$ref": "#/$defs/reconciliation" }
      }
    },
    "transition": {
      "type": "object",
      "required": ["operation_id", "kind", "phase_before", "phase_after", "effect_count", "attempts", "reconciliation"],
      "additionalProperties": false,
      "properties": {
        "operation_id": { "$ref": "#/$defs/hex32" },
        "kind": { "$ref": "#/$defs/operation_kind" },
        "phase_before": { "$ref": "#/$defs/phase" },
        "phase_after": { "$ref": "#/$defs/phase" },
        "effect_count": { "$ref": "#/$defs/ms" },
        "attempts": { "type": "integer", "minimum": 0 },
        "reconciliation": { "$ref": "#/$defs/reconciliation" }
      }
    },
    "case": {
      "type": "object",
      "required": ["interruption", "before", "after", "operations", "explanation"],
      "additionalProperties": false,
      "properties": {
        "interruption": {
          "enum": ["revoked_access", "refused_access", "builder_unavailable", "reviewer_unavailable",
                   "setup_interrupted", "lost_reply", "browser_restart", "process_restart",
                   "update_rejected", "removal_default", "repeat_approval"]
        },
        "before": { "type": "array", "items": { "$ref": "#/$defs/work_item" } },
        "after": { "type": "array", "items": { "$ref": "#/$defs/work_item" } },
        "operations": { "type": "array", "items": { "$ref": "#/$defs/transition" } },
        "explanation": {
          "type": "object",
          "required": ["what_happened", "took_effect", "next_action"],
          "additionalProperties": false,
          "properties": {
            "what_happened": { "$ref": "#/$defs/text" },
            "took_effect": { "enum": ["yes", "no", "unknown"] },
            "next_action": { "$ref": "#/$defs/text" }
          }
        }
      }
    },
    "finding": {
      "type": "object",
      "required": ["id", "severity", "work_loss", "summary", "owner", "disposition"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]{0,15}$" },
        "severity": { "enum": ["blocker", "high", "medium", "low"] },
        "work_loss": { "type": "boolean" },
        "summary": { "$ref": "#/$defs/text" },
        "owner": { "oneOf": [{ "$ref": "#/$defs/issue" }, { "type": "null" }] },
        "disposition": { "enum": ["open", "fixed", "accepted_gap"] }
      }
    },
    "gap": {
      "type": "object",
      "required": ["claim", "reason"],
      "additionalProperties": false,
      "properties": {
        "claim": { "enum": ["PR1", "PR2", "PR3", "PR4", "PR5", "PR6", "PR7", "PR8"] },
        "reason": { "$ref": "#/$defs/text" }
      }
    },
    "gate_state": { "enum": ["unresolved", "settled"] },
    "producers": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/issue" } },
    "gates": {
      "type": "object",
      "required": ["cloudroom_setup", "paid_offer", "feedback"],
      "additionalProperties": false,
      "properties": {
        "cloudroom_setup": {
          "type": "object",
          "required": ["decision_ticket", "state", "producers"],
          "additionalProperties": false,
          "properties": {
            "decision_ticket": { "type": "integer", "const": 2201 },
            "state": { "$ref": "#/$defs/gate_state" },
            "producers": { "$ref": "#/$defs/producers" }
          }
        },
        "paid_offer": {
          "type": "object",
          "required": ["decision_ticket", "state", "producers"],
          "additionalProperties": false,
          "properties": {
            "decision_ticket": { "type": "integer", "const": 2202 },
            "state": { "$ref": "#/$defs/gate_state" },
            "producers": { "$ref": "#/$defs/producers" }
          }
        },
        "feedback": {
          "type": "object",
          "required": ["decision_ticket", "state", "producers"],
          "additionalProperties": false,
          "properties": {
            "decision_ticket": { "type": "integer", "const": 2203 },
            "state": { "$ref": "#/$defs/gate_state" },
            "producers": { "$ref": "#/$defs/producers" }
          }
        }
      }
    },
    "ten_minute_fleet": {
      "type": "object",
      "required": ["owner", "state", "elapsed_ms"],
      "additionalProperties": false,
      "properties": {
        "owner": { "type": "integer", "const": 1110 },
        "state": { "enum": ["met", "missed", "unmeasured"] },
        "elapsed_ms": { "oneOf": [{ "$ref": "#/$defs/ms" }, { "type": "null" }] }
      }
    },
    "result": {
      "type": "object",
      "required": ["schema", "kind", "verdict", "proof_class", "synthetic_assumptions", "private_record",
                   "candidate", "repository", "clock", "stages", "builder", "reviewer", "waits", "help",
                   "retained_work", "operations", "interruptions", "findings", "gaps", "gates",
                   "ten_minute_fleet"],
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "openwiz.first-hour.v1" },
        "kind": { "const": "result" },
        "verdict": { "$ref": "#/$defs/verdict" },
        "proof_class": { "$ref": "#/$defs/proof_class" },
        "synthetic_assumptions": { "$ref": "#/$defs/synthetic_assumptions" },
        "private_record": { "$ref": "#/$defs/private_record" },
        "candidate": { "$ref": "#/$defs/candidate_fact" },
        "repository": { "$ref": "#/$defs/repository_fact" },
        "clock": { "$ref": "#/$defs/clock" },
        "stages": { "type": "array", "minItems": 10, "maxItems": 10, "items": { "$ref": "#/$defs/stage" } },
        "builder": { "$ref": "#/$defs/seat" },
        "reviewer": { "$ref": "#/$defs/seat" },
        "waits": { "type": "array", "items": { "$ref": "#/$defs/wait" } },
        "help": { "type": "array", "items": { "$ref": "#/$defs/help" } },
        "retained_work": { "type": "array", "items": { "$ref": "#/$defs/work_item" } },
        "operations": { "type": "array", "items": { "$ref": "#/$defs/operation" } },
        "interruptions": { "type": "array", "items": { "$ref": "#/$defs/case" } },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
        "gaps": { "type": "array", "items": { "$ref": "#/$defs/gap" } },
        "gates": { "$ref": "#/$defs/gates" },
        "ten_minute_fleet": { "$ref": "#/$defs/ten_minute_fleet" }
      }
    },
    "recovery": {
      "type": "object",
      "required": ["schema", "kind", "verdict", "proof_class", "synthetic_assumptions", "private_record",
                   "candidate", "case"],
      "additionalProperties": false,
      "properties": {
        "schema": { "const": "openwiz.first-hour.v1" },
        "kind": { "const": "recovery" },
        "verdict": { "$ref": "#/$defs/verdict" },
        "proof_class": { "$ref": "#/$defs/proof_class" },
        "synthetic_assumptions": { "$ref": "#/$defs/synthetic_assumptions" },
        "private_record": { "$ref": "#/$defs/private_record" },
        "candidate": { "$ref": "#/$defs/candidate_fact" },
        "case": { "$ref": "#/$defs/case" }
      }
    }
  }
}
