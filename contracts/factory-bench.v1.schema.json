{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openwiz.dev/contracts/factory-bench.v1.schema.json",
  "title": "Factory bench v1 task sets and results",
  "oneOf": [
    {"$ref": "#/$defs/task_set"},
    {"$ref": "#/$defs/result"}
  ],
  "$defs": {
    "schema": {"const": "openwiz.factory-bench.v1"},
    "text": {"type": "string", "minLength": 1},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}(?![\\s\\S])"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])"},
    "url": {"type": "string", "pattern": "^https://[^/\\s@?#]+/[^\\s?#]+(?![\\s\\S])"},
    "licence": {"enum": ["MIT", "Apache-2.0", "BSD-2-Clause", "BSD-3-Clause", "ISC"]},
    "task_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "name", "tasks"],
      "properties": {
        "schema": {"$ref": "#/$defs/schema"},
        "name": {"$ref": "#/$defs/text"},
        "tasks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/task"}}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "instruction", "start", "judge", "caps"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "source": {"$ref": "#/$defs/source"},
        "instruction": {"$ref": "#/$defs/text"},
        "start": {"$ref": "#/$defs/text"},
        "judge": {
          "type": "object",
          "additionalProperties": false,
          "required": ["run", "timeout"],
          "properties": {
            "run": {"$ref": "#/$defs/text"},
            "timeout": {"type": "integer", "minimum": 1}
          }
        },
        "caps": {
          "type": "object",
          "additionalProperties": false,
          "required": ["wall_minutes", "tokens"],
          "properties": {
            "wall_minutes": {"type": "integer", "minimum": 1},
            "tokens": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "repository", "commit", "licence"],
      "properties": {
        "product": {"$ref": "#/$defs/text"},
        "repository": {"$ref": "#/$defs/url"},
        "commit": {"$ref": "#/$defs/commit"},
        "licence": {"$ref": "#/$defs/licence"}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "version", "commit", "hash", "tasks"],
      "properties": {
        "schema": {"$ref": "#/$defs/schema"},
        "version": {"type": "string", "pattern": "^[0-9][A-Za-z0-9.+-]*(?![\\s\\S])"},
        "commit": {"$ref": "#/$defs/commit"},
        "hash": {"$ref": "#/$defs/hash"},
        "tasks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/task_result"}}
      }
    },
    "task_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "result", "wall_minutes", "tokens", "attempts", "link"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "result": {"type": "string", "pattern": "^(?:pass|fail|unproved: [^\\s].*)(?![\\s\\S])"},
        "wall_minutes": {"type": "number", "minimum": 0},
        "tokens": {"type": "integer", "minimum": 0},
        "attempts": {"type": "integer", "minimum": 0},
        "link": {"oneOf": [{"$ref": "#/$defs/url"}, {"type": "null"}]}
      }
    }
  }
}
