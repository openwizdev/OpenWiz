{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenWiz install v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "source",
    "target",
    "setup_api",
    "archive",
    "archive_sha256",
    "archive_bytes",
    "assets"
  ],
  "properties": {
    "schema": {
      "const": "openwiz.install.v1"
    },
    "version": {
      "type": "string",
      "pattern": "^0\\.[0-9]+\\.[0-9]+$"
    },
    "source": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "target": {
      "enum": [
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-gnu"
      ]
    },
    "setup_api": {
      "const": 1
    },
    "archive": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+\\.tar\\.gz$"
    },
    "archive_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "archive_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "bytes",
          "mode"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!.*(?:^|/)\\.)(openwiz|runtime/(?:[A-Za-z0-9_+-][A-Za-z0-9_.+-]*/)*[A-Za-z0-9_+-][A-Za-z0-9_.+-]*)$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "mode": {
            "enum": [
              "0600",
              "0700"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "path": {
                  "anyOf": [
                    {
                      "enum": [
                        "openwiz"
                      ]
                    },
                    {
                      "pattern": "\\.sh$"
                    }
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "mode": {
                  "const": "0700"
                }
              }
            },
            "else": {
              "properties": {
                "mode": {
                  "const": "0600"
                }
              }
            }
          }
        ]
      },
      "uniqueItems": true,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "const": "openwiz"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "const": "runtime/openwiz-build.txt"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "const": "runtime/install.py"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "const": "runtime/pull.py"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "const": "runtime/skills/setup/SKILL.md"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "const": "runtime/skills/grill/SKILL.md"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "const": "runtime/skills/to-tickets/SKILL.md"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "const": "runtime/skills/launch-fleet/SKILL.md"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "const": "runtime/skills/launch-fleet/scripts/fleet.sh"
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "harness": {
      "$comment": "#1361: the harness targets of install.v1.md \"Harness skills\"; not part of the manifest.",
      "enum": [
        "claude-code",
        "codex",
        "cursor",
        "opencode",
        "grok"
      ]
    }
  }
}
