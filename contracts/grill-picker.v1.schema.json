{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openwiz:schema:grill-picker:v1",
  "title": "openwiz.grill-picker.v1",
  "oneOf": [
    {"$ref": "#/$defs/card"},
    {"$ref": "#/$defs/answer"}
  ],
  "$defs": {
    "version": {"const": "openwiz.grill-picker.v1"},
    "positive_integer": {"type": "integer", "minimum": 1},
    "nonempty_text": {"type": "string", "minLength": 1},
    "option_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*(?![\\s\\S])"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "kind", "number"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9_.-]+(?![\\s\\S])"},
        "kind": {"const": "pull_request"},
        "number": {"$ref": "#/$defs/positive_integer"}
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "comment_id", "request_id", "request_kind", "fingerprint", "grill_file", "round", "question_id"],
      "properties": {
        "subject": {"$ref": "#/$defs/subject"},
        "comment_id": {"$ref": "#/$defs/positive_integer"},
        "request_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*(?![\\s\\S])"},
        "request_kind": {"const": "grill_round"},
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])"},
        "grill_file": {"type": "string", "pattern": "^docs/grills/[A-Za-z0-9][A-Za-z0-9_.-]*[.]md(?![\\s\\S])"},
        "round": {"$ref": "#/$defs/positive_integer"},
        "question_id": {"type": "string", "pattern": "^[A-Z]{1,2}[1-9][0-9]*(?![\\s\\S])"}
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "recommended"],
      "properties": {
        "id": {"$ref": "#/$defs/option_id"},
        "text": {"$ref": "#/$defs/nonempty_text"},
        "recommended": {"type": "boolean"}
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "kind", "context", "text", "options", "multi", "notes", "other"],
      "properties": {
        "schema": {"$ref": "#/$defs/version"},
        "kind": {"const": "card"},
        "context": {"$ref": "#/$defs/context"},
        "text": {"$ref": "#/$defs/nonempty_text"},
        "options": {
          "type": "array",
          "minItems": 1,
          "prefixItems": [
            {
              "$ref": "#/$defs/option",
              "properties": {"recommended": {"const": true}}
            }
          ],
          "items": {
            "$ref": "#/$defs/option",
            "properties": {"recommended": {"const": false}}
          }
        },
        "multi": {"type": "boolean"},
        "notes": {"type": "boolean"},
        "other": {"type": "boolean"}
      }
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "kind", "context", "chosen_option_ids", "at"],
      "properties": {
        "schema": {"$ref": "#/$defs/version"},
        "kind": {"const": "answer"},
        "context": {"$ref": "#/$defs/context"},
        "chosen_option_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/option_id"}
        },
        "notes": {"type": "string"},
        "other": {"$ref": "#/$defs/nonempty_text"},
        "at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9]([.][0-9]+)?Z(?![\\s\\S])"
        }
      },
      "if": {"required": ["other"]},
      "else": {"properties": {"chosen_option_ids": {"minItems": 1}}}
    }
  }
}
