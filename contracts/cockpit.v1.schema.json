{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openwiz:schema:cockpit:v1",
  "title": "openwiz.cockpit.v1",
  "description": "The read-only page-1 cockpit response. Unknown facts are explicit. See cockpit.v1.md for provenance, cross-record rules, freshness and approval guards. Rich fixture values are synthetic, not current-source observations.",
  "$ref": "#/$defs/response",
  "$defs": {
    "response": {
      "type": "object",
      "required": [
        "schema",
        "snapshot_at",
        "projects",
        "needs_you",
        "agents"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "openwiz.cockpit.v1"
        },
        "snapshot_at": {
          "type": "integer",
          "minimum": 0
        },
        "projects": {
          "$ref": "#/$defs/projects"
        },
        "needs_you": {
          "$ref": "#/$defs/needs_you"
        },
        "agents": {
          "$ref": "#/$defs/agents"
        },
        "ready_stock": {
          "$ref": "#/$defs/notification_stock"
        }
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "state",
        "gaps"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gap"
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "state": {
              "const": "complete"
            },
            "gaps": {
              "const": []
            }
          }
        },
        {
          "properties": {
            "state": {
              "const": "partial"
            }
          }
        }
      ]
    },
    "gap": {
      "type": "object",
      "required": [
        "project",
        "kind",
        "detail"
      ],
      "additionalProperties": false,
      "properties": {
        "project": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "kind": {
          "enum": [
            "untested_version",
            "command_failed",
            "timed_out",
            "budget_exhausted",
            "malformed",
            "missing_field",
            "wrong_type",
            "not_found",
            "truncated",
            "unsupported"
          ]
        },
        "detail": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "freshness": {
      "type": "object",
      "required": [
        "state",
        "snapshot_at"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "fresh",
            "stale",
            "unknown"
          ]
        },
        "snapshot_at": {
          "$ref": "#/$defs/fact_time"
        }
      },
      "oneOf": [
        {
          "properties": {
            "state": {
              "enum": [
                "fresh",
                "stale"
              ]
            },
            "snapshot_at": {
              "$ref": "#/$defs/known_time"
            }
          }
        },
        {
          "properties": {
            "state": {
              "const": "unknown"
            },
            "snapshot_at": {
              "$ref": "#/$defs/unknown"
            }
          }
        }
      ]
    },
    "projects": {
      "type": "object",
      "required": [
        "coverage",
        "freshness",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "freshness": {
          "$ref": "#/$defs/freshness"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/project"
          }
        }
      }
    },
    "needs_you": {
      "type": "object",
      "required": [
        "coverage",
        "freshness",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "freshness": {
          "$ref": "#/$defs/freshness"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/need"
          }
        }
      }
    },
    "agents": {
      "type": "object",
      "required": [
        "coverage",
        "freshness",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "freshness": {
          "$ref": "#/$defs/freshness"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/agent"
          }
        }
      }
    },
    "project": {
      "type": "object",
      "required": [
        "id",
        "name",
        "orchestrator"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "$ref": "#/$defs/fact_string"
        },
        "orchestrator": {
          "$ref": "#/$defs/orchestrator"
        }
      }
    },
    "orchestrator": {
      "type": "object",
      "required": [
        "coverage",
        "freshness",
        "target"
      ],
      "additionalProperties": false,
      "properties": {
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "freshness": {
          "$ref": "#/$defs/freshness"
        },
        "target": {
          "$ref": "#/$defs/fact_target"
        }
      }
    },
    "need": {
      "type": "object",
      "required": [
        "project",
        "kind",
        "spec",
        "ticket",
        "wording",
        "age_ms",
        "risky"
      ],
      "additionalProperties": false,
      "properties": {
        "project": {
          "$ref": "#/$defs/fact_string"
        },
        "kind": {
          "enum": [
            "needs_info",
            "held",
            "live",
            "release",
            "publish"
          ]
        },
        "spec": {
          "type": "integer",
          "minimum": 1
        },
        "ticket": {
          "type": "integer",
          "minimum": 1
        },
        "wording": {
          "$ref": "#/$defs/fact_string"
        },
        "age_ms": {
          "$ref": "#/$defs/fact_time"
        },
        "risky": {
          "$ref": "#/$defs/fact_boolean"
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": {
              "enum": [
                "needs_info",
                "held"
              ]
            }
          }
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "live",
                "release",
                "publish"
              ]
            },
            "risky": {
              "const": {
                "known": true
              }
            }
          }
        }
      ]
    },
    "agent": {
      "type": "object",
      "required": [
        "thread",
        "project",
        "title",
        "fleet",
        "ticket",
        "activity",
        "model",
        "state",
        "location",
        "started_at"
      ],
      "additionalProperties": false,
      "properties": {
        "thread": {
          "type": "string",
          "minLength": 1
        },
        "project": {
          "$ref": "#/$defs/fact_string"
        },
        "title": {
          "$ref": "#/$defs/fact_string"
        },
        "fleet": {
          "$ref": "#/$defs/fact_issue"
        },
        "ticket": {
          "$ref": "#/$defs/fact_issue"
        },
        "activity": {
          "const": "active"
        },
        "model": {
          "$ref": "#/$defs/fact_string"
        },
        "state": {
          "$ref": "#/$defs/fact_state"
        },
        "location": {
          "$ref": "#/$defs/fact_location"
        },
        "started_at": {
          "$ref": "#/$defs/fact_time"
        }
      }
    },
    "location": {
      "oneOf": [
        {
          "$ref": "#/$defs/cloud"
        },
        {
          "$ref": "#/$defs/local"
        }
      ]
    },
    "cloud": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "cloud"
        }
      }
    },
    "local": {
      "type": "object",
      "required": [
        "kind",
        "machine"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "local"
        },
        "machine": {
          "$ref": "#/$defs/fact_string"
        }
      }
    },
    "unknown": {
      "type": "object",
      "required": [
        "unknown"
      ],
      "additionalProperties": false,
      "properties": {
        "unknown": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "fact_string": {
      "oneOf": [
        {
          "$ref": "#/$defs/known_string"
        },
        {
          "$ref": "#/$defs/unknown"
        }
      ]
    },
    "known_string": {
      "type": "object",
      "required": [
        "known"
      ],
      "additionalProperties": false,
      "properties": {
        "known": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "fact_time": {
      "oneOf": [
        {
          "$ref": "#/$defs/known_time"
        },
        {
          "$ref": "#/$defs/unknown"
        }
      ]
    },
    "known_time": {
      "type": "object",
      "required": [
        "known"
      ],
      "additionalProperties": false,
      "properties": {
        "known": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "fact_issue": {
      "oneOf": [
        {
          "$ref": "#/$defs/known_issue"
        },
        {
          "$ref": "#/$defs/unknown"
        }
      ]
    },
    "known_issue": {
      "type": "object",
      "required": [
        "known"
      ],
      "additionalProperties": false,
      "properties": {
        "known": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "fact_boolean": {
      "oneOf": [
        {
          "$ref": "#/$defs/known_boolean"
        },
        {
          "$ref": "#/$defs/unknown"
        }
      ]
    },
    "known_boolean": {
      "type": "object",
      "required": [
        "known"
      ],
      "additionalProperties": false,
      "properties": {
        "known": {
          "type": "boolean"
        }
      }
    },
    "fact_state": {
      "oneOf": [
        {
          "$ref": "#/$defs/known_state"
        },
        {
          "$ref": "#/$defs/unknown"
        }
      ]
    },
    "known_state": {
      "type": "object",
      "required": [
        "known"
      ],
      "additionalProperties": false,
      "properties": {
        "known": {
          "enum": [
            "merged",
            "ready",
            "building",
            "in_review",
            "changes_requested",
            "held",
            "blocked"
          ]
        }
      }
    },
    "fact_location": {
      "oneOf": [
        {
          "$ref": "#/$defs/known_location"
        },
        {
          "$ref": "#/$defs/unknown"
        }
      ]
    },
    "known_location": {
      "type": "object",
      "required": [
        "known"
      ],
      "additionalProperties": false,
      "properties": {
        "known": {
          "$ref": "#/$defs/location"
        }
      }
    },
    "fact_target": {
      "oneOf": [
        {
          "$ref": "#/$defs/known_target"
        },
        {
          "$ref": "#/$defs/unknown"
        }
      ]
    },
    "known_target": {
      "type": "object",
      "required": [
        "known"
      ],
      "additionalProperties": false,
      "properties": {
        "known": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "notification_stock": {
      "type": "object",
      "required": [
        "coverage",
        "freshness",
        "projects",
        "totals"
      ],
      "additionalProperties": false,
      "properties": {
        "coverage": {
          "$ref": "#/$defs/notification_coverage"
        },
        "freshness": {
          "$ref": "#/$defs/notification_freshness"
        },
        "projects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/notification_project_stock"
          }
        },
        "totals": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "known"
              ],
              "additionalProperties": false,
              "properties": {
                "known": {
                  "$ref": "#/$defs/notification_stock_counts"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "unknown"
              ],
              "additionalProperties": false,
              "properties": {
                "unknown": {
                  "$ref": "#/$defs/notification_text"
                }
              }
            }
          ]
        }
      }
    },
    "notification_text": {
      "type": "string",
      "minLength": 1
    },
    "notification_stock_counts": {
      "type": "object",
      "required": [
        "ready",
        "running",
        "blocked",
        "held",
        "unapproved",
        "owner_wait",
        "capacity_wait",
        "unknown",
        "state"
      ],
      "additionalProperties": false,
      "properties": {
        "ready": {
          "type": "integer",
          "minimum": 0
        },
        "running": {
          "type": "integer",
          "minimum": 0
        },
        "blocked": {
          "type": "integer",
          "minimum": 0
        },
        "held": {
          "type": "integer",
          "minimum": 0
        },
        "unapproved": {
          "type": "integer",
          "minimum": 0
        },
        "owner_wait": {
          "type": "integer",
          "minimum": 0
        },
        "capacity_wait": {
          "type": "integer",
          "minimum": 0
        },
        "unknown": {
          "type": "integer",
          "minimum": 0
        },
        "state": {
          "type": "string",
          "enum": [
            "fed",
            "low_stock",
            "running_dry",
            "no_builders",
            "indeterminate"
          ]
        }
      }
    },
    "notification_project_stock": {
      "type": "object",
      "required": [
        "project",
        "coverage",
        "freshness",
        "counts",
        "last_good"
      ],
      "additionalProperties": false,
      "properties": {
        "project": {
          "$ref": "#/$defs/notification_id"
        },
        "coverage": {
          "$ref": "#/$defs/notification_coverage"
        },
        "freshness": {
          "$ref": "#/$defs/notification_freshness"
        },
        "counts": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "known"
              ],
              "additionalProperties": false,
              "properties": {
                "known": {
                  "$ref": "#/$defs/notification_stock_counts"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "unknown"
              ],
              "additionalProperties": false,
              "properties": {
                "unknown": {
                  "$ref": "#/$defs/notification_text"
                }
              }
            }
          ]
        },
        "last_good": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/notification_stock_sample"
            }
          ]
        }
      }
    },
    "notification_stock_sample": {
      "type": "object",
      "required": [
        "snapshot_at",
        "counts"
      ],
      "additionalProperties": false,
      "properties": {
        "snapshot_at": {
          "type": "integer",
          "minimum": 0
        },
        "counts": {
          "$ref": "#/$defs/notification_stock_counts"
        }
      }
    },
    "notification_freshness": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "state",
            "snapshot_at"
          ],
          "additionalProperties": false,
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "fresh",
                "stale"
              ]
            },
            "snapshot_at": {
              "type": "object",
              "required": [
                "known"
              ],
              "additionalProperties": false,
              "properties": {
                "known": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "state",
            "snapshot_at"
          ],
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "unknown"
            },
            "snapshot_at": {
              "type": "object",
              "required": [
                "unknown"
              ],
              "additionalProperties": false,
              "properties": {
                "unknown": {
                  "$ref": "#/$defs/notification_text"
                }
              }
            }
          }
        }
      ]
    },
    "notification_coverage": {
      "type": "object",
      "required": [
        "state",
        "gaps"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "complete",
            "partial"
          ]
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/notification_gap"
          }
        }
      }
    },
    "notification_gap": {
      "type": "object",
      "required": [
        "source",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/notification_source_owner"
        },
        "reason": {
          "$ref": "#/$defs/notification_text"
        }
      }
    },
    "notification_source_owner": {
      "type": "string",
      "enum": [
        "decisions",
        "service_health",
        "loop_watchdog",
        "event_router",
        "fleet",
        "inventory",
        "plan",
        "loops",
        "service_update"
      ]
    },
    "notification_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]*$"
    }
  }
}
