{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openwiz:schema:plan:v1",
  "title": "openwiz.plan.v1",
  "description": "Contract only. See plan.v1.md for provenance, cross-record rules and action guards. Fixtures prove no live behavior.",
  "$ref": "#/$defs/response",
  "$defs": {
    "unknown": {
      "type": "object",
      "required": [
        "unknown"
      ],
      "additionalProperties": false,
      "properties": {
        "unknown": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "gap": {
      "type": "object",
      "required": [
        "kind",
        "detail"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "untested_version",
            "command_failed",
            "timed_out",
            "budget_exhausted",
            "malformed",
            "missing_field",
            "wrong_type",
            "not_found",
            "truncated",
            "unsupported"
          ]
        },
        "detail": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "coverage": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "state",
            "gaps"
          ],
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "complete"
            },
            "gaps": {
              "const": []
            }
          }
        },
        {
          "type": "object",
          "required": [
            "state",
            "gaps"
          ],
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "partial"
            },
            "gaps": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/gap"
              },
              "minItems": 1
            }
          }
        }
      ]
    },
    "freshness": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "state",
            "snapshot_at"
          ],
          "additionalProperties": false,
          "properties": {
            "state": {
              "enum": [
                "fresh",
                "stale"
              ]
            },
            "snapshot_at": {
              "type": "object",
              "required": [
                "known"
              ],
              "additionalProperties": false,
              "properties": {
                "known": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "state",
            "snapshot_at"
          ],
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "unknown"
            },
            "snapshot_at": {
              "$ref": "#/$defs/unknown"
            }
          }
        }
      ]
    },
    "response": {
      "type": "object",
      "required": [
        "schema",
        "snapshot_at",
        "coverage",
        "freshness",
        "lanes",
        "tickets",
        "critical_chain"
      ],
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "openwiz.plan.v1"
        },
        "snapshot_at": {
          "type": "integer",
          "minimum": 0
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "freshness": {
          "$ref": "#/$defs/freshness"
        },
        "lanes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lane"
          }
        },
        "tickets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ticket"
          }
        },
        "critical_chain": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "known"
              ],
              "additionalProperties": false,
              "properties": {
                "known": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/chain"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            {
              "$ref": "#/$defs/unknown"
            }
          ]
        }
      }
    },
    "lane_ref": {
      "type": "object",
      "required": [
        "kind",
        "number"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "version",
            "side_spec"
          ]
        },
        "number": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "lane": {
      "type": "object",
      "required": [
        "kind",
        "number",
        "title"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "version",
            "side_spec"
          ]
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "$ref": "#/$defs/fact_string"
        }
      }
    },
    "ticket": {
      "type": "object",
      "required": [
        "number",
        "title",
        "url",
        "spec",
        "lane",
        "state",
        "column",
        "labels",
        "yours",
        "blockers",
        "dependents",
        "pr"
      ],
      "additionalProperties": false,
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "$ref": "#/$defs/fact_string"
        },
        "url": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "known"
              ],
              "additionalProperties": false,
              "properties": {
                "known": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^https://github[.]com/[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*/issues/[1-9][0-9]*$"
                }
              }
            },
            {
              "$ref": "#/$defs/unknown"
            }
          ]
        },
        "spec": {
          "$ref": "#/$defs/fact_issue_or_null"
        },
        "lane": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "known"
              ],
              "additionalProperties": false,
              "properties": {
                "known": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/lane_ref"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            {
              "$ref": "#/$defs/unknown"
            }
          ]
        },
        "state": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "known"
              ],
              "additionalProperties": false,
              "properties": {
                "known": {
                  "enum": [
                    "merged",
                    "ready",
                    "building",
                    "in_review",
                    "changes_requested",
                    "held",
                    "blocked"
                  ]
                }
              }
            },
            {
              "$ref": "#/$defs/unknown"
            }
          ]
        },
        "column": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "known"
              ],
              "additionalProperties": false,
              "properties": {
                "known": {
                  "enum": [
                    "done",
                    "building",
                    "waiting",
                    "needs_you"
                  ]
                }
              }
            },
            {
              "$ref": "#/$defs/unknown"
            }
          ]
        },
        "labels": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "known"
              ],
              "additionalProperties": false,
              "properties": {
                "known": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                }
              }
            },
            {
              "$ref": "#/$defs/unknown"
            }
          ]
        },
        "yours": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "known"
              ],
              "additionalProperties": false,
              "properties": {
                "known": {
                  "type": "boolean"
                }
              }
            },
            {
              "$ref": "#/$defs/unknown"
            }
          ]
        },
        "blockers": {
          "$ref": "#/$defs/fact_issues"
        },
        "dependents": {
          "$ref": "#/$defs/fact_issues"
        },
        "pr": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "known"
              ],
              "additionalProperties": false,
              "properties": {
                "known": {
                  "oneOf": [
                    {
                      "$ref": "#/$defs/pr"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            {
              "$ref": "#/$defs/unknown"
            }
          ]
        }
      }
    },
    "pr": {
      "type": "object",
      "required": [
        "number",
        "url"
      ],
      "additionalProperties": false,
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "pattern": "^https://github[.]com/[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*/pull/[1-9][0-9]*$"
        }
      }
    },
    "chain": {
      "type": "object",
      "required": [
        "root",
        "blocked_count",
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": "integer",
          "minimum": 1
        },
        "blocked_count": {
          "type": "integer",
          "minimum": 0
        },
        "path": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "fact_string": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "known"
          ],
          "additionalProperties": false,
          "properties": {
            "known": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "$ref": "#/$defs/unknown"
        }
      ]
    },
    "fact_issue_or_null": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "known"
          ],
          "additionalProperties": false,
          "properties": {
            "known": {
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "$ref": "#/$defs/unknown"
        }
      ]
    },
    "fact_issues": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "known"
          ],
          "additionalProperties": false,
          "properties": {
            "known": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "uniqueItems": true
            }
          }
        },
        {
          "$ref": "#/$defs/unknown"
        }
      ]
    }
  }
}
