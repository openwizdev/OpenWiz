          {
            "id": "L3",
            "decides": "Should a failing loop post its error once per hour?",
            "context": "Each failed run posts its error to the loop's thread today.",
            "recommendation": "No: post the first error and a count after that."
          },
          {
            "id": "L4",
            "decides": "Should a loop pause itself after three failed runs in a row?",
            "context": "Today a failing loop keeps running every hour and posts the same error each time.",
            "recommendation": "Yes: pause after three failures in a row and tell you once."
          },
          {
            "id": "L5",
            "decides": "Where should a paused loop's notice appear?",
            "context": "A notice can go to the loop's own thread or to Decisions.",
            "recommendation": "In Decisions, as a card with a Resume button."
          }
        ],
        "answered": [
          "L3"
        ]
      }
    },
