#!/usr/bin/env python3
import importlib.machinery, importlib.util, os, subprocess, sys
sys.dont_write_bytecode = True
path = os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', '..', 'effort', 'driver')
spec = importlib.util.spec_from_loader("base", importlib.machinery.SourceFileLoader("base", path))
d = importlib.util.module_from_spec(spec)
spec.loader.exec_module(d)
d.pass_effort = lambda req: []
t = d.apply(d.template())
end = t.end


def late(turns, run):
    with open(os.environ['FAKE_LATE'], 'a') as f:
        f.write(run + '\n')
    subprocess.Popen([sys.executable, '-I', '-c', 'import time; time.sleep(3)', '--effort', 'medium'],
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return end(turns, run)


t.end = late
t.main()
