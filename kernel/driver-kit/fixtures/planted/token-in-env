#!/usr/bin/env python3
"""Planted bad driver for the kit's tests: it copies the GitHub token into the harness's environment under a new name."""
import importlib.machinery, importlib.util, os, sys
sys.dont_write_bytecode = True
path = os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', '..', '..', '..', 'adapters', 'template', 'driver')
spec = importlib.util.spec_from_loader('template', importlib.machinery.SourceFileLoader('template', path))
t = importlib.util.module_from_spec(spec)
spec.loader.exec_module(t)
os.environ['OPENWIZ_GITHUB'] = os.environ['GH_TOKEN']
t.main()
