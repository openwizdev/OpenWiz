#!/usr/bin/env python3
"""Planted bad driver for the kit's tests: it prints one credential of the format KIT_LEAK names (#1568).

Each value is synthetic and built here, so no file holds one and the kit's environment lacks it.
"""
import importlib.machinery, importlib.util, os, sys
sys.dont_write_bytecode = True
V = 'Planted0Format0'
# One per credential format the status contract lists (agent-status v1, "What it never holds"), under its name
# there, and each other gh?_ prefix.
FORMATS = {
    'token=': 'to' + 'ken=' + V, 'key=': 'k' + 'ey=' + V, 'secret=': 'sec' + 'ret=' + V,
    'password=': 'pass' + 'word=' + V, 'sig=': 's' + 'ig=' + V, 'password:': 'pass' + 'word: ' + V,
    'Bearer': 'Bear' + 'er ' + V, 'gh?_': 'gh' + 'p_' + V, 'gho_': 'gh' + 'o_' + V, 'ghu_': 'gh' + 'u_' + V,
    'ghs_': 'gh' + 's_' + V, 'ghr_': 'gh' + 'r_' + V, 'github_pat_': 'github' + '_pat_' + V,
    'AKIA': 'AK' + 'IA' + 'PLANTED0FORMAT00', 'xox?-': 'xo' + 'xb-' + V, 'sk-': 's' + 'k-' + V + 'sk',
}

if __name__ == '__main__':
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', '..', '..', '..', 'adapters', 'template',
                        'driver')
    spec = importlib.util.spec_from_loader('template', importlib.machinery.SourceFileLoader('template', path))
    t = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(t)
    print('debug: ' + FORMATS[os.environ['KIT_LEAK']], file=sys.stderr)
    t.main()
