#!/usr/bin/env python3
import importlib.machinery, importlib.util, io, os, sys
sys.dont_write_bytecode = True
path = os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'base', 'driver')
spec = importlib.util.spec_from_loader('template', importlib.machinery.SourceFileLoader('template', path))
t = importlib.util.module_from_spec(spec)
spec.loader.exec_module(t)
class Bare(Exception):
    def __init__(self, error, next):
        super().__init__(error, None)
raw = sys.stdin.read() if sys.argv[1:] == ['start'] else None
if raw is not None:
    sys.stdin = io.StringIO(raw)
if '"effort"' not in (raw or ''):
    t.Refused = Bare
t.main()
