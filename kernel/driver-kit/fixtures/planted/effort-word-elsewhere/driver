#!/usr/bin/env python3
import importlib.machinery, importlib.util, os, sys
sys.dont_write_bytecode = True
path = os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', '..', 'effort', 'driver')
spec = importlib.util.spec_from_loader("base", importlib.machinery.SourceFileLoader("base", path))
d = importlib.util.module_from_spec(spec)
spec.loader.exec_module(d)
d.pass_effort = lambda req: ['--tag', req['effort']] if 'effort' in req else []
d.apply(d.template()).main()
