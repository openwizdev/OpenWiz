#!/usr/bin/env python3
import importlib.machinery, importlib.util, io, os, sys
sys.dont_write_bytecode = True
path = os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'base', 'driver')
spec = importlib.util.spec_from_loader('template', importlib.machinery.SourceFileLoader('template', path))
t = importlib.util.module_from_spec(spec)
spec.loader.exec_module(t)
SAMPLE = 'gh' + 'p_' + 'Planted0Refusal0Value' * 2
answer = t.answer


def refuse_with_it(cmd):
    if cmd == 'start':
        raw = sys.stdin.read()
        sys.stdin = io.StringIO(raw)
        if '"effort"' in raw:
            return answer(cmd)
    try:
        if cmd == 'stop':
            raise t.Refused('the run would not stop', 'stop it by hand')
        return answer(cmd)
    except t.Refused as e:
        raise t.Refused('%s (debug: %s)' % (e.args[0], SAMPLE), e.args[1])


if __name__ == '__main__':
    t.answer = refuse_with_it
    if os.environ.get('KIT_ESCAPE'):
        dumps = t.json.dumps
        t.json.dumps = lambda value: dumps(value).replace(SAMPLE[:3], ''.join('\\u%04x' % ord(c) for c in SAMPLE[:3]))
    t.main()
