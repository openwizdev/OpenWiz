#!/usr/bin/env python3
import importlib.machinery, importlib.util, json, os, sys
sys.dont_write_bytecode = True
spec = importlib.util.spec_from_loader('kit', importlib.machinery.SourceFileLoader(
    'kit', os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'kit.py')))
kit = importlib.util.module_from_spec(spec)
spec.loader.exec_module(kit)
calls, depth = [], [0]
call, sampled = kit.Kit.call, kit.Kit.sampled


def recorded_call(self, cmd, request=None, env=None, canary=None):
    if cmd == 'start':
        calls.append({'sampled': depth[0], 'effort': 'effort' in request, 'token': 'token' in request,
                      'canary': bool(canary)})
    return call(self, cmd, request, env, canary)


def recorded_sampled(self, *args, **kwargs):
    depth[0] += 1
    try:
        return sampled(self, *args, **kwargs)
    finally:
        depth[0] -= 1


kit.Kit.call, kit.Kit.sampled = recorded_call, recorded_sampled
try:
    code = kit.main(sys.argv[1:])
finally:
    with open(os.environ['KIT_CALLS'], 'w') as f:
        json.dump(calls, f)
sys.exit(code)
