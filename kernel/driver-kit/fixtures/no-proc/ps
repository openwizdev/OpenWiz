#!/bin/sh
env=
for a; do
    shift
    if [ "$a" != -E ]; then set -- "$@" "$a"
    elif [ -z "$NO_PROC_HIDE_ENV" ]; then env=1
    fi
done
for ps in /bin/ps /usr/bin/ps; do [ -x "$ps" ] && break; ps=; done
[ -n "$ps" ] || exit 127
[ -n "$env" ] || exec "$ps" "$@"
[ -n "$NO_PROC_PROBE_ONLY" ] && [ -z "$OPENWIZ_KIT_RUN" ] || exec "$ps" "$@" e
"$ps" "$@" || exit
"$ps" "$@" e | awk '/OPENWIZ_KIT_PROBE=/'
