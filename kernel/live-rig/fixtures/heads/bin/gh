#!/usr/bin/env python3
import base64, hashlib, json, os, sys, urllib.parse

args = sys.argv[1:]
host = args[-1] if args[-2:-1] == ['--hostname'] else None
args = args[:-2] if host else args
host = host or os.environ.get('GH_HOST')
auth = sorted(k for k in ('GH_TOKEN', 'GITHUB_TOKEN', 'GH_ENTERPRISE_TOKEN', 'GITHUB_ENTERPRISE_TOKEN') if k in os.environ)
stdin = '' if sys.stdin is None or sys.stdin.isatty() else sys.stdin.read()
with open(os.environ['HEADS_GH_LOG'], 'a') as f:
    f.write(json.dumps({'args': args, 'stdin': stdin, 'hostname': host, 'auth': auth}) + '\n')


def answer(value):
    print(json.dumps(value))
    sys.exit(0)


def counter(name):
    path = os.path.join(os.environ['HEADS_GH_STATE'], name)
    n = int(open(path).read()) + 1 if os.path.exists(path) else 1
    with open(path, 'w') as f:
        f.write(str(n))
    return n


def state(name, change=None):
    path = os.path.join(os.environ['HEADS_GH_STATE'], name + '.json')
    value = json.load(open(path)) if os.path.exists(path) else {}
    if change:
        change(value)
        with open(path, 'w') as f:
            json.dump(value, f)
    return value


def fail(status):
    print(json.dumps({'message': status}))
    sys.exit(1)


if args[:2] == ['api', 'graphql']:
    fields = dict(a.partition('=')[::2] for a in args[3::2])
    if fields.get('owner', '') + '/' + fields.get('name', '') != os.environ['HEADS_KIT_REPO']:
        sys.exit('gh: the fake answers GraphQL reads of the settings repository only')
    if 'docs/agents/fleet.md' in fields['query']:
        answer({'data': {'repository': {'object': {'text': '| Record authors | `example-bot[bot]` |\n'}}}})
    if fields.get('number') != os.environ['HEADS_KIT_TICKET']:
        sys.exit('gh: the fake answers the settings ticket only')
    with open(os.environ['KIT_TRACKER']) as f:
        comments = json.load(f)['comments']
    nodes = [{'databaseId': c['id'], 'updatedAt': c['updated_at'], 'body': c['body'],
              'author': {'__typename': 'Bot', 'login': c['author'][:-len('[bot]')]}} for c in comments]
    answer({'data': {'repository': {'issue': {'comments': {
        'pageInfo': {'hasNextPage': False, 'endCursor': None}, 'nodes': nodes}}}}})

if args == ['api', 'user']:
    answer({'login': os.environ['HEADS_GH_LOGIN']})

if args[:2] == ['api', '-i']:
    rest, etag = args[2:], None
    if rest[:1] == ['-H']:
        etag, rest = rest[1].partition('If-None-Match: ')[2], rest[2:]
    prefix, suffix = 'repos/openwizdev/OpenWiz/issues/', '/comments?per_page=100'
    page = 2 if rest and rest[0].endswith(suffix + '&page=2') else 1
    path = rest[0][:-len('&page=2')] if page == 2 else rest[0] if rest else ''
    if len(rest) != 1 or not path.startswith(prefix) or not path.endswith(suffix):
        sys.exit('gh: the fake answers live-check ticket comment reads only')
    number = path[len(prefix):-len(suffix)]
    with open(os.environ['HEADS_COMMENTS']) as f:
        comments = json.load(f).get(number)
    if comments is None:
        print('HTTP/2.0 404 Not Found\r\n\r\n{"message": "Not Found"}')
        sys.exit(1)
    link = 'Link: <https://api.github.com/%s&page=2>; rel="next"\r\n' % path if page == 1 and len(comments) > 100 else ''
    comments = comments[100:] if page == 2 else comments[:100]
    body = json.dumps(comments)
    tag = 'W/"%s"' % hashlib.sha256(body.encode()).hexdigest()
    if etag == tag:
        print('HTTP/2.0 304 Not Modified\r\nEtag: %s\r\n\r\n' % tag, end='')
        sys.exit(1)
    print('HTTP/2.0 200 OK\r\nContent-Type: application/json\r\nEtag: %s\r\n%s\r\n%s' % (tag, link, body))
    sys.exit(0)

if args == ['api', 'repos/openwizdev/WizMarket/git/ref/heads/main']:
    answer({'ref': 'refs/heads/main', 'object': {'sha': 'c' * 40}})

login = os.environ['HEADS_GH_LOGIN']
fork = 'repos/%s/WizMarket/' % login
if args[:1] == ['api'] and len(args) == 2 and args[1].startswith(fork + 'git/ref/heads/'):
    sha = state('refs').get(args[1][len(fork + 'git/ref/'):])
    answer({'object': {'sha': sha}}) if sha else fail('Not Found')
if args[:1] == ['api'] and len(args) == 2 and args[1].startswith(fork + 'contents/'):
    rel, _, branch = args[1][len(fork + 'contents/'):].partition('?ref=')
    text = state('contents').get(branch + ':' + rel)
    answer({'content': base64.b64encode(text.encode()).decode()}) if text else fail('Not Found')
if args[:1] == ['api'] and len(args) == 2 and args[1].startswith('repos/openwizdev/WizMarket/pulls?head='):
    query = urllib.parse.parse_qs(args[1].split('?', 1)[1])
    answer([p for p in state('pulls').get(query['head'][0], []) if query['state'][0] in ('all', p['state'])])
if args[:1] == ['api'] and len(args) == 2 and args[1].startswith('repos/openwizdev/OpenWiz/issues/') and \
        '/comments?' in args[1]:
    query = {k: v[0] for k, v in urllib.parse.parse_qs(args[1].split('?', 1)[1]).items()}
    found = [c for c in state('comments').get(args[1].split('/')[4], []) if c['updated_at'] >= query.get('since', '')]
    page = int(query.get('page', '1'))
    answer(found[(page - 1) * 100:page * 100])


def lose(method):
    if os.environ.get('HEADS_LOSE') == method:
        fail('the answer was lost')


if args[:2] == ['api', '-X'] and args[4:] == ['--input', '-']:
    method, path, sent = args[2], args[3], json.loads(stdin or '{}')
    if method == 'POST' and path.startswith('repos/openwizdev/OpenWiz/issues/') and path.endswith('/comments'):
        number = path.split('/')[4]
        url = 'https://github.com/openwizdev/OpenWiz/pull/%s#issuecomment-%d' % (number, 900 + counter('comment'))
        state('comments', lambda c: c.setdefault(number, []).append({'html_url': url, 'body': sent['body'],
                                                                       'user': {'login': login}, 'updated_at': os.environ.get(
                                                                           'HEADS_NOW', '2030-01-02T03:04:05Z')}))
        lose('comment')
        answer({'html_url': url})
    if (method, path) == ('POST', 'repos/openwizdev/WizMarket/forks'):
        answer({'full_name': login + '/WizMarket'})
    if (method, path) == ('POST', 'repos/%s/WizMarket/git/refs' % login):
        if sent['ref'][len('refs/'):] in state('refs'):
            fail('Reference already exists')
        state('refs', lambda r: r.update({sent['ref'][len('refs/'):]: sent['sha']}))
        answer({'ref': sent['ref']})
    if method == 'PUT' and path.startswith('repos/%s/WizMarket/contents/receipts/' % login):
        key = sent['branch'] + ':' + path.split('/contents/', 1)[1]
        if key in state('contents'):
            fail('Invalid request. "sha" wasn\'t supplied.')
        state('contents', lambda c: c.update({key: base64.b64decode(sent['content']).decode()}))
        lose('PUT')
        answer({'content': {'path': path.split('/contents/', 1)[1]}})
    if (method, path) == ('POST', 'repos/openwizdev/WizMarket/pulls'):
        if os.environ.get('HEADS_REFUSE') == 'pulls':
            fail('Server Error')
        url = 'https://github.com/openwizdev/WizMarket/pull/%d' % (40 + counter('pull'))
        state('pulls', lambda p: p.setdefault(sent['head'], []).append({
            'html_url': url, 'state': 'open', 'head': {'label': sent['head']}, 'base': {'ref': sent['base']},
            'title': sent['title'], 'body': sent['body']}))
        answer({'html_url': url})
sys.exit('gh: the fake refuses %s' % ' '.join(args[:4]))
